        // // Page_Footer is printed on each page before Page_Bottom
        //Procedure Page_Footer
        //    string  sFont
        //    integer iFontSize
        //    Move "arial" to sFont
        //    Move 8 to iFontSize
        //    DFFont sFont
        //    DFFontSize iFontSize
