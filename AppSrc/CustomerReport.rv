// CustomerReport.rv
// Customer Listing (WinPrint 2)
Register_Object oReport

Use DFRptVw.pkg
Use cWinReport2.pkg
Use Windows.pkg

Use cCustomerDataDictionary.dd

ACTIVATE_VIEW Activate_CustomerReport FOR CustomerReport
Object CustomerReport is a ReportView
    Set Location to 6 6
    Set Size to 60 202
    Set Label To "Customer Listing (WinPrint 2)"


    Object oCustomer_DD is a cCustomerDataDictionary
    End_Object 

    Set Main_DD To oCustomer_DD




    Object oPrintTo is a RadioGroup
        Set Size to 38 118
        Set Location to 10 12
        Set Label to C_$SendReportTo

        Object oRadio1 is a Radio
            Set Label to C_$PrintToReportViewer
            Set Size to 10 61
            Set Location to 12 6
            Set Status_Help to C_$PrintToScreenStatusHelp
        End_Object 

        Object oRadio2 is a Radio
            Set Label to C_$PrintToPrinter
            Set Size to 10 42
            Set Location to 24 6
            Set Status_Help to C_$PrintToPrinterStatusHelp
        End_Object 

        Function IsToPrinter Returns boolean
            integer iRadio
            Get Current_radio to iRadio
            Function_return (iRadio=1)
        End_Function 

    End_Object 

    Object oBtnPrint is a Button
        Set Label to C_$PrintButtonLabel
        Set Location to 5 140
        Set Status_Help to C_$PrintButtonStatusHelp
        Set Default_State to TRUE
        Procedure OnClick
            Send StartReport
        End_Procedure
    End_Object 

    Object oBtnPrinterSetup is a Button
        Set Label to C_$PrinterSetup
        Set Location to 22 140
        Set Status_Help to C_$PrinterSetupStatusHelp
        Procedure OnClick
            Send DFPrintSetup of oReport
        End_Procedure
    End_Object 

    Object oBtnCancel is a Button
        Set Label to C_$Cancel
        Set Location to 39 140
        Set Status_Help to C_$CloseThisPanel
        Procedure OnClick
            Send Close_Panel
        End_Procedure
    End_Object 



    Object oReport is a cWinReport2

        Set Report_Title to "Customer Listing (WinPrint 2)"

        // Set DDO, Index and breaks for the report
        Set Server to oCustomer_DD
        Set Ordering to 1
        // Report_Breaks file.field // no breaks in this report

        Function Starting_Main_Report Returns Integer
            Boolean bErr
            Send DFSetMetrics wpm_cm
            Send DFSetmargins 1 1 1 1
            //Send DFSetLandscape false // This can be used to force a page orientation
            Forward Get Starting_Main_Report to bErr
            Function_return bErr
        End_Function 

        // Page_Top is printed first at the top margin of each page
        Procedure Page_Top 
            string  sFont
            integer iFontSize

            Move "arial" to sFont
            Move 8 to iFontSize

            DFFont sFont
            DFFontSize iFontSize
            DFBeginHeader DFPageTop
                DFHeaderFrame Hdr_NoFrame
                DFHeaderPos   Hdr_Left
                DFWriteLn (C_$WinPrintPage * "#pagecount#") (Font_Right)
            DFEndHeader

        End_Procedure 

        // Report_Header is printed once in a report after Page_Top
        //Procedure Report_Header
        //    string  sFont
        //    integer iFontSize
        //    Move "arial" to sFont
        //    Move 8 to iFontSize
        //    DFFont sFont
        //    DFFontSize iFontSize
        //    DFBeginHeader  DFReportHeader
        //        DFHeaderFrame  Hdr_Margins 0.01
        //        DFHeaderPos    Hdr_Left
        //        DFHeaderMargin Hm_BottomOuter 0.08
        //        DFWrite     "Report_Header" (Font_Bold+Font_Center)
        //    DFEndHeader
        //End_Procedure

        Procedure Page_Header 
            integer iFill iBorder iStyle
            string  sFont sReportTitle
            integer iFontSize

            Move "arial" to sFont
            Move 16 to iFontSize
            Move (Font_bold + rgb_White) to iStyle
            Move (rgb_dGrey) to iFill
            Move (rgb_dGrey) to iBorder
            Get Report_Title to sReportTitle

            DFFont sFont
            DFFontSize iFontSize
            DFBeginHeader DFPageHeader
                DFHeaderPos   Hdr_Left
                DFHeaderFrame Hdr_Margins 0.01 iBorder iFill
                DFWritelnPos sReportTitle 0.1 iStyle
                DFHeaderMargin HM_BottomOuter 0.08
            DFEndHeader

        End_Procedure 

        Procedure Page_Title 
            string  sFont 
            integer iFontSize iHeaderStyle iFill iBorder

            Move "arial" to sFont
            Move 8 to iFontSize
            Move (Font_Bold + rgb_dBlue) to iHeaderStyle
            Move (rgb_Grey) to iFill
            Move (rgb_Grey) to iBorder

            DFFont sFont
            DFFontSize iFontSize
            DFBeginHeader DFPageTitle
                DFHeaderPos   Hdr_Left
                DFHeaderFrame Hdr_Margins 0.01 iBorder iFill
                DFHeaderMargin HM_TopInner    0.04
                DFHeaderMargin HM_BottomInner 0.04
                DFHeaderMargin HM_BottomOuter 0.08

                DFWritePos "Number"                       (0.08 + 1.22) (iHeaderStyle + Font_Right) -1 1.22
                DFWritePos "Name"                         1.38 iHeaderStyle -1 5.11
                DFWritePos "Address"                      6.57 iHeaderStyle -1 5.11
                DFWritePos "City"                         11.76 iHeaderStyle -1 2.38
                DFWritePos "St."                          14.22 iHeaderStyle -1 0.61
                DFWritePos "Zip"                          14.91 iHeaderStyle -1 1.7
                DFWriteLn
            DFEndHeader

        End_Procedure 

        Procedure Body 
            string  sFont 
            integer iFontSize iStyle

            Move "arial" to sFont
            Move 8 to iFontSize
            Move (font_default) to iStyle

            DFFont sFont
            DFFontSize iFontSize

            DFWritePos Customer.Customer_Number       (0.08 + 1.22) (iStyle + Font_Right) 0 1.22
            DFWritePos Customer.Name                  1.38 iStyle -1 5.11
            DFWritePos Customer.Address               6.57 iStyle -1 5.11
            DFWritePos Customer.City                  11.76 iStyle -1 2.38
            DFWritePos Customer.State                 14.22 iStyle -1 0.61
            DFWritePos Customer.Zip                   14.91 iStyle -1 1.7
            DFWriteLn

        End_Procedure 

