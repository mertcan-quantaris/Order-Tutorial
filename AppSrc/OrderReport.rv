        //        DFHeaderPos    Hdr_Left
        //        DFHeaderMargin Hm_BottomOuter 0.08
        //        DFWrite     "Page_Title" (Font_Bold+Font_Center)
        //    DFEndHeader
        //End_Procedure

        Procedure SubHeader1 
            string  sFont 
            integer iFontSize iStyle
            integer iFill iBorder iHeaderStyle

            Move "arial" to sFont
            Move 8 to iFontSize
            Move (Font_Bold + rgb_dBlue) to iStyle
            Move (Font_Bold + rgb_dBlue) to iHeaderStyle
            Move (rgb_dGrey) to iBorder
            Get DFGetDFColor 242 242 242 to iFill

            DFFont sFont
            DFFontSize iFontSize
            DFBeginHeader DFSubHeader 1
                DFHeaderLineCheck 5
                DFHeaderWrap   HDR_Wrap
                DFHeaderPos    HDR_Left
                DFHeaderFrame  Hdr_Margins 0.01 iBorder iFill
                DFHeaderMargin hm_BottomOuter 0.08
                DFHeaderMargin hm_TopInner    0.04
                DFHeaderMargin hm_BottomInner 0.04

                // display fields to be placed in this sub-header
                DFWritePos "Order Number:"               0.1 iHeaderStyle -1 4.9
                DFWritePos OrderHeader.Order_Number       5 (iStyle + Font_Right) 0
                DFWriteLn
                DFWritePos "Order Date:"                 0.1 iHeaderStyle -1 4.9
                DFWritePos OrderHeader.Order_Date         5 iStyle -1
                DFWriteLn
                DFWritePos "Order Total:"                0.1 iHeaderStyle -1 4.9
                DFWritePos OrderHeader.Order_Total        5 (iStyle + Font_Right) 2
                DFWriteLn
                DFWritePos "Sales Person Name:"          0.1 iHeaderStyle -1 4.9
                DFWritePos SalesPerson.Name               5 iStyle -1
                DFWriteLn

                // write the heading for the body section
                DFFontSize 1 // create a very small space on top and below the horizontal bar
                DFWriteLn
                DFWriteLine DFGR_CURRLINE DFGR_CURRLINE DFGR_RB_MARGIN DFGR_HORI iBorder
                DFWriteLn
                DFFontSize iFontSize
                DFWritePos "Vendor"                       0.08 iHeaderStyle -1 5.11
                DFWritePos "Item ID"                      (5.27 + 1.7) (iHeaderStyle + Font_Right) -1 1.7
                DFWritePos "Description"                  7.05 iHeaderStyle -1 5.97
                DFWritePos "Unit Price"                   (13.1 + 2.04) (iHeaderStyle + Font_Right) -1 2.04
                DFWriteLn

            DFEndHeader

        End_Procedure 

        Procedure Body 
            string  sFont 
            integer iFontSize iStyle

            Move "arial" to sFont
            Move 8 to iFontSize
            Move (font_default) to iStyle

            DFFont sFont
            DFFontSize iFontSize

            DFWritePos Vendor.Name                    0.08 iStyle -1 5.11
            DFWritePos Inventory.Item_Id              (5.27 + 1.7) (iStyle + Font_Right) 0 1.7
            DFWritePos Inventory.Description          7.05 iStyle -1 5.97
            DFWritePos Inventory.Unit_Price           (13.1 + 2.04) (iStyle + Font_Right) 2 2.04
            DFWriteLn

        End_Procedure 

