// OrderReport.rv
// Order Report
Register_Object oReport

Use DFRptVw.pkg
Use cWinReport2.pkg
Use Windows.pkg

Use cCustomerDataDictionary.dd
Use cSalesPersonDataDictionary.dd
Use cVendorDataDictionary.dd
Use cOrderHeaderDataDictionary.dd
Use cInventoryDataDictionary.dd
Use cOrderDetailDataDictionary.dd

ACTIVATE_VIEW Activate_OrderReport FOR OrderReport
Object OrderReport is a ReportView
    Set Location to 6 6
    Set Size to 100 202
    Set Label To "Order Report"


    Object oCustomer_DD is a cCustomerDataDictionary
    End_Object 

    Object oSalesPerson_DD is a cSalesPersonDataDictionary
    End_Object 

    Object oVendor_DD is a cVendorDataDictionary
    End_Object 

    Object oOrderHeader_DD is a cOrderHeaderDataDictionary
        Set DDO_Server To oCustomer_DD
        Set DDO_Server To oSalesPerson_DD
        Property Number pnStartOrder_Number
        Property Number pnStopOrder_Number

        Procedure OnConstrain 
            Number nStart nStop

            Get pnStartOrder_Number To nStart
            Get pnStopOrder_Number To nStop

            Case Begin
                Case (nStart <> 0 and nStop <> 0)
                    Constrain OrderHeader.Order_Number between nStart and nStop
                    Case Break
                Case (nStart <> 0)
                    Constrain OrderHeader.Order_Number GE nStart
                    Case Break
                Case (nStop <> 0)
                    Constrain OrderHeader.Order_Number LE nStop
            Case End
        End_Procedure 
    End_Object 

    Object oInventory_DD is a cInventoryDataDictionary
        Set DDO_Server To oVendor_DD
    End_Object 

    Object oOrderDetail_DD is a cOrderDetailDataDictionary
        Set DDO_Server To oOrderHeader_DD
        Set DDO_Server To oInventory_DD
    End_Object 

    Set Main_DD To oOrderDetail_DD



    Object oOrder_NumberSelection is a Group
        Set Size to 35 179
        Set Location to 5 12
        Set Label to "C_$Select Order Number"

        Object oSelStart is a Form
            Set Label to C_$FromValueLabel
            Set Size to 12 60
            Set Location to 13 30
            Set Status_Help to C_$FirstValueInSelectionRange
            Set Label_Col_Offset to 2
            Set Label_Justification_Mode to jMode_Right
            Set Form_datatype to 0
        End_Object 

        Object oSelStop is a Form
            Set Label to C_$ToValueLabel
            Set Size to 12 60
            Set Location to 13 111
            Set Status_Help to C_$LastValueInSelectionRange
            Set Label_Col_Offset to 2
            Set Label_Justification_Mode to jMode_Right
            Set Form_datatype to 0
        End_Object 


        Function StartValue returns String
            string sValue
            Get Value of oSelStart to sValue
            Function_return sValue
        End_Function 

        Function StopValue returns String
            string sValue
            Get Value of oSelStop to sValue
            Function_return sValue
        End_Function 

    End_Object 

    Object oPrintTo is a RadioGroup
        Set Size to 38 118
        Set Location to 50 12
        Set Label to C_$SendReportTo

        Object oRadio1 is a Radio
            Set Label to C_$PrintToReportViewer
            Set Size to 10 61
            Set Location to 12 6
            Set Status_Help to C_$PrintToScreenStatusHelp
        End_Object 

        Object oRadio2 is a Radio
            Set Label to C_$PrintToPrinter
            Set Size to 10 42
            Set Location to 24 6
            Set Status_Help to C_$PrintToPrinterStatusHelp
        End_Object 


        Function IsToPrinter Returns boolean
            integer iRadio
            Get Current_radio to iRadio
            Function_return (iRadio=1)
        End_Function 

    End_Object 

    Object oBtnPrint is a Button
        Set Label to C_$PrintButtonLabel
        Set Location to 45 140
        Set Status_Help to C_$PrintButtonStatusHelp
        Set Default_State to TRUE
        Procedure OnClick
            Send StartReport
        End_Procedure
    End_Object 

    Object oBtnPrinterSetup is a Button
        Set Label to C_$PrinterSetup
        Set Location to 62 140
        Set Status_Help to C_$PrinterSetupStatusHelp
        Procedure OnClick
            Send DFPrintSetup of oReport
        End_Procedure
    End_Object 

    Object oBtnCancel is a Button
        Set Label to C_$Cancel
        Set Location to 79 140
        Set Status_Help to C_$CloseThisPanel
        Procedure OnClick
            Send Close_Panel
        End_Procedure
    End_Object 



    Object oReport is a cWinReport2

        Set Report_Title to "Order Report"

        // Set DDO, Index and breaks for the report
        Set Server to oOrderDetail_DD
        Set Ordering to 1
        Report_Breaks OrderDetail.Order_Number

        Function Starting_Main_Report Returns Integer
            Boolean bErr
            Send DFSetMetrics wpm_cm
            Send DFSetmargins 1 1 1 1
            //Send DFSetLandscape false // This can be used to force a page orientation
            Forward Get Starting_Main_Report to bErr
            Function_return bErr
        End_Function 

        // Page_Top is printed first at the top margin of each page
        Procedure Page_Top 
            string  sFont
            integer iFontSize

            Move "arial" to sFont
            Move 8 to iFontSize

            DFFont sFont
            DFFontSize iFontSize
            DFBeginHeader DFPageTop
                DFHeaderFrame Hdr_NoFrame
                DFHeaderPos   Hdr_Left
                DFWriteLn (C_$WinPrintPage * "#pagecount#") (Font_Right)
            DFEndHeader

        End_Procedure 

        // Report_Header is printed once in a report after Page_Top
        //Procedure Report_Header
        //    string  sFont
        //    integer iFontSize
        //    Move "arial" to sFont
        //    Move 8 to iFontSize
        //    DFFont sFont
        //    DFFontSize iFontSize
        //    DFBeginHeader  DFReportHeader
        //        DFHeaderFrame  Hdr_Margins 0.01
        //        DFHeaderPos    Hdr_Left
        //        DFHeaderMargin Hm_BottomOuter 0.08
        //        DFWrite     "Report_Header" (Font_Bold+Font_Center)
        //    DFEndHeader
        //End_Procedure

        Procedure Page_Header 
            integer iFill iBorder iStyle
            string  sFont sReportTitle
            integer iFontSize

            Move "arial" to sFont
            Move 16 to iFontSize
            Move (Font_bold + rgb_White) to iStyle
            Move (rgb_dGrey) to iFill
            Move (rgb_dGrey) to iBorder
            Get Report_Title to sReportTitle

            DFFont sFont
            DFFontSize iFontSize
            DFBeginHeader DFPageHeader
                DFHeaderPos   Hdr_Left
                DFHeaderFrame Hdr_Margins 0.01 iBorder iFill
                DFWritelnPos sReportTitle 0.1 iStyle
                DFHeaderMargin HM_BottomOuter 0.08
            DFEndHeader

        End_Procedure 

        // Page_Title appears on every page after Page_Header
        //Procedure Page_Title
        //    string  sFont
        //    integer iFontSize
        //    Move "arial" to sFont
        //    Move 8 to iFontSize
        //    DFFont sFont
        //    DFFontSize iFontSize
