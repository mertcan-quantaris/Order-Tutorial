75931>>>>>    Procedure End_Construct_Object
75933>>>>>        Handle hoVersionInfo
75933>>>>>        Boolean bIncluded
75933>>>>>        Integer iMajor iMinor iRelease iBuild
75933>>>>>        String sLabel
75933>>>>>        
75933>>>>>        Get Label of oVersion to sLabel
75934>>>>>        If (sLabel = C_$VERSION) Begin
75936>>>>>            // set it To the version info Of the program, if available
75936>>>>>            If (ghoApplication <> 0) Begin
75938>>>>>                Get phoVersionInfo of ghoApplication to hoVersionInfo
75939>>>>>                If (hoVersionInfo <> 0) Begin
75941>>>>>                    Get pbIncluded of hoVersionInfo to bIncluded
75942>>>>>                    If (bIncluded) Begin
75944>>>>>                        Get piVersionMajor of hoVersionInfo to iMajor
75945>>>>>                        Get piVersionMinor of hoVersionInfo to iMinor
75946>>>>>                        Get piVersionRelease of hoVersionInfo to iRelease
75947>>>>>                        Get piVersionBuild of hoVersionInfo to iBuild
75948>>>>>                        Move (SFormat (C_$VERSION + ": %1.%2.%3.%4", iMajor, iMinor, iRelease, iBuild)) to sLabel
75949>>>>>                        Set Version to sLabel
75950>>>>>                    End
75950>>>>>>
75950>>>>>                End
75950>>>>>>
75950>>>>>            End
75950>>>>>>
75950>>>>>        End
75950>>>>>>
75950>>>>>        
75950>>>>>        Forward Send End_Construct_Object
75952>>>>>    End_Procedure
