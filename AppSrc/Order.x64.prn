75341>>>>>>>    Function EnumerateServersNetworkOrLocal Integer iNetworkLocal  Returns Integer
75343>>>>>>>        
75343>>>>>>>        String  sServerList
75343>>>>>>>        Integer iNumServers
75343>>>>>>>        Integer iDriver
75343>>>>>>>        Integer iClientVersion
75343>>>>>>>        String  sDriver
75343>>>>>>>        
75343>>>>>>>        Get DriverIndex MSSQLDRV_ID to iDriver
75344>>>>>>>        
75344>>>>>>>        If (iDriver) Begin
75346>>>>>>>            
75346>>>>>>>            Get_Attribute DF_DRIVER_SQLSERVER_CLIENT_VERSION of iDriver to iClientVersion
75349>>>>>>>            
75349>>>>>>>            Get SqlServerClientDriverName iClientVersion to sDriver
75350>>>>>>>            
75350>>>>>>>            Move ("DRIVER={" + sDriver + "};") to sDriver
75351>>>>>>>            If (iNetworkLocal = 0) Begin
75353>>>>>>>                Get BrowseConnect sDriver to sServerList
75354>>>>>>>            End
75354>>>>>>>>
75354>>>>>>>            Else Begin
75355>>>>>>>                Get BrowseConnectLocal sDriver to sServerList
75356>>>>>>>            End
75356>>>>>>>>
75356>>>>>>>            Get ExtractList sServerList Current_object to iNumServers
75357>>>>>>>        End
75357>>>>>>>>
75357>>>>>>>        
75357>>>>>>>        Function_Return iNumServers
75358>>>>>>>        
75358>>>>>>>    End_Function
75359>>>>>>>    
75359>>>>>>>    //   Enumerate the available SQL Server database servers
75359>>>>>>>    //   This function will return all SQL Server instances on the network.
75359>>>>>>>    //   This may take a long time.
