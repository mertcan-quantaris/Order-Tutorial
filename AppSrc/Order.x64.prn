75385>>>>>>>    Function EnumerateServersNetworkOrLocal Integer iNetworkLocal  Returns Integer
75387>>>>>>>        
75387>>>>>>>        String  sServerList
75387>>>>>>>        Integer iNumServers
75387>>>>>>>        Integer iDriver
75387>>>>>>>        Integer iClientVersion
75387>>>>>>>        String  sDriver
75387>>>>>>>        
75387>>>>>>>        Get DriverIndex MSSQLDRV_ID to iDriver
75388>>>>>>>        
75388>>>>>>>        If (iDriver) Begin
75390>>>>>>>            
75390>>>>>>>            Get_Attribute DF_DRIVER_SQLSERVER_CLIENT_VERSION of iDriver to iClientVersion
75393>>>>>>>            
75393>>>>>>>            Get SqlServerClientDriverName iClientVersion to sDriver
75394>>>>>>>            
75394>>>>>>>            Move ("DRIVER={" + sDriver + "};") to sDriver
75395>>>>>>>            If (iNetworkLocal = 0) Begin
75397>>>>>>>                Get BrowseConnect sDriver to sServerList
75398>>>>>>>            End
75398>>>>>>>>
75398>>>>>>>            Else Begin
75399>>>>>>>                Get BrowseConnectLocal sDriver to sServerList
75400>>>>>>>            End
75400>>>>>>>>
75400>>>>>>>            Get ExtractList sServerList Current_object to iNumServers
75401>>>>>>>        End
75401>>>>>>>>
75401>>>>>>>        
75401>>>>>>>        Function_Return iNumServers
75402>>>>>>>        
75402>>>>>>>    End_Function
75403>>>>>>>    
