75724>>>>>    Procedure Show_Drivers
75726>>>>>        String sCurrentDriver sRevNumber
75726>>>>>        String sLoadedDrivers sClientDriver
75726>>>>>        Integer iNumberOfDrivers iCount iClientVersion iMSSQLIndex
75726>>>>>        Boolean bOK
75726>>>>>        Handle hoMsqlDrv
75726>>>>>        
75726>>>>>        Move "" to sLoadedDrivers
75727>>>>>        Get_Attribute DF_NUMBER_DRIVERS to iNumberOfDrivers
75730>>>>>        For iCount from 1 to iNumberOfDrivers
75736>>>>>>
75736>>>>>            Get_Attribute DF_DRIVER_NAME of iCount to sCurrentDriver
75739>>>>>            If (sLoadedDrivers <> "") Begin
75741>>>>>                Move (Append (sLoadedDrivers, ", ")) to sLoadedDrivers
75742>>>>>            End
75742>>>>>>
75742>>>>>            Get IsDataAccessCK sCurrentDriver to bOK
75743>>>>>            If (bOK) Begin
75745>>>>>                If (sCurrentDriver = "MSSQLDRV") Begin
75747>>>>>                    Move iCount to iMSSQLIndex
75748>>>>>                End
75748>>>>>>
75748>>>>>                Get CKRevisionNumber sCurrentDriver to sRevNumber
75749>>>>>                // if mssqldrv, show the client number
75749>>>>>                Move (sCurrentDriver * "(" + sRevNumber + ")") to sCurrentDriver
75750>>>>>            End
75750>>>>>>
75750>>>>>            Move (Append (sLoadedDrivers, sCurrentDriver)) to sLoadedDrivers
75751>>>>>        Loop
75752>>>>>>
75752>>>>>        Send AppendTextLn (SFormat (C_$DatabaseDriver, sLoadedDrivers))
75753>>>>>        If (iMSSQLIndex>0) Begin
75755>>>>>            Get_Attribute DF_DRIVER_SQLSERVER_CLIENT_VERSION of iMSSQLIndex to iClientVersion
75758>>>>>            Get Create (RefClass(cMSSQLHandler)) to hoMsqlDrv
75759>>>>>            Get SqlServerClientVersionName of hoMsqlDrv iClientVersion to sClientDriver
75760>>>>>            Send Destroy of hoMsqlDrv
75761>>>>>            Send AppendTextLn (SFormat("MSSQLDRV Client Version: %1", sClientDriver))
75762>>>>>        End
75762>>>>>>
75762>>>>>    End_Procedure
