75761>>>>>    
75761>>>>>    Function IsDataAccessCK String sDriverID Returns Boolean
75763>>>>>        
75763>>>>>        If (sDriverID = "DATAFLEX") Begin
75765>>>>>            Function_Return False
75766>>>>>        End
75766>>>>>>
75766>>>>>        
75766>>>>>        Function_Return (sDriverID = "MSSQLDRV" or sDriverID = "ODBC_DRV" or sDriverID = "DB2_DRV" or sDriverID = "DFBTRDRV")
75767>>>>>    End_Function
