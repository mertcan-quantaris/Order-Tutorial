79260>>>>>    // Print report to appropriate device (printer, preview) based
79260>>>>>    // on output_device_mode
79260>>>>>    //
79260>>>>>    Procedure PrintReport
79262>>>>>        Integer eMode
79262>>>>>        Get OutPut_Device_Mode to eMode
79263>>>>>        If ((eMode=PRINT_TO_WINDOW) or (eMode=DEFERRED_PRINT_TO_WINDOW)) Begin
79265>>>>>            Send DFPreview
79266>>>>>        End
79266>>>>>>
79266>>>>>        Else If (eMode=PRINT_TO_PRINTER_NO_DIALOG) Begin
79269>>>>>            Send DFPrintDoc // print, no print job dialog
79270>>>>>        End
79270>>>>>>
79270>>>>>        Else Begin // (eMode=PRINT_TO_PRINTER)
79271>>>>>            Send DFPrint // print with print job dialog
79272>>>>>        End
79272>>>>>>
79272>>>>>    End_Procedure
