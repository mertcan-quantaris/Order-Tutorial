76007>>>//  This is the default message. It is expected that you will
76007>>>//  create your own message to override this
76007>>>Procedure Activate_About
76010>>>    Send DoAbout "" "" "" "" ""
76011>>>End_Procedure
76012>>>
76012>>>//  It is expected that you will send this message (most
76012>>>//  likely from Activate_About. This creates an about object, activates it
76012>>>//  and destroys it when done. It is not exepected that you will augment this.
76012>>>Procedure DoAbout String sTitle String sVersion String sCopyRight String sAuthor String sBitmap
76015>>>    Integer hoObj hoMain
76015>>>    
76015>>>    // create object
76015>>>    Object About is an AboutDialog
76017>>>        // if no title passed use the label of the main panel
76017>>>        // (if a main panel exists).
76017>>>        If (sTitle = "") Begin
76019>>>            Get Main_Window of desktop to hoMain
76020>>>            If hoMain ;                Get Label of hoMain to sTitle
76023>>>        End
76023>>>>
76023>>>        Set productname to sTitle
76024>>>        Set version     to sVersion
76025>>>        Set copyright   to sCopyRight
76026>>>        Set author      to sAuthor
76027>>>        If (sBitmap <> '') ;            Set logo to sBitMap // square bitmaps of 42x42 work best
76030>>>        Move Self to hoObj // object Id
76031>>>    End_Object
76032>>>    Send Popup   of hoObj    // popup the about object
76033>>>    Send Destroy of hoObj // when done, it will be destroyed
76034>>>End_Procedure
