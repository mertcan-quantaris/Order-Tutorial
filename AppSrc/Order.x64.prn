75940>>>>>    Procedure End_Construct_Object
75942>>>>>        Handle hoVersionInfo
75942>>>>>        Boolean bIncluded
75942>>>>>        Integer iMajor iMinor iRelease iBuild
75942>>>>>        String sLabel
75942>>>>>        
75942>>>>>        Get Label of oVersion to sLabel
75943>>>>>        If (sLabel = C_$VERSION) Begin
75945>>>>>            // set it To the version info Of the program, if available
75945>>>>>            If (ghoApplication <> 0) Begin
75947>>>>>                Get phoVersionInfo of ghoApplication to hoVersionInfo
75948>>>>>                If (hoVersionInfo <> 0) Begin
75950>>>>>                    Get pbIncluded of hoVersionInfo to bIncluded
75951>>>>>                    If (bIncluded) Begin
75953>>>>>                        Get piVersionMajor of hoVersionInfo to iMajor
75954>>>>>                        Get piVersionMinor of hoVersionInfo to iMinor
75955>>>>>                        Get piVersionRelease of hoVersionInfo to iRelease
75956>>>>>                        Get piVersionBuild of hoVersionInfo to iBuild
75957>>>>>                        Move (SFormat (C_$VERSION + ": %1.%2.%3.%4", iMajor, iMinor, iRelease, iBuild)) to sLabel
75958>>>>>                        Set Version to sLabel
75959>>>>>                    End
75959>>>>>>
75959>>>>>                End
75959>>>>>>
75959>>>>>            End
75959>>>>>>
75959>>>>>        End
75959>>>>>>
75959>>>>>        
75959>>>>>        Forward Send End_Construct_Object
75961>>>>>    End_Procedure
