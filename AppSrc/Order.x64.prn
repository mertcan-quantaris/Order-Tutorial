75349>>>>>>>    
75349>>>>>>>    //   Enumerate database in a given server.
75349>>>>>>>    Function EnumerateDatabases String sServer String sUser String sPassWord Returns Integer
75351>>>>>>>        Integer hoSQL
75351>>>>>>>        String  sConnect
75351>>>>>>>        String  sDatabase
75351>>>>>>>        Integer hdbc
75351>>>>>>>        Integer hstmt
75351>>>>>>>        Integer iFetchResult
75351>>>>>>>        
75351>>>>>>>        If (Num_Arguments < 3) ;            Move "" to sPassWord
75354>>>>>>>        If (Num_Arguments < 2) ;            Move "" to sUser
75357>>>>>>>        
75357>>>>>>>        If (sUser <> "") ;            Move ("SERVER=" + Trim(sServer) + ";UID=" + Trim(sUser) + ";PWD=" + Trim(sPassword) + ";") to sConnect
75360>>>>>>>        Else ;            Move ("SERVER=" + Trim(sServer) + ";Trusted_Connection=yes") to sConnect
75362>>>>>>>        
75362>>>>>>>        Object oEnumDBSQLmanager is a cSQLHandleManager
75364>>>>>>>            Move Current_Object to hoSQL
75365>>>>>>>        End_Object
75366>>>>>>>        
75366>>>>>>>        If (hoSQL <> 0) Begin
75368>>>>>>>            Get SQLConnect of hoSQL "MSSQLDRV" sConnect to hdbc
75369>>>>>>>            If (hdbc <> 0) Begin
75371>>>>>>>                Get SQLOpen of hdbc to hstmt
75372>>>>>>>                If (hstmt <> 0) Begin
75374>>>>>>>                    //   We could do a direct select on the sysdatabases table but we use
75374>>>>>>>                    //   the stored procedure sp_database instead. SQL Server recommends this
75374>>>>>>>                    //   approach in case meta data might change, the stored procedure will
75374>>>>>>>                    //   stay the same.
75374>>>>>>>                    Send SQLSetProcedureName to hstmt "sp_databases"
75375>>>>>>>                    Send SQLCall to hstmt
75376>>>>>>>                    Repeat
75376>>>>>>>>
75376>>>>>>>                        Get SQLFetch of hstmt to iFetchResult
75377>>>>>>>                        If (iFetchResult <> 0) Begin
75379>>>>>>>                            Get SQLColumnValue of hstmt 1 to sDatabase
75380>>>>>>>                            Set Value  (Item_Count(Current_Object)) to sDatabase
75381>>>>>>>                        End
75381>>>>>>>>
75381>>>>>>>                    Until (iFetchResult = 0)
75383>>>>>>>                    
75383>>>>>>>                    Send SQLClose to hstmt
75384>>>>>>>                End
75384>>>>>>>>
75384>>>>>>>                Send SQLDisconnect to hdbc
75385>>>>>>>            End
75385>>>>>>>>
75385>>>>>>>        End
75385>>>>>>>>
75385>>>>>>>        Send Destroy_Object to hoSQL
75386>>>>>>>        
75386>>>>>>>        Function_Return (Item_Count(Current_Object))
75387>>>>>>>    End_Function
