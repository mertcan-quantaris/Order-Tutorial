77986>>>>>>>Class cWinPrint2 is a cObject
77987>>>>>>>    Procedure Construct_Object
77989>>>>>>>        Forward Send construct_object
77991>>>>>>>        
77991>>>>>>>        // internal properties
77991>>>>>>>        Property Integer DFCurrent_Color       0
77992>>>>>>>        Property String  DFCurrent_OutPut      "WinPrint"
77993>>>>>>>        Property Integer DFCurrent_Diagram     0
77994>>>>>>>        Property Integer DFCurrent_HeaderType  0
77995>>>>>>>        Property Integer DFCurrent_HeaderNr    0
77996>>>>>>>        Property Number  DFCurrent_FontSize    10
77997>>>>>>>        Property String  DFCurrent_Font        "Arial"
77998>>>>>>>        
77998>>>>>>>        // Default values for margins 2.53 CM = 1 inch
77998>>>>>>>        Property Number  DFLeft_Margin    2.53
77999>>>>>>>        Property Number  DFTop_Margin     2.53
78000>>>>>>>        Property Number  DFright_Margin   2.53
78001>>>>>>>        Property Number  DFBottom_Margin  2.53
78002>>>>>>>        
78002>>>>>>>        // If WP1 this defaults to false. In 2, it is true which means that the print job
78002>>>>>>>        // dialog appears when you hitprint in previewer.
78002>>>>>>>        Property Integer PrintDlgInPreview   1
78003>>>>>>>        // This does nothing in Wp2 (because you can't to this anyway)
78003>>>>>>>        Property Integer EnablePrintSetupFromPreview  True
78004>>>>>>>        Property Integer EnablePrintFromPreview  1
78005>>>>>>>        
78005>>>>>>>        // is the GUI Suspended. This is privately maintained and is used
78005>>>>>>>        // to figure out if a preview panel is up or not
78005>>>>>>>        Property Integer pbIsSuspended False
78006>>>>>>>        
78006>>>>>>>        Object oDFColorArray is an Array
78008>>>>>>>            //Moved into array
78008>>>>>>>            Set Value  0  to RGB_WHITE
78009>>>>>>>            Set Value  1  to RGB_RED
78010>>>>>>>            Set Value  2  to RGB_BLUE
78011>>>>>>>            Set Value  3  to RGB_GREEN
78012>>>>>>>            Set Value  4  to RGB_YELLOW
78013>>>>>>>            Set Value  5  to RGB_GREY
78014>>>>>>>            Set Value  6  to RGB_CYAN
78015>>>>>>>            Set Value  7  to RGB_MAGENTA
78016>>>>>>>            Set Value  8  to RGB_DRED
78017>>>>>>>            Set Value  9  to RGB_DBLUE
78018>>>>>>>            Set Value  10 to RGB_DGREEN
78019>>>>>>>            Set Value  11 to RGB_DYELLOW
78020>>>>>>>            Set Value  12 to RGB_DGREY
78021>>>>>>>            Set Value  13 to RGB_DCYAN
78022>>>>>>>            Set Value  14 to RGB_DMAGENTA
78023>>>>>>>            Set Value  15 to RGB_BLACK
78024>>>>>>>        End_Object
78025>>>>>>>        
78025>>>>>>>        Object oDiagramArray is an Array
78027>>>>>>>        End_Object
78028>>>>>>>        
78028>>>>>>>    End_Procedure
