75174>>>>>>>    
75174>>>>>>>    Procedure Construct_Object Integer iImage
75176>>>>>>>        Forward Send Construct_object iImage
75178>>>>>>>        
75178>>>>>>>        Property String  psDriverID "DFBTRDRV"
75179>>>>>>>    End_Procedure
75180>>>>>>>    
75180>>>>>>>    //  The revsion of a Dfbtrdrv Connectivity Kit
75180>>>>>>>    //
75180>>>>>>>    
75180>>>>>>>    Function CKRevision Returns String
75182>>>>>>>        String  sDriverID
75182>>>>>>>        String  sRevision
75182>>>>>>>        String  sVoid
75182>>>>>>>        Integer iRetval
75182>>>>>>>        
75182>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75182>>>>>>>        // This error would otherwise be raised when we have an older
75182>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75182>>>>>>>        Send Ignore_error to Error_object_Id 20491
75183>>>>>>>        Get psDriverID to sDriverID
75184>>>>>>>        Move (Repeat(" ", 255)) to sRevision
75185>>>>>>>        Call_Driver 0 sDRiverID Function DFBTRFN_CKREVISION Callback 0 Passing sRevision sVoid 0 Result iRetval
75190>>>>>>>        Send Trap_Error to Error_object_Id 20491
75191>>>>>>>        If (Trim(sRevision) = "") Begin
75193>>>>>>>            // Unable to get the revision. return all zeroes.
75193>>>>>>>            Move "0.0.0.0" to sRevision
75194>>>>>>>        End
75194>>>>>>>>
75194>>>>>>>        Function_Return sRevision
75195>>>>>>>    End_Function
75196>>>>>>>    
75196>>>>>>>    Function CkUsesUri Returns Integer
75198>>>>>>>        String  sDriverID
75198>>>>>>>        String  sVoid1
75198>>>>>>>        String  sVoid2
75198>>>>>>>        Integer iRetval
75198>>>>>>>        
75198>>>>>>>        Get psDriverID to sDriverID
75199>>>>>>>        
75199>>>>>>>        Move 0 to iRetval
75200>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75200>>>>>>>        // This error would otherwise be raised when we have an older
75200>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKUSESURI function
75200>>>>>>>        Send Ignore_error to Error_object_Id 20491
75201>>>>>>>        Call_Driver 0 sDRiverID Function DFBTRFN_CKUSESURI Callback 0 Passing sVoid1 sVoid2 0 Result iRetval
75206>>>>>>>        Send Trap_Error to Error_object_Id 20491
75207>>>>>>>        
75207>>>>>>>        Function_Return iRetval
75208>>>>>>>    End_Function
75209>>>>>>>    
75209>>>>>>>    
75209>>>>>>>    
75209>>>>>>>    // Extract the Nth part of a a.b.c.d revsion string.
75209>>>>>>>    //
75209>>>>>>>    // Returns : The part version number or -1 if there is no such part number.
75209>>>>>>>    //
75209>>>>>>>    
75209>>>>>>>    Function ExtractPartFromRevision Integer iPartNum String sRevision Returns Integer
75211>>>>>>>        Integer iPartRev
75211>>>>>>>        Integer iCurrentPart
75211>>>>>>>        Integer iSeparatorPos
75211>>>>>>>        
75211>>>>>>>        If (iPartNum > 4) ;            Function_Return -1
75214>>>>>>>        
75214>>>>>>>        Move 0 to iCurrentPart
75215>>>>>>>        Repeat
75215>>>>>>>>
75215>>>>>>>            Move (Pos(".", sRevision)) to iSeparatorPos
75216>>>>>>>            If (iSeparatorPos > 0) Begin
75218>>>>>>>                Move (Left(sRevision, iSeparatorPos - 1)) to iPartRev
75219>>>>>>>                Move (Right(sRevision, Length(sRevision) - iSeparatorPos)) to sRevision
75220>>>>>>>                Increment iCurrentPart
75221>>>>>>>            End
75221>>>>>>>>
75221>>>>>>>            Else If (sRevision <> "") Begin
75224>>>>>>>                Move sRevision to iPartRev
75225>>>>>>>                Move "" to sRevision
75226>>>>>>>                Increment iCurrentPart
75227>>>>>>>            End
75227>>>>>>>>
75227>>>>>>>            Else ;                Move -1 to iPartRev
75229>>>>>>>        Until (iCurrentPart >= iPartNum or iPartRev = -1)
75231>>>>>>>        
75231>>>>>>>        Function_Return iPartRev
75232>>>>>>>    End_Function
75233>>>>>>>    
75233>>>>>>>    
75233>>>>>>>    
75233>>>>>>>    //
75233>>>>>>>    //  Returns the major revision of the CK
75233>>>>>>>    //
75233>>>>>>>    
75233>>>>>>>    Function CKMajorRevision Returns Integer
75235>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 1, CKRevision(Current_Object)))
75236>>>>>>>    End_Function
75237>>>>>>>    
75237>>>>>>>    
75237>>>>>>>    
75237>>>>>>>    //  Returns the minor revision of the CK
75237>>>>>>>    //
75237>>>>>>>    
75237>>>>>>>    Function CKMinorRevision Returns Integer
75239>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 2, CKRevision(Current_Object)))
75240>>>>>>>    End_Function
75241>>>>>>>    
75241>>>>>>>    
75241>>>>>>>    //  Returns the release revision of the CK
75241>>>>>>>    //
75241>>>>>>>    
75241>>>>>>>    Function CKReleaseRevision Returns Integer
75243>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 3, CKRevision(Current_Object)))
75244>>>>>>>    End_Function
75245>>>>>>>    
75245>>>>>>>    
75245>>>>>>>    //  Returns the major revision of the CK
75245>>>>>>>    //
75245>>>>>>>    
75245>>>>>>>    Function CKBuildRevision Returns Integer
75247>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 4, CKRevision(Current_Object)))
75248>>>>>>>    End_Function
75249>>>>>>>    
75249>>>>>>>    
75249>>>>>>>    //  Determines if the CK conforms to a passed minimal revsion.
75249>>>>>>>    //
75249>>>>>>>    
75249>>>>>>>    Function IsMinimalRevision Integer iMajor Integer iMinor Integer iRelease Integer iBuild Returns Integer
75251>>>>>>>        If (iMajor < CKMajorRevision(Current_object)) ;            Function_Return (True)
75254>>>>>>>        Else If (iMajor = CKMajorRevision(Current_object)) Begin
75257>>>>>>>            If (iMinor < CKMinorRevision(Current_object)) ;                Function_Return (True)
75260>>>>>>>            Else If (iMinor = CKMinorRevision(Current_object)) Begin
75263>>>>>>>                If (iRelease < CKReleaseRevision(Current_object)) ;                    Function_Return (True)
75266>>>>>>>                Else If (iRelease = CKReleaseRevision(Current_object) and iBuild <= CKBuildRevision(Current_object)) ;                    Function_Return (True)
75270>>>>>>>            End
75270>>>>>>>>
75270>>>>>>>        End
75270>>>>>>>>
75270>>>>>>>        
75270>>>>>>>        Function_Return (False)
75271>>>>>>>    End_Function
75272>>>>>>>    
75272>>>>>>>    //   Functions to query the Pervasive.SQL version:
75272>>>>>>>    //       PSQLRequesterVersionInfo    Integer iFileNum Returns String
75272>>>>>>>    //       PSQLLocalEngineVersionInfo  Integer iFileNum Returns String
75272>>>>>>>    //       PSQLServerEngineVersionInfo Integer iFileNum Returns String
75272>>>>>>>    //
75272>>>>>>>    //   All 3 functions return the version of a Pervasive.SQL component
75272>>>>>>>    //   in the following format:
75272>>>>>>>    //       <version>.<revision>.<type>
75272>>>>>>>    //   possible values for <type>:
75272>>>>>>>    //       9 for 32-bit Windows workstation/workgroup engine or Linux
75272>>>>>>>    //         server using Workgroup authentication mode
75272>>>>>>>    //       C for client cache engine
75272>>>>>>>    //       D for DOS workstation
75272>>>>>>>    //       N for client Requester
75272>>>>>>>    //       S for NetWare server
75272>>>>>>>    //       T for 32-bit Windows server engine
75272>>>>>>>    //       U for Linux server using PAM or BTPASSWD authentication
75272>>>>>>>    //
75272>>>>>>>    //   example:
75272>>>>>>>    //       8.50.T
75272>>>>>>>    //   will be returned for a Pervasive.SQL 8.5 Server Engine running on
75272>>>>>>>    //   32-bits Windows server.
75272>>>>>>>    //
75272>>>>>>>    //   The FileNumber parameter must specify an opened table or 0.
75272>>>>>>>    //   For PSQLServerEngineVersionInfo the FileNumber can not be 0.
75272>>>>>>>    //
75272>>>>>>>    //   If the version information is not available or can not be obtained
75272>>>>>>>    //   the functions will return "0.0.0"
75272>>>>>>>    
75272>>>>>>>    //  Returns the version information of the
75272>>>>>>>    //           Pervasive.SQL Client requester.
75272>>>>>>>    
75272>>>>>>>    Function PSQLRequesterVersionInfo Integer iFileNum Returns String
75274>>>>>>>        
75274>>>>>>>        String  sDriverID
75274>>>>>>>        String  sVersion
75274>>>>>>>        String  sVoid
75274>>>>>>>        Integer iRetval
75274>>>>>>>        
75274>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75274>>>>>>>        // This error would otherwise be raised when we have an older
75274>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75274>>>>>>>        Send Ignore_error to Error_object_Id 20491
75275>>>>>>>        Get psDriverID to sDriverID
75276>>>>>>>        Move (Repeat(" ", 255)) to sVersion
75277>>>>>>>        Call_Driver iFileNum sDRiverID Function DFBTRFN_PSQLREQUESTERVERSIONINFO Callback 0 Passing sVersion sVoid 0 Result iRetval
75282>>>>>>>        Send Trap_Error to Error_object_Id 20491
75283>>>>>>>        If (Trim(sVersion) = "") Begin
75285>>>>>>>            // Unable to get the revision. return all zeroes.
75285>>>>>>>            Move "0.0.0" to sVersion
75286>>>>>>>        End
75286>>>>>>>>
75286>>>>>>>        Function_Return sVersion
75287>>>>>>>    End_Function
75288>>>>>>>    
75288>>>>>>>    //           Pervasive.SQL Engine
75288>>>>>>>    
