75984>>>>>    Procedure End_Construct_Object
75986>>>>>        Handle hoVersionInfo
75986>>>>>        Boolean bIncluded
75986>>>>>        Integer iMajor iMinor iRelease iBuild
75986>>>>>        String sLabel
75986>>>>>        
75986>>>>>        Get Label of oVersion to sLabel
75987>>>>>        If (sLabel = C_$VERSION) Begin
75989>>>>>            // set it To the version info Of the program, if available
75989>>>>>            If (ghoApplication <> 0) Begin
75991>>>>>                Get phoVersionInfo of ghoApplication to hoVersionInfo
75992>>>>>                If (hoVersionInfo <> 0) Begin
75994>>>>>                    Get pbIncluded of hoVersionInfo to bIncluded
75995>>>>>                    If (bIncluded) Begin
75997>>>>>                        Get piVersionMajor of hoVersionInfo to iMajor
75998>>>>>                        Get piVersionMinor of hoVersionInfo to iMinor
75999>>>>>                        Get piVersionRelease of hoVersionInfo to iRelease
76000>>>>>                        Get piVersionBuild of hoVersionInfo to iBuild
76001>>>>>                        Move (SFormat (C_$VERSION + ": %1.%2.%3.%4", iMajor, iMinor, iRelease, iBuild)) to sLabel
76002>>>>>                        Set Version to sLabel
76003>>>>>                    End
76003>>>>>>
76003>>>>>                End
76003>>>>>>
76003>>>>>            End
76003>>>>>>
76003>>>>>        End
76003>>>>>>
76003>>>>>        
76003>>>>>        Forward Send End_Construct_Object
76005>>>>>    End_Procedure
