75319>>>>>>>    Function EnumerateServersNetworkOrLocal Integer iNetworkLocal  Returns Integer
75321>>>>>>>        
75321>>>>>>>        String  sServerList
75321>>>>>>>        Integer iNumServers
75321>>>>>>>        Integer iDriver
75321>>>>>>>        Integer iClientVersion
75321>>>>>>>        String  sDriver
75321>>>>>>>        
75321>>>>>>>        Get DriverIndex MSSQLDRV_ID to iDriver
75322>>>>>>>        
75322>>>>>>>        If (iDriver) Begin
75324>>>>>>>            
75324>>>>>>>            Get_Attribute DF_DRIVER_SQLSERVER_CLIENT_VERSION of iDriver to iClientVersion
75327>>>>>>>            
75327>>>>>>>            Get SqlServerClientDriverName iClientVersion to sDriver
75328>>>>>>>            
75328>>>>>>>            Move ("DRIVER={" + sDriver + "};") to sDriver
75329>>>>>>>            If (iNetworkLocal = 0) Begin
75331>>>>>>>                Get BrowseConnect sDriver to sServerList
75332>>>>>>>            End
75332>>>>>>>>
75332>>>>>>>            Else Begin
75333>>>>>>>                Get BrowseConnectLocal sDriver to sServerList
75334>>>>>>>            End
75334>>>>>>>>
75334>>>>>>>            Get ExtractList sServerList Current_object to iNumServers
75335>>>>>>>        End
75335>>>>>>>>
75335>>>>>>>        
75335>>>>>>>        Function_Return iNumServers
75336>>>>>>>        
75336>>>>>>>    End_Function
75337>>>>>>>    
75337>>>>>>>    //   Enumerate the available SQL Server database servers
75337>>>>>>>    //   This function will return all SQL Server instances on the network.
75337>>>>>>>    //   This may take a long time.
