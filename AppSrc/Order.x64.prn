77997>>>>>>>Class cWinPrint2 is a cObject
77998>>>>>>>    Procedure Construct_Object
78000>>>>>>>        Forward Send construct_object
78002>>>>>>>        
78002>>>>>>>        // internal properties
78002>>>>>>>        Property Integer DFCurrent_Color       0
78003>>>>>>>        Property String  DFCurrent_OutPut      "WinPrint"
78004>>>>>>>        Property Integer DFCurrent_Diagram     0
78005>>>>>>>        Property Integer DFCurrent_HeaderType  0
78006>>>>>>>        Property Integer DFCurrent_HeaderNr    0
78007>>>>>>>        Property Number  DFCurrent_FontSize    10
78008>>>>>>>        Property String  DFCurrent_Font        "Arial"
78009>>>>>>>        
78009>>>>>>>        // Default values for margins 2.53 CM = 1 inch
78009>>>>>>>        Property Number  DFLeft_Margin    2.53
78010>>>>>>>        Property Number  DFTop_Margin     2.53
78011>>>>>>>        Property Number  DFright_Margin   2.53
78012>>>>>>>        Property Number  DFBottom_Margin  2.53
78013>>>>>>>        
78013>>>>>>>        // If WP1 this defaults to false. In 2, it is true which means that the print job
78013>>>>>>>        // dialog appears when you hitprint in previewer.
78013>>>>>>>        Property Integer PrintDlgInPreview   1
78014>>>>>>>        // This does nothing in Wp2 (because you can't to this anyway)
78014>>>>>>>        Property Integer EnablePrintSetupFromPreview  True
78015>>>>>>>        Property Integer EnablePrintFromPreview  1
78016>>>>>>>        
78016>>>>>>>        // is the GUI Suspended. This is privately maintained and is used
78016>>>>>>>        // to figure out if a preview panel is up or not
78016>>>>>>>        Property Integer pbIsSuspended False
78017>>>>>>>        
78017>>>>>>>        Object oDFColorArray is an Array
78019>>>>>>>            //Moved into array
78019>>>>>>>            Set Value  0  to RGB_WHITE
78020>>>>>>>            Set Value  1  to RGB_RED
78021>>>>>>>            Set Value  2  to RGB_BLUE
78022>>>>>>>            Set Value  3  to RGB_GREEN
78023>>>>>>>            Set Value  4  to RGB_YELLOW
78024>>>>>>>            Set Value  5  to RGB_GREY
78025>>>>>>>            Set Value  6  to RGB_CYAN
78026>>>>>>>            Set Value  7  to RGB_MAGENTA
78027>>>>>>>            Set Value  8  to RGB_DRED
78028>>>>>>>            Set Value  9  to RGB_DBLUE
78029>>>>>>>            Set Value  10 to RGB_DGREEN
78030>>>>>>>            Set Value  11 to RGB_DYELLOW
78031>>>>>>>            Set Value  12 to RGB_DGREY
78032>>>>>>>            Set Value  13 to RGB_DCYAN
78033>>>>>>>            Set Value  14 to RGB_DMAGENTA
78034>>>>>>>            Set Value  15 to RGB_BLACK
78035>>>>>>>        End_Object
78036>>>>>>>        
78036>>>>>>>        Object oDiagramArray is an Array
78038>>>>>>>        End_Object
78039>>>>>>>        
78039>>>>>>>    End_Procedure
