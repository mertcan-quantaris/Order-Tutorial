75695>>>>>    Function IsDataAccessCK String sDriverID Returns Boolean
75697>>>>>        
75697>>>>>        If (sDriverID = "DATAFLEX") Begin
75699>>>>>            Function_Return False
75700>>>>>        End
75700>>>>>>
75700>>>>>        
75700>>>>>        Function_Return (sDriverID = "MSSQLDRV" or sDriverID = "ODBC_DRV" or sDriverID = "DB2_DRV" or sDriverID = "DFBTRDRV")
75701>>>>>    End_Function
