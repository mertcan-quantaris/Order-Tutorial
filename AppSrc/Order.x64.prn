77606>>>>>Class cOrderDetailDataDictionary is a DataDictionary
77607>>>>>    
77607>>>>>    Procedure Construct_Object
77609>>>>>        Forward Send Construct_Object
77611>>>>>        
77611>>>>>        Set Main_File to OrderDetail.File_Number
77612>>>>>        Set Cascade_Delete_State to False
77613>>>>>        
77613>>>>>        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
77614>>>>>        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
77615>>>>>        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True
77616>>>>>        
77616>>>>>        Set Add_Server_File to OrderHeader.File_Number
77617>>>>>        Set Add_Server_File to Inventory.File_Number
77618>>>>>        
77618>>>>>        Set Field_Auto_Increment Field OrderDetail.Detail_Number to File_Field OrderHeader.Last_Detail_Num
77619>>>>>        
77619>>>>>        Set Field_Option Field OrderDetail.Order_Number DD_NOPUT to True
77620>>>>>        
77620>>>>>        Set Field_Option Field OrderDetail.Detail_Number DD_NOPUT to True
77621>>>>>        
77621>>>>>        Set Field_Exit_msg Field OrderDetail.Qty_Ordered to Adjust_Display_Total
77622>>>>>        Set Field_Label_Long Field OrderDetail.Qty_Ordered to "Quantity Ordered"
77623>>>>>        Set Field_Label_Short Field OrderDetail.Qty_Ordered to "Quantity"
77624>>>>>        Set Field_Mask_Type Field OrderDetail.Qty_Ordered to Mask_Numeric_Window
77625>>>>>        Set Status_Help Field OrderDetail.Qty_Ordered to "Number of items ordered"
77626>>>>>        Set Field_Value_Range Field OrderDetail.Qty_Ordered to 1 100
77627>>>>>        Set Field_Error Field OrderDetail.Qty_Ordered to 0 "Quantity per order line limited to 100"
77628>>>>>
77628>>>>>        
77628>>>>>        Set Field_Entry_msg Field OrderDetail.Price to Entering_Price
77629>>>>>        Set Field_Exit_msg Field OrderDetail.Price to Adjust_Display_Total
77630>>>>>        Set Field_Label_Long Field OrderDetail.Price to "Price per Unit"
77631>>>>>        Set Field_Label_Short Field OrderDetail.Price to "Price"
77632>>>>>        Set Field_Mask_Type Field OrderDetail.Price to MASK_CURRENCY_WINDOW
77633>>>>>        Set Status_Help Field OrderDetail.Price to "Price per Unit"
77634>>>>>        Set Field_Value_Range Field OrderDetail.Price to 0.01 2500
77635>>>>>        Set Field_Error Field OrderDetail.Price to 0 (String("Unit price may not exceed" * FormatCurrency(2500, 2)))
77636>>>>>        
77636>>>>>        Set Field_Label_Long Field OrderDetail.Extended_Price to "Extended Price"
77637>>>>>        Set Field_Label_Short Field OrderDetail.Extended_Price to "Total"
77638>>>>>        Set Field_Mask_Type Field OrderDetail.Extended_Price to MASK_CURRENCY_WINDOW
77639>>>>>        Set Field_Option Field OrderDetail.Extended_Price DD_DISPLAYONLY to True
77640>>>>>        Set Status_Help Field OrderDetail.Extended_Price to "Total extended price"
77641>>>>>        
77641>>>>>        Set piPrimaryIndex to 1
77642>>>>>    End_Procedure
77643>>>>>    
77643>>>>>    // Update and Backout need to adjust the Inventory.On_Hand quantity,
77643>>>>>    // the OrderDetail line's extended price and the OrderHeader total.
77643>>>>>    // We will call the same procedure (Adjust_Balances) to insure that
77643>>>>>    // Backout and Update are inverses of each other.
77643>>>>>    // Note that Backout does not need to change the Extended_Price.
77643>>>>>    // This only gets changed as part of Update.
77643>>>>>    Procedure Update
77645>>>>>        Forward Send Update
77647>>>>>        Move (OrderDetail.Price * OrderDetail.Qty_Ordered) to OrderDetail.Extended_Price
77648>>>>>        Send Adjust_Balances OrderDetail.Qty_Ordered OrderDetail.Extended_Price
77649>>>>>    End_Procedure
77650>>>>>    
77650>>>>>    Procedure Backout
77652>>>>>        Forward Send Backout
77654>>>>>        Send Adjust_Balances (-OrderDetail.Qty_Ordered) (-OrderDetail.Extended_Price)
77655>>>>>    End_Procedure
77656>>>>>    
77656>>>>>    // Called by Backout and Update, passing the quantity and the extended price.
77656>>>>>    // Subtract quantity from on-hand Inventory and add extended Amt to order total.
77656>>>>>    Procedure Adjust_Balances Number Qty Number Amt
77658>>>>>        Subtract Qty from Inventory.On_Hand
77659>>>>>        Add      Amt to   OrderHeader.Order_Total
77660>>>>>    End_Procedure
77661>>>>>    
77661>>>>>    // when entering the price field we may wish to update the
77661>>>>>    // current field value with the standard unit price from the Inventory table.
77661>>>>>    // Only do this if the current amount is zero and an item was actually picked.
77661>>>>>    // If non-zero or no item picked, we assume the field is being edited (and we make no assumptions).
77661>>>>>    Procedure Entering_Price Integer Field# Number nAmnt
77663>>>>>        Handle hoInventoryDD
77663>>>>>        Boolean bHasRecord
77663>>>>>        
77663>>>>>        Get Data_Set Inventory.File_Number to hoInventoryDD
77664>>>>>        
77664>>>>>        If (hoInventoryDD) Begin
77666>>>>>            Get HasRecord of hoInventoryDD to bHasRecord
77667>>>>>            
77667>>>>>            If (nAmnt=0 and bHasRecord) Begin
77669>>>>>                Get File_Field_Current_Value File_Field Inventory.Unit_Price to nAmnt
77670>>>>>                Set Field_Changed_Value Field# to nAmnt
77671>>>>>                Send Adjust_Display_Total
77672>>>>>            End
77672>>>>>>
77672>>>>>        End
77672>>>>>>
77672>>>>>        
77672>>>>>    End_Procedure
77673>>>>>    
77673>>>>>    // This updates the extended price field, which will update any display balances.
77673>>>>>    // This is only done for display purposes.
77673>>>>>    // The actual amount is updated to the field during the save.
77673>>>>>    Procedure Adjust_Display_total Integer iField String sValue
77675>>>>>        Integer iQty
77675>>>>>        Number  nAmnt
77675>>>>>        
77675>>>>>        Get Field_Current_Value Field OrderDetail.Qty_Ordered    to iQty
77676>>>>>        Get Field_Current_Value Field OrderDetail.Price          to nAmnt
77677>>>>>        Set Field_Current_Value Field OrderDetail.Extended_Price to (nAmnt * iQty)
77678>>>>>        // note we set value, but not changed_state!
77678>>>>>    End_Procedure
77679>>>>>    
77679>>>>>    Procedure Field_Defaults
77681>>>>>        Forward Send Field_Defaults
77683>>>>>        Set Field_Changed_Value Field OrderDetail.Qty_Ordered to 1
77684>>>>>    End_Procedure
77685>>>>>    
77685>>>>>End_Class
