75388>>>>>>>    Function SqlServerClientVersionName Integer iClientVersion  Returns String
75390>>>>>>>        
75390>>>>>>>        String  sSqlServerClientVersionName
75390>>>>>>>        
75390>>>>>>>        
75390>>>>>>>        Case Begin
75390>>>>>>>
75390>>>>>>>            Case (iClientVersion = SQLSERVER2019CLIENT)
75392>>>>>>>                Move SQLSERVER2019CLIENTNAME to sSqlServerClientVersionName
75393>>>>>>>                Case Break
75394>>>>>>>            
75394>>>>>>>            Case (iClientVersion = SQLSERVER2017CLIENT)
75397>>>>>>>                Move SQLSERVER2017CLIENTNAME to sSqlServerClientVersionName
75398>>>>>>>                Case Break
75399>>>>>>>                
75399>>>>>>>            Case (iClientVersion = SQLSERVER2016CLIENT)
75402>>>>>>>                Move SQLSERVER2016CLIENTNAME to sSqlServerClientVersionName
75403>>>>>>>                Case Break
75404>>>>>>>            
75404>>>>>>>            Case (iClientVersion = SQLSERVER2014CLIENT)
75407>>>>>>>                Move SQLSERVER2014CLIENTNAME to sSqlServerClientVersionName
75408>>>>>>>                Case Break
75409>>>>>>>            
75409>>>>>>>            Case (iClientVersion = SQLSERVER2012CLIENT)
75412>>>>>>>                Move SQLSERVER2012CLIENTNAME to sSqlServerClientVersionName
75413>>>>>>>                Case Break
75414>>>>>>>            
75414>>>>>>>            Case (iClientVersion = SQLSERVER2008CLIENT)
75417>>>>>>>                Move SQLSERVER2008CLIENTNAME to sSqlServerClientVersionName
75418>>>>>>>                Case Break
75419>>>>>>>            
75419>>>>>>>            Case (iClientVersion = SQLSERVER2005CLIENT)
75422>>>>>>>                Move SQLSERVER2005CLIENTNAME to sSqlServerClientVersionName
75423>>>>>>>                Case Break
75424>>>>>>>            
75424>>>>>>>            Case (iClientVersion = SQLSERVER2000CLIENT)
75427>>>>>>>                Move SQLSERVER2000CLIENTNAME to sSqlServerClientVersionName
75428>>>>>>>                Case Break
75429>>>>>>>            
75429>>>>>>>            Case Else
75429>>>>>>>                Move (SFormat("%1 (version %2) ",SQLSERVERUNKNOWNCLIENTNAME,iClientVersion)) to sSqlServerClientVersionName
75430>>>>>>>                
75430>>>>>>>        Case End
75430>>>>>>>        
75430>>>>>>>        
75430>>>>>>>        Function_Return sSqlServerClientVersionName
75431>>>>>>>        
75431>>>>>>>    End_Function
