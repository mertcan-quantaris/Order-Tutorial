79557>>>            DFBeginHeader DFPageBottom
79558>>>                DFHeaderFrame Hdr_Margins 0.01 iBorder
79559>>>                DFHeaderPos Hdr_Left
79560>>>                DFWriteln (C_$ReportPrintedOn * string(dtDT)) (iStyle+Font_Center)
79561>>>            DFEndHeader
79563>>>
79563>>>        End_Procedure 
79564>>>
79564>>>        // Returns string with description of selection ranges
79564>>>        // Pass: Selection title, start value and end value. Return: description
79564>>>        Function SelectionCriteraDescription string sTitle string sStart string sStop returns String
79567>>>            string sText
79567>>>            If (sStart=""  AND sStop="") ;                function_return ""
79570>>>            If (sStart="0" AND sStop="0") ;                function_return ""
79573>>>            If (sStart<>"" AND sStop<>"") begin
79575>>>                Move (C_$ReportCriteriaBetween * sStart * C_$ReportCriteriaAnd * sStop) to sText
79576>>>            end
79576>>>>
79576>>>            Else if (sStart > "") begin
79579>>>                Move (C_$ReportCriteriaStartingAt * sStart) to sText
79580>>>            end
79580>>>>
79580>>>            Else if (sStop > "") begin
79583>>>                Move (C_$ReportCriteriaUpTo * sStop) to sText
79584>>>            End
79584>>>>
79584>>>            function_return (sTitle * sText)
79585>>>        End_Function
79586>>>
79586>>>    End_Object 
