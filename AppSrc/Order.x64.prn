75744>>>>>    Function CKRevisionNumber String sDriverID Returns String
75746>>>>>        Handle hoCLIHandler
75746>>>>>        Handle hoDFBtrDrvHandler
75746>>>>>        String sCKRevision
75746>>>>>        
75746>>>>>        
75746>>>>>        If (sDriverID = "MSSQLDRV" or sDriverID = "ODBC_DRV" or sDriverID = "DB2_DRV") Begin
75748>>>>>            Get Create (RefClass(cCLIHandler)) to hoCLIHandler
75749>>>>>            Set psDriverID of hoCLIHandler to sDriverID
75750>>>>>            Move (CKRevision(hoCLIHandler)) to sCKRevision
75751>>>>>            Send Destroy of hoCLIHandler
75752>>>>>        End
75752>>>>>>
75752>>>>>        Else Begin
75753>>>>>            If (sDriverID = "DFBTRDRV") Begin
75755>>>>>                Get Create (RefClass(cDFBtrDrvHandler)) to hoDFBtrDrvHandler
75756>>>>>                Set psDriverID of hoDFBtrDrvHandler to sDriverID
75757>>>>>                Move (CKRevision(hoDFBtrDrvHandler)) to sCKRevision
75758>>>>>                Send Destroy of hoDFBtrDrvHandler
75759>>>>>            End
75759>>>>>>
75759>>>>>        End
75759>>>>>>
75759>>>>>        
75759>>>>>        Function_Return sCKRevision
75760>>>>>    End_Function
