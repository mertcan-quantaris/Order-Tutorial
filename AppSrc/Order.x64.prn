76136>>>>>    //  Validates if the field contains a valid email address (it allows empty values too).
76136>>>>>    Function ValidateEmail Integer iColumn String sValue Returns Boolean
76138>>>>>        Integer iAt iDot
76138>>>>>        Boolean bResult
76138>>>>>        
76138>>>>>        If (Trim(sValue) <> "") Begin
76140>>>>>            Move (Pos("@", sValue)) to iAt
76141>>>>>            Move (RightPos(".", sValue)) to iDot
76142>>>>>            
76142>>>>>            If (not(iAt > 1 and iDot > 0 and iDot > iAt + 1 and iDot < Length(sValue))) Begin
76144>>>>>                Send Data_set_error iColumn DFERR_OPERATOR "Please enter a valid email address"
76145>>>>>                Move True to bResult
76146>>>>>            End
76146>>>>>>
76146>>>>>        End
76146>>>>>>
76146>>>>>        
76146>>>>>        Function_Return bResult
76147>>>>>    End_Function
76148>>>>>    
