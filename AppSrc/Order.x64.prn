75700>>>>>    Function CKRevisionNumber String sDriverID Returns String
75702>>>>>        Handle hoCLIHandler
75702>>>>>        Handle hoDFBtrDrvHandler
75702>>>>>        String sCKRevision
75702>>>>>        
75702>>>>>        
75702>>>>>        If (sDriverID = "MSSQLDRV" or sDriverID = "ODBC_DRV" or sDriverID = "DB2_DRV") Begin
75704>>>>>            Get Create (RefClass(cCLIHandler)) to hoCLIHandler
75705>>>>>            Set psDriverID of hoCLIHandler to sDriverID
75706>>>>>            Move (CKRevision(hoCLIHandler)) to sCKRevision
75707>>>>>            Send Destroy of hoCLIHandler
75708>>>>>        End
75708>>>>>>
75708>>>>>        Else Begin
75709>>>>>            If (sDriverID = "DFBTRDRV") Begin
75711>>>>>                Get Create (RefClass(cDFBtrDrvHandler)) to hoDFBtrDrvHandler
75712>>>>>                Set psDriverID of hoDFBtrDrvHandler to sDriverID
75713>>>>>                Move (CKRevision(hoDFBtrDrvHandler)) to sCKRevision
75714>>>>>                Send Destroy of hoDFBtrDrvHandler
75715>>>>>            End
75715>>>>>>
75715>>>>>        End
75715>>>>>>
75715>>>>>        
75715>>>>>        Function_Return sCKRevision
75716>>>>>    End_Function
75717>>>>>    
75717>>>>>    
75717>>>>>    Function IsDataAccessCK String sDriverID Returns Boolean
75719>>>>>        
75719>>>>>        If (sDriverID = "DATAFLEX") Begin
75721>>>>>            Function_Return False
75722>>>>>        End
75722>>>>>>
75722>>>>>        
75722>>>>>        Function_Return (sDriverID = "MSSQLDRV" or sDriverID = "ODBC_DRV" or sDriverID = "DB2_DRV" or sDriverID = "DFBTRDRV")
75723>>>>>    End_Function
