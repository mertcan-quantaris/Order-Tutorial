75371>>>>>>>    
75371>>>>>>>    
75371>>>>>>>    
75371>>>>>>>    //   Enumerate database in a given server.
75371>>>>>>>    Function EnumerateDatabases String sServer String sUser String sPassWord Returns Integer
75373>>>>>>>        Integer hoSQL
75373>>>>>>>        String  sConnect
75373>>>>>>>        String  sDatabase
75373>>>>>>>        Integer hdbc
75373>>>>>>>        Integer hstmt
75373>>>>>>>        Integer iFetchResult
75373>>>>>>>        
75373>>>>>>>        If (Num_Arguments < 3) ;            Move "" to sPassWord
75376>>>>>>>        If (Num_Arguments < 2) ;            Move "" to sUser
75379>>>>>>>        
75379>>>>>>>        If (sUser <> "") ;            Move ("SERVER=" + Trim(sServer) + ";UID=" + Trim(sUser) + ";PWD=" + Trim(sPassword) + ";") to sConnect
75382>>>>>>>        Else ;            Move ("SERVER=" + Trim(sServer) + ";Trusted_Connection=yes") to sConnect
75384>>>>>>>        
75384>>>>>>>        Object oEnumDBSQLmanager is a cSQLHandleManager
75386>>>>>>>            Move Current_Object to hoSQL
75387>>>>>>>        End_Object
75388>>>>>>>        
75388>>>>>>>        If (hoSQL <> 0) Begin
75390>>>>>>>            Get SQLConnect of hoSQL "MSSQLDRV" sConnect to hdbc
75391>>>>>>>            If (hdbc <> 0) Begin
75393>>>>>>>                Get SQLOpen of hdbc to hstmt
75394>>>>>>>                If (hstmt <> 0) Begin
75396>>>>>>>                    //   We could do a direct select on the sysdatabases table but we use
75396>>>>>>>                    //   the stored procedure sp_database instead. SQL Server recommends this
75396>>>>>>>                    //   approach in case meta data might change, the stored procedure will
75396>>>>>>>                    //   stay the same.
75396>>>>>>>                    Send SQLSetProcedureName to hstmt "sp_databases"
75397>>>>>>>                    Send SQLCall to hstmt
75398>>>>>>>                    Repeat
75398>>>>>>>>
75398>>>>>>>                        Get SQLFetch of hstmt to iFetchResult
75399>>>>>>>                        If (iFetchResult <> 0) Begin
75401>>>>>>>                            Get SQLColumnValue of hstmt 1 to sDatabase
75402>>>>>>>                            Set Value  (Item_Count(Current_Object)) to sDatabase
75403>>>>>>>                        End
75403>>>>>>>>
75403>>>>>>>                    Until (iFetchResult = 0)
75405>>>>>>>                    
75405>>>>>>>                    Send SQLClose to hstmt
75406>>>>>>>                End
75406>>>>>>>>
75406>>>>>>>                Send SQLDisconnect to hdbc
75407>>>>>>>            End
75407>>>>>>>>
75407>>>>>>>        End
75407>>>>>>>>
75407>>>>>>>        Send Destroy_Object to hoSQL
75408>>>>>>>        
75408>>>>>>>        Function_Return (Item_Count(Current_Object))
75409>>>>>>>    End_Function
75410>>>>>>>    
75410>>>>>>>    
75410>>>>>>>    Function SqlServerClientVersionName Integer iClientVersion  Returns String
75412>>>>>>>        
75412>>>>>>>        String  sSqlServerClientVersionName
75412>>>>>>>        
75412>>>>>>>        
75412>>>>>>>        Case Begin
75412>>>>>>>
75412>>>>>>>            Case (iClientVersion = SQLSERVER2019CLIENT)
75414>>>>>>>                Move SQLSERVER2019CLIENTNAME to sSqlServerClientVersionName
75415>>>>>>>                Case Break
75416>>>>>>>            
75416>>>>>>>            Case (iClientVersion = SQLSERVER2017CLIENT)
75419>>>>>>>                Move SQLSERVER2017CLIENTNAME to sSqlServerClientVersionName
75420>>>>>>>                Case Break
75421>>>>>>>                
75421>>>>>>>            Case (iClientVersion = SQLSERVER2016CLIENT)
75424>>>>>>>                Move SQLSERVER2016CLIENTNAME to sSqlServerClientVersionName
75425>>>>>>>                Case Break
75426>>>>>>>            
75426>>>>>>>            Case (iClientVersion = SQLSERVER2014CLIENT)
75429>>>>>>>                Move SQLSERVER2014CLIENTNAME to sSqlServerClientVersionName
75430>>>>>>>                Case Break
75431>>>>>>>            
75431>>>>>>>            Case (iClientVersion = SQLSERVER2012CLIENT)
75434>>>>>>>                Move SQLSERVER2012CLIENTNAME to sSqlServerClientVersionName
75435>>>>>>>                Case Break
75436>>>>>>>            
75436>>>>>>>            Case (iClientVersion = SQLSERVER2008CLIENT)
75439>>>>>>>                Move SQLSERVER2008CLIENTNAME to sSqlServerClientVersionName
75440>>>>>>>                Case Break
75441>>>>>>>            
75441>>>>>>>            Case (iClientVersion = SQLSERVER2005CLIENT)
75444>>>>>>>                Move SQLSERVER2005CLIENTNAME to sSqlServerClientVersionName
75445>>>>>>>                Case Break
75446>>>>>>>            
75446>>>>>>>            Case (iClientVersion = SQLSERVER2000CLIENT)
75449>>>>>>>                Move SQLSERVER2000CLIENTNAME to sSqlServerClientVersionName
75450>>>>>>>                Case Break
75451>>>>>>>            
75451>>>>>>>            Case Else
75451>>>>>>>                Move (SFormat("%1 (version %2) ",SQLSERVERUNKNOWNCLIENTNAME,iClientVersion)) to sSqlServerClientVersionName
75452>>>>>>>                
75452>>>>>>>        Case End
75452>>>>>>>        
75452>>>>>>>        
75452>>>>>>>        Function_Return sSqlServerClientVersionName
75453>>>>>>>        
75453>>>>>>>    End_Function
75454>>>>>>>
75454>>>>>>>
75454>>>>>>>    Function SqlServerClientDriverName Integer iClientVersion  Returns String
75456>>>>>>>        
75456>>>>>>>        String  sSqlServerClientDriverName
75456>>>>>>>        
75456>>>>>>>        Case Begin
75456>>>>>>>
75456>>>>>>>            Case (iClientVersion = SQLSERVER2019CLIENT)
75458>>>>>>>                Move SQLSERVER2019DRVRSTR to sSqlServerClientDriverName
75459>>>>>>>                Case Break
75460>>>>>>>
75460>>>>>>>            Case (iClientVersion = SQLSERVER2017CLIENT)
75463>>>>>>>                Move SQLSERVER2017DRVRSTR to sSqlServerClientDriverName
75464>>>>>>>                Case Break
75465>>>>>>>                
75465>>>>>>>            Case (iClientVersion = SQLSERVER2016CLIENT)
75468>>>>>>>                Move SQLSERVER2016DRVRSTR to sSqlServerClientDriverName
75469>>>>>>>                Case Break
75470>>>>>>>            
75470>>>>>>>            Case (iClientVersion = SQLSERVER2014CLIENT)
75473>>>>>>>                Move SQLSERVER2014DRVRSTR to sSqlServerClientDriverName
75474>>>>>>>                Case Break
