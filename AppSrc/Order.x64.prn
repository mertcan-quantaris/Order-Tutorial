75262>>>>>>>    //   Extract the list from the out connect string.
75262>>>>>>>    Function ExtractList String sOutConnStr Integer hoStore Returns Integer
75264>>>>>>>        String  sItem
75264>>>>>>>        Integer iStart
75264>>>>>>>        Integer iEnd
75264>>>>>>>        
75264>>>>>>>        If (hoStore = 0) ;            Move Current_object to hoStore
75267>>>>>>>        
75267>>>>>>>        Send Delete_Data to hoStore
75268>>>>>>>        Move (Pos("{", sOutConnStr)) to iStart
75269>>>>>>>        While (iStart > 0)
75273>>>>>>>            Move (Right(sOutConnStr, Length(sOutConnStr) - iStart)) to sOutConnStr
75274>>>>>>>            If (Left(sOutConnStr, 1) = "}") ;                Move 0 to iStart
75277>>>>>>>            Else Begin
75278>>>>>>>                Move (Pos(",", sOutConnStr)) to iStart
75279>>>>>>>                Move (Pos("}", sOutConnStr)) to iEnd
75280>>>>>>>                If ((iStart = 0) or (iEnd < iStart)) ;                    Move iEnd to iStart
75283>>>>>>>                
75283>>>>>>>                If (iStart > 0) ;                    Set Value of hoStore  (Item_Count(Current_Object)) to (Left(sOutConnStr, iStart - 1))
75286>>>>>>>                
75286>>>>>>>                If (iStart = iEnd) ;                    Move 0 to iStart
75289>>>>>>>            End
75289>>>>>>>>
75289>>>>>>>        Loop
75290>>>>>>>>
75290>>>>>>>        
75290>>>>>>>        Function_Return (Item_Count(hoStore))
75291>>>>>>>    End_Procedure
