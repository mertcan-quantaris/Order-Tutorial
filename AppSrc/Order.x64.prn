74566>>>>>    
74566>>>>>    // This can be augmented to return a password encryption key using any
74566>>>>>    // hidden mechanism desired.
74566>>>>>    Function GetEncryptionPassword Returns String
74568>>>>>        String sPassword
74568>>>>>        Get psEncryptPassword to sPassword
74569>>>>>        Function_Return sPassword
74570>>>>>    End_Function
74571>>>>>    
74571>>>>>    // Encrypts a string into an unreadable hash that can later be decrypted using DecryptKey.
74571>>>>>    //
74571>>>>>    // Params:
74571>>>>>    //   sPlainText     String to encrypt.
74571>>>>>    // Returns:
74571>>>>>    //   Base64 encoded hash.
74571>>>>>    Function EncryptPassword String sPlainText Returns String
74573>>>>>        String sEncryptPassword sBase64
74573>>>>>        UChar[] ucBinary
74574>>>>>        Pointer pBase64
74574>>>>>        Integer iVoid
74574>>>>>        
74574>>>>>        //  Encrypt Key
74574>>>>>        Get GetEncryptionPassword to sEncryptPassword
74575>>>>>        If (sEncryptPassword = "") Begin
74577>>>>>            Error DFERR_PROGRAM "No encryption password set"
74578>>>>>>
74578>>>>>        End
74578>>>>>>
74578>>>>>        
74578>>>>>        Get Encrypt of oDataCrypter (StringToUCharArray(sEncryptPassword)) (StringToUCharArray(sPlainText)) to ucBinary
74579>>>>>        
74579>>>>>        If (SizeOfArray(ucBinary) = 0) Begin
74581>>>>>            Error DFERR_PROGRAM "Unable to encrypt database login password"
74582>>>>>>
74582>>>>>            Function_Return ""
74583>>>>>        End
74583>>>>>>
74583>>>>>        
74583>>>>>        //  Encode binary hash to Base64
74583>>>>>        Move (Base64Encode(AddressOf(ucBinary), SizeOfArray(ucBinary))) to pBase64
74584>>>>>        Move (PointerToString(pBase64)) to sBase64
74585>>>>>        Move (Free(pBase64)) to iVoid
74586>>>>>        
74586>>>>>        Function_Return sBase64
74587>>>>>    End_Function
74588>>>>>    
74588>>>>>    
74588>>>>>    // Decrypts the unreadable hash generated by EncryptKey into a readable string.
74588>>>>>    //
74588>>>>>    // Params:
74588>>>>>    //   sBase64EncryptedPassword       Base64 Encrypted password
74588>>>>>    // Returns:
74588>>>>>    //   Readable plain text password
74588>>>>>    Function DecryptPassword String sBase64EncryptedPassword Returns String
74590>>>>>        String sEncryptPassword
74590>>>>>        UChar[] ucBinary ucPlain
74592>>>>>        Boolean bIsHex
74592>>>>>        Integer iLen iVoid
74592>>>>>        Pointer pBinary
74592>>>>>        
74592>>>>>        If (sBase64EncryptedPassword <> "") Begin
74594>>>>>            //  Decode from Base64
74594>>>>>            Move (Base64Decode(AddressOf(sBase64EncryptedPassword), &iLen)) to pBinary
74595>>>>>            
74595>>>>>            Move (ResizeArray(ucBinary, iLen, 0)) to ucBinary
74596>>>>>            Move (MemCopy(AddressOf(ucBinary), pBinary, iLen)) to iVoid
74597>>>>>                        
74597>>>>>            Move (Free(pBinary)) to iVoid
74598>>>>>            
74598>>>>>            //  Encrypted binary hash to string
74598>>>>>            Get GetEncryptionPassword to sEncryptPassword
74599>>>>>            Get Decrypt of oDataCrypter (StringToUCharArray(sEncryptPassword)) ucBinary to ucPlain
74600>>>>>        End
74600>>>>>>
74600>>>>>        
74600>>>>>        Function_Return (UCharArrayToString(ucPlain))
74601>>>>>    End_Function
74602>>>>>End_Class
