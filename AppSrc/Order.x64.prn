79634>>>        Property Number pnStartOrder_Number
79636>>>        Property Number pnStopOrder_Number
79638>>>
79638>>>        Procedure OnConstrain 
79641>>>            Number nStart nStop
79641>>>
79641>>>            Get pnStartOrder_Number To nStart
79642>>>            Get pnStopOrder_Number To nStop
79643>>>
79643>>>            Case Begin
79643>>>                Case (nStart <> 0 and nStop <> 0)
79645>>>                    Constrain OrderHeader.Order_Number between nStart and nStop
79649>>>                    Case Break
79650>>>                Case (nStart <> 0)
79653>>>                    Constrain OrderHeader.Order_Number GE nStart
79655>>>                    Case Break
79656>>>                Case (nStop <> 0)
79659>>>                    Constrain OrderHeader.Order_Number LE nStop
79661>>>            Case End
79661>>>        End_Procedure 
79662>>>    End_Object 
