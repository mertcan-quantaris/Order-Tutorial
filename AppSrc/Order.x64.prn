75640>>>>>    // If workspaces are used, we will send the message EnumerateWorkspaceData
75640>>>>>    // To the workspace object passing the an object and message To send back
75640>>>>>    // To this object. It is expected that the workspace object will send this
75640>>>>>    // message for every line Of information it wants displayed (passing the
75640>>>>>    // information To be displayed
75640>>>>>    Register_Procedure EnumerateWorkspaceData Handle hObjId Handle hmMessId
75640>>>>>    
75640>>>>>    Procedure Show_ServicePack
75642>>>>>        String sKey sVersionDescription sVersion
75642>>>>>        Handle hoRegistry
75642>>>>>        Boolean bExists bOpened
75642>>>>>        
75642>>>>>        Get Create (RefClass (cRegistry)) to hoRegistry
75643>>>>>        Set phRootKey of hoRegistry to HKEY_LOCAL_MACHINE
75644>>>>>        Set pfAccessRights of hoRegistry to KEY_READ
75645>>>>>        
75645>>>>>        Move C_DFVersionRegistryRoot to sKey
75646>>>>>        Get KeyExists of hoRegistry sKey to bExists
75647>>>>>        If (bExists) Begin
75649>>>>>            Get OpenKey of hoRegistry sKey to bOpened
75650>>>>>            If (bOpened) Begin
75652>>>>>                Get ValueExists of hoRegistry "CurrentVersionDescription" to bExists
75653>>>>>                If (bExists) Begin
75655>>>>>                    Get ReadString of hoRegistry "CurrentVersionDescription" to sVersionDescription
75656>>>>>                End
75656>>>>>>
75656>>>>>                
75656>>>>>                Get ValueExists of hoRegistry "CurrentVersion" to bExists
75657>>>>>                If (bExists) Begin
75659>>>>>                    Get ReadString of hoRegistry "CurrentVersion" to sVersion
75660>>>>>                End
75660>>>>>>
75660>>>>>                Send CloseKey of hoRegistry
75661>>>>>            End
75661>>>>>>
75661>>>>>        End
75661>>>>>>
75661>>>>>        Send Destroy of hoRegistry
75662>>>>>        
75662>>>>>        If (sVersionDescription <> "") Begin
75664>>>>>            Send AppendTextLn (sVersionDescription * "-" * sVersion)
75665>>>>>            Send AppendTextLn ""
75666>>>>>        End
75666>>>>>>
75666>>>>>    End_Procedure
75667>>>>>    
75667>>>>>    
