75443>>>>>>>    Function SqlServerClientVersionName Integer iClientVersion  Returns String
75445>>>>>>>        
75445>>>>>>>        String  sSqlServerClientVersionName
75445>>>>>>>        
75445>>>>>>>        
75445>>>>>>>        Case Begin
75445>>>>>>>
75445>>>>>>>            Case (iClientVersion = SQLSERVER2019CLIENT)
75447>>>>>>>                Move SQLSERVER2019CLIENTNAME to sSqlServerClientVersionName
75448>>>>>>>                Case Break
75449>>>>>>>            
75449>>>>>>>            Case (iClientVersion = SQLSERVER2017CLIENT)
75452>>>>>>>                Move SQLSERVER2017CLIENTNAME to sSqlServerClientVersionName
75453>>>>>>>                Case Break
75454>>>>>>>                
75454>>>>>>>            Case (iClientVersion = SQLSERVER2016CLIENT)
75457>>>>>>>                Move SQLSERVER2016CLIENTNAME to sSqlServerClientVersionName
75458>>>>>>>                Case Break
75459>>>>>>>            
75459>>>>>>>            Case (iClientVersion = SQLSERVER2014CLIENT)
75462>>>>>>>                Move SQLSERVER2014CLIENTNAME to sSqlServerClientVersionName
75463>>>>>>>                Case Break
75464>>>>>>>            
75464>>>>>>>            Case (iClientVersion = SQLSERVER2012CLIENT)
75467>>>>>>>                Move SQLSERVER2012CLIENTNAME to sSqlServerClientVersionName
75468>>>>>>>                Case Break
75469>>>>>>>            
75469>>>>>>>            Case (iClientVersion = SQLSERVER2008CLIENT)
75472>>>>>>>                Move SQLSERVER2008CLIENTNAME to sSqlServerClientVersionName
75473>>>>>>>                Case Break
75474>>>>>>>            
75474>>>>>>>            Case (iClientVersion = SQLSERVER2005CLIENT)
75477>>>>>>>                Move SQLSERVER2005CLIENTNAME to sSqlServerClientVersionName
75478>>>>>>>                Case Break
75479>>>>>>>            
75479>>>>>>>            Case (iClientVersion = SQLSERVER2000CLIENT)
75482>>>>>>>                Move SQLSERVER2000CLIENTNAME to sSqlServerClientVersionName
75483>>>>>>>                Case Break
75484>>>>>>>            
75484>>>>>>>            Case Else
