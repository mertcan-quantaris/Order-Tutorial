75426>>>>>>>    //   Enumerate database in a given server.
75426>>>>>>>    Function EnumerateDatabases String sServer String sUser String sPassWord Returns Integer
75428>>>>>>>        Integer hoSQL
75428>>>>>>>        String  sConnect
75428>>>>>>>        String  sDatabase
75428>>>>>>>        Integer hdbc
75428>>>>>>>        Integer hstmt
75428>>>>>>>        Integer iFetchResult
75428>>>>>>>        
75428>>>>>>>        If (Num_Arguments < 3) ;            Move "" to sPassWord
75431>>>>>>>        If (Num_Arguments < 2) ;            Move "" to sUser
75434>>>>>>>        
75434>>>>>>>        If (sUser <> "") ;            Move ("SERVER=" + Trim(sServer) + ";UID=" + Trim(sUser) + ";PWD=" + Trim(sPassword) + ";") to sConnect
75437>>>>>>>        Else ;            Move ("SERVER=" + Trim(sServer) + ";Trusted_Connection=yes") to sConnect
75439>>>>>>>        
75439>>>>>>>        Object oEnumDBSQLmanager is a cSQLHandleManager
75441>>>>>>>            Move Current_Object to hoSQL
75442>>>>>>>        End_Object
75443>>>>>>>        
75443>>>>>>>        If (hoSQL <> 0) Begin
75445>>>>>>>            Get SQLConnect of hoSQL "MSSQLDRV" sConnect to hdbc
75446>>>>>>>            If (hdbc <> 0) Begin
75448>>>>>>>                Get SQLOpen of hdbc to hstmt
75449>>>>>>>                If (hstmt <> 0) Begin
75451>>>>>>>                    //   We could do a direct select on the sysdatabases table but we use
75451>>>>>>>                    //   the stored procedure sp_database instead. SQL Server recommends this
75451>>>>>>>                    //   approach in case meta data might change, the stored procedure will
75451>>>>>>>                    //   stay the same.
75451>>>>>>>                    Send SQLSetProcedureName to hstmt "sp_databases"
75452>>>>>>>                    Send SQLCall to hstmt
75453>>>>>>>                    Repeat
75453>>>>>>>>
75453>>>>>>>                        Get SQLFetch of hstmt to iFetchResult
75454>>>>>>>                        If (iFetchResult <> 0) Begin
75456>>>>>>>                            Get SQLColumnValue of hstmt 1 to sDatabase
75457>>>>>>>                            Set Value  (Item_Count(Current_Object)) to sDatabase
75458>>>>>>>                        End
75458>>>>>>>>
75458>>>>>>>                    Until (iFetchResult = 0)
75460>>>>>>>                    
75460>>>>>>>                    Send SQLClose to hstmt
75461>>>>>>>                End
75461>>>>>>>>
75461>>>>>>>                Send SQLDisconnect to hdbc
75462>>>>>>>            End
75462>>>>>>>>
75462>>>>>>>        End
75462>>>>>>>>
75462>>>>>>>        Send Destroy_Object to hoSQL
75463>>>>>>>        
75463>>>>>>>        Function_Return (Item_Count(Current_Object))
75464>>>>>>>    End_Function
