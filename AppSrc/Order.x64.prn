75362>>>>>>>    
75362>>>>>>>    
75362>>>>>>>    
75362>>>>>>>    //   Enumerate database in a given server.
75362>>>>>>>    Function EnumerateDatabases String sServer String sUser String sPassWord Returns Integer
75364>>>>>>>        Integer hoSQL
75364>>>>>>>        String  sConnect
75364>>>>>>>        String  sDatabase
75364>>>>>>>        Integer hdbc
75364>>>>>>>        Integer hstmt
75364>>>>>>>        Integer iFetchResult
75364>>>>>>>        
75364>>>>>>>        If (Num_Arguments < 3) ;            Move "" to sPassWord
75367>>>>>>>        If (Num_Arguments < 2) ;            Move "" to sUser
75370>>>>>>>        
75370>>>>>>>        If (sUser <> "") ;            Move ("SERVER=" + Trim(sServer) + ";UID=" + Trim(sUser) + ";PWD=" + Trim(sPassword) + ";") to sConnect
75373>>>>>>>        Else ;            Move ("SERVER=" + Trim(sServer) + ";Trusted_Connection=yes") to sConnect
75375>>>>>>>        
75375>>>>>>>        Object oEnumDBSQLmanager is a cSQLHandleManager
75377>>>>>>>            Move Current_Object to hoSQL
75378>>>>>>>        End_Object
75379>>>>>>>        
75379>>>>>>>        If (hoSQL <> 0) Begin
75381>>>>>>>            Get SQLConnect of hoSQL "MSSQLDRV" sConnect to hdbc
75382>>>>>>>            If (hdbc <> 0) Begin
75384>>>>>>>                Get SQLOpen of hdbc to hstmt
75385>>>>>>>                If (hstmt <> 0) Begin
75387>>>>>>>                    //   We could do a direct select on the sysdatabases table but we use
75387>>>>>>>                    //   the stored procedure sp_database instead. SQL Server recommends this
75387>>>>>>>                    //   approach in case meta data might change, the stored procedure will
75387>>>>>>>                    //   stay the same.
75387>>>>>>>                    Send SQLSetProcedureName to hstmt "sp_databases"
75388>>>>>>>                    Send SQLCall to hstmt
75389>>>>>>>                    Repeat
75389>>>>>>>>
75389>>>>>>>                        Get SQLFetch of hstmt to iFetchResult
75390>>>>>>>                        If (iFetchResult <> 0) Begin
75392>>>>>>>                            Get SQLColumnValue of hstmt 1 to sDatabase
75393>>>>>>>                            Set Value  (Item_Count(Current_Object)) to sDatabase
75394>>>>>>>                        End
75394>>>>>>>>
75394>>>>>>>                    Until (iFetchResult = 0)
75396>>>>>>>                    
75396>>>>>>>                    Send SQLClose to hstmt
75397>>>>>>>                End
75397>>>>>>>>
75397>>>>>>>                Send SQLDisconnect to hdbc
75398>>>>>>>            End
75398>>>>>>>>
75398>>>>>>>        End
75398>>>>>>>>
75398>>>>>>>        Send Destroy_Object to hoSQL
75399>>>>>>>        
75399>>>>>>>        Function_Return (Item_Count(Current_Object))
75400>>>>>>>    End_Function
75401>>>>>>>    
75401>>>>>>>    
75401>>>>>>>    Function SqlServerClientVersionName Integer iClientVersion  Returns String
75403>>>>>>>        
75403>>>>>>>        String  sSqlServerClientVersionName
75403>>>>>>>        
75403>>>>>>>        
75403>>>>>>>        Case Begin
75403>>>>>>>
75403>>>>>>>            Case (iClientVersion = SQLSERVER2019CLIENT)
75405>>>>>>>                Move SQLSERVER2019CLIENTNAME to sSqlServerClientVersionName
75406>>>>>>>                Case Break
75407>>>>>>>            
75407>>>>>>>            Case (iClientVersion = SQLSERVER2017CLIENT)
75410>>>>>>>                Move SQLSERVER2017CLIENTNAME to sSqlServerClientVersionName
75411>>>>>>>                Case Break
75412>>>>>>>                
75412>>>>>>>            Case (iClientVersion = SQLSERVER2016CLIENT)
75415>>>>>>>                Move SQLSERVER2016CLIENTNAME to sSqlServerClientVersionName
75416>>>>>>>                Case Break
75417>>>>>>>            
75417>>>>>>>            Case (iClientVersion = SQLSERVER2014CLIENT)
75420>>>>>>>                Move SQLSERVER2014CLIENTNAME to sSqlServerClientVersionName
75421>>>>>>>                Case Break
75422>>>>>>>            
75422>>>>>>>            Case (iClientVersion = SQLSERVER2012CLIENT)
75425>>>>>>>                Move SQLSERVER2012CLIENTNAME to sSqlServerClientVersionName
75426>>>>>>>                Case Break
75427>>>>>>>            
75427>>>>>>>            Case (iClientVersion = SQLSERVER2008CLIENT)
75430>>>>>>>                Move SQLSERVER2008CLIENTNAME to sSqlServerClientVersionName
75431>>>>>>>                Case Break
75432>>>>>>>            
75432>>>>>>>            Case (iClientVersion = SQLSERVER2005CLIENT)
75435>>>>>>>                Move SQLSERVER2005CLIENTNAME to sSqlServerClientVersionName
75436>>>>>>>                Case Break
75437>>>>>>>            
75437>>>>>>>            Case (iClientVersion = SQLSERVER2000CLIENT)
75440>>>>>>>                Move SQLSERVER2000CLIENTNAME to sSqlServerClientVersionName
75441>>>>>>>                Case Break
75442>>>>>>>            
75442>>>>>>>            Case Else
75442>>>>>>>                Move (SFormat("%1 (version %2) ",SQLSERVERUNKNOWNCLIENTNAME,iClientVersion)) to sSqlServerClientVersionName
75443>>>>>>>                
75443>>>>>>>        Case End
75443>>>>>>>        
75443>>>>>>>        
75443>>>>>>>        Function_Return sSqlServerClientVersionName
75444>>>>>>>        
75444>>>>>>>    End_Function
