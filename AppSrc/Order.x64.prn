75415>>>>>>>    
75415>>>>>>>    
75415>>>>>>>    //   Enumerate database in a given server.
75415>>>>>>>    Function EnumerateDatabases String sServer String sUser String sPassWord Returns Integer
75417>>>>>>>        Integer hoSQL
75417>>>>>>>        String  sConnect
75417>>>>>>>        String  sDatabase
75417>>>>>>>        Integer hdbc
75417>>>>>>>        Integer hstmt
75417>>>>>>>        Integer iFetchResult
75417>>>>>>>        
75417>>>>>>>        If (Num_Arguments < 3) ;            Move "" to sPassWord
75420>>>>>>>        If (Num_Arguments < 2) ;            Move "" to sUser
75423>>>>>>>        
75423>>>>>>>        If (sUser <> "") ;            Move ("SERVER=" + Trim(sServer) + ";UID=" + Trim(sUser) + ";PWD=" + Trim(sPassword) + ";") to sConnect
75426>>>>>>>        Else ;            Move ("SERVER=" + Trim(sServer) + ";Trusted_Connection=yes") to sConnect
75428>>>>>>>        
75428>>>>>>>        Object oEnumDBSQLmanager is a cSQLHandleManager
75430>>>>>>>            Move Current_Object to hoSQL
75431>>>>>>>        End_Object
75432>>>>>>>        
75432>>>>>>>        If (hoSQL <> 0) Begin
75434>>>>>>>            Get SQLConnect of hoSQL "MSSQLDRV" sConnect to hdbc
75435>>>>>>>            If (hdbc <> 0) Begin
75437>>>>>>>                Get SQLOpen of hdbc to hstmt
75438>>>>>>>                If (hstmt <> 0) Begin
75440>>>>>>>                    //   We could do a direct select on the sysdatabases table but we use
75440>>>>>>>                    //   the stored procedure sp_database instead. SQL Server recommends this
75440>>>>>>>                    //   approach in case meta data might change, the stored procedure will
75440>>>>>>>                    //   stay the same.
75440>>>>>>>                    Send SQLSetProcedureName to hstmt "sp_databases"
75441>>>>>>>                    Send SQLCall to hstmt
75442>>>>>>>                    Repeat
75442>>>>>>>>
75442>>>>>>>                        Get SQLFetch of hstmt to iFetchResult
75443>>>>>>>                        If (iFetchResult <> 0) Begin
75445>>>>>>>                            Get SQLColumnValue of hstmt 1 to sDatabase
75446>>>>>>>                            Set Value  (Item_Count(Current_Object)) to sDatabase
75447>>>>>>>                        End
75447>>>>>>>>
75447>>>>>>>                    Until (iFetchResult = 0)
75449>>>>>>>                    
75449>>>>>>>                    Send SQLClose to hstmt
75450>>>>>>>                End
75450>>>>>>>>
75450>>>>>>>                Send SQLDisconnect to hdbc
75451>>>>>>>            End
75451>>>>>>>>
75451>>>>>>>        End
75451>>>>>>>>
75451>>>>>>>        Send Destroy_Object to hoSQL
75452>>>>>>>        
75452>>>>>>>        Function_Return (Item_Count(Current_Object))
75453>>>>>>>    End_Function
75454>>>>>>>    
75454>>>>>>>    
75454>>>>>>>    Function SqlServerClientVersionName Integer iClientVersion  Returns String
75456>>>>>>>        
75456>>>>>>>        String  sSqlServerClientVersionName
75456>>>>>>>        
75456>>>>>>>        
75456>>>>>>>        Case Begin
75456>>>>>>>
75456>>>>>>>            Case (iClientVersion = SQLSERVER2019CLIENT)
75458>>>>>>>                Move SQLSERVER2019CLIENTNAME to sSqlServerClientVersionName
75459>>>>>>>                Case Break
75460>>>>>>>            
75460>>>>>>>            Case (iClientVersion = SQLSERVER2017CLIENT)
75463>>>>>>>                Move SQLSERVER2017CLIENTNAME to sSqlServerClientVersionName
75464>>>>>>>                Case Break
75465>>>>>>>                
75465>>>>>>>            Case (iClientVersion = SQLSERVER2016CLIENT)
75468>>>>>>>                Move SQLSERVER2016CLIENTNAME to sSqlServerClientVersionName
75469>>>>>>>                Case Break
75470>>>>>>>            
75470>>>>>>>            Case (iClientVersion = SQLSERVER2014CLIENT)
75473>>>>>>>                Move SQLSERVER2014CLIENTNAME to sSqlServerClientVersionName
75474>>>>>>>                Case Break
75475>>>>>>>            
75475>>>>>>>            Case (iClientVersion = SQLSERVER2012CLIENT)
75478>>>>>>>                Move SQLSERVER2012CLIENTNAME to sSqlServerClientVersionName
75479>>>>>>>                Case Break
75480>>>>>>>            
75480>>>>>>>            Case (iClientVersion = SQLSERVER2008CLIENT)
75483>>>>>>>                Move SQLSERVER2008CLIENTNAME to sSqlServerClientVersionName
75484>>>>>>>                Case Break
75485>>>>>>>            
