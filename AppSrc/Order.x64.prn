78052>>>>>>>    Function DFNewPage Integer Columns Returns Integer
78054>>>>>>>        Integer iPageNum
78054>>>>>>>        // This returns a page number used in report object....(this may change)
78054>>>>>>>        Move (WP_CreatePage(Columns)) to iPageNum
78055>>>>>>>        If (iPageNum=0) Begin
78057>>>>>>>            Error DFERR_WINPRINT DFPrintError900
78058>>>>>>>>
78058>>>>>>>        End
78058>>>>>>>>
78058>>>>>>>        Function_Return iPageNum
78059>>>>>>>    End_Function
78060>>>>>>>    
78060>>>>>>>    //Return handle to use for winprint dialog. If main_window
78060>>>>>>>    //   exists, use it. Else, get object's handle
78060>>>>>>>    Function Report_Window_Handle Returns Handle
78062>>>>>>>        Handle hWnd
78062>>>>>>>        Handle hoObj
78062>>>>>>>        Get Focus of desktop to hoObj // start with the focus
78063>>>>>>>        Move (gOwnerWindowHandle(hoObj)) to hWnd // global function finds the right handle for us
78064>>>>>>>        Function_Return hWnd
78065>>>>>>>    End_Function
78066>>>>>>>    
78066>>>>>>>    
78066>>>>>>>    //
78066>>>>>>>    Function DFPrintDialog Returns Boolean
78068>>>>>>>        Handle hwnd
78068>>>>>>>        Boolean bOk
78068>>>>>>>        
78068>>>>>>>        Get Report_Window_Handle to hWnd
78069>>>>>>>        Move (WP_ExecutePrintDialog(hwnd)) to bOk
78070>>>>>>>        
78070>>>>>>>        Function_Return bOk
78071>>>>>>>    End_Function
78072>>>>>>>    
78072>>>>>>>    
78072>>>>>>>    // You can only invoke the print setup if the report is cleared. If you try to to do this in
78072>>>>>>>    //    the wrong state you will get an error.
78072>>>>>>>    Function DFPrintSetupDialog Returns Boolean
78074>>>>>>>        Handle hwnd
78074>>>>>>>        Boolean bOk
78074>>>>>>>        Integer iStatus
78074>>>>>>>        Get ArePrintersInstalled to bOk
78075>>>>>>>        If not bOk Begin
78077>>>>>>>            Error DFERR_WINPRINT C_$NoInstalledPrinters
78078>>>>>>>>
78078>>>>>>>        End
78078>>>>>>>>
78078>>>>>>>        Else Begin
78079>>>>>>>            Get DocumentStatus to iStatus
78080>>>>>>>            
78080>>>>>>>            If (iStatus=dsNotStarted) Begin
78082>>>>>>>                Get Report_Window_Handle to hWnd
78083>>>>>>>                Move (WP_ExecutePrinterSetupDialog(hwnd)) to bOk
78084>>>>>>>                
78084>>>>>>>                // test that the selected printer is valid....
78084>>>>>>>                If bOK Begin
78086>>>>>>>                    Get IsPrinterValid to bOk // if printer not valid, it's not ok
78087>>>>>>>                    If not bOk Begin
78089>>>>>>>                        Error DFERR_WINPRINT DFPrintError936  // could not select a valid printer
78090>>>>>>>>
78090>>>>>>>                    End
78090>>>>>>>>
78090>>>>>>>                End
78090>>>>>>>>
78090>>>>>>>            End
78090>>>>>>>>
78090>>>>>>>            Else Begin
78091>>>>>>>                Error DFERR_WINPRINT DFPrintError966      // cannot change printer when report is active
78092>>>>>>>>
78092>>>>>>>            End
78092>>>>>>>>
78092>>>>>>>        End
78092>>>>>>>>
78092>>>>>>>        Function_Return bOk
78093>>>>>>>    End_Function
78094>>>>>>>    
78094>>>>>>>    
78094>>>>>>>    // Provided for backwards compatibility. DFPrintSetupDialog is more flexible because it returns a
78094>>>>>>>    //    false if cancel was selected.
78094>>>>>>>    Procedure DFPrintSetup
78096>>>>>>>        Boolean bOk
78096>>>>>>>        Get DFPrintSetupDialog to bOk
78097>>>>>>>    End_Procedure
78098>>>>>>>    
78098>>>>>>>    // This invokes the print job dialog, prints the report, then clears the report document.
78098>>>>>>>    //    This should be called after the report is complete.
78098>>>>>>>    Procedure DFPrint
78100>>>>>>>        Integer bOk
78100>>>>>>>        Get DFPrintDialog to bOk
78101>>>>>>>        If bOk Begin
78103>>>>>>>            Send DFPrintDoc
78104>>>>>>>            Send DFClearDoc
78105>>>>>>>        End
78105>>>>>>>>
78105>>>>>>>    End_Procedure
78106>>>>>>>    
78106>>>>>>>    Procedure DFSuspendGui Boolean bSuspend
78108>>>>>>>        If (bSuspend<>pbIsSuspended(Self)) Begin
78110>>>>>>>            Send SuspendGui of Desktop bSuspend
78111>>>>>>>            Set pbIsSuspended to bSuspend
78112>>>>>>>        End
78112>>>>>>>>
78112>>>>>>>    End_Procedure
78113>>>>>>>    
78113>>>>>>>    // this is protected so that the queue is only pumped if the
78113>>>>>>>    // gui is suspended.
78113>>>>>>>    Procedure PumpMsgQueue
78115>>>>>>>        If (pbIsSuspended(Self)) Begin
78117>>>>>>>            Send PumpMsgQueue of desktop // permit painting
78118>>>>>>>        End
78118>>>>>>>>
78118>>>>>>>    End_Procedure
78119>>>>>>>    
78119>>>>>>>    
78119>>>>>>>    // This does a modeless preview. This is what you'd want during
78119>>>>>>>    //    report generation and it may be what you want for report viewing.
78119>>>>>>>    Procedure DFPreviewNoWait
78121>>>>>>>        Boolean bOk
78121>>>>>>>        Boolean bPrntDlg bPrintSetup bPrint
78121>>>>>>>        Integer iStatus
78121>>>>>>>        Get PrintDlgInPreview to bPrntDlg
78122>>>>>>>        Get EnablePrintSetupFromPreview to bPrintSetup
78123>>>>>>>        Get EnablePrintFromPreview to bPrint
78124>>>>>>>        Get DocumentStatus to iStatus
78125>>>>>>>        If (iStatus=dsStarted) Begin
78127>>>>>>>            Send DfSuspendGui True
78128>>>>>>>        End
78128>>>>>>>>
78128>>>>>>>        Move (WP_PreviewDocument(bPrntDlg,bPrintSetup,bPrint)) to bOk
78129>>>>>>>        If not bOk Begin
78131>>>>>>>            Error DFERR_WINPRINT DFPrintError901
78132>>>>>>>>
78132>>>>>>>            Send DfSuspendGui False
78133>>>>>>>        End
78133>>>>>>>>
78133>>>>>>>    End_Procedure
78134>>>>>>>    
78134>>>>>>>    
78134>>>>>>>    // This does a modal preview. You might want this for report
78134>>>>>>>    //    viewing as the program knows when the viewer is closed
78134>>>>>>>    // Note that this is a private message and it was never intended that this
78134>>>>>>>    // should be used. We expect winprint reports to use modeless viewers.
78134>>>>>>>    Procedure DFPreviewWait
78136>>>>>>>        Handle hViewerProcess
78136>>>>>>>        Boolean bPrntDlg bPrintSetup bPrint
78136>>>>>>>        Integer iRetVal
78136>>>>>>>        Handle hwMain hMain
78136>>>>>>>        
78136>>>>>>>        Get PrintDlgInPreview to bPrntDlg
78137>>>>>>>        Get EnablePrintSetupFromPreview to bPrintSetup
78138>>>>>>>        Get EnablePrintFromPreview to bPrint
78139>>>>>>>        
78139>>>>>>>        Send DfSuspendGui True
78140>>>>>>>        Move (WP_PreviewDocument(bPrntDlg,bPrintSetup,bPrint)) to hViewerProcess
78141>>>>>>>        
78141>>>>>>>        If (hViewerProcess = 0) Begin
78143>>>>>>>            Error DFERR_WINPRINT DFPrintError901
78144>>>>>>>>
78144>>>>>>>        End
78144>>>>>>>>
78144>>>>>>>        Else Begin
78145>>>>>>>            // We need to wait for either the Viewer to close, or a WM_PAINT message in the thread's queue...
78145>>>>>>>            Repeat
78145>>>>>>>>
78145>>>>>>>                Move (MsgWaitForMultipleObjects(1, AddressOf(hViewerProcess), False, INFINITE, QS_PAINT)) to iRetVal
78146>>>>>>>                Send PumpMsgQueue // permit painting
78147>>>>>>>            Until (iRetVal = 0) // 0 means that the viewer process terminated
78149>>>>>>>        End
78149>>>>>>>>
78149>>>>>>>        Send DfSuspendGui False
78150>>>>>>>        
78150>>>>>>>        // Do what we can to force VDF application to the top.
78150>>>>>>>        // As 12.0 dfSuspendGUI actually properly disables the underlying windows. When the viewer
78150>>>>>>>        // is closed it cannot give the focus back to this so it goes elsewhere. This will force it
78150>>>>>>>        // back.
78150>>>>>>>        
78150>>>>>>>        Get main_window of desktop to hMain
78151>>>>>>>        If hMain Begin
78153>>>>>>>            Get window_handle of hMain to hwMain
78154>>>>>>>            If hwMain Begin
78156>>>>>>>                If (GetForegroundWindow()<>hwMain) Begin
78158>>>>>>>                    Move (SetForegroundWindow(hwMain)) to hwMain
78159>>>>>>>                End
78159>>>>>>>>
78159>>>>>>>            End
78159>>>>>>>>
78159>>>>>>>        End
78159>>>>>>>>
78159>>>>>>>        
78159>>>>>>>    End_Procedure
78160>>>>>>>    
78160>>>>>>>    Procedure DfPreview
78162>>>>>>>        Send DfPreviewNoWait
78163>>>>>>>    End_Procedure
78164>>>>>>>    
78164>>>>>>>    
