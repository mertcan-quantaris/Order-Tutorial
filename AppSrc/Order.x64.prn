75358>>>>>>>    //   Call the driver's browse connect function
75358>>>>>>>    Function BrowseConnect String sInConnStr Returns String
75360>>>>>>>        String  sDriver
75360>>>>>>>        String  sOutConnStr
75360>>>>>>>        Integer iArg
75360>>>>>>>        Integer iRetval
75360>>>>>>>        
75360>>>>>>>        Get psDriverID to sDriver
75361>>>>>>>        If (sDriver <> "") Begin
75363>>>>>>>            Move (Repeat(" ", 8192)) to sOutConnStr
75364>>>>>>>            Call_Driver 0 sDRiver Function CLI_BROWSECONNECT Callback 0 Passing sInConnStr sOutConnStr iArg Result iRetval
75369>>>>>>>        End
75369>>>>>>>>
75369>>>>>>>        
75369>>>>>>>        Function_Return sOutConnStr
75370>>>>>>>    End_Function// BrowseConnect
