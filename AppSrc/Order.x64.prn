74210>>>>>Class cCJMDIWindowsMenuItem is a cCJMenuItem
74211>>>>>    
74211>>>>>    Procedure Construct_Object
74213>>>>>        Forward Send Construct_Object
74215>>>>>        Property Handle[] phArrayOfWindows
74216>>>>>        Set peControlType to xtpControlPopup
74217>>>>>        Set psCategory to C_$CategoryWindow
74218>>>>>    End_Procedure
74219>>>>>    
74219>>>>>    // This adds MDI windows to the existing menu items.
74219>>>>>    // This removes any existing windows menus and always adds a new set to the end
74219>>>>>    
74219>>>>>    Procedure OnPopupInit Variant vCommandBarControl Handle hCommandBarControls
74221>>>>>        Handle  hClientArea hView
74221>>>>>        String  sLabel
74221>>>>>        Integer i iWindows
74221>>>>>        Handle[] hArrayOfWindows
74222>>>>>        Variant vItem
74222>>>>>        
74222>>>>>        // delete all windows actions and menu items. Assume we have an array of DF action objects for the windows
74222>>>>>        // also assume that destroying an action removes all menu instances of that action
74222>>>>>        Get phArrayOfWindows to hArrayOfWindows
74223>>>>>        Move (SizeOfArray(hArrayOfWindows)) to iWindows
74224>>>>>        For i from 0 to (iWindows-1)
74230>>>>>>
74230>>>>>            Send Destroy of hArrayOfWindows[i] // assume this removes all menu items of this action
74231>>>>>        Loop
74232>>>>>>
74232>>>>>        Move (ResizeArray(hArrayOfWindows,0)) to hArrayOfWindows
74233>>>>>        
74233>>>>>        // Add all views to this menu. Create the action and add the item
74233>>>>>        Move 0 to i
74234>>>>>        Get Client_Id to hClientArea // object id of client area
74235>>>>>        If (hClientArea > 0) Begin
74237>>>>>            Get Next_Mdi_Dialog of hClientArea True to hView // find first view
74238>>>>>            While (hView <> 0)
74242>>>>>                If (Active_State(hView)) Begin
74244>>>>>                    // create the action
74244>>>>>                    Get Create U_cCJMDIWindowItem to hArrayOfWindows[i]
74245>>>>>                    Get Label of hView to sLabel // caption bar (name) of view
74246>>>>>                    Set psCaption of hArrayOfWindows[i] to sLabel
74247>>>>>                    Set psDescription of hArrayOfWindows[i] to ("Make this view (" - trim(sLabel) - ") the active window.")
74248>>>>>                    If (current_scope(desktop)=hView and View_mode(hView)<>VIEWMODE_ICONIZE) Begin
74250>>>>>                        Set pbChecked of hArrayOfWindows[i] to True
74251>>>>>                    End
74251>>>>>>
74251>>>>>                    Set phWindow of hArrayOfWindows[i] to hView // used by custom OnExecute
74252>>>>>                    If (i=0) Begin
74254>>>>>                        Set pbControlBeginGroup of hArrayOfWindows[i] to True
74255>>>>>                    End
74255>>>>>>
74255>>>>>                    // Create a menu item for this action
74255>>>>>                    Get AddDynamicControl of hArrayOfWindows[i] hCommandBarControls to vItem
74256>>>>>                    Increment i
74257>>>>>                End
74257>>>>>>
74257>>>>>                Get Next_Mdi_Dialog of hClientArea False to hView // find next
74258>>>>>            Loop
74259>>>>>>
74259>>>>>        End
74259>>>>>>
74259>>>>>        
74259>>>>>        Set phArrayOfWindows to hArrayOfWindows
74260>>>>>        
74260>>>>>    End_Procedure
74261>>>>>    
74261>>>>>End_Class
