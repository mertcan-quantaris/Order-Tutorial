75304>>>>>>>        Call_Driver iFileNum sDRiverID Function DFBTRFN_PSQLLOCALENGINEVERSIONINFO Callback 0 Passing sVersion sVoid 0 Result iRetval
75309>>>>>>>        Send Trap_Error to Error_object_Id 20491
75310>>>>>>>        If (Trim(sVersion) = "") Begin
75312>>>>>>>            // Unable to get the revision. return all zeroes.
75312>>>>>>>            Move "0.0.0" to sVersion
