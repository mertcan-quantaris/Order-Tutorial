75755>>>>>    Function CKRevisionNumber String sDriverID Returns String
75757>>>>>        Handle hoCLIHandler
75757>>>>>        Handle hoDFBtrDrvHandler
75757>>>>>        String sCKRevision
75757>>>>>        
75757>>>>>        
75757>>>>>        If (sDriverID = "MSSQLDRV" or sDriverID = "ODBC_DRV" or sDriverID = "DB2_DRV") Begin
75759>>>>>            Get Create (RefClass(cCLIHandler)) to hoCLIHandler
75760>>>>>            Set psDriverID of hoCLIHandler to sDriverID
75761>>>>>            Move (CKRevision(hoCLIHandler)) to sCKRevision
75762>>>>>            Send Destroy of hoCLIHandler
75763>>>>>        End
75763>>>>>>
75763>>>>>        Else Begin
75764>>>>>            If (sDriverID = "DFBTRDRV") Begin
75766>>>>>                Get Create (RefClass(cDFBtrDrvHandler)) to hoDFBtrDrvHandler
75767>>>>>                Set psDriverID of hoDFBtrDrvHandler to sDriverID
75768>>>>>                Move (CKRevision(hoDFBtrDrvHandler)) to sCKRevision
75769>>>>>                Send Destroy of hoDFBtrDrvHandler
75770>>>>>            End
75770>>>>>>
75770>>>>>        End
75770>>>>>>
75770>>>>>        
75770>>>>>        Function_Return sCKRevision
75771>>>>>    End_Function
75772>>>>>    
75772>>>>>    
75772>>>>>    Function IsDataAccessCK String sDriverID Returns Boolean
75774>>>>>        
75774>>>>>        If (sDriverID = "DATAFLEX") Begin
75776>>>>>            Function_Return False
75777>>>>>        End
75777>>>>>>
75777>>>>>        
75777>>>>>        Function_Return (sDriverID = "MSSQLDRV" or sDriverID = "ODBC_DRV" or sDriverID = "DB2_DRV" or sDriverID = "DFBTRDRV")
75778>>>>>    End_Function
