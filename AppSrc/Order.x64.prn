77584>>>>>Class cOrderDetailDataDictionary is a DataDictionary
77585>>>>>    
77585>>>>>    Procedure Construct_Object
77587>>>>>        Forward Send Construct_Object
77589>>>>>        
77589>>>>>        Set Main_File to OrderDetail.File_Number
77590>>>>>        Set Cascade_Delete_State to False
77591>>>>>        
77591>>>>>        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
77592>>>>>        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
77593>>>>>        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True
77594>>>>>        
77594>>>>>        Set Add_Server_File to OrderHeader.File_Number
77595>>>>>        Set Add_Server_File to Inventory.File_Number
77596>>>>>        
77596>>>>>        Set Field_Auto_Increment Field OrderDetail.Detail_Number to File_Field OrderHeader.Last_Detail_Num
77597>>>>>        
77597>>>>>        Set Field_Option Field OrderDetail.Order_Number DD_NOPUT to True
77598>>>>>        
77598>>>>>        Set Field_Option Field OrderDetail.Detail_Number DD_NOPUT to True
77599>>>>>        
77599>>>>>        Set Field_Exit_msg Field OrderDetail.Qty_Ordered to Adjust_Display_Total
77600>>>>>        Set Field_Label_Long Field OrderDetail.Qty_Ordered to "Quantity Ordered"
77601>>>>>        Set Field_Label_Short Field OrderDetail.Qty_Ordered to "Quantity"
77602>>>>>        Set Field_Mask_Type Field OrderDetail.Qty_Ordered to Mask_Numeric_Window
77603>>>>>        Set Status_Help Field OrderDetail.Qty_Ordered to "Number of items ordered"
77604>>>>>        Set Field_Value_Range Field OrderDetail.Qty_Ordered to 1 100
77605>>>>>        Set Field_Error Field OrderDetail.Qty_Ordered to 0 "Quantity per order line limited to 100"
77606>>>>>
77606>>>>>        
77606>>>>>        Set Field_Entry_msg Field OrderDetail.Price to Entering_Price
77607>>>>>        Set Field_Exit_msg Field OrderDetail.Price to Adjust_Display_Total
77608>>>>>        Set Field_Label_Long Field OrderDetail.Price to "Price per Unit"
77609>>>>>        Set Field_Label_Short Field OrderDetail.Price to "Price"
77610>>>>>        Set Field_Mask_Type Field OrderDetail.Price to MASK_CURRENCY_WINDOW
77611>>>>>        Set Status_Help Field OrderDetail.Price to "Price per Unit"
77612>>>>>        Set Field_Value_Range Field OrderDetail.Price to 0.01 2500
77613>>>>>        Set Field_Error Field OrderDetail.Price to 0 (String("Unit price may not exceed" * FormatCurrency(2500, 2)))
77614>>>>>        
77614>>>>>        Set Field_Label_Long Field OrderDetail.Extended_Price to "Extended Price"
77615>>>>>        Set Field_Label_Short Field OrderDetail.Extended_Price to "Total"
77616>>>>>        Set Field_Mask_Type Field OrderDetail.Extended_Price to MASK_CURRENCY_WINDOW
77617>>>>>        Set Field_Option Field OrderDetail.Extended_Price DD_DISPLAYONLY to True
77618>>>>>        Set Status_Help Field OrderDetail.Extended_Price to "Total extended price"
77619>>>>>        
77619>>>>>        Set piPrimaryIndex to 1
77620>>>>>    End_Procedure
77621>>>>>    
77621>>>>>    // Update and Backout need to adjust the Inventory.On_Hand quantity,
77621>>>>>    // the OrderDetail line's extended price and the OrderHeader total.
77621>>>>>    // We will call the same procedure (Adjust_Balances) to insure that
77621>>>>>    // Backout and Update are inverses of each other.
77621>>>>>    // Note that Backout does not need to change the Extended_Price.
77621>>>>>    // This only gets changed as part of Update.
77621>>>>>    Procedure Update
77623>>>>>        Forward Send Update
77625>>>>>        Move (OrderDetail.Price * OrderDetail.Qty_Ordered) to OrderDetail.Extended_Price
77626>>>>>        Send Adjust_Balances OrderDetail.Qty_Ordered OrderDetail.Extended_Price
77627>>>>>    End_Procedure
77628>>>>>    
77628>>>>>    Procedure Backout
77630>>>>>        Forward Send Backout
77632>>>>>        Send Adjust_Balances (-OrderDetail.Qty_Ordered) (-OrderDetail.Extended_Price)
77633>>>>>    End_Procedure
77634>>>>>    
77634>>>>>    // Called by Backout and Update, passing the quantity and the extended price.
77634>>>>>    // Subtract quantity from on-hand Inventory and add extended Amt to order total.
77634>>>>>    Procedure Adjust_Balances Number Qty Number Amt
77636>>>>>        Subtract Qty from Inventory.On_Hand
77637>>>>>        Add      Amt to   OrderHeader.Order_Total
77638>>>>>    End_Procedure
77639>>>>>    
77639>>>>>    // when entering the price field we may wish to update the
77639>>>>>    // current field value with the standard unit price from the Inventory table.
77639>>>>>    // Only do this if the current amount is zero and an item was actually picked.
77639>>>>>    // If non-zero or no item picked, we assume the field is being edited (and we make no assumptions).
77639>>>>>    Procedure Entering_Price Integer Field# Number nAmnt
77641>>>>>        Handle hoInventoryDD
77641>>>>>        Boolean bHasRecord
77641>>>>>        
77641>>>>>        Get Data_Set Inventory.File_Number to hoInventoryDD
77642>>>>>        
77642>>>>>        If (hoInventoryDD) Begin
77644>>>>>            Get HasRecord of hoInventoryDD to bHasRecord
77645>>>>>            
77645>>>>>            If (nAmnt=0 and bHasRecord) Begin
77647>>>>>                Get File_Field_Current_Value File_Field Inventory.Unit_Price to nAmnt
77648>>>>>                Set Field_Changed_Value Field# to nAmnt
77649>>>>>                Send Adjust_Display_Total
77650>>>>>            End
77650>>>>>>
77650>>>>>        End
77650>>>>>>
77650>>>>>        
77650>>>>>    End_Procedure
77651>>>>>    
77651>>>>>    // This updates the extended price field, which will update any display balances.
77651>>>>>    // This is only done for display purposes.
77651>>>>>    // The actual amount is updated to the field during the save.
77651>>>>>    Procedure Adjust_Display_total Integer iField String sValue
77653>>>>>        Integer iQty
77653>>>>>        Number  nAmnt
77653>>>>>        
77653>>>>>        Get Field_Current_Value Field OrderDetail.Qty_Ordered    to iQty
77654>>>>>        Get Field_Current_Value Field OrderDetail.Price          to nAmnt
77655>>>>>        Set Field_Current_Value Field OrderDetail.Extended_Price to (nAmnt * iQty)
77656>>>>>        // note we set value, but not changed_state!
77656>>>>>    End_Procedure
77657>>>>>    
77657>>>>>    Procedure Field_Defaults
77659>>>>>        Forward Send Field_Defaults
77661>>>>>        Set Field_Changed_Value Field OrderDetail.Qty_Ordered to 1
77662>>>>>    End_Procedure
77663>>>>>    
77663>>>>>End_Class
