78746>>>>>>>        Move (WP_GetUserDefinedPapersize()) to iRetVal
78747>>>>>>>        
78747>>>>>>>        If (iRetVal=0) Begin
78749>>>>>>>            Error DFERR_WINPRINT DFPrintError963
78750>>>>>>>>
78750>>>>>>>            Function_Return 0
78751>>>>>>>        End
78751>>>>>>>>
78751>>>>>>>        
78751>>>>>>>        Move (Low(iRetVal)) to nRetVal
78752>>>>>>>        Move (nRetVal/100) to nRetVal //Returns CM
78753>>>>>>>        
78753>>>>>>>        Function_Return nRetVal
78754>>>>>>>    End_Function
