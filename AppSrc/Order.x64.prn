75678>>>>>    Function CKRevisionNumber String sDriverID Returns String
75680>>>>>        Handle hoCLIHandler
75680>>>>>        Handle hoDFBtrDrvHandler
75680>>>>>        String sCKRevision
75680>>>>>        
75680>>>>>        
75680>>>>>        If (sDriverID = "MSSQLDRV" or sDriverID = "ODBC_DRV" or sDriverID = "DB2_DRV") Begin
75682>>>>>            Get Create (RefClass(cCLIHandler)) to hoCLIHandler
75683>>>>>            Set psDriverID of hoCLIHandler to sDriverID
75684>>>>>            Move (CKRevision(hoCLIHandler)) to sCKRevision
75685>>>>>            Send Destroy of hoCLIHandler
75686>>>>>        End
75686>>>>>>
75686>>>>>        Else Begin
75687>>>>>            If (sDriverID = "DFBTRDRV") Begin
75689>>>>>                Get Create (RefClass(cDFBtrDrvHandler)) to hoDFBtrDrvHandler
75690>>>>>                Set psDriverID of hoDFBtrDrvHandler to sDriverID
75691>>>>>                Move (CKRevision(hoDFBtrDrvHandler)) to sCKRevision
75692>>>>>                Send Destroy of hoDFBtrDrvHandler
75693>>>>>            End
75693>>>>>>
75693>>>>>        End
75693>>>>>>
75693>>>>>        
75693>>>>>        Function_Return sCKRevision
75694>>>>>    End_Function
