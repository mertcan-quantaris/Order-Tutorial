75750>>>>>    
75750>>>>>    Function IsDataAccessCK String sDriverID Returns Boolean
75752>>>>>        
75752>>>>>        If (sDriverID = "DATAFLEX") Begin
75754>>>>>            Function_Return False
75755>>>>>        End
75755>>>>>>
75755>>>>>        
75755>>>>>        Function_Return (sDriverID = "MSSQLDRV" or sDriverID = "ODBC_DRV" or sDriverID = "DB2_DRV" or sDriverID = "DFBTRDRV")
75756>>>>>    End_Function
