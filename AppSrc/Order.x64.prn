75328>>>>>>>    //   Extract the list from the out connect string.
75328>>>>>>>    Function ExtractList String sOutConnStr Integer hoStore Returns Integer
75330>>>>>>>        String  sItem
75330>>>>>>>        Integer iStart
75330>>>>>>>        Integer iEnd
75330>>>>>>>        
75330>>>>>>>        If (hoStore = 0) ;            Move Current_object to hoStore
75333>>>>>>>        
75333>>>>>>>        Send Delete_Data to hoStore
75334>>>>>>>        Move (Pos("{", sOutConnStr)) to iStart
75335>>>>>>>        While (iStart > 0)
75339>>>>>>>            Move (Right(sOutConnStr, Length(sOutConnStr) - iStart)) to sOutConnStr
75340>>>>>>>            If (Left(sOutConnStr, 1) = "}") ;                Move 0 to iStart
75343>>>>>>>            Else Begin
75344>>>>>>>                Move (Pos(",", sOutConnStr)) to iStart
75345>>>>>>>                Move (Pos("}", sOutConnStr)) to iEnd
75346>>>>>>>                If ((iStart = 0) or (iEnd < iStart)) ;                    Move iEnd to iStart
75349>>>>>>>                
75349>>>>>>>                If (iStart > 0) ;                    Set Value of hoStore  (Item_Count(Current_Object)) to (Left(sOutConnStr, iStart - 1))
75352>>>>>>>                
75352>>>>>>>                If (iStart = iEnd) ;                    Move 0 to iStart
75355>>>>>>>            End
75355>>>>>>>>
75355>>>>>>>        Loop
75356>>>>>>>>
75356>>>>>>>        
75356>>>>>>>        Function_Return (Item_Count(hoStore))
75357>>>>>>>    End_Procedure
