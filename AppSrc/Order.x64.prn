75406>>>>>>>            If (iNetworkLocal = 0) Begin
75408>>>>>>>                Get BrowseConnect sDriver to sServerList
75409>>>>>>>            End
75409>>>>>>>>
75409>>>>>>>            Else Begin
75410>>>>>>>                Get BrowseConnectLocal sDriver to sServerList
75411>>>>>>>            End
75411>>>>>>>>
75411>>>>>>>            Get ExtractList sServerList Current_object to iNumServers
