75339>>>>>>>    //   Extract the list from the out connect string.
75339>>>>>>>    Function ExtractList String sOutConnStr Integer hoStore Returns Integer
75341>>>>>>>        String  sItem
75341>>>>>>>        Integer iStart
75341>>>>>>>        Integer iEnd
75341>>>>>>>        
75341>>>>>>>        If (hoStore = 0) ;            Move Current_object to hoStore
75344>>>>>>>        
75344>>>>>>>        Send Delete_Data to hoStore
75345>>>>>>>        Move (Pos("{", sOutConnStr)) to iStart
75346>>>>>>>        While (iStart > 0)
75350>>>>>>>            Move (Right(sOutConnStr, Length(sOutConnStr) - iStart)) to sOutConnStr
75351>>>>>>>            If (Left(sOutConnStr, 1) = "}") ;                Move 0 to iStart
75354>>>>>>>            Else Begin
75355>>>>>>>                Move (Pos(",", sOutConnStr)) to iStart
75356>>>>>>>                Move (Pos("}", sOutConnStr)) to iEnd
75357>>>>>>>                If ((iStart = 0) or (iEnd < iStart)) ;                    Move iEnd to iStart
75360>>>>>>>                
75360>>>>>>>                If (iStart > 0) ;                    Set Value of hoStore  (Item_Count(Current_Object)) to (Left(sOutConnStr, iStart - 1))
75363>>>>>>>                
75363>>>>>>>                If (iStart = iEnd) ;                    Move 0 to iStart
75366>>>>>>>            End
75366>>>>>>>>
75366>>>>>>>        Loop
75367>>>>>>>>
75367>>>>>>>        
75367>>>>>>>        Function_Return (Item_Count(hoStore))
75368>>>>>>>    End_Procedure
