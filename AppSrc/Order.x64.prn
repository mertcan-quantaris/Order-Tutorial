75317>>>>>>>    //   Extract the list from the out connect string.
75317>>>>>>>    Function ExtractList String sOutConnStr Integer hoStore Returns Integer
75319>>>>>>>        String  sItem
75319>>>>>>>        Integer iStart
75319>>>>>>>        Integer iEnd
75319>>>>>>>        
75319>>>>>>>        If (hoStore = 0) ;            Move Current_object to hoStore
75322>>>>>>>        
75322>>>>>>>        Send Delete_Data to hoStore
75323>>>>>>>        Move (Pos("{", sOutConnStr)) to iStart
75324>>>>>>>        While (iStart > 0)
75328>>>>>>>            Move (Right(sOutConnStr, Length(sOutConnStr) - iStart)) to sOutConnStr
75329>>>>>>>            If (Left(sOutConnStr, 1) = "}") ;                Move 0 to iStart
75332>>>>>>>            Else Begin
75333>>>>>>>                Move (Pos(",", sOutConnStr)) to iStart
75334>>>>>>>                Move (Pos("}", sOutConnStr)) to iEnd
75335>>>>>>>                If ((iStart = 0) or (iEnd < iStart)) ;                    Move iEnd to iStart
75338>>>>>>>                
75338>>>>>>>                If (iStart > 0) ;                    Set Value of hoStore  (Item_Count(Current_Object)) to (Left(sOutConnStr, iStart - 1))
75341>>>>>>>                
75341>>>>>>>                If (iStart = iEnd) ;                    Move 0 to iStart
75344>>>>>>>            End
75344>>>>>>>>
75344>>>>>>>        Loop
75345>>>>>>>>
75345>>>>>>>        
75345>>>>>>>        Function_Return (Item_Count(hoStore))
75346>>>>>>>    End_Procedure
