79545>>>            string  sFont 
79545>>>            integer iFontSize iStyle
79545>>>
79545>>>            Move "arial" to sFont
79546>>>            Move 8 to iFontSize
79547>>>            Move (font_default) to iStyle
79548>>>
79548>>>            DFFont sFont
79549>>>            DFFontSize iFontSize
79550>>>
79550>>>            DFWritePos Customer.Customer_Number       (0.08 + 1.22) (iStyle + Font_Right) 0 1.22
79551>>>            DFWritePos Customer.Name                  1.38 iStyle -1 5.11
79552>>>            DFWritePos Customer.Address               6.57 iStyle -1 5.11
79553>>>            DFWritePos Customer.City                  11.76 iStyle -1 2.38
79554>>>            DFWritePos Customer.State                 14.22 iStyle -1 0.61
79555>>>            DFWritePos Customer.Zip                   14.91 iStyle -1 1.7
79556>>>            DFWriteLn
79557>>>
79557>>>        End_Procedure 
