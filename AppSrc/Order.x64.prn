75708>>>>>    
75708>>>>>    Function IsDataAccessCK String sDriverID Returns Boolean
75710>>>>>        
75710>>>>>        If (sDriverID = "DATAFLEX") Begin
75712>>>>>            Function_Return False
75713>>>>>        End
75713>>>>>>
75713>>>>>        
75713>>>>>        Function_Return (sDriverID = "MSSQLDRV" or sDriverID = "ODBC_DRV" or sDriverID = "DB2_DRV" or sDriverID = "DFBTRDRV")
75714>>>>>    End_Function
