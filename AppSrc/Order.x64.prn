75768>>>>>    Procedure Show_Drivers
75770>>>>>        String sCurrentDriver sRevNumber
75770>>>>>        String sLoadedDrivers sClientDriver
75770>>>>>        Integer iNumberOfDrivers iCount iClientVersion iMSSQLIndex
75770>>>>>        Boolean bOK
75770>>>>>        Handle hoMsqlDrv
75770>>>>>        
75770>>>>>        Move "" to sLoadedDrivers
75771>>>>>        Get_Attribute DF_NUMBER_DRIVERS to iNumberOfDrivers
75774>>>>>        For iCount from 1 to iNumberOfDrivers
75780>>>>>>
75780>>>>>            Get_Attribute DF_DRIVER_NAME of iCount to sCurrentDriver
75783>>>>>            If (sLoadedDrivers <> "") Begin
75785>>>>>                Move (Append (sLoadedDrivers, ", ")) to sLoadedDrivers
75786>>>>>            End
75786>>>>>>
75786>>>>>            Get IsDataAccessCK sCurrentDriver to bOK
75787>>>>>            If (bOK) Begin
75789>>>>>                If (sCurrentDriver = "MSSQLDRV") Begin
75791>>>>>                    Move iCount to iMSSQLIndex
75792>>>>>                End
75792>>>>>>
75792>>>>>                Get CKRevisionNumber sCurrentDriver to sRevNumber
75793>>>>>                // if mssqldrv, show the client number
75793>>>>>                Move (sCurrentDriver * "(" + sRevNumber + ")") to sCurrentDriver
75794>>>>>            End
75794>>>>>>
75794>>>>>            Move (Append (sLoadedDrivers, sCurrentDriver)) to sLoadedDrivers
75795>>>>>        Loop
75796>>>>>>
75796>>>>>        Send AppendTextLn (SFormat (C_$DatabaseDriver, sLoadedDrivers))
75797>>>>>        If (iMSSQLIndex>0) Begin
75799>>>>>            Get_Attribute DF_DRIVER_SQLSERVER_CLIENT_VERSION of iMSSQLIndex to iClientVersion
75802>>>>>            Get Create (RefClass(cMSSQLHandler)) to hoMsqlDrv
75803>>>>>            Get SqlServerClientVersionName of hoMsqlDrv iClientVersion to sClientDriver
75804>>>>>            Send Destroy of hoMsqlDrv
75805>>>>>            Send AppendTextLn (SFormat("MSSQLDRV Client Version: %1", sClientDriver))
75806>>>>>        End
75806>>>>>>
75806>>>>>    End_Procedure
