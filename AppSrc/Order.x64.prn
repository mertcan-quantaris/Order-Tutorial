77908>>>    //-----------------------------------------------------------------------
77908>>>    // Create custom confirmation messages for save and delete
77908>>>    // We must create the new functions and assign verify messages
77908>>>    // to them.
77908>>>    //-----------------------------------------------------------------------
77908>>>
77908>>>    Function ConfirmDeleteHeader Returns Boolean
77911>>>        Boolean bFail
77911>>>        Get Confirm C_$DeleteEntireHeaderAndAllDetail to bFail
77912>>>        Function_Return bFail
77913>>>    End_Function 
77914>>>
77914>>>    // Only confirm on the saving of new records
77914>>>    Function ConfirmSaveHeader Returns Boolean
77917>>>        Boolean bNoSave bHasRecord
77917>>>        Handle  hoSrvr
77917>>>        Get Server to hoSrvr
77918>>>        Get HasRecord of hoSrvr to bHasRecord
77919>>>        If not bHasRecord Begin
77921>>>            Get Confirm C_$SaveThisNewHeader to bNoSave
77922>>>        End
77922>>>>
77922>>>        Function_Return bNoSave
77923>>>    End_Function 
