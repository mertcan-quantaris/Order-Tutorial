79927>>>
79927>>>        // Returns string with description of selection ranges
79927>>>        // Pass: Selection title, start value and end value. Return: description
79927>>>        Function SelectionCriteraDescription string sTitle string sStart string sStop returns String
79930>>>            string sText
79930>>>            If (sStart=""  AND sStop="") ;                function_return ""
79933>>>            If (sStart="0" AND sStop="0") ;                function_return ""
79936>>>            If (sStart<>"" AND sStop<>"") begin
79938>>>                Move (C_$ReportCriteriaBetween * sStart * C_$ReportCriteriaAnd * sStop) to sText
79939>>>            end
79939>>>>
79939>>>            Else if (sStart > "") begin
79942>>>                Move (C_$ReportCriteriaStartingAt * sStart) to sText
79943>>>            end
79943>>>>
79943>>>            Else if (sStop > "") begin
79946>>>                Move (C_$ReportCriteriaUpTo * sStop) to sText
79947>>>            End
79947>>>>
79947>>>            function_return (sTitle * sText)
79948>>>        End_Function
79949>>>
79949>>>    End_Object 
