75941>>>//  This is the default message. It is expected that you will
75941>>>//  create your own message to override this
75941>>>Procedure Activate_About
75944>>>    Send DoAbout "" "" "" "" ""
75945>>>End_Procedure
75946>>>
75946>>>//  It is expected that you will send this message (most
75946>>>//  likely from Activate_About. This creates an about object, activates it
75946>>>//  and destroys it when done. It is not exepected that you will augment this.
75946>>>Procedure DoAbout String sTitle String sVersion String sCopyRight String sAuthor String sBitmap
75949>>>    Integer hoObj hoMain
75949>>>    
75949>>>    // create object
75949>>>    Object About is an AboutDialog
75951>>>        // if no title passed use the label of the main panel
75951>>>        // (if a main panel exists).
75951>>>        If (sTitle = "") Begin
75953>>>            Get Main_Window of desktop to hoMain
75954>>>            If hoMain ;                Get Label of hoMain to sTitle
75957>>>        End
75957>>>>
75957>>>        Set productname to sTitle
75958>>>        Set version     to sVersion
75959>>>        Set copyright   to sCopyRight
75960>>>        Set author      to sAuthor
75961>>>        If (sBitmap <> '') ;            Set logo to sBitMap // square bitmaps of 42x42 work best
75964>>>        Move Self to hoObj // object Id
75965>>>    End_Object
75966>>>    Send Popup   of hoObj    // popup the about object
75967>>>    Send Destroy of hoObj // when done, it will be destroyed
75968>>>End_Procedure
75969>>>
