75129>>>>>>>// Purpose: An instance of this class can be used as a broker object to
75129>>>>>>>//          call several Dfbtrdrv releated methods.
75129>>>>>>>
75129>>>>>>>Class cDFBtrDrvHandler is an Array
75130>>>>>>>    
75130>>>>>>>    Procedure Construct_Object Integer iImage
75132>>>>>>>        Forward Send Construct_object iImage
75134>>>>>>>        
75134>>>>>>>        Property String  psDriverID "DFBTRDRV"
75135>>>>>>>    End_Procedure
75136>>>>>>>    
75136>>>>>>>    //  The revsion of a Dfbtrdrv Connectivity Kit
75136>>>>>>>    //
75136>>>>>>>    
75136>>>>>>>    Function CKRevision Returns String
75138>>>>>>>        String  sDriverID
75138>>>>>>>        String  sRevision
75138>>>>>>>        String  sVoid
75138>>>>>>>        Integer iRetval
75138>>>>>>>        
75138>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75138>>>>>>>        // This error would otherwise be raised when we have an older
75138>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75138>>>>>>>        Send Ignore_error to Error_object_Id 20491
75139>>>>>>>        Get psDriverID to sDriverID
75140>>>>>>>        Move (Repeat(" ", 255)) to sRevision
75141>>>>>>>        Call_Driver 0 sDRiverID Function DFBTRFN_CKREVISION Callback 0 Passing sRevision sVoid 0 Result iRetval
75146>>>>>>>        Send Trap_Error to Error_object_Id 20491
75147>>>>>>>        If (Trim(sRevision) = "") Begin
75149>>>>>>>            // Unable to get the revision. return all zeroes.
75149>>>>>>>            Move "0.0.0.0" to sRevision
75150>>>>>>>        End
75150>>>>>>>>
75150>>>>>>>        Function_Return sRevision
75151>>>>>>>    End_Function
75152>>>>>>>    
75152>>>>>>>    Function CkUsesUri Returns Integer
75154>>>>>>>        String  sDriverID
75154>>>>>>>        String  sVoid1
75154>>>>>>>        String  sVoid2
75154>>>>>>>        Integer iRetval
75154>>>>>>>        
75154>>>>>>>        Get psDriverID to sDriverID
75155>>>>>>>        
75155>>>>>>>        Move 0 to iRetval
75156>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75156>>>>>>>        // This error would otherwise be raised when we have an older
75156>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKUSESURI function
75156>>>>>>>        Send Ignore_error to Error_object_Id 20491
75157>>>>>>>        Call_Driver 0 sDRiverID Function DFBTRFN_CKUSESURI Callback 0 Passing sVoid1 sVoid2 0 Result iRetval
75162>>>>>>>        Send Trap_Error to Error_object_Id 20491
75163>>>>>>>        
75163>>>>>>>        Function_Return iRetval
75164>>>>>>>    End_Function
75165>>>>>>>    
75165>>>>>>>    
75165>>>>>>>    
75165>>>>>>>    // Extract the Nth part of a a.b.c.d revsion string.
75165>>>>>>>    //
75165>>>>>>>    // Returns : The part version number or -1 if there is no such part number.
75165>>>>>>>    //
75165>>>>>>>    
75165>>>>>>>    Function ExtractPartFromRevision Integer iPartNum String sRevision Returns Integer
75167>>>>>>>        Integer iPartRev
75167>>>>>>>        Integer iCurrentPart
75167>>>>>>>        Integer iSeparatorPos
75167>>>>>>>        
75167>>>>>>>        If (iPartNum > 4) ;            Function_Return -1
75170>>>>>>>        
75170>>>>>>>        Move 0 to iCurrentPart
75171>>>>>>>        Repeat
75171>>>>>>>>
75171>>>>>>>            Move (Pos(".", sRevision)) to iSeparatorPos
75172>>>>>>>            If (iSeparatorPos > 0) Begin
75174>>>>>>>                Move (Left(sRevision, iSeparatorPos - 1)) to iPartRev
75175>>>>>>>                Move (Right(sRevision, Length(sRevision) - iSeparatorPos)) to sRevision
75176>>>>>>>                Increment iCurrentPart
75177>>>>>>>            End
75177>>>>>>>>
75177>>>>>>>            Else If (sRevision <> "") Begin
75180>>>>>>>                Move sRevision to iPartRev
75181>>>>>>>                Move "" to sRevision
75182>>>>>>>                Increment iCurrentPart
75183>>>>>>>            End
75183>>>>>>>>
75183>>>>>>>            Else ;                Move -1 to iPartRev
75185>>>>>>>        Until (iCurrentPart >= iPartNum or iPartRev = -1)
75187>>>>>>>        
75187>>>>>>>        Function_Return iPartRev
75188>>>>>>>    End_Function
75189>>>>>>>    
75189>>>>>>>    
75189>>>>>>>    
75189>>>>>>>    //
75189>>>>>>>    //  Returns the major revision of the CK
75189>>>>>>>    //
75189>>>>>>>    
75189>>>>>>>    Function CKMajorRevision Returns Integer
75191>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 1, CKRevision(Current_Object)))
75192>>>>>>>    End_Function
75193>>>>>>>    
75193>>>>>>>    
75193>>>>>>>    
75193>>>>>>>    //  Returns the minor revision of the CK
75193>>>>>>>    //
75193>>>>>>>    
75193>>>>>>>    Function CKMinorRevision Returns Integer
75195>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 2, CKRevision(Current_Object)))
75196>>>>>>>    End_Function
75197>>>>>>>    
75197>>>>>>>    
75197>>>>>>>    //  Returns the release revision of the CK
75197>>>>>>>    //
75197>>>>>>>    
75197>>>>>>>    Function CKReleaseRevision Returns Integer
75199>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 3, CKRevision(Current_Object)))
75200>>>>>>>    End_Function
75201>>>>>>>    
75201>>>>>>>    
75201>>>>>>>    //  Returns the major revision of the CK
75201>>>>>>>    //
75201>>>>>>>    
75201>>>>>>>    Function CKBuildRevision Returns Integer
75203>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 4, CKRevision(Current_Object)))
75204>>>>>>>    End_Function
75205>>>>>>>    
75205>>>>>>>    
75205>>>>>>>    //  Determines if the CK conforms to a passed minimal revsion.
75205>>>>>>>    //
75205>>>>>>>    
75205>>>>>>>    Function IsMinimalRevision Integer iMajor Integer iMinor Integer iRelease Integer iBuild Returns Integer
75207>>>>>>>        If (iMajor < CKMajorRevision(Current_object)) ;            Function_Return (True)
75210>>>>>>>        Else If (iMajor = CKMajorRevision(Current_object)) Begin
75213>>>>>>>            If (iMinor < CKMinorRevision(Current_object)) ;                Function_Return (True)
75216>>>>>>>            Else If (iMinor = CKMinorRevision(Current_object)) Begin
75219>>>>>>>                If (iRelease < CKReleaseRevision(Current_object)) ;                    Function_Return (True)
75222>>>>>>>                Else If (iRelease = CKReleaseRevision(Current_object) and iBuild <= CKBuildRevision(Current_object)) ;                    Function_Return (True)
75226>>>>>>>            End
75226>>>>>>>>
75226>>>>>>>        End
75226>>>>>>>>
75226>>>>>>>        
75226>>>>>>>        Function_Return (False)
75227>>>>>>>    End_Function
75228>>>>>>>    
75228>>>>>>>    //   Functions to query the Pervasive.SQL version:
75228>>>>>>>    //       PSQLRequesterVersionInfo    Integer iFileNum Returns String
75228>>>>>>>    //       PSQLLocalEngineVersionInfo  Integer iFileNum Returns String
75228>>>>>>>    //       PSQLServerEngineVersionInfo Integer iFileNum Returns String
75228>>>>>>>    //
75228>>>>>>>    //   All 3 functions return the version of a Pervasive.SQL component
75228>>>>>>>    //   in the following format:
75228>>>>>>>    //       <version>.<revision>.<type>
75228>>>>>>>    //   possible values for <type>:
75228>>>>>>>    //       9 for 32-bit Windows workstation/workgroup engine or Linux
75228>>>>>>>    //         server using Workgroup authentication mode
75228>>>>>>>    //       C for client cache engine
75228>>>>>>>    //       D for DOS workstation
75228>>>>>>>    //       N for client Requester
75228>>>>>>>    //       S for NetWare server
75228>>>>>>>    //       T for 32-bit Windows server engine
75228>>>>>>>    //       U for Linux server using PAM or BTPASSWD authentication
75228>>>>>>>    //
75228>>>>>>>    //   example:
75228>>>>>>>    //       8.50.T
75228>>>>>>>    //   will be returned for a Pervasive.SQL 8.5 Server Engine running on
75228>>>>>>>    //   32-bits Windows server.
75228>>>>>>>    //
75228>>>>>>>    //   The FileNumber parameter must specify an opened table or 0.
75228>>>>>>>    //   For PSQLServerEngineVersionInfo the FileNumber can not be 0.
75228>>>>>>>    //
75228>>>>>>>    //   If the version information is not available or can not be obtained
75228>>>>>>>    //   the functions will return "0.0.0"
75228>>>>>>>    
75228>>>>>>>    //  Returns the version information of the
75228>>>>>>>    //           Pervasive.SQL Client requester.
75228>>>>>>>    
75228>>>>>>>    Function PSQLRequesterVersionInfo Integer iFileNum Returns String
75230>>>>>>>        
75230>>>>>>>        String  sDriverID
75230>>>>>>>        String  sVersion
75230>>>>>>>        String  sVoid
75230>>>>>>>        Integer iRetval
75230>>>>>>>        
75230>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75230>>>>>>>        // This error would otherwise be raised when we have an older
75230>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75230>>>>>>>        Send Ignore_error to Error_object_Id 20491
75231>>>>>>>        Get psDriverID to sDriverID
75232>>>>>>>        Move (Repeat(" ", 255)) to sVersion
75233>>>>>>>        Call_Driver iFileNum sDRiverID Function DFBTRFN_PSQLREQUESTERVERSIONINFO Callback 0 Passing sVersion sVoid 0 Result iRetval
75238>>>>>>>        Send Trap_Error to Error_object_Id 20491
75239>>>>>>>        If (Trim(sVersion) = "") Begin
75241>>>>>>>            // Unable to get the revision. return all zeroes.
75241>>>>>>>            Move "0.0.0" to sVersion
75242>>>>>>>        End
75242>>>>>>>>
75242>>>>>>>        Function_Return sVersion
75243>>>>>>>    End_Function
75244>>>>>>>    
75244>>>>>>>    //           Pervasive.SQL Engine
75244>>>>>>>    
75244>>>>>>>    Function PSQLLocalEngineVersionInfo Integer iFileNum Returns String
75246>>>>>>>        
75246>>>>>>>        String  sDriverID
75246>>>>>>>        String  sVersion
75246>>>>>>>        String  sVoid
75246>>>>>>>        Integer iRetval
75246>>>>>>>        
75246>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75246>>>>>>>        // This error would otherwise be raised when we have an older
75246>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75246>>>>>>>        Send Ignore_error to Error_object_Id 20491
75247>>>>>>>        Get psDriverID to sDriverID
75248>>>>>>>        Move (Repeat(" ", 255)) to sVersion
75249>>>>>>>        Call_Driver iFileNum sDRiverID Function DFBTRFN_PSQLLOCALENGINEVERSIONINFO Callback 0 Passing sVersion sVoid 0 Result iRetval
75254>>>>>>>        Send Trap_Error to Error_object_Id 20491
75255>>>>>>>        If (Trim(sVersion) = "") Begin
75257>>>>>>>            // Unable to get the revision. return all zeroes.
75257>>>>>>>            Move "0.0.0" to sVersion
75258>>>>>>>        End
75258>>>>>>>>
75258>>>>>>>        Function_Return sVersion
75259>>>>>>>    End_Function
75260>>>>>>>    
75260>>>>>>>    //  Returns the version information of the
