75684>>>>>    // If workspaces are used, we will send the message EnumerateWorkspaceData
75684>>>>>    // To the workspace object passing the an object and message To send back
75684>>>>>    // To this object. It is expected that the workspace object will send this
75684>>>>>    // message for every line Of information it wants displayed (passing the
75684>>>>>    // information To be displayed
75684>>>>>    Register_Procedure EnumerateWorkspaceData Handle hObjId Handle hmMessId
75684>>>>>    
75684>>>>>    Procedure Show_ServicePack
75686>>>>>        String sKey sVersionDescription sVersion
75686>>>>>        Handle hoRegistry
75686>>>>>        Boolean bExists bOpened
75686>>>>>        
75686>>>>>        Get Create (RefClass (cRegistry)) to hoRegistry
75687>>>>>        Set phRootKey of hoRegistry to HKEY_LOCAL_MACHINE
75688>>>>>        Set pfAccessRights of hoRegistry to KEY_READ
75689>>>>>        
75689>>>>>        Move C_DFVersionRegistryRoot to sKey
75690>>>>>        Get KeyExists of hoRegistry sKey to bExists
75691>>>>>        If (bExists) Begin
75693>>>>>            Get OpenKey of hoRegistry sKey to bOpened
75694>>>>>            If (bOpened) Begin
75696>>>>>                Get ValueExists of hoRegistry "CurrentVersionDescription" to bExists
75697>>>>>                If (bExists) Begin
75699>>>>>                    Get ReadString of hoRegistry "CurrentVersionDescription" to sVersionDescription
75700>>>>>                End
75700>>>>>>
75700>>>>>                
75700>>>>>                Get ValueExists of hoRegistry "CurrentVersion" to bExists
75701>>>>>                If (bExists) Begin
75703>>>>>                    Get ReadString of hoRegistry "CurrentVersion" to sVersion
75704>>>>>                End
75704>>>>>>
75704>>>>>                Send CloseKey of hoRegistry
75705>>>>>            End
75705>>>>>>
75705>>>>>        End
75705>>>>>>
75705>>>>>        Send Destroy of hoRegistry
75706>>>>>        
75706>>>>>        If (sVersionDescription <> "") Begin
75708>>>>>            Send AppendTextLn (sVersionDescription * "-" * sVersion)
75709>>>>>            Send AppendTextLn ""
75710>>>>>        End
75710>>>>>>
75710>>>>>    End_Procedure
75711>>>>>    
75711>>>>>    
