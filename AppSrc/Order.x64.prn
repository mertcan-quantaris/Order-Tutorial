74553>>>>>    Procedure Construct_Object
74555>>>>>        Forward Send Construct_Object
74557>>>>>        // this must be set to a multi (40ish) character random key
74557>>>>>        Property String psEncryptPassword ""
74558>>>>>        
74558>>>>>        Object oDataCrypter is a cCryptographerEx
74560>>>>>            Set piHash to CALG_SHA_256
74561>>>>>            Set piCipher to CALG_AES_256
74562>>>>>            Set psProvider to "" //  Not providing a specific provider gives the default provider for the provider type
74563>>>>>            Set piProvider to PROV_RSA_AES
74564>>>>>        End_Object
