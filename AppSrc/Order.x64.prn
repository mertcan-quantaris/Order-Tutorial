75120>>>>>>>//
75120>>>>>>>
75120>>>>>>>//
75120>>>>>>>// Command to get detection for incompatible positive signs in numeric fields
75120>>>>>>>//
75120>>>>>>>
75120>>>>>>>// Purpose: An instance of this class can be used as a broker object to
75120>>>>>>>//          call several Dfbtrdrv releated methods.
75120>>>>>>>
75120>>>>>>>Class cDFBtrDrvHandler is an Array
75121>>>>>>>    
75121>>>>>>>    Procedure Construct_Object Integer iImage
75123>>>>>>>        Forward Send Construct_object iImage
75125>>>>>>>        
75125>>>>>>>        Property String  psDriverID "DFBTRDRV"
75126>>>>>>>    End_Procedure
75127>>>>>>>    
75127>>>>>>>    //  The revsion of a Dfbtrdrv Connectivity Kit
75127>>>>>>>    //
75127>>>>>>>    
75127>>>>>>>    Function CKRevision Returns String
75129>>>>>>>        String  sDriverID
75129>>>>>>>        String  sRevision
75129>>>>>>>        String  sVoid
75129>>>>>>>        Integer iRetval
75129>>>>>>>        
75129>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75129>>>>>>>        // This error would otherwise be raised when we have an older
75129>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75129>>>>>>>        Send Ignore_error to Error_object_Id 20491
75130>>>>>>>        Get psDriverID to sDriverID
75131>>>>>>>        Move (Repeat(" ", 255)) to sRevision
75132>>>>>>>        Call_Driver 0 sDRiverID Function DFBTRFN_CKREVISION Callback 0 Passing sRevision sVoid 0 Result iRetval
75137>>>>>>>        Send Trap_Error to Error_object_Id 20491
75138>>>>>>>        If (Trim(sRevision) = "") Begin
75140>>>>>>>            // Unable to get the revision. return all zeroes.
75140>>>>>>>            Move "0.0.0.0" to sRevision
75141>>>>>>>        End
75141>>>>>>>>
75141>>>>>>>        Function_Return sRevision
75142>>>>>>>    End_Function
75143>>>>>>>    
75143>>>>>>>    Function CkUsesUri Returns Integer
75145>>>>>>>        String  sDriverID
75145>>>>>>>        String  sVoid1
75145>>>>>>>        String  sVoid2
75145>>>>>>>        Integer iRetval
75145>>>>>>>        
75145>>>>>>>        Get psDriverID to sDriverID
75146>>>>>>>        
75146>>>>>>>        Move 0 to iRetval
75147>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75147>>>>>>>        // This error would otherwise be raised when we have an older
75147>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKUSESURI function
75147>>>>>>>        Send Ignore_error to Error_object_Id 20491
75148>>>>>>>        Call_Driver 0 sDRiverID Function DFBTRFN_CKUSESURI Callback 0 Passing sVoid1 sVoid2 0 Result iRetval
75153>>>>>>>        Send Trap_Error to Error_object_Id 20491
75154>>>>>>>        
75154>>>>>>>        Function_Return iRetval
75155>>>>>>>    End_Function
75156>>>>>>>    
75156>>>>>>>    
75156>>>>>>>    
75156>>>>>>>    // Extract the Nth part of a a.b.c.d revsion string.
75156>>>>>>>    //
75156>>>>>>>    // Returns : The part version number or -1 if there is no such part number.
75156>>>>>>>    //
75156>>>>>>>    
75156>>>>>>>    Function ExtractPartFromRevision Integer iPartNum String sRevision Returns Integer
75158>>>>>>>        Integer iPartRev
75158>>>>>>>        Integer iCurrentPart
75158>>>>>>>        Integer iSeparatorPos
75158>>>>>>>        
75158>>>>>>>        If (iPartNum > 4) ;            Function_Return -1
75161>>>>>>>        
75161>>>>>>>        Move 0 to iCurrentPart
75162>>>>>>>        Repeat
75162>>>>>>>>
75162>>>>>>>            Move (Pos(".", sRevision)) to iSeparatorPos
75163>>>>>>>            If (iSeparatorPos > 0) Begin
75165>>>>>>>                Move (Left(sRevision, iSeparatorPos - 1)) to iPartRev
75166>>>>>>>                Move (Right(sRevision, Length(sRevision) - iSeparatorPos)) to sRevision
75167>>>>>>>                Increment iCurrentPart
75168>>>>>>>            End
75168>>>>>>>>
75168>>>>>>>            Else If (sRevision <> "") Begin
75171>>>>>>>                Move sRevision to iPartRev
75172>>>>>>>                Move "" to sRevision
75173>>>>>>>                Increment iCurrentPart
75174>>>>>>>            End
75174>>>>>>>>
75174>>>>>>>            Else ;                Move -1 to iPartRev
75176>>>>>>>        Until (iCurrentPart >= iPartNum or iPartRev = -1)
75178>>>>>>>        
75178>>>>>>>        Function_Return iPartRev
75179>>>>>>>    End_Function
75180>>>>>>>    
75180>>>>>>>    
75180>>>>>>>    
75180>>>>>>>    //
75180>>>>>>>    //  Returns the major revision of the CK
75180>>>>>>>    //
75180>>>>>>>    
75180>>>>>>>    Function CKMajorRevision Returns Integer
75182>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 1, CKRevision(Current_Object)))
75183>>>>>>>    End_Function
75184>>>>>>>    
75184>>>>>>>    
75184>>>>>>>    
75184>>>>>>>    //  Returns the minor revision of the CK
75184>>>>>>>    //
75184>>>>>>>    
75184>>>>>>>    Function CKMinorRevision Returns Integer
75186>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 2, CKRevision(Current_Object)))
75187>>>>>>>    End_Function
75188>>>>>>>    
75188>>>>>>>    
75188>>>>>>>    //  Returns the release revision of the CK
75188>>>>>>>    //
75188>>>>>>>    
75188>>>>>>>    Function CKReleaseRevision Returns Integer
75190>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 3, CKRevision(Current_Object)))
75191>>>>>>>    End_Function
75192>>>>>>>    
75192>>>>>>>    
75192>>>>>>>    //  Returns the major revision of the CK
75192>>>>>>>    //
75192>>>>>>>    
75192>>>>>>>    Function CKBuildRevision Returns Integer
75194>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 4, CKRevision(Current_Object)))
75195>>>>>>>    End_Function
75196>>>>>>>    
75196>>>>>>>    
75196>>>>>>>    //  Determines if the CK conforms to a passed minimal revsion.
75196>>>>>>>    //
75196>>>>>>>    
75196>>>>>>>    Function IsMinimalRevision Integer iMajor Integer iMinor Integer iRelease Integer iBuild Returns Integer
75198>>>>>>>        If (iMajor < CKMajorRevision(Current_object)) ;            Function_Return (True)
75201>>>>>>>        Else If (iMajor = CKMajorRevision(Current_object)) Begin
75204>>>>>>>            If (iMinor < CKMinorRevision(Current_object)) ;                Function_Return (True)
75207>>>>>>>            Else If (iMinor = CKMinorRevision(Current_object)) Begin
75210>>>>>>>                If (iRelease < CKReleaseRevision(Current_object)) ;                    Function_Return (True)
75213>>>>>>>                Else If (iRelease = CKReleaseRevision(Current_object) and iBuild <= CKBuildRevision(Current_object)) ;                    Function_Return (True)
75217>>>>>>>            End
75217>>>>>>>>
75217>>>>>>>        End
75217>>>>>>>>
75217>>>>>>>        
75217>>>>>>>        Function_Return (False)
75218>>>>>>>    End_Function
75219>>>>>>>    
75219>>>>>>>    //   Functions to query the Pervasive.SQL version:
75219>>>>>>>    //       PSQLRequesterVersionInfo    Integer iFileNum Returns String
75219>>>>>>>    //       PSQLLocalEngineVersionInfo  Integer iFileNum Returns String
75219>>>>>>>    //       PSQLServerEngineVersionInfo Integer iFileNum Returns String
75219>>>>>>>    //
75219>>>>>>>    //   All 3 functions return the version of a Pervasive.SQL component
75219>>>>>>>    //   in the following format:
75219>>>>>>>    //       <version>.<revision>.<type>
75219>>>>>>>    //   possible values for <type>:
75219>>>>>>>    //       9 for 32-bit Windows workstation/workgroup engine or Linux
75219>>>>>>>    //         server using Workgroup authentication mode
75219>>>>>>>    //       C for client cache engine
75219>>>>>>>    //       D for DOS workstation
75219>>>>>>>    //       N for client Requester
75219>>>>>>>    //       S for NetWare server
75219>>>>>>>    //       T for 32-bit Windows server engine
75219>>>>>>>    //       U for Linux server using PAM or BTPASSWD authentication
75219>>>>>>>    //
75219>>>>>>>    //   example:
75219>>>>>>>    //       8.50.T
75219>>>>>>>    //   will be returned for a Pervasive.SQL 8.5 Server Engine running on
75219>>>>>>>    //   32-bits Windows server.
75219>>>>>>>    //
75219>>>>>>>    //   The FileNumber parameter must specify an opened table or 0.
75219>>>>>>>    //   For PSQLServerEngineVersionInfo the FileNumber can not be 0.
75219>>>>>>>    //
75219>>>>>>>    //   If the version information is not available or can not be obtained
75219>>>>>>>    //   the functions will return "0.0.0"
75219>>>>>>>    
75219>>>>>>>    //  Returns the version information of the
75219>>>>>>>    //           Pervasive.SQL Client requester.
75219>>>>>>>    
75219>>>>>>>    Function PSQLRequesterVersionInfo Integer iFileNum Returns String
75221>>>>>>>        
75221>>>>>>>        String  sDriverID
75221>>>>>>>        String  sVersion
75221>>>>>>>        String  sVoid
75221>>>>>>>        Integer iRetval
75221>>>>>>>        
75221>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75221>>>>>>>        // This error would otherwise be raised when we have an older
75221>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75221>>>>>>>        Send Ignore_error to Error_object_Id 20491
75222>>>>>>>        Get psDriverID to sDriverID
75223>>>>>>>        Move (Repeat(" ", 255)) to sVersion
75224>>>>>>>        Call_Driver iFileNum sDRiverID Function DFBTRFN_PSQLREQUESTERVERSIONINFO Callback 0 Passing sVersion sVoid 0 Result iRetval
75229>>>>>>>        Send Trap_Error to Error_object_Id 20491
75230>>>>>>>        If (Trim(sVersion) = "") Begin
75232>>>>>>>            // Unable to get the revision. return all zeroes.
75232>>>>>>>            Move "0.0.0" to sVersion
75233>>>>>>>        End
75233>>>>>>>>
75233>>>>>>>        Function_Return sVersion
75234>>>>>>>    End_Function
75235>>>>>>>    
75235>>>>>>>    //           Pervasive.SQL Engine
75235>>>>>>>    
75235>>>>>>>    Function PSQLLocalEngineVersionInfo Integer iFileNum Returns String
75237>>>>>>>        
75237>>>>>>>        String  sDriverID
