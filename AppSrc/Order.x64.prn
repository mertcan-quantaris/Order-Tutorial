75963>>>//  This is the default message. It is expected that you will
75963>>>//  create your own message to override this
75963>>>Procedure Activate_About
75966>>>    Send DoAbout "" "" "" "" ""
75967>>>End_Procedure
75968>>>
75968>>>//  It is expected that you will send this message (most
75968>>>//  likely from Activate_About. This creates an about object, activates it
75968>>>//  and destroys it when done. It is not exepected that you will augment this.
75968>>>Procedure DoAbout String sTitle String sVersion String sCopyRight String sAuthor String sBitmap
75971>>>    Integer hoObj hoMain
75971>>>    
75971>>>    // create object
75971>>>    Object About is an AboutDialog
75973>>>        // if no title passed use the label of the main panel
75973>>>        // (if a main panel exists).
75973>>>        If (sTitle = "") Begin
75975>>>            Get Main_Window of desktop to hoMain
75976>>>            If hoMain ;                Get Label of hoMain to sTitle
75979>>>        End
75979>>>>
75979>>>        Set productname to sTitle
75980>>>        Set version     to sVersion
75981>>>        Set copyright   to sCopyRight
75982>>>        Set author      to sAuthor
75983>>>        If (sBitmap <> '') ;            Set logo to sBitMap // square bitmaps of 42x42 work best
75986>>>        Move Self to hoObj // object Id
75987>>>    End_Object
75988>>>    Send Popup   of hoObj    // popup the about object
75989>>>    Send Destroy of hoObj // when done, it will be destroyed
75990>>>End_Procedure
