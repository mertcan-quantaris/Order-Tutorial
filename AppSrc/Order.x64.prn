75631>>>>>    // If workspaces are used, we will send the message EnumerateWorkspaceData
75631>>>>>    // To the workspace object passing the an object and message To send back
75631>>>>>    // To this object. It is expected that the workspace object will send this
75631>>>>>    // message for every line Of information it wants displayed (passing the
75631>>>>>    // information To be displayed
75631>>>>>    Register_Procedure EnumerateWorkspaceData Handle hObjId Handle hmMessId
75631>>>>>    
75631>>>>>    Procedure Show_ServicePack
75633>>>>>        String sKey sVersionDescription sVersion
75633>>>>>        Handle hoRegistry
75633>>>>>        Boolean bExists bOpened
75633>>>>>        
75633>>>>>        Get Create (RefClass (cRegistry)) to hoRegistry
75634>>>>>        Set phRootKey of hoRegistry to HKEY_LOCAL_MACHINE
75635>>>>>        Set pfAccessRights of hoRegistry to KEY_READ
75636>>>>>        
75636>>>>>        Move C_DFVersionRegistryRoot to sKey
75637>>>>>        Get KeyExists of hoRegistry sKey to bExists
75638>>>>>        If (bExists) Begin
75640>>>>>            Get OpenKey of hoRegistry sKey to bOpened
75641>>>>>            If (bOpened) Begin
75643>>>>>                Get ValueExists of hoRegistry "CurrentVersionDescription" to bExists
75644>>>>>                If (bExists) Begin
75646>>>>>                    Get ReadString of hoRegistry "CurrentVersionDescription" to sVersionDescription
75647>>>>>                End
75647>>>>>>
75647>>>>>                
75647>>>>>                Get ValueExists of hoRegistry "CurrentVersion" to bExists
75648>>>>>                If (bExists) Begin
75650>>>>>                    Get ReadString of hoRegistry "CurrentVersion" to sVersion
75651>>>>>                End
75651>>>>>>
75651>>>>>                Send CloseKey of hoRegistry
75652>>>>>            End
75652>>>>>>
75652>>>>>        End
75652>>>>>>
75652>>>>>        Send Destroy of hoRegistry
75653>>>>>        
75653>>>>>        If (sVersionDescription <> "") Begin
75655>>>>>            Send AppendTextLn (sVersionDescription * "-" * sVersion)
75656>>>>>            Send AppendTextLn ""
75657>>>>>        End
75657>>>>>>
75657>>>>>    End_Procedure
75658>>>>>    
75658>>>>>    
