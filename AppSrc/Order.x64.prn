75779>>>>>    Procedure Show_Drivers
75781>>>>>        String sCurrentDriver sRevNumber
75781>>>>>        String sLoadedDrivers sClientDriver
75781>>>>>        Integer iNumberOfDrivers iCount iClientVersion iMSSQLIndex
75781>>>>>        Boolean bOK
75781>>>>>        Handle hoMsqlDrv
75781>>>>>        
75781>>>>>        Move "" to sLoadedDrivers
75782>>>>>        Get_Attribute DF_NUMBER_DRIVERS to iNumberOfDrivers
75785>>>>>        For iCount from 1 to iNumberOfDrivers
75791>>>>>>
75791>>>>>            Get_Attribute DF_DRIVER_NAME of iCount to sCurrentDriver
75794>>>>>            If (sLoadedDrivers <> "") Begin
75796>>>>>                Move (Append (sLoadedDrivers, ", ")) to sLoadedDrivers
75797>>>>>            End
75797>>>>>>
75797>>>>>            Get IsDataAccessCK sCurrentDriver to bOK
75798>>>>>            If (bOK) Begin
75800>>>>>                If (sCurrentDriver = "MSSQLDRV") Begin
75802>>>>>                    Move iCount to iMSSQLIndex
75803>>>>>                End
75803>>>>>>
75803>>>>>                Get CKRevisionNumber sCurrentDriver to sRevNumber
75804>>>>>                // if mssqldrv, show the client number
75804>>>>>                Move (sCurrentDriver * "(" + sRevNumber + ")") to sCurrentDriver
75805>>>>>            End
75805>>>>>>
75805>>>>>            Move (Append (sLoadedDrivers, sCurrentDriver)) to sLoadedDrivers
75806>>>>>        Loop
75807>>>>>>
75807>>>>>        Send AppendTextLn (SFormat (C_$DatabaseDriver, sLoadedDrivers))
75808>>>>>        If (iMSSQLIndex>0) Begin
75810>>>>>            Get_Attribute DF_DRIVER_SQLSERVER_CLIENT_VERSION of iMSSQLIndex to iClientVersion
75813>>>>>            Get Create (RefClass(cMSSQLHandler)) to hoMsqlDrv
75814>>>>>            Get SqlServerClientVersionName of hoMsqlDrv iClientVersion to sClientDriver
75815>>>>>            Send Destroy of hoMsqlDrv
75816>>>>>            Send AppendTextLn (SFormat("MSSQLDRV Client Version: %1", sClientDriver))
75817>>>>>        End
75817>>>>>>
75817>>>>>    End_Procedure
