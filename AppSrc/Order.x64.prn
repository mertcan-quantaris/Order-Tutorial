75275>>>>>>>    //   Extract the list from the out connect string.
75275>>>>>>>    Function ExtractList String sOutConnStr Integer hoStore Returns Integer
75277>>>>>>>        String  sItem
75277>>>>>>>        Integer iStart
75277>>>>>>>        Integer iEnd
75277>>>>>>>        
75277>>>>>>>        If (hoStore = 0) ;            Move Current_object to hoStore
75280>>>>>>>        
75280>>>>>>>        Send Delete_Data to hoStore
75281>>>>>>>        Move (Pos("{", sOutConnStr)) to iStart
75282>>>>>>>        While (iStart > 0)
75286>>>>>>>            Move (Right(sOutConnStr, Length(sOutConnStr) - iStart)) to sOutConnStr
75287>>>>>>>            If (Left(sOutConnStr, 1) = "}") ;                Move 0 to iStart
75290>>>>>>>            Else Begin
75291>>>>>>>                Move (Pos(",", sOutConnStr)) to iStart
75292>>>>>>>                Move (Pos("}", sOutConnStr)) to iEnd
75293>>>>>>>                If ((iStart = 0) or (iEnd < iStart)) ;                    Move iEnd to iStart
75296>>>>>>>                
75296>>>>>>>                If (iStart > 0) ;                    Set Value of hoStore  (Item_Count(Current_Object)) to (Left(sOutConnStr, iStart - 1))
75299>>>>>>>                
75299>>>>>>>                If (iStart = iEnd) ;                    Move 0 to iStart
75302>>>>>>>            End
75302>>>>>>>>
75302>>>>>>>        Loop
75303>>>>>>>>
75303>>>>>>>        
75303>>>>>>>        Function_Return (Item_Count(hoStore))
75304>>>>>>>    End_Procedure
75305>>>>>>>    
75305>>>>>>>    
75305>>>>>>>    
75305>>>>>>>    //   Call the driver's browse connect function
75305>>>>>>>    Function BrowseConnect String sInConnStr Returns String
75307>>>>>>>        String  sDriver
75307>>>>>>>        String  sOutConnStr
75307>>>>>>>        Integer iArg
75307>>>>>>>        Integer iRetval
75307>>>>>>>        
75307>>>>>>>        Get psDriverID to sDriver
75308>>>>>>>        If (sDriver <> "") Begin
75310>>>>>>>            Move (Repeat(" ", 8192)) to sOutConnStr
75311>>>>>>>            Call_Driver 0 sDRiver Function CLI_BROWSECONNECT Callback 0 Passing sInConnStr sOutConnStr iArg Result iRetval
75316>>>>>>>        End
75316>>>>>>>>
75316>>>>>>>        
75316>>>>>>>        Function_Return sOutConnStr
75317>>>>>>>    End_Function// BrowseConnect
