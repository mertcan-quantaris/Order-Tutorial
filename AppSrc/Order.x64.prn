75757>>>>>    Procedure Show_Drivers
75759>>>>>        String sCurrentDriver sRevNumber
75759>>>>>        String sLoadedDrivers sClientDriver
75759>>>>>        Integer iNumberOfDrivers iCount iClientVersion iMSSQLIndex
75759>>>>>        Boolean bOK
75759>>>>>        Handle hoMsqlDrv
75759>>>>>        
75759>>>>>        Move "" to sLoadedDrivers
75760>>>>>        Get_Attribute DF_NUMBER_DRIVERS to iNumberOfDrivers
75763>>>>>        For iCount from 1 to iNumberOfDrivers
75769>>>>>>
75769>>>>>            Get_Attribute DF_DRIVER_NAME of iCount to sCurrentDriver
75772>>>>>            If (sLoadedDrivers <> "") Begin
75774>>>>>                Move (Append (sLoadedDrivers, ", ")) to sLoadedDrivers
75775>>>>>            End
75775>>>>>>
75775>>>>>            Get IsDataAccessCK sCurrentDriver to bOK
75776>>>>>            If (bOK) Begin
75778>>>>>                If (sCurrentDriver = "MSSQLDRV") Begin
75780>>>>>                    Move iCount to iMSSQLIndex
75781>>>>>                End
75781>>>>>>
75781>>>>>                Get CKRevisionNumber sCurrentDriver to sRevNumber
75782>>>>>                // if mssqldrv, show the client number
75782>>>>>                Move (sCurrentDriver * "(" + sRevNumber + ")") to sCurrentDriver
75783>>>>>            End
75783>>>>>>
75783>>>>>            Move (Append (sLoadedDrivers, sCurrentDriver)) to sLoadedDrivers
75784>>>>>        Loop
75785>>>>>>
75785>>>>>        Send AppendTextLn (SFormat (C_$DatabaseDriver, sLoadedDrivers))
75786>>>>>        If (iMSSQLIndex>0) Begin
75788>>>>>            Get_Attribute DF_DRIVER_SQLSERVER_CLIENT_VERSION of iMSSQLIndex to iClientVersion
75791>>>>>            Get Create (RefClass(cMSSQLHandler)) to hoMsqlDrv
75792>>>>>            Get SqlServerClientVersionName of hoMsqlDrv iClientVersion to sClientDriver
75793>>>>>            Send Destroy of hoMsqlDrv
75794>>>>>            Send AppendTextLn (SFormat("MSSQLDRV Client Version: %1", sClientDriver))
75795>>>>>        End
75795>>>>>>
75795>>>>>    End_Procedure
