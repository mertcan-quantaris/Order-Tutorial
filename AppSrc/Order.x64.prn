79558>>>        // Page_Bottom is printed last at the bottom margin of each page
79558>>>        Procedure Page_Bottom 
79561>>>            string sFont
79561>>>            integer iFontSize iBorder iStyle
79561>>>            DateTime dtDT
79561>>>
79561>>>            Move (CurrentDateTime()) to dtDT
79562>>>
79562>>>            Move "arial" to sFont
79563>>>            Move 8 to iFontSize
79564>>>            Move (font_default) to iStyle
79565>>>            Move (rgb_dGrey) to iBorder
79566>>>
79566>>>            DFFont sFont
79567>>>            DFFontSize iFontSize
79568>>>            DFBeginHeader DFPageBottom
79569>>>                DFHeaderFrame Hdr_Margins 0.01 iBorder
79570>>>                DFHeaderPos Hdr_Left
79571>>>                DFWriteln (C_$ReportPrintedOn * string(dtDT)) (iStyle+Font_Center)
79572>>>            DFEndHeader
79574>>>
79574>>>        End_Procedure 
79575>>>
79575>>>        // Returns string with description of selection ranges
79575>>>        // Pass: Selection title, start value and end value. Return: description
79575>>>        Function SelectionCriteraDescription string sTitle string sStart string sStop returns String
79578>>>            string sText
79578>>>            If (sStart=""  AND sStop="") ;                function_return ""
79581>>>            If (sStart="0" AND sStop="0") ;                function_return ""
79584>>>            If (sStart<>"" AND sStop<>"") begin
79586>>>                Move (C_$ReportCriteriaBetween * sStart * C_$ReportCriteriaAnd * sStop) to sText
79587>>>            end
79587>>>>
79587>>>            Else if (sStart > "") begin
79590>>>                Move (C_$ReportCriteriaStartingAt * sStart) to sText
79591>>>            end
79591>>>>
79591>>>            Else if (sStop > "") begin
79594>>>                Move (C_$ReportCriteriaUpTo * sStop) to sText
79595>>>            End
79595>>>>
79595>>>            function_return (sTitle * sText)
79596>>>        End_Function
79597>>>
79597>>>    End_Object 
79598>>>
79598>>>    Procedure StartReport 
79601>>>        Boolean bToPrinter
79601>>>
79601>>>        // determine if direct print
79601>>>        Get IsToPrinter of oPrintTo to bToPrinter
79602>>>        Set OutPut_Device_Mode of oReport to (If(bToPrinter, PRINT_TO_PRINTER, PRINT_TO_WINDOW))
79603>>>
79603>>>        // run the report
79603>>>        Send Run_Report of oReport
79604>>>
79604>>>    End_Procedure 
79605>>>End_Object 
