75715>>>>>    Procedure Show_Drivers
75717>>>>>        String sCurrentDriver sRevNumber
75717>>>>>        String sLoadedDrivers sClientDriver
75717>>>>>        Integer iNumberOfDrivers iCount iClientVersion iMSSQLIndex
75717>>>>>        Boolean bOK
75717>>>>>        Handle hoMsqlDrv
75717>>>>>        
75717>>>>>        Move "" to sLoadedDrivers
75718>>>>>        Get_Attribute DF_NUMBER_DRIVERS to iNumberOfDrivers
75721>>>>>        For iCount from 1 to iNumberOfDrivers
75727>>>>>>
75727>>>>>            Get_Attribute DF_DRIVER_NAME of iCount to sCurrentDriver
75730>>>>>            If (sLoadedDrivers <> "") Begin
75732>>>>>                Move (Append (sLoadedDrivers, ", ")) to sLoadedDrivers
75733>>>>>            End
75733>>>>>>
75733>>>>>            Get IsDataAccessCK sCurrentDriver to bOK
75734>>>>>            If (bOK) Begin
75736>>>>>                If (sCurrentDriver = "MSSQLDRV") Begin
75738>>>>>                    Move iCount to iMSSQLIndex
75739>>>>>                End
75739>>>>>>
75739>>>>>                Get CKRevisionNumber sCurrentDriver to sRevNumber
75740>>>>>                // if mssqldrv, show the client number
75740>>>>>                Move (sCurrentDriver * "(" + sRevNumber + ")") to sCurrentDriver
75741>>>>>            End
75741>>>>>>
75741>>>>>            Move (Append (sLoadedDrivers, sCurrentDriver)) to sLoadedDrivers
75742>>>>>        Loop
75743>>>>>>
75743>>>>>        Send AppendTextLn (SFormat (C_$DatabaseDriver, sLoadedDrivers))
75744>>>>>        If (iMSSQLIndex>0) Begin
75746>>>>>            Get_Attribute DF_DRIVER_SQLSERVER_CLIENT_VERSION of iMSSQLIndex to iClientVersion
75749>>>>>            Get Create (RefClass(cMSSQLHandler)) to hoMsqlDrv
75750>>>>>            Get SqlServerClientVersionName of hoMsqlDrv iClientVersion to sClientDriver
75751>>>>>            Send Destroy of hoMsqlDrv
75752>>>>>            Send AppendTextLn (SFormat("MSSQLDRV Client Version: %1", sClientDriver))
75753>>>>>        End
75753>>>>>>
75753>>>>>    End_Procedure
