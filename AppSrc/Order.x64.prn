78733>>>>>>>    //
78733>>>>>>>    Function DFGetUserDefinedLength Returns Number
78735>>>>>>>        Integer iRetVal
78735>>>>>>>        Number  nRetVal
78735>>>>>>>        
78735>>>>>>>        Move (WP_GetUserDefinedPapersize()) to iRetVal
78736>>>>>>>        
78736>>>>>>>        If (iRetVal=0) Begin
78738>>>>>>>            Error DFERR_WINPRINT DFPrintError962
78739>>>>>>>>
78739>>>>>>>            Function_Return 0
78740>>>>>>>        End
78740>>>>>>>>
78740>>>>>>>        
78740>>>>>>>        Move (Hi(iRetVal)) to nRetVal
78741>>>>>>>        Move (nRetVal/100) to nRetVal //Returns CM
78742>>>>>>>        
78742>>>>>>>        Function_Return nRetVal
78743>>>>>>>    End_Function
78744>>>>>>>    
78744>>>>>>>    
78744>>>>>>>    //
78744>>>>>>>    Function DFGetUserDefinedWidth Returns Number
78746>>>>>>>        Integer iRetVal
