75510>>>>>    WString wName
75510>>>>>    Integer iRetval iLength
75510>>>>>    
75510>>>>>    Move 0 to iLength
75511>>>>>    Move (WNetGetUserW (0, 0, AddressOf (iLength))) to iRetval
75512>>>>>    Move (ZeroString(iLength)) to wName
75513>>>>>    Move (WNetGetUserW (0, AddressOf (wName), AddressOf (iLength))) to iRetval
75514>>>>>    
75514>>>>>    If (iRetval = NO_ERROR) Begin
75516>>>>>        Function_Return (CString (wName))
75517>>>>>    End
75517>>>>>>
75517>>>>>    
75517>>>>>    Function_Return "User Unknown"
75518>>>>>End_Function
