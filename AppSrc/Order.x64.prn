75284>>>>>>>    //   Extract the list from the out connect string.
75284>>>>>>>    Function ExtractList String sOutConnStr Integer hoStore Returns Integer
75286>>>>>>>        String  sItem
75286>>>>>>>        Integer iStart
75286>>>>>>>        Integer iEnd
75286>>>>>>>        
75286>>>>>>>        If (hoStore = 0) ;            Move Current_object to hoStore
75289>>>>>>>        
75289>>>>>>>        Send Delete_Data to hoStore
75290>>>>>>>        Move (Pos("{", sOutConnStr)) to iStart
75291>>>>>>>        While (iStart > 0)
75295>>>>>>>            Move (Right(sOutConnStr, Length(sOutConnStr) - iStart)) to sOutConnStr
75296>>>>>>>            If (Left(sOutConnStr, 1) = "}") ;                Move 0 to iStart
75299>>>>>>>            Else Begin
75300>>>>>>>                Move (Pos(",", sOutConnStr)) to iStart
75301>>>>>>>                Move (Pos("}", sOutConnStr)) to iEnd
75302>>>>>>>                If ((iStart = 0) or (iEnd < iStart)) ;                    Move iEnd to iStart
75305>>>>>>>                
75305>>>>>>>                If (iStart > 0) ;                    Set Value of hoStore  (Item_Count(Current_Object)) to (Left(sOutConnStr, iStart - 1))
75308>>>>>>>                
75308>>>>>>>                If (iStart = iEnd) ;                    Move 0 to iStart
75311>>>>>>>            End
75311>>>>>>>>
75311>>>>>>>        Loop
75312>>>>>>>>
75312>>>>>>>        
75312>>>>>>>        Function_Return (Item_Count(hoStore))
75313>>>>>>>    End_Procedure
75314>>>>>>>    
75314>>>>>>>    
75314>>>>>>>    
75314>>>>>>>    //   Call the driver's browse connect function
75314>>>>>>>    Function BrowseConnect String sInConnStr Returns String
75316>>>>>>>        String  sDriver
75316>>>>>>>        String  sOutConnStr
75316>>>>>>>        Integer iArg
75316>>>>>>>        Integer iRetval
75316>>>>>>>        
75316>>>>>>>        Get psDriverID to sDriver
75317>>>>>>>        If (sDriver <> "") Begin
75319>>>>>>>            Move (Repeat(" ", 8192)) to sOutConnStr
75320>>>>>>>            Call_Driver 0 sDRiver Function CLI_BROWSECONNECT Callback 0 Passing sInConnStr sOutConnStr iArg Result iRetval
75325>>>>>>>        End
75325>>>>>>>>
75325>>>>>>>        
75325>>>>>>>        Function_Return sOutConnStr
75326>>>>>>>    End_Function// BrowseConnect
