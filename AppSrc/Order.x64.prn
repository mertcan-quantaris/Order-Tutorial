75691>>>>>    Function CKRevisionNumber String sDriverID Returns String
75693>>>>>        Handle hoCLIHandler
75693>>>>>        Handle hoDFBtrDrvHandler
75693>>>>>        String sCKRevision
75693>>>>>        
75693>>>>>        
75693>>>>>        If (sDriverID = "MSSQLDRV" or sDriverID = "ODBC_DRV" or sDriverID = "DB2_DRV") Begin
75695>>>>>            Get Create (RefClass(cCLIHandler)) to hoCLIHandler
75696>>>>>            Set psDriverID of hoCLIHandler to sDriverID
75697>>>>>            Move (CKRevision(hoCLIHandler)) to sCKRevision
75698>>>>>            Send Destroy of hoCLIHandler
75699>>>>>        End
75699>>>>>>
75699>>>>>        Else Begin
75700>>>>>            If (sDriverID = "DFBTRDRV") Begin
75702>>>>>                Get Create (RefClass(cDFBtrDrvHandler)) to hoDFBtrDrvHandler
75703>>>>>                Set psDriverID of hoDFBtrDrvHandler to sDriverID
75704>>>>>                Move (CKRevision(hoDFBtrDrvHandler)) to sCKRevision
75705>>>>>                Send Destroy of hoDFBtrDrvHandler
75706>>>>>            End
75706>>>>>>
75706>>>>>        End
75706>>>>>>
75706>>>>>        
75706>>>>>        Function_Return sCKRevision
75707>>>>>    End_Function
