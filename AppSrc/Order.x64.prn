75702>>>>>    Procedure Show_Drivers
75704>>>>>        String sCurrentDriver sRevNumber
75704>>>>>        String sLoadedDrivers sClientDriver
75704>>>>>        Integer iNumberOfDrivers iCount iClientVersion iMSSQLIndex
75704>>>>>        Boolean bOK
75704>>>>>        Handle hoMsqlDrv
75704>>>>>        
75704>>>>>        Move "" to sLoadedDrivers
75705>>>>>        Get_Attribute DF_NUMBER_DRIVERS to iNumberOfDrivers
75708>>>>>        For iCount from 1 to iNumberOfDrivers
75714>>>>>>
75714>>>>>            Get_Attribute DF_DRIVER_NAME of iCount to sCurrentDriver
75717>>>>>            If (sLoadedDrivers <> "") Begin
75719>>>>>                Move (Append (sLoadedDrivers, ", ")) to sLoadedDrivers
75720>>>>>            End
75720>>>>>>
75720>>>>>            Get IsDataAccessCK sCurrentDriver to bOK
75721>>>>>            If (bOK) Begin
75723>>>>>                If (sCurrentDriver = "MSSQLDRV") Begin
75725>>>>>                    Move iCount to iMSSQLIndex
75726>>>>>                End
75726>>>>>>
75726>>>>>                Get CKRevisionNumber sCurrentDriver to sRevNumber
75727>>>>>                // if mssqldrv, show the client number
75727>>>>>                Move (sCurrentDriver * "(" + sRevNumber + ")") to sCurrentDriver
75728>>>>>            End
75728>>>>>>
75728>>>>>            Move (Append (sLoadedDrivers, sCurrentDriver)) to sLoadedDrivers
75729>>>>>        Loop
75730>>>>>>
75730>>>>>        Send AppendTextLn (SFormat (C_$DatabaseDriver, sLoadedDrivers))
75731>>>>>        If (iMSSQLIndex>0) Begin
75733>>>>>            Get_Attribute DF_DRIVER_SQLSERVER_CLIENT_VERSION of iMSSQLIndex to iClientVersion
75736>>>>>            Get Create (RefClass(cMSSQLHandler)) to hoMsqlDrv
75737>>>>>            Get SqlServerClientVersionName of hoMsqlDrv iClientVersion to sClientDriver
75738>>>>>            Send Destroy of hoMsqlDrv
75739>>>>>            Send AppendTextLn (SFormat("MSSQLDRV Client Version: %1", sClientDriver))
75740>>>>>        End
75740>>>>>>
75740>>>>>    End_Procedure
