75162>>>>>>>// Purpose: An instance of this class can be used as a broker object to
75162>>>>>>>//          call several Dfbtrdrv releated methods.
75162>>>>>>>
75162>>>>>>>Class cDFBtrDrvHandler is an Array
75163>>>>>>>    
75163>>>>>>>    Procedure Construct_Object Integer iImage
75165>>>>>>>        Forward Send Construct_object iImage
75167>>>>>>>        
75167>>>>>>>        Property String  psDriverID "DFBTRDRV"
75168>>>>>>>    End_Procedure
75169>>>>>>>    
75169>>>>>>>    //  The revsion of a Dfbtrdrv Connectivity Kit
75169>>>>>>>    //
75169>>>>>>>    
75169>>>>>>>    Function CKRevision Returns String
75171>>>>>>>        String  sDriverID
75171>>>>>>>        String  sRevision
75171>>>>>>>        String  sVoid
75171>>>>>>>        Integer iRetval
75171>>>>>>>        
75171>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75171>>>>>>>        // This error would otherwise be raised when we have an older
75171>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75171>>>>>>>        Send Ignore_error to Error_object_Id 20491
75172>>>>>>>        Get psDriverID to sDriverID
75173>>>>>>>        Move (Repeat(" ", 255)) to sRevision
75174>>>>>>>        Call_Driver 0 sDRiverID Function DFBTRFN_CKREVISION Callback 0 Passing sRevision sVoid 0 Result iRetval
75179>>>>>>>        Send Trap_Error to Error_object_Id 20491
75180>>>>>>>        If (Trim(sRevision) = "") Begin
75182>>>>>>>            // Unable to get the revision. return all zeroes.
75182>>>>>>>            Move "0.0.0.0" to sRevision
75183>>>>>>>        End
75183>>>>>>>>
75183>>>>>>>        Function_Return sRevision
75184>>>>>>>    End_Function
75185>>>>>>>    
75185>>>>>>>    Function CkUsesUri Returns Integer
75187>>>>>>>        String  sDriverID
75187>>>>>>>        String  sVoid1
75187>>>>>>>        String  sVoid2
75187>>>>>>>        Integer iRetval
75187>>>>>>>        
75187>>>>>>>        Get psDriverID to sDriverID
75188>>>>>>>        
75188>>>>>>>        Move 0 to iRetval
75189>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75189>>>>>>>        // This error would otherwise be raised when we have an older
75189>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKUSESURI function
75189>>>>>>>        Send Ignore_error to Error_object_Id 20491
75190>>>>>>>        Call_Driver 0 sDRiverID Function DFBTRFN_CKUSESURI Callback 0 Passing sVoid1 sVoid2 0 Result iRetval
75195>>>>>>>        Send Trap_Error to Error_object_Id 20491
75196>>>>>>>        
75196>>>>>>>        Function_Return iRetval
75197>>>>>>>    End_Function
75198>>>>>>>    
75198>>>>>>>    
75198>>>>>>>    
75198>>>>>>>    // Extract the Nth part of a a.b.c.d revsion string.
75198>>>>>>>    //
75198>>>>>>>    // Returns : The part version number or -1 if there is no such part number.
75198>>>>>>>    //
75198>>>>>>>    
75198>>>>>>>    Function ExtractPartFromRevision Integer iPartNum String sRevision Returns Integer
75200>>>>>>>        Integer iPartRev
75200>>>>>>>        Integer iCurrentPart
75200>>>>>>>        Integer iSeparatorPos
75200>>>>>>>        
75200>>>>>>>        If (iPartNum > 4) ;            Function_Return -1
75203>>>>>>>        
75203>>>>>>>        Move 0 to iCurrentPart
75204>>>>>>>        Repeat
75204>>>>>>>>
75204>>>>>>>            Move (Pos(".", sRevision)) to iSeparatorPos
75205>>>>>>>            If (iSeparatorPos > 0) Begin
75207>>>>>>>                Move (Left(sRevision, iSeparatorPos - 1)) to iPartRev
75208>>>>>>>                Move (Right(sRevision, Length(sRevision) - iSeparatorPos)) to sRevision
75209>>>>>>>                Increment iCurrentPart
75210>>>>>>>            End
75210>>>>>>>>
75210>>>>>>>            Else If (sRevision <> "") Begin
75213>>>>>>>                Move sRevision to iPartRev
75214>>>>>>>                Move "" to sRevision
75215>>>>>>>                Increment iCurrentPart
75216>>>>>>>            End
75216>>>>>>>>
75216>>>>>>>            Else ;                Move -1 to iPartRev
75218>>>>>>>        Until (iCurrentPart >= iPartNum or iPartRev = -1)
75220>>>>>>>        
75220>>>>>>>        Function_Return iPartRev
75221>>>>>>>    End_Function
75222>>>>>>>    
75222>>>>>>>    
75222>>>>>>>    
75222>>>>>>>    //
75222>>>>>>>    //  Returns the major revision of the CK
75222>>>>>>>    //
75222>>>>>>>    
75222>>>>>>>    Function CKMajorRevision Returns Integer
75224>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 1, CKRevision(Current_Object)))
75225>>>>>>>    End_Function
75226>>>>>>>    
75226>>>>>>>    
75226>>>>>>>    
75226>>>>>>>    //  Returns the minor revision of the CK
75226>>>>>>>    //
75226>>>>>>>    
75226>>>>>>>    Function CKMinorRevision Returns Integer
75228>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 2, CKRevision(Current_Object)))
75229>>>>>>>    End_Function
75230>>>>>>>    
75230>>>>>>>    
75230>>>>>>>    //  Returns the release revision of the CK
75230>>>>>>>    //
75230>>>>>>>    
75230>>>>>>>    Function CKReleaseRevision Returns Integer
75232>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 3, CKRevision(Current_Object)))
75233>>>>>>>    End_Function
75234>>>>>>>    
75234>>>>>>>    
75234>>>>>>>    //  Returns the major revision of the CK
75234>>>>>>>    //
75234>>>>>>>    
75234>>>>>>>    Function CKBuildRevision Returns Integer
75236>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 4, CKRevision(Current_Object)))
75237>>>>>>>    End_Function
75238>>>>>>>    
75238>>>>>>>    
75238>>>>>>>    //  Determines if the CK conforms to a passed minimal revsion.
75238>>>>>>>    //
75238>>>>>>>    
75238>>>>>>>    Function IsMinimalRevision Integer iMajor Integer iMinor Integer iRelease Integer iBuild Returns Integer
75240>>>>>>>        If (iMajor < CKMajorRevision(Current_object)) ;            Function_Return (True)
75243>>>>>>>        Else If (iMajor = CKMajorRevision(Current_object)) Begin
75246>>>>>>>            If (iMinor < CKMinorRevision(Current_object)) ;                Function_Return (True)
75249>>>>>>>            Else If (iMinor = CKMinorRevision(Current_object)) Begin
75252>>>>>>>                If (iRelease < CKReleaseRevision(Current_object)) ;                    Function_Return (True)
75255>>>>>>>                Else If (iRelease = CKReleaseRevision(Current_object) and iBuild <= CKBuildRevision(Current_object)) ;                    Function_Return (True)
75259>>>>>>>            End
75259>>>>>>>>
75259>>>>>>>        End
75259>>>>>>>>
75259>>>>>>>        
75259>>>>>>>        Function_Return (False)
75260>>>>>>>    End_Function
75261>>>>>>>    
75261>>>>>>>    //   Functions to query the Pervasive.SQL version:
75261>>>>>>>    //       PSQLRequesterVersionInfo    Integer iFileNum Returns String
75261>>>>>>>    //       PSQLLocalEngineVersionInfo  Integer iFileNum Returns String
75261>>>>>>>    //       PSQLServerEngineVersionInfo Integer iFileNum Returns String
75261>>>>>>>    //
75261>>>>>>>    //   All 3 functions return the version of a Pervasive.SQL component
75261>>>>>>>    //   in the following format:
75261>>>>>>>    //       <version>.<revision>.<type>
75261>>>>>>>    //   possible values for <type>:
75261>>>>>>>    //       9 for 32-bit Windows workstation/workgroup engine or Linux
75261>>>>>>>    //         server using Workgroup authentication mode
75261>>>>>>>    //       C for client cache engine
75261>>>>>>>    //       D for DOS workstation
75261>>>>>>>    //       N for client Requester
75261>>>>>>>    //       S for NetWare server
75261>>>>>>>    //       T for 32-bit Windows server engine
75261>>>>>>>    //       U for Linux server using PAM or BTPASSWD authentication
75261>>>>>>>    //
75261>>>>>>>    //   example:
75261>>>>>>>    //       8.50.T
75261>>>>>>>    //   will be returned for a Pervasive.SQL 8.5 Server Engine running on
75261>>>>>>>    //   32-bits Windows server.
75261>>>>>>>    //
75261>>>>>>>    //   The FileNumber parameter must specify an opened table or 0.
75261>>>>>>>    //   For PSQLServerEngineVersionInfo the FileNumber can not be 0.
75261>>>>>>>    //
75261>>>>>>>    //   If the version information is not available or can not be obtained
75261>>>>>>>    //   the functions will return "0.0.0"
75261>>>>>>>    
75261>>>>>>>    //  Returns the version information of the
75261>>>>>>>    //           Pervasive.SQL Client requester.
75261>>>>>>>    
75261>>>>>>>    Function PSQLRequesterVersionInfo Integer iFileNum Returns String
75263>>>>>>>        
75263>>>>>>>        String  sDriverID
75263>>>>>>>        String  sVersion
75263>>>>>>>        String  sVoid
75263>>>>>>>        Integer iRetval
75263>>>>>>>        
75263>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75263>>>>>>>        // This error would otherwise be raised when we have an older
75263>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75263>>>>>>>        Send Ignore_error to Error_object_Id 20491
75264>>>>>>>        Get psDriverID to sDriverID
75265>>>>>>>        Move (Repeat(" ", 255)) to sVersion
75266>>>>>>>        Call_Driver iFileNum sDRiverID Function DFBTRFN_PSQLREQUESTERVERSIONINFO Callback 0 Passing sVersion sVoid 0 Result iRetval
75271>>>>>>>        Send Trap_Error to Error_object_Id 20491
75272>>>>>>>        If (Trim(sVersion) = "") Begin
75274>>>>>>>            // Unable to get the revision. return all zeroes.
75274>>>>>>>            Move "0.0.0" to sVersion
75275>>>>>>>        End
75275>>>>>>>>
75275>>>>>>>        Function_Return sVersion
75276>>>>>>>    End_Function
75277>>>>>>>    
