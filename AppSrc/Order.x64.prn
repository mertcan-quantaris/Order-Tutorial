75224>>>>>>>        // This error would otherwise be raised when we have an older
75224>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75224>>>>>>>        Send Ignore_error to Error_object_Id 20491
75225>>>>>>>        Get psDriverID to sDriverID
75226>>>>>>>        Move (Repeat(" ", 255)) to sVersion
75227>>>>>>>        Call_Driver iFileNum sDRiverID Function DFBTRFN_PSQLLOCALENGINEVERSIONINFO Callback 0 Passing sVersion sVoid 0 Result iRetval
75232>>>>>>>        Send Trap_Error to Error_object_Id 20491
75233>>>>>>>        If (Trim(sVersion) = "") Begin
75235>>>>>>>            // Unable to get the revision. return all zeroes.
75235>>>>>>>            Move "0.0.0" to sVersion
75236>>>>>>>        End
75236>>>>>>>>
75236>>>>>>>        Function_Return sVersion
75237>>>>>>>    End_Function
75238>>>>>>>    
