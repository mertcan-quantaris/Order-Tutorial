75954>>>//  This is the default message. It is expected that you will
75954>>>//  create your own message to override this
75954>>>Procedure Activate_About
75957>>>    Send DoAbout "" "" "" "" ""
75958>>>End_Procedure
75959>>>
75959>>>//  It is expected that you will send this message (most
75959>>>//  likely from Activate_About. This creates an about object, activates it
75959>>>//  and destroys it when done. It is not exepected that you will augment this.
75959>>>Procedure DoAbout String sTitle String sVersion String sCopyRight String sAuthor String sBitmap
75962>>>    Integer hoObj hoMain
75962>>>    
75962>>>    // create object
75962>>>    Object About is an AboutDialog
75964>>>        // if no title passed use the label of the main panel
75964>>>        // (if a main panel exists).
75964>>>        If (sTitle = "") Begin
75966>>>            Get Main_Window of desktop to hoMain
75967>>>            If hoMain ;                Get Label of hoMain to sTitle
75970>>>        End
75970>>>>
75970>>>        Set productname to sTitle
75971>>>        Set version     to sVersion
75972>>>        Set copyright   to sCopyRight
75973>>>        Set author      to sAuthor
75974>>>        If (sBitmap <> '') ;            Set logo to sBitMap // square bitmaps of 42x42 work best
75977>>>        Move Self to hoObj // object Id
75978>>>    End_Object
75979>>>    Send Popup   of hoObj    // popup the about object
75980>>>    Send Destroy of hoObj // when done, it will be destroyed
75981>>>End_Procedure
