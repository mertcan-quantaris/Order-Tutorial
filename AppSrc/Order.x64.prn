79497>>>        Procedure Page_Header 
79500>>>            integer iFill iBorder iStyle
79500>>>            string  sFont sReportTitle
79500>>>            integer iFontSize
79500>>>
79500>>>            Move "arial" to sFont
79501>>>            Move 16 to iFontSize
79502>>>            Move (Font_bold + rgb_White) to iStyle
79503>>>            Move (rgb_dGrey) to iFill
79504>>>            Move (rgb_dGrey) to iBorder
79505>>>            Get Report_Title to sReportTitle
79506>>>
79506>>>            DFFont sFont
79507>>>            DFFontSize iFontSize
79508>>>            DFBeginHeader DFPageHeader
79509>>>                DFHeaderPos   Hdr_Left
79510>>>                DFHeaderFrame Hdr_Margins 0.01 iBorder iFill
79511>>>                DFWritelnPos sReportTitle 0.1 iStyle
79512>>>                DFHeaderMargin HM_BottomOuter 0.08
79513>>>            DFEndHeader
