77897>>>    //-----------------------------------------------------------------------
77897>>>    // Create custom confirmation messages for save and delete
77897>>>    // We must create the new functions and assign verify messages
77897>>>    // to them.
77897>>>    //-----------------------------------------------------------------------
77897>>>
77897>>>    Function ConfirmDeleteHeader Returns Boolean
77900>>>        Boolean bFail
77900>>>        Get Confirm C_$DeleteEntireHeaderAndAllDetail to bFail
77901>>>        Function_Return bFail
77902>>>    End_Function 
77903>>>
77903>>>    // Only confirm on the saving of new records
77903>>>    Function ConfirmSaveHeader Returns Boolean
77906>>>        Boolean bNoSave bHasRecord
77906>>>        Handle  hoSrvr
77906>>>        Get Server to hoSrvr
77907>>>        Get HasRecord of hoSrvr to bHasRecord
77908>>>        If not bHasRecord Begin
77910>>>            Get Confirm C_$SaveThisNewHeader to bNoSave
77911>>>        End
77911>>>>
77911>>>        Function_Return bNoSave
77912>>>    End_Function 
77913>>>
77913>>>    // Define alternate confirmation Messages
77913>>>    Set Verify_Save_MSG       to (RefFunc(ConfirmSaveHeader))
77914>>>    Set Verify_Delete_MSG     to (RefFunc(ConfirmDeleteHeader))
77915>>>    // Saves in header should not clear the view
77915>>>    Set Auto_Clear_Deo_State to False
77916>>>
