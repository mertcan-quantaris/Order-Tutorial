75282>>>>>>>        Call_Driver iFileNum sDRiverID Function DFBTRFN_PSQLLOCALENGINEVERSIONINFO Callback 0 Passing sVersion sVoid 0 Result iRetval
75287>>>>>>>        Send Trap_Error to Error_object_Id 20491
75288>>>>>>>        If (Trim(sVersion) = "") Begin
75290>>>>>>>            // Unable to get the revision. return all zeroes.
75290>>>>>>>            Move "0.0.0" to sVersion
75291>>>>>>>        End
75291>>>>>>>>
75291>>>>>>>        Function_Return sVersion
75292>>>>>>>    End_Function
