75332>>>>>>>    Function EnumerateServersNetworkOrLocal Integer iNetworkLocal  Returns Integer
75334>>>>>>>        
75334>>>>>>>        String  sServerList
75334>>>>>>>        Integer iNumServers
75334>>>>>>>        Integer iDriver
75334>>>>>>>        Integer iClientVersion
75334>>>>>>>        String  sDriver
75334>>>>>>>        
75334>>>>>>>        Get DriverIndex MSSQLDRV_ID to iDriver
75335>>>>>>>        
75335>>>>>>>        If (iDriver) Begin
75337>>>>>>>            
75337>>>>>>>            Get_Attribute DF_DRIVER_SQLSERVER_CLIENT_VERSION of iDriver to iClientVersion
75340>>>>>>>            
75340>>>>>>>            Get SqlServerClientDriverName iClientVersion to sDriver
75341>>>>>>>            
75341>>>>>>>            Move ("DRIVER={" + sDriver + "};") to sDriver
75342>>>>>>>            If (iNetworkLocal = 0) Begin
75344>>>>>>>                Get BrowseConnect sDriver to sServerList
75345>>>>>>>            End
75345>>>>>>>>
75345>>>>>>>            Else Begin
75346>>>>>>>                Get BrowseConnectLocal sDriver to sServerList
75347>>>>>>>            End
75347>>>>>>>>
75347>>>>>>>            Get ExtractList sServerList Current_object to iNumServers
75348>>>>>>>        End
75348>>>>>>>>
75348>>>>>>>        
75348>>>>>>>        Function_Return iNumServers
75349>>>>>>>        
75349>>>>>>>    End_Function
75350>>>>>>>    
75350>>>>>>>    //   Enumerate the available SQL Server database servers
75350>>>>>>>    //   This function will return all SQL Server instances on the network.
75350>>>>>>>    //   This may take a long time.
75350>>>>>>>    //   To enumerate only local SQL Server instances use EnumerateServersLocal
75350>>>>>>>    Function EnumerateServers Returns Integer
75352>>>>>>>        
75352>>>>>>>        Integer iNumServers
75352>>>>>>>        Integer iNetworkLocal
75352>>>>>>>        
75352>>>>>>>        Move 0 to iNetworkLocal // 0 = enumerate network servers
75353>>>>>>>        
75353>>>>>>>        Get EnumerateServersNetworkOrLocal iNetworkLocal to iNumServers
75354>>>>>>>        
75354>>>>>>>        Function_Return iNumServers
75355>>>>>>>        
75355>>>>>>>    End_Function
75356>>>>>>>    
75356>>>>>>>    
75356>>>>>>>    //   Enumerate the available SQL Server database servers
