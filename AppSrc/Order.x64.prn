75290>>>>>>>        // This error would otherwise be raised when we have an older
75290>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75290>>>>>>>        Send Ignore_error to Error_object_Id 20491
75291>>>>>>>        Get psDriverID to sDriverID
75292>>>>>>>        Move (Repeat(" ", 255)) to sVersion
75293>>>>>>>        Call_Driver iFileNum sDRiverID Function DFBTRFN_PSQLLOCALENGINEVERSIONINFO Callback 0 Passing sVersion sVoid 0 Result iRetval
75298>>>>>>>        Send Trap_Error to Error_object_Id 20491
75299>>>>>>>        If (Trim(sVersion) = "") Begin
75301>>>>>>>            // Unable to get the revision. return all zeroes.
75301>>>>>>>            Move "0.0.0" to sVersion
75302>>>>>>>        End
75302>>>>>>>>
75302>>>>>>>        Function_Return sVersion
75303>>>>>>>    End_Function
75304>>>>>>>    
