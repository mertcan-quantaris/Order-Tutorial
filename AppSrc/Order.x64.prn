75695>>>>>    // If workspaces are used, we will send the message EnumerateWorkspaceData
75695>>>>>    // To the workspace object passing the an object and message To send back
75695>>>>>    // To this object. It is expected that the workspace object will send this
75695>>>>>    // message for every line Of information it wants displayed (passing the
75695>>>>>    // information To be displayed
75695>>>>>    Register_Procedure EnumerateWorkspaceData Handle hObjId Handle hmMessId
75695>>>>>    
75695>>>>>    Procedure Show_ServicePack
75697>>>>>        String sKey sVersionDescription sVersion
75697>>>>>        Handle hoRegistry
75697>>>>>        Boolean bExists bOpened
75697>>>>>        
75697>>>>>        Get Create (RefClass (cRegistry)) to hoRegistry
75698>>>>>        Set phRootKey of hoRegistry to HKEY_LOCAL_MACHINE
75699>>>>>        Set pfAccessRights of hoRegistry to KEY_READ
75700>>>>>        
75700>>>>>        Move C_DFVersionRegistryRoot to sKey
75701>>>>>        Get KeyExists of hoRegistry sKey to bExists
75702>>>>>        If (bExists) Begin
75704>>>>>            Get OpenKey of hoRegistry sKey to bOpened
75705>>>>>            If (bOpened) Begin
75707>>>>>                Get ValueExists of hoRegistry "CurrentVersionDescription" to bExists
75708>>>>>                If (bExists) Begin
75710>>>>>                    Get ReadString of hoRegistry "CurrentVersionDescription" to sVersionDescription
75711>>>>>                End
75711>>>>>>
75711>>>>>                
75711>>>>>                Get ValueExists of hoRegistry "CurrentVersion" to bExists
75712>>>>>                If (bExists) Begin
75714>>>>>                    Get ReadString of hoRegistry "CurrentVersion" to sVersion
75715>>>>>                End
75715>>>>>>
75715>>>>>                Send CloseKey of hoRegistry
75716>>>>>            End
75716>>>>>>
75716>>>>>        End
75716>>>>>>
75716>>>>>        Send Destroy of hoRegistry
75717>>>>>        
75717>>>>>        If (sVersionDescription <> "") Begin
75719>>>>>            Send AppendTextLn (sVersionDescription * "-" * sVersion)
75720>>>>>            Send AppendTextLn ""
75721>>>>>        End
75721>>>>>>
75721>>>>>    End_Procedure
75722>>>>>    
75722>>>>>    
75722>>>>>    Procedure Show_WorkspaceInformation
75724>>>>>        Integer hoWorkspace
75724>>>>>        
75724>>>>>        If (ghoApplication <> 0) Begin
75726>>>>>            Get phoWorkspace of ghoApplication to hoWorkspace
75727>>>>>            If (hoWorkspace <> 0) Begin
75729>>>>>                Send EnumerateWorkspaceData of hoWorkspace Self (Refproc (AppendTextLn))
75730>>>>>                Send AppendTextLn ""
75731>>>>>            End
75731>>>>>>
75731>>>>>        End
75731>>>>>>
75731>>>>>    End_Procedure
75732>>>>>    
75732>>>>>    // If connection ids are used, we will send the message EnumerateConnections
75732>>>>>    // to the connection manager object passing the an object and message to send
