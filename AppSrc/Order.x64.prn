77448>>>>>    // Add a default date if the field is blank
77448>>>>>    Procedure Entry_Order_Date Integer iField Date dDate
77450>>>>>        Integer iChanged
77450>>>>>        
77450>>>>>        Get Field_Changed_State iField to iChanged
77451>>>>>        If (iChanged=0 and dDate=0) Begin
77453>>>>>            Sysdate dDate
77454>>>>>            Set Field_Default_Value iField to dDate
77455>>>>>        End
77455>>>>>>
77455>>>>>    End_Procedure
77456>>>>>    
77456>>>>>    Procedure Update
77458>>>>>        Forward Send Update
77460>>>>>        Send Adjust_Balances OrderHeader.Order_Total
77461>>>>>    End_Procedure
77462>>>>>    
77462>>>>>    Procedure Backout
77464>>>>>        Forward Send Backout
77466>>>>>        Send Adjust_Balances (-OrderHeader.Order_Total)
77467>>>>>    End_Procedure
77468>>>>>    
77468>>>>>    Procedure Adjust_Balances Number Amt
77470>>>>>        
77470>>>>>        If (((Amt + Customer.Purchases) < 999999) and ((Amt + Customer.Balance) < 999999)) Begin
77472>>>>>            Add Amt to Customer.Purchases
77473>>>>>            Add Amt to Customer.Balance
77474>>>>>        End
77474>>>>>>
77474>>>>>        Else Begin
77475>>>>>            Send UserError ("The value of" * FormatCurrency(Amt + Customer.Purchases, 2) * "exceeds the maximum amount allowed for customer purchases." * ;                 "Review your order to adjust prices and quantities to be within the limit of" * FormatCurrency(999999, 2)) "Error in updating Customer"
77476>>>>>        End
77476>>>>>>
77476>>>>>    End_Procedure
77477>>>>>    
77477>>>>>    Procedure Deleting
77479>>>>>        Forward Send Deleting
77481>>>>>        // see if we can decrement the order number in sys table...
77481>>>>>        // can only do this if this is the newest order.
77481>>>>>        If (OrderHeader.Order_Number=DFLastID.Order_Number) Begin // if this is
77483>>>>>            Decrement DFLastID.Order_Number          // the last number,
77484>>>>>            SaveRecord DFLastID                      // decrement and save.
77485>>>>>        End
77485>>>>>>
77485>>>>>    End_Procedure
