77103>>>>>>>>>Class cFormatter is an cObject
77104>>>>>>>>>    
77104>>>>>>>>>    Procedure Construct_object
77106>>>>>>>>>        Integer iCh
77106>>>>>>>>>        Forward Send construct_object
77108>>>>>>>>>        Property String  psCurrencySymbol
77109>>>>>>>>>        Set psCurrencySymbol to (Default_Currency_Symbol())
77110>>>>>>>>>        
77110>>>>>>>>>        Property String  psLeft
77111>>>>>>>>>        Property String  psright
77112>>>>>>>>>        Property Integer pbThousandsSep
77113>>>>>>>>>        Property Integer piPoints
77114>>>>>>>>>        
77114>>>>>>>>>        Property String  psCurPosLeft
77115>>>>>>>>>        Property String  psCurPosright
77116>>>>>>>>>        Property Integer pbCurPosThousandsSep
77117>>>>>>>>>        Property Integer piCurPosPoints
77118>>>>>>>>>        
77118>>>>>>>>>        Property String  psCurNegLeft
77119>>>>>>>>>        Property String  psCurNegright
77120>>>>>>>>>        Property Integer pbCurNegThousandsSep
77121>>>>>>>>>        Property Integer piCurNegPoints
77122>>>>>>>>>        
77122>>>>>>>>>        Property String  psNumPosLeft
77123>>>>>>>>>        Property String  psNumPosright
77124>>>>>>>>>        Property Integer pbNumPosThousandsSep
77125>>>>>>>>>        Property Integer piNumPosPoints
77126>>>>>>>>>        
77126>>>>>>>>>        Property String  psNumNegLeft
77127>>>>>>>>>        Property String  psNumNegright
77128>>>>>>>>>        Property Integer pbNumNegThousandsSep
77129>>>>>>>>>        Property Integer piNumNegPoints
77130>>>>>>>>>        
77130>>>>>>>>>        Send SetFormat "$,#.##;($,#.##)" True  // currency
77131>>>>>>>>>        Send SetFormat  ",#.*"           False // numeric
77132>>>>>>>>>        
77132>>>>>>>>>    End_Procedure
77133>>>>>>>>>    
77133>>>>>>>>>    // internal
77133>>>>>>>>>    // parse passed format string and set temporary properties with result
77133>>>>>>>>>    Procedure ParseFormat String sFmt
77135>>>>>>>>>        
77135>>>>>>>>>        String sLeft sRight sDigit
77135>>>>>>>>>        Integer bSep iPos i iDigits
77135>>>>>>>>>        
77135>>>>>>>>>        // replace any literals. A "/" followed by anything.
77135>>>>>>>>>        // some literals are special. $ . , / #
77135>>>>>>>>>        Move (Replaces("/$",sFmt,Character(1)))    to sFmt
77136>>>>>>>>>        Move (Replaces("/.",sFmt,Character(2)))    to sFmt
77137>>>>>>>>>        Move (Replaces("/,",sFmt,Character(3)))    to sFmt
77138>>>>>>>>>        Move (Replaces("/"+"/",sFmt,Character(4))) to sFmt
77139>>>>>>>>>        Move (Replaces("/#",sFmt,Character(5)))    to sFmt
77140>>>>>>>>>        Move (Character(9)) to sDigit
77141>>>>>>>>>        Move (Replaces("#",sFmt,sDigit))           to sFmt
77142>>>>>>>>>        Move (Replaces("/",sFmt,""))               to sFmt // replace all others
77143>>>>>>>>>        
77143>>>>>>>>>        Move (Pos(",",sFmt))                 to bSep // if we have any , we use thousand seps
77144>>>>>>>>>        If bSep ;            Move (Replaces(",",sFmt,"")) to sFmt // remove all ,
77147>>>>>>>>>        
77147>>>>>>>>>        Move (Replaces("$",sFmt,psCurrencySymbol(Self))) to sFmt // replace any $ with currency symbol
77148>>>>>>>>>        
77148>>>>>>>>>        Move (Pos(".",sFmt)) to iPos                 // position of decimal
77149>>>>>>>>>        
77149>>>>>>>>>        // Move all the special literals back into place before parsing
77149>>>>>>>>>        Move (Replaces(Character(1),sFmt,"$")) to sFmt
77150>>>>>>>>>        Move (Replaces(Character(2),sFmt,".")) to sFmt
77151>>>>>>>>>        Move (Replaces(Character(3),sFmt,",")) to sFmt
77152>>>>>>>>>        Move (Replaces(Character(4),sFmt,"/")) to sFmt
77153>>>>>>>>>        Move (Replaces(Character(5),sFmt,"#")) to sFmt
77154>>>>>>>>>        
77154>>>>>>>>>        If (iPos>0) Begin                      // if we have a decimanl point
77156>>>>>>>>>            Move 1 to i                        // look for first non # to right and count the #s
77157>>>>>>>>>            If (mid(sFmt,1,iPos+i)="*") Begin  // the "*" is special. It means as many as you want
77159>>>>>>>>>                Move -2 to iDigits
77160>>>>>>>>>                Increment i
77161>>>>>>>>>            End
77161>>>>>>>>>>
77161>>>>>>>>>            While (mid(sFmt,1,iPos+i)=sDigit)
77165>>>>>>>>>                Increment i
77166>>>>>>>>>            Loop
77167>>>>>>>>>>
77167>>>>>>>>>            Move (Mid(sFmt,255,iPos+i)) to sRight // everything to the right of the last # is format stuff
77168>>>>>>>>>            If (iDigits=0) ;                Move (i-1) to iDigits
77171>>>>>>>>>            //
77171>>>>>>>>>            Move 1 to i                           // find the first non-# to the left of the point
77172>>>>>>>>>            While (mid(sFmt,1,iPos-i)=sDigit)     // everything to the left is format stuff
77176>>>>>>>>>                Increment i
77177>>>>>>>>>            Loop
77178>>>>>>>>>>
77178>>>>>>>>>            Move (left(sFmt,iPos-i)) to sLeft
77179>>>>>>>>>        End
77179>>>>>>>>>>
77179>>>>>>>>>        Else Begin                             // we have no decinal
77180>>>>>>>>>            Move 0 to iDigits                  // so points is none
77181>>>>>>>>>            Move (Pos(sDigit,sFmt)) to iPos    // find first #.
77182>>>>>>>>>            If (iPos=0) Begin                  // if none, entire string is left format stuff..wierd!
77184>>>>>>>>>                Move sFmt to sLeft
77185>>>>>>>>>                Move ""   to sRight
77186>>>>>>>>>            End
77186>>>>>>>>>>
77186>>>>>>>>>            Else Begin
77187>>>>>>>>>                Move (left(sFmt,iPos-1)) to sLeft // all char to left of first # is left format stuff
77188>>>>>>>>>                Move 1 to i
77189>>>>>>>>>                While (mid(sFmt,1,iPos+i)=sDigit) // find last #, all char to right is right format
77193>>>>>>>>>                    Increment i
77194>>>>>>>>>                Loop
77195>>>>>>>>>>
77195>>>>>>>>>                Move (Mid(sFmt,255,i+iPos)) to sRight
77196>>>>>>>>>            End
77196>>>>>>>>>>
77196>>>>>>>>>        End
77196>>>>>>>>>>
77196>>>>>>>>>        // set temporary format properties and exit
77196>>>>>>>>>        Set pbThousandsSep to bSep
77197>>>>>>>>>        Set psLeft         to sLeft
77198>>>>>>>>>        Set psRight        to sRight
77199>>>>>>>>>        Set piPoints       to iDigits
77200>>>>>>>>>    End_Procedure
77201>>>>>>>>>    
77201>>>>>>>>>    // Public: Sets a format string. Pass full format for Positve and negative in sFmt. Pass
77201>>>>>>>>>    //         bCurrency true is this is a currency format, false if a numeric format
77201>>>>>>>>>    //
77201>>>>>>>>>    //  e.g. Send SetFormat "$,#.##;($,#.##)" True
77201>>>>>>>>>    Procedure SetFormat String sFmt Integer bCurrency
77203>>>>>>>>>        String sPos sNeg
77203>>>>>>>>>        Integer iPos
77203>>>>>>>>>        
77203>>>>>>>>>        Move (Pos(";",sFmt)) to iPos
77204>>>>>>>>>        If iPos Begin
77206>>>>>>>>>            Move (left(sFmt,iPos-1))    to sPos
77207>>>>>>>>>            Move (mid(sFmt,255,iPos+1)) to sNeg
77208>>>>>>>>>        End
77208>>>>>>>>>>
77208>>>>>>>>>        Else Begin
77209>>>>>>>>>            Move sFmt         to sPos
77210>>>>>>>>>            Move ("-" + sFmt) to sNeg
77211>>>>>>>>>        End
77211>>>>>>>>>>
77211>>>>>>>>>        Send ParseFormat sPos
77212>>>>>>>>>        If bCurrency Begin
77214>>>>>>>>>            Set pbCurPosThousandsSep to (pbThousandsSep(Self))
77215>>>>>>>>>            Set psCurPosLeft         to (psLeft(Self))
77216>>>>>>>>>            Set psCurPosRight        to (psRight(Self))
77217>>>>>>>>>            Set piCurPosPoints       to (piPoints(Self))
77218>>>>>>>>>        End
77218>>>>>>>>>>
77218>>>>>>>>>        Else Begin
77219>>>>>>>>>            Set pbNumPosThousandsSep to (pbThousandsSep(Self))
77220>>>>>>>>>            Set psNumPosLeft         to (psLeft(Self))
77221>>>>>>>>>            Set psNumPosRight        to (psRight(Self))
77222>>>>>>>>>            Set piNumPosPoints       to (piPoints(Self))
77223>>>>>>>>>        End
77223>>>>>>>>>>
77223>>>>>>>>>        
77223>>>>>>>>>        Send ParseFormat sNeg
77224>>>>>>>>>        If bCurrency Begin
77226>>>>>>>>>            Set pbCurNegThousandsSep to (pbThousandsSep(Self))
77227>>>>>>>>>            Set psCurNegLeft         to (psLeft(Self))
77228>>>>>>>>>            Set psCurNegRight        to (psRight(Self))
77229>>>>>>>>>            Set piCurNegPoints       to (piPoints(Self))
77230>>>>>>>>>        End
77230>>>>>>>>>>
77230>>>>>>>>>        Else Begin
77231>>>>>>>>>            Set pbNumNegThousandsSep to (pbThousandsSep(Self))
77232>>>>>>>>>            Set psNumNegLeft         to (psLeft(Self))
77233>>>>>>>>>            Set psNumNegRight        to (psRight(Self))
77234>>>>>>>>>            Set piNumNegPoints       to (piPoints(Self))
77235>>>>>>>>>        End
77235>>>>>>>>>>
77235>>>>>>>>>    End_Procedure
77236>>>>>>>>>    
77236>>>>>>>>>    // low level formatting. Pass parameters
77236>>>>>>>>>    Function Format_Num Number nNumber Integer iPoints Integer bSep ;            String sPrefix String sSuffix Returns String
77238>>>>>>>>>        String  sLeft sRight sNumber sSep sDec
77238>>>>>>>>>        Integer iDec iLen iCh
77238>>>>>>>>>        
77238>>>>>>>>>        Get_Attribute DF_DECIMAL_SEPARATOR to iCh
77241>>>>>>>>>        Move (Character(iCh)) to sDec
77242>>>>>>>>>        
77242>>>>>>>>>        Move (abs(nNumber)) to sNumber
77243>>>>>>>>>        Move (Pos(sDec,sNumber)) to iDec
77244>>>>>>>>>        Move (If(iDec=0, sNumber, left(sNumber,iDec-1))) to sLeft
77245>>>>>>>>>        Move (If(iDec=0, "", mid(sNumber,255,iDec+1)))   to sRight
77246>>>>>>>>>        // format for decimal separator
77246>>>>>>>>>        If (iPoints>=0) ; // if -2, leave it alone, it should not be -1            Move (left(sRight+Repeat("0",iPoints),iPoints)) to sRight
77249>>>>>>>>>        
77249>>>>>>>>>        // format for thousand sep.
77249>>>>>>>>>        If bSep Begin
77251>>>>>>>>>            Get_Attribute DF_THOUSANDS_SEPARATOR to iCh
77254>>>>>>>>>            Move (Character(iCh)) to sSep
77255>>>>>>>>>            Move (Length(sLeft)) to iLen
77256>>>>>>>>>            While (iLen>3)
77260>>>>>>>>>                Move (insert(sSep,sLeft,iLen-2)) to sLeft
77261>>>>>>>>>                Move (iLen-3) to iLen
77262>>>>>>>>>            Loop
77263>>>>>>>>>>
77263>>>>>>>>>        End
77263>>>>>>>>>>
77263>>>>>>>>>        // if decimal points or -2 (allow anything) and there are points to show
77263>>>>>>>>>        If (iPoints>0 or (iPoints=-2 and sRight<>"")) ;            Move (sLeft + sDec + sright) to sLeft
77266>>>>>>>>>        Function_Return (sPrefix + sLeft+ sSuffix)
77267>>>>>>>>>    End_Function
77268>>>>>>>>>    
77268>>>>>>>>>    // Public: Format for currency
77268>>>>>>>>>    Function FormatCur Number nNumber Integer iPoints Returns String
77270>>>>>>>>>        String  sLeft sRight
77270>>>>>>>>>        Integer bSep
77270>>>>>>>>>        If (nNumber<0) Begin
77272>>>>>>>>>            Get pbCurNegThousandsSep to bSep
77273>>>>>>>>>            Get psCurNegLeft         to sLeft
77274>>>>>>>>>            Get psCurNegRight        to sRight
77275>>>>>>>>>            If (iPoints=-1) ;                Get piCurNegPoints       to iPoints
77278>>>>>>>>>        End
77278>>>>>>>>>>
77278>>>>>>>>>        Else Begin
77279>>>>>>>>>            Get pbCurPosThousandsSep to bSep
77280>>>>>>>>>            Get psCurPosLeft         to sLeft
77281>>>>>>>>>            Get psCurPosRight        to sRight
77282>>>>>>>>>            If (iPoints=-1) ;                Get piCurPosPoints       to iPoints
77285>>>>>>>>>        End
77285>>>>>>>>>>
77285>>>>>>>>>        Function_Return (Format_Num(Self, nNumber,iPoints,bSep,sLeft,sRight))
77286>>>>>>>>>    End_Function
77287>>>>>>>>>    
77287>>>>>>>>>    // Public: Format for numeric
77287>>>>>>>>>    Function FormatNum Number nNumber Integer iPoints Returns String
77289>>>>>>>>>        String  sLeft sRight
77289>>>>>>>>>        Integer bSep
77289>>>>>>>>>        If (nNumber<0) Begin
77291>>>>>>>>>            Get pbNumNegThousandsSep to bSep
77292>>>>>>>>>            Get psNumNegLeft         to sLeft
77293>>>>>>>>>            Get psNumNegRight        to sRight
77294>>>>>>>>>            If (iPoints=-1) ;                Get piNumNegPoints       to iPoints
77297>>>>>>>>>        End
77297>>>>>>>>>>
77297>>>>>>>>>        Else Begin
77298>>>>>>>>>            Get pbNumPosThousandsSep to bSep
77299>>>>>>>>>            Get psNumPosLeft         to sLeft
77300>>>>>>>>>            Get psNumPosRight        to sRight
77301>>>>>>>>>            If (iPoints=-1) ;                Get piNumPosPoints       to iPoints
77304>>>>>>>>>        End
77304>>>>>>>>>>
77304>>>>>>>>>        Function_Return (Format_Num(Self, nNumber,iPoints,bSep,sLeft,sRight))
77305>>>>>>>>>    End_Function
77306>>>>>>>>>    
77306>>>>>>>>>    
77306>>>>>>>>>    // Public: Format passing format string
77306>>>>>>>>>    Function FormatVal Number nNumber String sFmt Returns String
77308>>>>>>>>>        Integer iPos bIsNeg
77308>>>>>>>>>        String  sLeft sRight
77308>>>>>>>>>        Integer iPoints bSep
77308>>>>>>>>>        Move (nNumber<0) to bIsNeg
77309>>>>>>>>>        Move (Pos(";",sFmt)) to iPos
77310>>>>>>>>>        Case Begin
77310>>>>>>>>>            Case (iPos and not(bIsNeg)) ;                Move (left(sFmt,iPos-1))    to sFmt
77313>>>>>>>>>            Case (iPos and bIsNeg) ;                Move (mid(sFmt,255,iPos+1)) to sFmt
77317>>>>>>>>>            Case (not(iPos) and not(bIsNeg)) ;                Move sFmt                   to sFmt
77321>>>>>>>>>            Case Else ;                Move ("-" + sFmt)           to sFmt
77323>>>>>>>>>        Case End
77323>>>>>>>>>        Send ParseFormat sFmt
77324>>>>>>>>>        Get pbThousandsSep to bSep
77325>>>>>>>>>        Get psLeft         to sLeft
77326>>>>>>>>>        Get psRight        to sRight
77327>>>>>>>>>        Get piPoints       to iPoints
77328>>>>>>>>>        Function_Return (Format_Num(Self, nNumber,iPoints,bSep,sLeft,sRight))
77329>>>>>>>>>    End_Function
77330>>>>>>>>>    
77330>>>>>>>>>End_Class
