75618>>>>>    // If workspaces are used, we will send the message EnumerateWorkspaceData
75618>>>>>    // To the workspace object passing the an object and message To send back
75618>>>>>    // To this object. It is expected that the workspace object will send this
75618>>>>>    // message for every line Of information it wants displayed (passing the
75618>>>>>    // information To be displayed
75618>>>>>    Register_Procedure EnumerateWorkspaceData Handle hObjId Handle hmMessId
75618>>>>>    
75618>>>>>    Procedure Show_ServicePack
75620>>>>>        String sKey sVersionDescription sVersion
75620>>>>>        Handle hoRegistry
75620>>>>>        Boolean bExists bOpened
75620>>>>>        
75620>>>>>        Get Create (RefClass (cRegistry)) to hoRegistry
75621>>>>>        Set phRootKey of hoRegistry to HKEY_LOCAL_MACHINE
75622>>>>>        Set pfAccessRights of hoRegistry to KEY_READ
75623>>>>>        
75623>>>>>        Move C_DFVersionRegistryRoot to sKey
75624>>>>>        Get KeyExists of hoRegistry sKey to bExists
75625>>>>>        If (bExists) Begin
75627>>>>>            Get OpenKey of hoRegistry sKey to bOpened
75628>>>>>            If (bOpened) Begin
75630>>>>>                Get ValueExists of hoRegistry "CurrentVersionDescription" to bExists
75631>>>>>                If (bExists) Begin
75633>>>>>                    Get ReadString of hoRegistry "CurrentVersionDescription" to sVersionDescription
75634>>>>>                End
75634>>>>>>
75634>>>>>                
75634>>>>>                Get ValueExists of hoRegistry "CurrentVersion" to bExists
75635>>>>>                If (bExists) Begin
75637>>>>>                    Get ReadString of hoRegistry "CurrentVersion" to sVersion
75638>>>>>                End
75638>>>>>>
75638>>>>>                Send CloseKey of hoRegistry
75639>>>>>            End
75639>>>>>>
75639>>>>>        End
75639>>>>>>
75639>>>>>        Send Destroy of hoRegistry
75640>>>>>        
75640>>>>>        If (sVersionDescription <> "") Begin
75642>>>>>            Send AppendTextLn (sVersionDescription * "-" * sVersion)
75643>>>>>            Send AppendTextLn ""
75644>>>>>        End
75644>>>>>>
75644>>>>>    End_Procedure
75645>>>>>    
75645>>>>>    
