75112>>>>>>>        Property String  psDriverID "DFBTRDRV"
75113>>>>>>>    End_Procedure
75114>>>>>>>    
75114>>>>>>>    //  The revsion of a Dfbtrdrv Connectivity Kit
75114>>>>>>>    //
75114>>>>>>>    
75114>>>>>>>    Function CKRevision Returns String
75116>>>>>>>        String  sDriverID
75116>>>>>>>        String  sRevision
75116>>>>>>>        String  sVoid
75116>>>>>>>        Integer iRetval
75116>>>>>>>        
75116>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75116>>>>>>>        // This error would otherwise be raised when we have an older
75116>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75116>>>>>>>        Send Ignore_error to Error_object_Id 20491
75117>>>>>>>        Get psDriverID to sDriverID
75118>>>>>>>        Move (Repeat(" ", 255)) to sRevision
75119>>>>>>>        Call_Driver 0 sDRiverID Function DFBTRFN_CKREVISION Callback 0 Passing sRevision sVoid 0 Result iRetval
75124>>>>>>>        Send Trap_Error to Error_object_Id 20491
75125>>>>>>>        If (Trim(sRevision) = "") Begin
75127>>>>>>>            // Unable to get the revision. return all zeroes.
75127>>>>>>>            Move "0.0.0.0" to sRevision
75128>>>>>>>        End
75128>>>>>>>>
75128>>>>>>>        Function_Return sRevision
75129>>>>>>>    End_Function
75130>>>>>>>    
75130>>>>>>>    Function CkUsesUri Returns Integer
75132>>>>>>>        String  sDriverID
75132>>>>>>>        String  sVoid1
75132>>>>>>>        String  sVoid2
75132>>>>>>>        Integer iRetval
75132>>>>>>>        
75132>>>>>>>        Get psDriverID to sDriverID
75133>>>>>>>        
75133>>>>>>>        Move 0 to iRetval
75134>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75134>>>>>>>        // This error would otherwise be raised when we have an older
75134>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKUSESURI function
75134>>>>>>>        Send Ignore_error to Error_object_Id 20491
75135>>>>>>>        Call_Driver 0 sDRiverID Function DFBTRFN_CKUSESURI Callback 0 Passing sVoid1 sVoid2 0 Result iRetval
75140>>>>>>>        Send Trap_Error to Error_object_Id 20491
75141>>>>>>>        
75141>>>>>>>        Function_Return iRetval
75142>>>>>>>    End_Function
75143>>>>>>>    
75143>>>>>>>    
75143>>>>>>>    
75143>>>>>>>    // Extract the Nth part of a a.b.c.d revsion string.
75143>>>>>>>    //
75143>>>>>>>    // Returns : The part version number or -1 if there is no such part number.
75143>>>>>>>    //
75143>>>>>>>    
75143>>>>>>>    Function ExtractPartFromRevision Integer iPartNum String sRevision Returns Integer
75145>>>>>>>        Integer iPartRev
75145>>>>>>>        Integer iCurrentPart
75145>>>>>>>        Integer iSeparatorPos
75145>>>>>>>        
75145>>>>>>>        If (iPartNum > 4) ;            Function_Return -1
75148>>>>>>>        
75148>>>>>>>        Move 0 to iCurrentPart
75149>>>>>>>        Repeat
75149>>>>>>>>
75149>>>>>>>            Move (Pos(".", sRevision)) to iSeparatorPos
75150>>>>>>>            If (iSeparatorPos > 0) Begin
75152>>>>>>>                Move (Left(sRevision, iSeparatorPos - 1)) to iPartRev
75153>>>>>>>                Move (Right(sRevision, Length(sRevision) - iSeparatorPos)) to sRevision
75154>>>>>>>                Increment iCurrentPart
75155>>>>>>>            End
75155>>>>>>>>
75155>>>>>>>            Else If (sRevision <> "") Begin
75158>>>>>>>                Move sRevision to iPartRev
75159>>>>>>>                Move "" to sRevision
75160>>>>>>>                Increment iCurrentPart
75161>>>>>>>            End
75161>>>>>>>>
75161>>>>>>>            Else ;                Move -1 to iPartRev
75163>>>>>>>        Until (iCurrentPart >= iPartNum or iPartRev = -1)
75165>>>>>>>        
75165>>>>>>>        Function_Return iPartRev
75166>>>>>>>    End_Function
75167>>>>>>>    
75167>>>>>>>    
75167>>>>>>>    
75167>>>>>>>    //
75167>>>>>>>    //  Returns the major revision of the CK
75167>>>>>>>    //
75167>>>>>>>    
75167>>>>>>>    Function CKMajorRevision Returns Integer
75169>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 1, CKRevision(Current_Object)))
75170>>>>>>>    End_Function
75171>>>>>>>    
75171>>>>>>>    
75171>>>>>>>    
75171>>>>>>>    //  Returns the minor revision of the CK
75171>>>>>>>    //
75171>>>>>>>    
75171>>>>>>>    Function CKMinorRevision Returns Integer
75173>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 2, CKRevision(Current_Object)))
75174>>>>>>>    End_Function
75175>>>>>>>    
75175>>>>>>>    
75175>>>>>>>    //  Returns the release revision of the CK
75175>>>>>>>    //
75175>>>>>>>    
75175>>>>>>>    Function CKReleaseRevision Returns Integer
75177>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 3, CKRevision(Current_Object)))
75178>>>>>>>    End_Function
75179>>>>>>>    
75179>>>>>>>    
75179>>>>>>>    //  Returns the major revision of the CK
75179>>>>>>>    //
75179>>>>>>>    
75179>>>>>>>    Function CKBuildRevision Returns Integer
75181>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 4, CKRevision(Current_Object)))
75182>>>>>>>    End_Function
75183>>>>>>>    
75183>>>>>>>    
75183>>>>>>>    //  Determines if the CK conforms to a passed minimal revsion.
75183>>>>>>>    //
75183>>>>>>>    
75183>>>>>>>    Function IsMinimalRevision Integer iMajor Integer iMinor Integer iRelease Integer iBuild Returns Integer
75185>>>>>>>        If (iMajor < CKMajorRevision(Current_object)) ;            Function_Return (True)
75188>>>>>>>        Else If (iMajor = CKMajorRevision(Current_object)) Begin
75191>>>>>>>            If (iMinor < CKMinorRevision(Current_object)) ;                Function_Return (True)
75194>>>>>>>            Else If (iMinor = CKMinorRevision(Current_object)) Begin
75197>>>>>>>                If (iRelease < CKReleaseRevision(Current_object)) ;                    Function_Return (True)
75200>>>>>>>                Else If (iRelease = CKReleaseRevision(Current_object) and iBuild <= CKBuildRevision(Current_object)) ;                    Function_Return (True)
75204>>>>>>>            End
75204>>>>>>>>
75204>>>>>>>        End
75204>>>>>>>>
75204>>>>>>>        
75204>>>>>>>        Function_Return (False)
75205>>>>>>>    End_Function
75206>>>>>>>    
75206>>>>>>>    //   Functions to query the Pervasive.SQL version:
75206>>>>>>>    //       PSQLRequesterVersionInfo    Integer iFileNum Returns String
75206>>>>>>>    //       PSQLLocalEngineVersionInfo  Integer iFileNum Returns String
75206>>>>>>>    //       PSQLServerEngineVersionInfo Integer iFileNum Returns String
75206>>>>>>>    //
75206>>>>>>>    //   All 3 functions return the version of a Pervasive.SQL component
75206>>>>>>>    //   in the following format:
75206>>>>>>>    //       <version>.<revision>.<type>
75206>>>>>>>    //   possible values for <type>:
75206>>>>>>>    //       9 for 32-bit Windows workstation/workgroup engine or Linux
75206>>>>>>>    //         server using Workgroup authentication mode
75206>>>>>>>    //       C for client cache engine
75206>>>>>>>    //       D for DOS workstation
75206>>>>>>>    //       N for client Requester
75206>>>>>>>    //       S for NetWare server
75206>>>>>>>    //       T for 32-bit Windows server engine
75206>>>>>>>    //       U for Linux server using PAM or BTPASSWD authentication
75206>>>>>>>    //
75206>>>>>>>    //   example:
75206>>>>>>>    //       8.50.T
75206>>>>>>>    //   will be returned for a Pervasive.SQL 8.5 Server Engine running on
75206>>>>>>>    //   32-bits Windows server.
75206>>>>>>>    //
75206>>>>>>>    //   The FileNumber parameter must specify an opened table or 0.
75206>>>>>>>    //   For PSQLServerEngineVersionInfo the FileNumber can not be 0.
75206>>>>>>>    //
75206>>>>>>>    //   If the version information is not available or can not be obtained
75206>>>>>>>    //   the functions will return "0.0.0"
75206>>>>>>>    
75206>>>>>>>    //  Returns the version information of the
75206>>>>>>>    //           Pervasive.SQL Client requester.
75206>>>>>>>    
75206>>>>>>>    Function PSQLRequesterVersionInfo Integer iFileNum Returns String
75208>>>>>>>        
75208>>>>>>>        String  sDriverID
75208>>>>>>>        String  sVersion
75208>>>>>>>        String  sVoid
75208>>>>>>>        Integer iRetval
75208>>>>>>>        
75208>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75208>>>>>>>        // This error would otherwise be raised when we have an older
75208>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75208>>>>>>>        Send Ignore_error to Error_object_Id 20491
75209>>>>>>>        Get psDriverID to sDriverID
75210>>>>>>>        Move (Repeat(" ", 255)) to sVersion
75211>>>>>>>        Call_Driver iFileNum sDRiverID Function DFBTRFN_PSQLREQUESTERVERSIONINFO Callback 0 Passing sVersion sVoid 0 Result iRetval
75216>>>>>>>        Send Trap_Error to Error_object_Id 20491
75217>>>>>>>        If (Trim(sVersion) = "") Begin
75219>>>>>>>            // Unable to get the revision. return all zeroes.
75219>>>>>>>            Move "0.0.0" to sVersion
75220>>>>>>>        End
75220>>>>>>>>
75220>>>>>>>        Function_Return sVersion
75221>>>>>>>    End_Function
75222>>>>>>>    
