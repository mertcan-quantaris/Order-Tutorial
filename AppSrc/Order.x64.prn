76072>>>>>    //  Validates if the field contains a valid email address (it allows empty values too).
76072>>>>>    Function ValidateEmail Integer iColumn String sValue Returns Boolean
76074>>>>>        Integer iAt iDot
76074>>>>>        Boolean bResult
76074>>>>>        
76074>>>>>        If (Trim(sValue) <> "") Begin
76076>>>>>            Move (Pos("@", sValue)) to iAt
76077>>>>>            Move (RightPos(".", sValue)) to iDot
76078>>>>>            
76078>>>>>            If (not(iAt > 1 and iDot > 0 and iDot > iAt + 1 and iDot < Length(sValue))) Begin
76080>>>>>                Send Data_set_error iColumn DFERR_OPERATOR "Please enter a valid email address"
76081>>>>>                Move True to bResult
76082>>>>>            End
76082>>>>>>
76082>>>>>        End
76082>>>>>>
76082>>>>>        
76082>>>>>        Function_Return bResult
76083>>>>>    End_Function
76084>>>>>    
