77426>>>>>    // Add a default date if the field is blank
77426>>>>>    Procedure Entry_Order_Date Integer iField Date dDate
77428>>>>>        Integer iChanged
77428>>>>>        
77428>>>>>        Get Field_Changed_State iField to iChanged
77429>>>>>        If (iChanged=0 and dDate=0) Begin
77431>>>>>            Sysdate dDate
77432>>>>>            Set Field_Default_Value iField to dDate
77433>>>>>        End
77433>>>>>>
77433>>>>>    End_Procedure
77434>>>>>    
77434>>>>>    Procedure Update
77436>>>>>        Forward Send Update
77438>>>>>        Send Adjust_Balances OrderHeader.Order_Total
77439>>>>>    End_Procedure
77440>>>>>    
77440>>>>>    Procedure Backout
77442>>>>>        Forward Send Backout
77444>>>>>        Send Adjust_Balances (-OrderHeader.Order_Total)
77445>>>>>    End_Procedure
77446>>>>>    
77446>>>>>    Procedure Adjust_Balances Number Amt
77448>>>>>        
77448>>>>>        If (((Amt + Customer.Purchases) < 999999) and ((Amt + Customer.Balance) < 999999)) Begin
77450>>>>>            Add Amt to Customer.Purchases
77451>>>>>            Add Amt to Customer.Balance
77452>>>>>        End
77452>>>>>>
77452>>>>>        Else Begin
77453>>>>>            Send UserError ("The value of" * FormatCurrency(Amt + Customer.Purchases, 2) * "exceeds the maximum amount allowed for customer purchases." * ;                 "Review your order to adjust prices and quantities to be within the limit of" * FormatCurrency(999999, 2)) "Error in updating Customer"
77454>>>>>        End
77454>>>>>>
77454>>>>>    End_Procedure
77455>>>>>    
77455>>>>>    Procedure Deleting
77457>>>>>        Forward Send Deleting
77459>>>>>        // see if we can decrement the order number in sys table...
77459>>>>>        // can only do this if this is the newest order.
77459>>>>>        If (OrderHeader.Order_Number=DFLastID.Order_Number) Begin // if this is
77461>>>>>            Decrement DFLastID.Order_Number          // the last number,
77462>>>>>            SaveRecord DFLastID                      // decrement and save.
77463>>>>>        End
77463>>>>>>
77463>>>>>    End_Procedure
