77595>>>>>Class cOrderDetailDataDictionary is a DataDictionary
77596>>>>>    
77596>>>>>    Procedure Construct_Object
77598>>>>>        Forward Send Construct_Object
77600>>>>>        
77600>>>>>        Set Main_File to OrderDetail.File_Number
77601>>>>>        Set Cascade_Delete_State to False
77602>>>>>        
77602>>>>>        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
77603>>>>>        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
77604>>>>>        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True
77605>>>>>        
77605>>>>>        Set Add_Server_File to OrderHeader.File_Number
77606>>>>>        Set Add_Server_File to Inventory.File_Number
77607>>>>>        
77607>>>>>        Set Field_Auto_Increment Field OrderDetail.Detail_Number to File_Field OrderHeader.Last_Detail_Num
77608>>>>>        
77608>>>>>        Set Field_Option Field OrderDetail.Order_Number DD_NOPUT to True
77609>>>>>        
77609>>>>>        Set Field_Option Field OrderDetail.Detail_Number DD_NOPUT to True
77610>>>>>        
77610>>>>>        Set Field_Exit_msg Field OrderDetail.Qty_Ordered to Adjust_Display_Total
77611>>>>>        Set Field_Label_Long Field OrderDetail.Qty_Ordered to "Quantity Ordered"
77612>>>>>        Set Field_Label_Short Field OrderDetail.Qty_Ordered to "Quantity"
77613>>>>>        Set Field_Mask_Type Field OrderDetail.Qty_Ordered to Mask_Numeric_Window
77614>>>>>        Set Status_Help Field OrderDetail.Qty_Ordered to "Number of items ordered"
77615>>>>>        Set Field_Value_Range Field OrderDetail.Qty_Ordered to 1 100
77616>>>>>        Set Field_Error Field OrderDetail.Qty_Ordered to 0 "Quantity per order line limited to 100"
77617>>>>>
77617>>>>>        
77617>>>>>        Set Field_Entry_msg Field OrderDetail.Price to Entering_Price
77618>>>>>        Set Field_Exit_msg Field OrderDetail.Price to Adjust_Display_Total
77619>>>>>        Set Field_Label_Long Field OrderDetail.Price to "Price per Unit"
77620>>>>>        Set Field_Label_Short Field OrderDetail.Price to "Price"
77621>>>>>        Set Field_Mask_Type Field OrderDetail.Price to MASK_CURRENCY_WINDOW
77622>>>>>        Set Status_Help Field OrderDetail.Price to "Price per Unit"
77623>>>>>        Set Field_Value_Range Field OrderDetail.Price to 0.01 2500
77624>>>>>        Set Field_Error Field OrderDetail.Price to 0 (String("Unit price may not exceed" * FormatCurrency(2500, 2)))
77625>>>>>        
77625>>>>>        Set Field_Label_Long Field OrderDetail.Extended_Price to "Extended Price"
77626>>>>>        Set Field_Label_Short Field OrderDetail.Extended_Price to "Total"
77627>>>>>        Set Field_Mask_Type Field OrderDetail.Extended_Price to MASK_CURRENCY_WINDOW
77628>>>>>        Set Field_Option Field OrderDetail.Extended_Price DD_DISPLAYONLY to True
77629>>>>>        Set Status_Help Field OrderDetail.Extended_Price to "Total extended price"
77630>>>>>        
77630>>>>>        Set piPrimaryIndex to 1
77631>>>>>    End_Procedure
77632>>>>>    
77632>>>>>    // Update and Backout need to adjust the Inventory.On_Hand quantity,
77632>>>>>    // the OrderDetail line's extended price and the OrderHeader total.
77632>>>>>    // We will call the same procedure (Adjust_Balances) to insure that
77632>>>>>    // Backout and Update are inverses of each other.
77632>>>>>    // Note that Backout does not need to change the Extended_Price.
77632>>>>>    // This only gets changed as part of Update.
77632>>>>>    Procedure Update
77634>>>>>        Forward Send Update
77636>>>>>        Move (OrderDetail.Price * OrderDetail.Qty_Ordered) to OrderDetail.Extended_Price
77637>>>>>        Send Adjust_Balances OrderDetail.Qty_Ordered OrderDetail.Extended_Price
77638>>>>>    End_Procedure
77639>>>>>    
77639>>>>>    Procedure Backout
77641>>>>>        Forward Send Backout
77643>>>>>        Send Adjust_Balances (-OrderDetail.Qty_Ordered) (-OrderDetail.Extended_Price)
77644>>>>>    End_Procedure
77645>>>>>    
77645>>>>>    // Called by Backout and Update, passing the quantity and the extended price.
77645>>>>>    // Subtract quantity from on-hand Inventory and add extended Amt to order total.
77645>>>>>    Procedure Adjust_Balances Number Qty Number Amt
77647>>>>>        Subtract Qty from Inventory.On_Hand
77648>>>>>        Add      Amt to   OrderHeader.Order_Total
77649>>>>>    End_Procedure
77650>>>>>    
77650>>>>>    // when entering the price field we may wish to update the
77650>>>>>    // current field value with the standard unit price from the Inventory table.
77650>>>>>    // Only do this if the current amount is zero and an item was actually picked.
77650>>>>>    // If non-zero or no item picked, we assume the field is being edited (and we make no assumptions).
77650>>>>>    Procedure Entering_Price Integer Field# Number nAmnt
77652>>>>>        Handle hoInventoryDD
77652>>>>>        Boolean bHasRecord
77652>>>>>        
77652>>>>>        Get Data_Set Inventory.File_Number to hoInventoryDD
77653>>>>>        
77653>>>>>        If (hoInventoryDD) Begin
77655>>>>>            Get HasRecord of hoInventoryDD to bHasRecord
77656>>>>>            
77656>>>>>            If (nAmnt=0 and bHasRecord) Begin
77658>>>>>                Get File_Field_Current_Value File_Field Inventory.Unit_Price to nAmnt
77659>>>>>                Set Field_Changed_Value Field# to nAmnt
77660>>>>>                Send Adjust_Display_Total
77661>>>>>            End
77661>>>>>>
77661>>>>>        End
77661>>>>>>
77661>>>>>        
77661>>>>>    End_Procedure
77662>>>>>    
77662>>>>>    // This updates the extended price field, which will update any display balances.
77662>>>>>    // This is only done for display purposes.
77662>>>>>    // The actual amount is updated to the field during the save.
77662>>>>>    Procedure Adjust_Display_total Integer iField String sValue
77664>>>>>        Integer iQty
77664>>>>>        Number  nAmnt
77664>>>>>        
77664>>>>>        Get Field_Current_Value Field OrderDetail.Qty_Ordered    to iQty
77665>>>>>        Get Field_Current_Value Field OrderDetail.Price          to nAmnt
77666>>>>>        Set Field_Current_Value Field OrderDetail.Extended_Price to (nAmnt * iQty)
77667>>>>>        // note we set value, but not changed_state!
77667>>>>>    End_Procedure
77668>>>>>    
77668>>>>>    Procedure Field_Defaults
77670>>>>>        Forward Send Field_Defaults
77672>>>>>        Set Field_Changed_Value Field OrderDetail.Qty_Ordered to 1
77673>>>>>    End_Procedure
77674>>>>>    
77674>>>>>End_Class
