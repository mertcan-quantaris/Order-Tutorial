76081>>>>>    //  Validates if the field contains a valid email address (it allows empty values too).
76081>>>>>    Function ValidateEmail Integer iColumn String sValue Returns Boolean
76083>>>>>        Integer iAt iDot
76083>>>>>        Boolean bResult
76083>>>>>        
76083>>>>>        If (Trim(sValue) <> "") Begin
76085>>>>>            Move (Pos("@", sValue)) to iAt
76086>>>>>            Move (RightPos(".", sValue)) to iDot
76087>>>>>            
76087>>>>>            If (not(iAt > 1 and iDot > 0 and iDot > iAt + 1 and iDot < Length(sValue))) Begin
76089>>>>>                Send Data_set_error iColumn DFERR_OPERATOR "Please enter a valid email address"
76090>>>>>                Move True to bResult
76091>>>>>            End
76091>>>>>>
76091>>>>>        End
76091>>>>>>
76091>>>>>        
76091>>>>>        Function_Return bResult
76092>>>>>    End_Function
76093>>>>>    
76093>>>>>End_Class
