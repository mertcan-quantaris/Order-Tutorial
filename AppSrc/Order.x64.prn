78079>>>>>>>        
78079>>>>>>>        Get Report_Window_Handle to hWnd
78080>>>>>>>        Move (WP_ExecutePrintDialog(hwnd)) to bOk
78081>>>>>>>        
78081>>>>>>>        Function_Return bOk
78082>>>>>>>    End_Function
78083>>>>>>>    
78083>>>>>>>    
78083>>>>>>>    // You can only invoke the print setup if the report is cleared. If you try to to do this in
78083>>>>>>>    //    the wrong state you will get an error.
78083>>>>>>>    Function DFPrintSetupDialog Returns Boolean
78085>>>>>>>        Handle hwnd
78085>>>>>>>        Boolean bOk
78085>>>>>>>        Integer iStatus
78085>>>>>>>        Get ArePrintersInstalled to bOk
78086>>>>>>>        If not bOk Begin
78088>>>>>>>            Error DFERR_WINPRINT C_$NoInstalledPrinters
78089>>>>>>>>
78089>>>>>>>        End
78089>>>>>>>>
78089>>>>>>>        Else Begin
78090>>>>>>>            Get DocumentStatus to iStatus
78091>>>>>>>            
78091>>>>>>>            If (iStatus=dsNotStarted) Begin
78093>>>>>>>                Get Report_Window_Handle to hWnd
78094>>>>>>>                Move (WP_ExecutePrinterSetupDialog(hwnd)) to bOk
78095>>>>>>>                
78095>>>>>>>                // test that the selected printer is valid....
78095>>>>>>>                If bOK Begin
78097>>>>>>>                    Get IsPrinterValid to bOk // if printer not valid, it's not ok
78098>>>>>>>                    If not bOk Begin
78100>>>>>>>                        Error DFERR_WINPRINT DFPrintError936  // could not select a valid printer
78101>>>>>>>>
78101>>>>>>>                    End
78101>>>>>>>>
78101>>>>>>>                End
78101>>>>>>>>
78101>>>>>>>            End
78101>>>>>>>>
78101>>>>>>>            Else Begin
78102>>>>>>>                Error DFERR_WINPRINT DFPrintError966      // cannot change printer when report is active
78103>>>>>>>>
78103>>>>>>>            End
78103>>>>>>>>
78103>>>>>>>        End
78103>>>>>>>>
78103>>>>>>>        Function_Return bOk
78104>>>>>>>    End_Function
78105>>>>>>>    
78105>>>>>>>    
78105>>>>>>>    // Provided for backwards compatibility. DFPrintSetupDialog is more flexible because it returns a
78105>>>>>>>    //    false if cancel was selected.
78105>>>>>>>    Procedure DFPrintSetup
78107>>>>>>>        Boolean bOk
78107>>>>>>>        Get DFPrintSetupDialog to bOk
78108>>>>>>>    End_Procedure
78109>>>>>>>    
78109>>>>>>>    // This invokes the print job dialog, prints the report, then clears the report document.
78109>>>>>>>    //    This should be called after the report is complete.
78109>>>>>>>    Procedure DFPrint
78111>>>>>>>        Integer bOk
78111>>>>>>>        Get DFPrintDialog to bOk
78112>>>>>>>        If bOk Begin
78114>>>>>>>            Send DFPrintDoc
78115>>>>>>>            Send DFClearDoc
78116>>>>>>>        End
78116>>>>>>>>
78116>>>>>>>    End_Procedure
78117>>>>>>>    
78117>>>>>>>    Procedure DFSuspendGui Boolean bSuspend
78119>>>>>>>        If (bSuspend<>pbIsSuspended(Self)) Begin
78121>>>>>>>            Send SuspendGui of Desktop bSuspend
78122>>>>>>>            Set pbIsSuspended to bSuspend
78123>>>>>>>        End
78123>>>>>>>>
78123>>>>>>>    End_Procedure
78124>>>>>>>    
78124>>>>>>>    // this is protected so that the queue is only pumped if the
78124>>>>>>>    // gui is suspended.
78124>>>>>>>    Procedure PumpMsgQueue
78126>>>>>>>        If (pbIsSuspended(Self)) Begin
78128>>>>>>>            Send PumpMsgQueue of desktop // permit painting
78129>>>>>>>        End
78129>>>>>>>>
78129>>>>>>>    End_Procedure
78130>>>>>>>    
78130>>>>>>>    
78130>>>>>>>    // This does a modeless preview. This is what you'd want during
78130>>>>>>>    //    report generation and it may be what you want for report viewing.
78130>>>>>>>    Procedure DFPreviewNoWait
78132>>>>>>>        Boolean bOk
78132>>>>>>>        Boolean bPrntDlg bPrintSetup bPrint
78132>>>>>>>        Integer iStatus
78132>>>>>>>        Get PrintDlgInPreview to bPrntDlg
78133>>>>>>>        Get EnablePrintSetupFromPreview to bPrintSetup
78134>>>>>>>        Get EnablePrintFromPreview to bPrint
78135>>>>>>>        Get DocumentStatus to iStatus
78136>>>>>>>        If (iStatus=dsStarted) Begin
78138>>>>>>>            Send DfSuspendGui True
78139>>>>>>>        End
78139>>>>>>>>
78139>>>>>>>        Move (WP_PreviewDocument(bPrntDlg,bPrintSetup,bPrint)) to bOk
78140>>>>>>>        If not bOk Begin
78142>>>>>>>            Error DFERR_WINPRINT DFPrintError901
78143>>>>>>>>
78143>>>>>>>            Send DfSuspendGui False
78144>>>>>>>        End
78144>>>>>>>>
78144>>>>>>>    End_Procedure
78145>>>>>>>    
78145>>>>>>>    
78145>>>>>>>    // This does a modal preview. You might want this for report
78145>>>>>>>    //    viewing as the program knows when the viewer is closed
78145>>>>>>>    // Note that this is a private message and it was never intended that this
78145>>>>>>>    // should be used. We expect winprint reports to use modeless viewers.
78145>>>>>>>    Procedure DFPreviewWait
78147>>>>>>>        Handle hViewerProcess
78147>>>>>>>        Boolean bPrntDlg bPrintSetup bPrint
78147>>>>>>>        Integer iRetVal
78147>>>>>>>        Handle hwMain hMain
78147>>>>>>>        
78147>>>>>>>        Get PrintDlgInPreview to bPrntDlg
78148>>>>>>>        Get EnablePrintSetupFromPreview to bPrintSetup
78149>>>>>>>        Get EnablePrintFromPreview to bPrint
78150>>>>>>>        
78150>>>>>>>        Send DfSuspendGui True
78151>>>>>>>        Move (WP_PreviewDocument(bPrntDlg,bPrintSetup,bPrint)) to hViewerProcess
78152>>>>>>>        
78152>>>>>>>        If (hViewerProcess = 0) Begin
78154>>>>>>>            Error DFERR_WINPRINT DFPrintError901
78155>>>>>>>>
78155>>>>>>>        End
78155>>>>>>>>
78155>>>>>>>        Else Begin
78156>>>>>>>            // We need to wait for either the Viewer to close, or a WM_PAINT message in the thread's queue...
78156>>>>>>>            Repeat
78156>>>>>>>>
78156>>>>>>>                Move (MsgWaitForMultipleObjects(1, AddressOf(hViewerProcess), False, INFINITE, QS_PAINT)) to iRetVal
78157>>>>>>>                Send PumpMsgQueue // permit painting
78158>>>>>>>            Until (iRetVal = 0) // 0 means that the viewer process terminated
78160>>>>>>>        End
78160>>>>>>>>
78160>>>>>>>        Send DfSuspendGui False
78161>>>>>>>        
78161>>>>>>>        // Do what we can to force VDF application to the top.
78161>>>>>>>        // As 12.0 dfSuspendGUI actually properly disables the underlying windows. When the viewer
78161>>>>>>>        // is closed it cannot give the focus back to this so it goes elsewhere. This will force it
78161>>>>>>>        // back.
78161>>>>>>>        
78161>>>>>>>        Get main_window of desktop to hMain
78162>>>>>>>        If hMain Begin
78164>>>>>>>            Get window_handle of hMain to hwMain
78165>>>>>>>            If hwMain Begin
78167>>>>>>>                If (GetForegroundWindow()<>hwMain) Begin
78169>>>>>>>                    Move (SetForegroundWindow(hwMain)) to hwMain
78170>>>>>>>                End
78170>>>>>>>>
78170>>>>>>>            End
78170>>>>>>>>
78170>>>>>>>        End
78170>>>>>>>>
78170>>>>>>>        
78170>>>>>>>    End_Procedure
78171>>>>>>>    
78171>>>>>>>    Procedure DfPreview
78173>>>>>>>        Send DfPreviewNoWait
78174>>>>>>>    End_Procedure
78175>>>>>>>    
78175>>>>>>>    
