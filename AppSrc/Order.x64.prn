79950>>>    Procedure StartReport 
79953>>>        Boolean bToPrinter
79953>>>        String sValue
79953>>>        Number nStart nStop
79953>>>
79953>>>        // Set all selection critera properties
79953>>>        Get StartValue of oOrder_NumberSelection to sValue
79954>>>        Set pnStartOrder_Number of oOrderHeader_DD To sValue
79955>>>
79955>>>        Get StopValue of oOrder_NumberSelection to sValue
79956>>>        Set pnStopOrder_Number of oOrderHeader_DD To sValue
79957>>>
79957>>>
79957>>>        // determine if direct print
79957>>>        Get IsToPrinter of oPrintTo to bToPrinter
79958>>>        Set OutPut_Device_Mode of oReport to (If(bToPrinter, PRINT_TO_PRINTER, PRINT_TO_WINDOW))
79959>>>
79959>>>        // run the report
79959>>>        Send Run_Report of oReport
79960>>>
79960>>>    End_Procedure  
