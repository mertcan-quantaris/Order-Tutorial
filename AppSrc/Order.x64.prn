75996>>>//  This is the default message. It is expected that you will
75996>>>//  create your own message to override this
75996>>>Procedure Activate_About
75999>>>    Send DoAbout "" "" "" "" ""
76000>>>End_Procedure
76001>>>
76001>>>//  It is expected that you will send this message (most
76001>>>//  likely from Activate_About. This creates an about object, activates it
76001>>>//  and destroys it when done. It is not exepected that you will augment this.
76001>>>Procedure DoAbout String sTitle String sVersion String sCopyRight String sAuthor String sBitmap
76004>>>    Integer hoObj hoMain
76004>>>    
76004>>>    // create object
76004>>>    Object About is an AboutDialog
76006>>>        // if no title passed use the label of the main panel
76006>>>        // (if a main panel exists).
76006>>>        If (sTitle = "") Begin
76008>>>            Get Main_Window of desktop to hoMain
76009>>>            If hoMain ;                Get Label of hoMain to sTitle
76012>>>        End
76012>>>>
76012>>>        Set productname to sTitle
76013>>>        Set version     to sVersion
76014>>>        Set copyright   to sCopyRight
76015>>>        Set author      to sAuthor
76016>>>        If (sBitmap <> '') ;            Set logo to sBitMap // square bitmaps of 42x42 work best
76019>>>        Move Self to hoObj // object Id
76020>>>    End_Object
76021>>>    Send Popup   of hoObj    // popup the about object
76022>>>    Send Destroy of hoObj // when done, it will be destroyed
76023>>>End_Procedure
