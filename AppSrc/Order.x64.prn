78168>>>>>>>        
78168>>>>>>>        If not bOk Begin
78170>>>>>>>            Error DFERR_WINPRINT DFPrintError902
78171>>>>>>>>
78171>>>>>>>        End
78171>>>>>>>>
78171>>>>>>>    End_Procedure
78172>>>>>>>    
78172>>>>>>>    
78172>>>>>>>    //
78172>>>>>>>    Procedure DFClearDoc
78174>>>>>>>        Boolean bOk
78174>>>>>>>        Get ArePrintersInstalled to bOk
78175>>>>>>>        If bOk Begin
78177>>>>>>>            Move (WP_ClearDocument()) to bOk
78178>>>>>>>            Send DFSuspendGUI False
78179>>>>>>>            If not bOk Begin
78181>>>>>>>                Error DFERR_WINPRINT DFPrintError903 // error number right?
78182>>>>>>>>
78182>>>>>>>            End
78182>>>>>>>>
78182>>>>>>>        End
78182>>>>>>>>
78182>>>>>>>    End_Procedure
78183>>>>>>>    
78183>>>>>>>    Procedure DFNewDoc Boolean bAutoPreview
78185>>>>>>>        Boolean bOk
78185>>>>>>>        // this is the most likely place we will encounter when we start a report. Check for
78185>>>>>>>        // printers and return an explicit error to make it easy to identify the error
78185>>>>>>>        Get ArePrintersInstalled to bOk
78186>>>>>>>        If not bOk Begin
78188>>>>>>>            Error DFERR_WINPRINT C_$NoInstalledPrinters
78189>>>>>>>>
78189>>>>>>>        End
78189>>>>>>>>
78189>>>>>>>        Else Begin
78190>>>>>>>            Send DfClearDoc // a new doc should always start with a clear
78191>>>>>>>            If bAutoPreview ;                Send DFSuspendGUI True
78194>>>>>>>            Move (WP_NewDocument(bAutoPreview)) to bOk
78195>>>>>>>            
78195>>>>>>>            If not bOk Begin
78197>>>>>>>                Error DFERR_WINPRINT DFPrintError902  // could not print document
78198>>>>>>>>
78198>>>>>>>                Send DFSuspendGUI False
78199>>>>>>>            End
78199>>>>>>>>
78199>>>>>>>        End
78199>>>>>>>>
78199>>>>>>>    End_Procedure
