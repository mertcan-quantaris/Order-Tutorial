75973>>>>>    Procedure End_Construct_Object
75975>>>>>        Handle hoVersionInfo
75975>>>>>        Boolean bIncluded
75975>>>>>        Integer iMajor iMinor iRelease iBuild
75975>>>>>        String sLabel
75975>>>>>        
75975>>>>>        Get Label of oVersion to sLabel
75976>>>>>        If (sLabel = C_$VERSION) Begin
75978>>>>>            // set it To the version info Of the program, if available
75978>>>>>            If (ghoApplication <> 0) Begin
75980>>>>>                Get phoVersionInfo of ghoApplication to hoVersionInfo
75981>>>>>                If (hoVersionInfo <> 0) Begin
75983>>>>>                    Get pbIncluded of hoVersionInfo to bIncluded
75984>>>>>                    If (bIncluded) Begin
75986>>>>>                        Get piVersionMajor of hoVersionInfo to iMajor
75987>>>>>                        Get piVersionMinor of hoVersionInfo to iMinor
75988>>>>>                        Get piVersionRelease of hoVersionInfo to iRelease
75989>>>>>                        Get piVersionBuild of hoVersionInfo to iBuild
75990>>>>>                        Move (SFormat (C_$VERSION + ": %1.%2.%3.%4", iMajor, iMinor, iRelease, iBuild)) to sLabel
75991>>>>>                        Set Version to sLabel
75992>>>>>                    End
75992>>>>>>
75992>>>>>                End
75992>>>>>>
75992>>>>>            End
75992>>>>>>
75992>>>>>        End
75992>>>>>>
75992>>>>>        
75992>>>>>        Forward Send End_Construct_Object
75994>>>>>    End_Procedure
