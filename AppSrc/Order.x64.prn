79547>>>        // Page_Bottom is printed last at the bottom margin of each page
79547>>>        Procedure Page_Bottom 
79550>>>            string sFont
79550>>>            integer iFontSize iBorder iStyle
79550>>>            DateTime dtDT
79550>>>
79550>>>            Move (CurrentDateTime()) to dtDT
79551>>>
79551>>>            Move "arial" to sFont
79552>>>            Move 8 to iFontSize
79553>>>            Move (font_default) to iStyle
79554>>>            Move (rgb_dGrey) to iBorder
79555>>>
