77114>>>>>>>>>Class cFormatter is an cObject
77115>>>>>>>>>    
77115>>>>>>>>>    Procedure Construct_object
77117>>>>>>>>>        Integer iCh
77117>>>>>>>>>        Forward Send construct_object
77119>>>>>>>>>        Property String  psCurrencySymbol
77120>>>>>>>>>        Set psCurrencySymbol to (Default_Currency_Symbol())
77121>>>>>>>>>        
77121>>>>>>>>>        Property String  psLeft
77122>>>>>>>>>        Property String  psright
77123>>>>>>>>>        Property Integer pbThousandsSep
77124>>>>>>>>>        Property Integer piPoints
77125>>>>>>>>>        
77125>>>>>>>>>        Property String  psCurPosLeft
77126>>>>>>>>>        Property String  psCurPosright
77127>>>>>>>>>        Property Integer pbCurPosThousandsSep
77128>>>>>>>>>        Property Integer piCurPosPoints
77129>>>>>>>>>        
77129>>>>>>>>>        Property String  psCurNegLeft
77130>>>>>>>>>        Property String  psCurNegright
77131>>>>>>>>>        Property Integer pbCurNegThousandsSep
77132>>>>>>>>>        Property Integer piCurNegPoints
77133>>>>>>>>>        
77133>>>>>>>>>        Property String  psNumPosLeft
77134>>>>>>>>>        Property String  psNumPosright
77135>>>>>>>>>        Property Integer pbNumPosThousandsSep
77136>>>>>>>>>        Property Integer piNumPosPoints
77137>>>>>>>>>        
77137>>>>>>>>>        Property String  psNumNegLeft
77138>>>>>>>>>        Property String  psNumNegright
77139>>>>>>>>>        Property Integer pbNumNegThousandsSep
77140>>>>>>>>>        Property Integer piNumNegPoints
77141>>>>>>>>>        
77141>>>>>>>>>        Send SetFormat "$,#.##;($,#.##)" True  // currency
77142>>>>>>>>>        Send SetFormat  ",#.*"           False // numeric
77143>>>>>>>>>        
77143>>>>>>>>>    End_Procedure
77144>>>>>>>>>    
77144>>>>>>>>>    // internal
77144>>>>>>>>>    // parse passed format string and set temporary properties with result
77144>>>>>>>>>    Procedure ParseFormat String sFmt
77146>>>>>>>>>        
77146>>>>>>>>>        String sLeft sRight sDigit
77146>>>>>>>>>        Integer bSep iPos i iDigits
77146>>>>>>>>>        
77146>>>>>>>>>        // replace any literals. A "/" followed by anything.
77146>>>>>>>>>        // some literals are special. $ . , / #
77146>>>>>>>>>        Move (Replaces("/$",sFmt,Character(1)))    to sFmt
77147>>>>>>>>>        Move (Replaces("/.",sFmt,Character(2)))    to sFmt
77148>>>>>>>>>        Move (Replaces("/,",sFmt,Character(3)))    to sFmt
77149>>>>>>>>>        Move (Replaces("/"+"/",sFmt,Character(4))) to sFmt
77150>>>>>>>>>        Move (Replaces("/#",sFmt,Character(5)))    to sFmt
77151>>>>>>>>>        Move (Character(9)) to sDigit
77152>>>>>>>>>        Move (Replaces("#",sFmt,sDigit))           to sFmt
77153>>>>>>>>>        Move (Replaces("/",sFmt,""))               to sFmt // replace all others
77154>>>>>>>>>        
77154>>>>>>>>>        Move (Pos(",",sFmt))                 to bSep // if we have any , we use thousand seps
77155>>>>>>>>>        If bSep ;            Move (Replaces(",",sFmt,"")) to sFmt // remove all ,
77158>>>>>>>>>        
77158>>>>>>>>>        Move (Replaces("$",sFmt,psCurrencySymbol(Self))) to sFmt // replace any $ with currency symbol
77159>>>>>>>>>        
77159>>>>>>>>>        Move (Pos(".",sFmt)) to iPos                 // position of decimal
77160>>>>>>>>>        
77160>>>>>>>>>        // Move all the special literals back into place before parsing
77160>>>>>>>>>        Move (Replaces(Character(1),sFmt,"$")) to sFmt
77161>>>>>>>>>        Move (Replaces(Character(2),sFmt,".")) to sFmt
77162>>>>>>>>>        Move (Replaces(Character(3),sFmt,",")) to sFmt
77163>>>>>>>>>        Move (Replaces(Character(4),sFmt,"/")) to sFmt
77164>>>>>>>>>        Move (Replaces(Character(5),sFmt,"#")) to sFmt
77165>>>>>>>>>        
77165>>>>>>>>>        If (iPos>0) Begin                      // if we have a decimanl point
77167>>>>>>>>>            Move 1 to i                        // look for first non # to right and count the #s
77168>>>>>>>>>            If (mid(sFmt,1,iPos+i)="*") Begin  // the "*" is special. It means as many as you want
77170>>>>>>>>>                Move -2 to iDigits
77171>>>>>>>>>                Increment i
77172>>>>>>>>>            End
77172>>>>>>>>>>
77172>>>>>>>>>            While (mid(sFmt,1,iPos+i)=sDigit)
77176>>>>>>>>>                Increment i
77177>>>>>>>>>            Loop
77178>>>>>>>>>>
77178>>>>>>>>>            Move (Mid(sFmt,255,iPos+i)) to sRight // everything to the right of the last # is format stuff
77179>>>>>>>>>            If (iDigits=0) ;                Move (i-1) to iDigits
77182>>>>>>>>>            //
77182>>>>>>>>>            Move 1 to i                           // find the first non-# to the left of the point
77183>>>>>>>>>            While (mid(sFmt,1,iPos-i)=sDigit)     // everything to the left is format stuff
77187>>>>>>>>>                Increment i
77188>>>>>>>>>            Loop
77189>>>>>>>>>>
77189>>>>>>>>>            Move (left(sFmt,iPos-i)) to sLeft
77190>>>>>>>>>        End
77190>>>>>>>>>>
77190>>>>>>>>>        Else Begin                             // we have no decinal
77191>>>>>>>>>            Move 0 to iDigits                  // so points is none
77192>>>>>>>>>            Move (Pos(sDigit,sFmt)) to iPos    // find first #.
77193>>>>>>>>>            If (iPos=0) Begin                  // if none, entire string is left format stuff..wierd!
77195>>>>>>>>>                Move sFmt to sLeft
77196>>>>>>>>>                Move ""   to sRight
77197>>>>>>>>>            End
77197>>>>>>>>>>
77197>>>>>>>>>            Else Begin
77198>>>>>>>>>                Move (left(sFmt,iPos-1)) to sLeft // all char to left of first # is left format stuff
77199>>>>>>>>>                Move 1 to i
77200>>>>>>>>>                While (mid(sFmt,1,iPos+i)=sDigit) // find last #, all char to right is right format
77204>>>>>>>>>                    Increment i
77205>>>>>>>>>                Loop
77206>>>>>>>>>>
77206>>>>>>>>>                Move (Mid(sFmt,255,i+iPos)) to sRight
77207>>>>>>>>>            End
77207>>>>>>>>>>
77207>>>>>>>>>        End
77207>>>>>>>>>>
77207>>>>>>>>>        // set temporary format properties and exit
77207>>>>>>>>>        Set pbThousandsSep to bSep
77208>>>>>>>>>        Set psLeft         to sLeft
77209>>>>>>>>>        Set psRight        to sRight
77210>>>>>>>>>        Set piPoints       to iDigits
77211>>>>>>>>>    End_Procedure
77212>>>>>>>>>    
77212>>>>>>>>>    // Public: Sets a format string. Pass full format for Positve and negative in sFmt. Pass
77212>>>>>>>>>    //         bCurrency true is this is a currency format, false if a numeric format
77212>>>>>>>>>    //
77212>>>>>>>>>    //  e.g. Send SetFormat "$,#.##;($,#.##)" True
77212>>>>>>>>>    Procedure SetFormat String sFmt Integer bCurrency
77214>>>>>>>>>        String sPos sNeg
77214>>>>>>>>>        Integer iPos
77214>>>>>>>>>        
77214>>>>>>>>>        Move (Pos(";",sFmt)) to iPos
77215>>>>>>>>>        If iPos Begin
77217>>>>>>>>>            Move (left(sFmt,iPos-1))    to sPos
77218>>>>>>>>>            Move (mid(sFmt,255,iPos+1)) to sNeg
77219>>>>>>>>>        End
77219>>>>>>>>>>
77219>>>>>>>>>        Else Begin
77220>>>>>>>>>            Move sFmt         to sPos
77221>>>>>>>>>            Move ("-" + sFmt) to sNeg
77222>>>>>>>>>        End
77222>>>>>>>>>>
77222>>>>>>>>>        Send ParseFormat sPos
77223>>>>>>>>>        If bCurrency Begin
77225>>>>>>>>>            Set pbCurPosThousandsSep to (pbThousandsSep(Self))
77226>>>>>>>>>            Set psCurPosLeft         to (psLeft(Self))
77227>>>>>>>>>            Set psCurPosRight        to (psRight(Self))
77228>>>>>>>>>            Set piCurPosPoints       to (piPoints(Self))
77229>>>>>>>>>        End
77229>>>>>>>>>>
77229>>>>>>>>>        Else Begin
77230>>>>>>>>>            Set pbNumPosThousandsSep to (pbThousandsSep(Self))
77231>>>>>>>>>            Set psNumPosLeft         to (psLeft(Self))
77232>>>>>>>>>            Set psNumPosRight        to (psRight(Self))
77233>>>>>>>>>            Set piNumPosPoints       to (piPoints(Self))
77234>>>>>>>>>        End
77234>>>>>>>>>>
77234>>>>>>>>>        
77234>>>>>>>>>        Send ParseFormat sNeg
77235>>>>>>>>>        If bCurrency Begin
77237>>>>>>>>>            Set pbCurNegThousandsSep to (pbThousandsSep(Self))
77238>>>>>>>>>            Set psCurNegLeft         to (psLeft(Self))
77239>>>>>>>>>            Set psCurNegRight        to (psRight(Self))
77240>>>>>>>>>            Set piCurNegPoints       to (piPoints(Self))
77241>>>>>>>>>        End
77241>>>>>>>>>>
77241>>>>>>>>>        Else Begin
77242>>>>>>>>>            Set pbNumNegThousandsSep to (pbThousandsSep(Self))
77243>>>>>>>>>            Set psNumNegLeft         to (psLeft(Self))
77244>>>>>>>>>            Set psNumNegRight        to (psRight(Self))
77245>>>>>>>>>            Set piNumNegPoints       to (piPoints(Self))
77246>>>>>>>>>        End
77246>>>>>>>>>>
77246>>>>>>>>>    End_Procedure
77247>>>>>>>>>    
77247>>>>>>>>>    // low level formatting. Pass parameters
77247>>>>>>>>>    Function Format_Num Number nNumber Integer iPoints Integer bSep ;            String sPrefix String sSuffix Returns String
77249>>>>>>>>>        String  sLeft sRight sNumber sSep sDec
77249>>>>>>>>>        Integer iDec iLen iCh
77249>>>>>>>>>        
77249>>>>>>>>>        Get_Attribute DF_DECIMAL_SEPARATOR to iCh
77252>>>>>>>>>        Move (Character(iCh)) to sDec
77253>>>>>>>>>        
77253>>>>>>>>>        Move (abs(nNumber)) to sNumber
77254>>>>>>>>>        Move (Pos(sDec,sNumber)) to iDec
77255>>>>>>>>>        Move (If(iDec=0, sNumber, left(sNumber,iDec-1))) to sLeft
77256>>>>>>>>>        Move (If(iDec=0, "", mid(sNumber,255,iDec+1)))   to sRight
77257>>>>>>>>>        // format for decimal separator
77257>>>>>>>>>        If (iPoints>=0) ; // if -2, leave it alone, it should not be -1            Move (left(sRight+Repeat("0",iPoints),iPoints)) to sRight
77260>>>>>>>>>        
77260>>>>>>>>>        // format for thousand sep.
77260>>>>>>>>>        If bSep Begin
77262>>>>>>>>>            Get_Attribute DF_THOUSANDS_SEPARATOR to iCh
77265>>>>>>>>>            Move (Character(iCh)) to sSep
77266>>>>>>>>>            Move (Length(sLeft)) to iLen
77267>>>>>>>>>            While (iLen>3)
77271>>>>>>>>>                Move (insert(sSep,sLeft,iLen-2)) to sLeft
77272>>>>>>>>>                Move (iLen-3) to iLen
77273>>>>>>>>>            Loop
77274>>>>>>>>>>
77274>>>>>>>>>        End
77274>>>>>>>>>>
77274>>>>>>>>>        // if decimal points or -2 (allow anything) and there are points to show
77274>>>>>>>>>        If (iPoints>0 or (iPoints=-2 and sRight<>"")) ;            Move (sLeft + sDec + sright) to sLeft
77277>>>>>>>>>        Function_Return (sPrefix + sLeft+ sSuffix)
77278>>>>>>>>>    End_Function
77279>>>>>>>>>    
77279>>>>>>>>>    // Public: Format for currency
77279>>>>>>>>>    Function FormatCur Number nNumber Integer iPoints Returns String
77281>>>>>>>>>        String  sLeft sRight
77281>>>>>>>>>        Integer bSep
77281>>>>>>>>>        If (nNumber<0) Begin
77283>>>>>>>>>            Get pbCurNegThousandsSep to bSep
77284>>>>>>>>>            Get psCurNegLeft         to sLeft
77285>>>>>>>>>            Get psCurNegRight        to sRight
77286>>>>>>>>>            If (iPoints=-1) ;                Get piCurNegPoints       to iPoints
77289>>>>>>>>>        End
77289>>>>>>>>>>
77289>>>>>>>>>        Else Begin
77290>>>>>>>>>            Get pbCurPosThousandsSep to bSep
77291>>>>>>>>>            Get psCurPosLeft         to sLeft
77292>>>>>>>>>            Get psCurPosRight        to sRight
77293>>>>>>>>>            If (iPoints=-1) ;                Get piCurPosPoints       to iPoints
77296>>>>>>>>>        End
77296>>>>>>>>>>
77296>>>>>>>>>        Function_Return (Format_Num(Self, nNumber,iPoints,bSep,sLeft,sRight))
77297>>>>>>>>>    End_Function
77298>>>>>>>>>    
77298>>>>>>>>>    // Public: Format for numeric
77298>>>>>>>>>    Function FormatNum Number nNumber Integer iPoints Returns String
77300>>>>>>>>>        String  sLeft sRight
77300>>>>>>>>>        Integer bSep
77300>>>>>>>>>        If (nNumber<0) Begin
77302>>>>>>>>>            Get pbNumNegThousandsSep to bSep
77303>>>>>>>>>            Get psNumNegLeft         to sLeft
77304>>>>>>>>>            Get psNumNegRight        to sRight
77305>>>>>>>>>            If (iPoints=-1) ;                Get piNumNegPoints       to iPoints
77308>>>>>>>>>        End
77308>>>>>>>>>>
77308>>>>>>>>>        Else Begin
77309>>>>>>>>>            Get pbNumPosThousandsSep to bSep
77310>>>>>>>>>            Get psNumPosLeft         to sLeft
77311>>>>>>>>>            Get psNumPosRight        to sRight
77312>>>>>>>>>            If (iPoints=-1) ;                Get piNumPosPoints       to iPoints
77315>>>>>>>>>        End
77315>>>>>>>>>>
77315>>>>>>>>>        Function_Return (Format_Num(Self, nNumber,iPoints,bSep,sLeft,sRight))
77316>>>>>>>>>    End_Function
77317>>>>>>>>>    
77317>>>>>>>>>    
77317>>>>>>>>>    // Public: Format passing format string
77317>>>>>>>>>    Function FormatVal Number nNumber String sFmt Returns String
77319>>>>>>>>>        Integer iPos bIsNeg
77319>>>>>>>>>        String  sLeft sRight
77319>>>>>>>>>        Integer iPoints bSep
77319>>>>>>>>>        Move (nNumber<0) to bIsNeg
77320>>>>>>>>>        Move (Pos(";",sFmt)) to iPos
77321>>>>>>>>>        Case Begin
77321>>>>>>>>>            Case (iPos and not(bIsNeg)) ;                Move (left(sFmt,iPos-1))    to sFmt
77324>>>>>>>>>            Case (iPos and bIsNeg) ;                Move (mid(sFmt,255,iPos+1)) to sFmt
77328>>>>>>>>>            Case (not(iPos) and not(bIsNeg)) ;                Move sFmt                   to sFmt
77332>>>>>>>>>            Case Else ;                Move ("-" + sFmt)           to sFmt
77334>>>>>>>>>        Case End
77334>>>>>>>>>        Send ParseFormat sFmt
77335>>>>>>>>>        Get pbThousandsSep to bSep
77336>>>>>>>>>        Get psLeft         to sLeft
77337>>>>>>>>>        Get psRight        to sRight
77338>>>>>>>>>        Get piPoints       to iPoints
77339>>>>>>>>>        Function_Return (Format_Num(Self, nNumber,iPoints,bSep,sLeft,sRight))
77340>>>>>>>>>    End_Function
77341>>>>>>>>>    
77341>>>>>>>>>End_Class
