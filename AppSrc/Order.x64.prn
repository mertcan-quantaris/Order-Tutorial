75237>>>>>>>        // This error would otherwise be raised when we have an older
75237>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75237>>>>>>>        Send Ignore_error to Error_object_Id 20491
75238>>>>>>>        Get psDriverID to sDriverID
75239>>>>>>>        Move (Repeat(" ", 255)) to sVersion
75240>>>>>>>        Call_Driver iFileNum sDRiverID Function DFBTRFN_PSQLLOCALENGINEVERSIONINFO Callback 0 Passing sVersion sVoid 0 Result iRetval
75245>>>>>>>        Send Trap_Error to Error_object_Id 20491
75246>>>>>>>        If (Trim(sVersion) = "") Begin
75248>>>>>>>            // Unable to get the revision. return all zeroes.
75248>>>>>>>            Move "0.0.0" to sVersion
75249>>>>>>>        End
75249>>>>>>>>
75249>>>>>>>        Function_Return sVersion
75250>>>>>>>    End_Function
75251>>>>>>>    
