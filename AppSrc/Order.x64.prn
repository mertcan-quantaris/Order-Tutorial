74704>>>    Function LoginConnectIdDialog String sId Returns Boolean
74707>>>        Boolean bOk bChanged bTrusted bAllowRemember bRemember
74707>>>        String sUser sPwd sDescription
74707>>>        tConnection Connect
74707>>>        tConnection Connect
74707>>>        
74707>>>        Get pbAllowRemember to bAllowRemember
74708>>>        
74708>>>        
74708>>>        If not bAllowRemember Begin
74710>>>            Set Enabled_State of oRemember to bRemember
74711>>>            Set Visible_State of oRemember to bRemember
74712>>>        End
74712>>>>
74712>>>        
74712>>>        Get ConnectionIdInfo of ghoConnection sId to Connect
74713>>>        Set Value of oConnectionIdInfo to ("Connection ID="+Connect.sId)
74714>>>        Set Value of oConnectionServerInfo to Connect.sString
74715>>>        
74715>>>        Set psId to sId
74716>>>        Set pbOk to False
74717>>>        Set pbChanged to False
74718>>>        Set Value of oUserIDForm to Connect.sUID
74719>>>        Set Value of oPwdForm to ""
74720>>>        
74720>>>        Send Popup
74721>>>        
74721>>>        Get pbOk to bOk
74722>>>        Get pbChanged to bChanged
74723>>>        If (bChanged and bOk) Begin
74725>>>            If bAllowRemember Begin
74727>>>                Get Checked_State of oRemember to bRemember
74728>>>                If bRemember Begin
74730>>>                    Get Checked_State of oTrustedConnection to bTrusted
74731>>>                    If not (bTrusted) Begin
74733>>>                        Get Value of oUserIDForm to sUser
74734>>>                        Get Value of oPwdForm to sPwd
74735>>>                    End
74735>>>>
74735>>>                    Get StoreConnectionIdCredentials of ghoConnection sId sUser sPwd bTrusted to bOk
74736>>>                End
74736>>>>
74736>>>            End
74736>>>>
74736>>>        End
74736>>>>
74736>>>        Function_Return bOk
74737>>>    End_Function
