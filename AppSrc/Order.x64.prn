78183>>>>>>>    Procedure DFClearDoc
78185>>>>>>>        Boolean bOk
78185>>>>>>>        Get ArePrintersInstalled to bOk
78186>>>>>>>        If bOk Begin
78188>>>>>>>            Move (WP_ClearDocument()) to bOk
78189>>>>>>>            Send DFSuspendGUI False
78190>>>>>>>            If not bOk Begin
78192>>>>>>>                Error DFERR_WINPRINT DFPrintError903 // error number right?
78193>>>>>>>>
78193>>>>>>>            End
78193>>>>>>>>
78193>>>>>>>        End
78193>>>>>>>>
78193>>>>>>>    End_Procedure
78194>>>>>>>    
78194>>>>>>>    Procedure DFNewDoc Boolean bAutoPreview
78196>>>>>>>        Boolean bOk
78196>>>>>>>        // this is the most likely place we will encounter when we start a report. Check for
78196>>>>>>>        // printers and return an explicit error to make it easy to identify the error
78196>>>>>>>        Get ArePrintersInstalled to bOk
78197>>>>>>>        If not bOk Begin
78199>>>>>>>            Error DFERR_WINPRINT C_$NoInstalledPrinters
78200>>>>>>>>
78200>>>>>>>        End
78200>>>>>>>>
78200>>>>>>>        Else Begin
78201>>>>>>>            Send DfClearDoc // a new doc should always start with a clear
78202>>>>>>>            If bAutoPreview ;                Send DFSuspendGUI True
78205>>>>>>>            Move (WP_NewDocument(bAutoPreview)) to bOk
78206>>>>>>>            
78206>>>>>>>            If not bOk Begin
78208>>>>>>>                Error DFERR_WINPRINT DFPrintError902  // could not print document
78209>>>>>>>>
78209>>>>>>>                Send DFSuspendGUI False
78210>>>>>>>            End
78210>>>>>>>>
78210>>>>>>>        End
78210>>>>>>>>
78210>>>>>>>    End_Procedure
