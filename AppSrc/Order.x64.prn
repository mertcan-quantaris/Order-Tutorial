77886>>>    //-----------------------------------------------------------------------
77886>>>    // Create custom confirmation messages for save and delete
77886>>>    // We must create the new functions and assign verify messages
77886>>>    // to them.
77886>>>    //-----------------------------------------------------------------------
77886>>>
77886>>>    Function ConfirmDeleteHeader Returns Boolean
77889>>>        Boolean bFail
77889>>>        Get Confirm C_$DeleteEntireHeaderAndAllDetail to bFail
77890>>>        Function_Return bFail
77891>>>    End_Function 
77892>>>
77892>>>    // Only confirm on the saving of new records
77892>>>    Function ConfirmSaveHeader Returns Boolean
77895>>>        Boolean bNoSave bHasRecord
77895>>>        Handle  hoSrvr
77895>>>        Get Server to hoSrvr
77896>>>        Get HasRecord of hoSrvr to bHasRecord
77897>>>        If not bHasRecord Begin
77899>>>            Get Confirm C_$SaveThisNewHeader to bNoSave
77900>>>        End
77900>>>>
77900>>>        Function_Return bNoSave
77901>>>    End_Function 
77902>>>
77902>>>    // Define alternate confirmation Messages
77902>>>    Set Verify_Save_MSG       to (RefFunc(ConfirmSaveHeader))
77903>>>    Set Verify_Delete_MSG     to (RefFunc(ConfirmDeleteHeader))
77904>>>    // Saves in header should not clear the view
77904>>>    Set Auto_Clear_Deo_State to False
77905>>>
77905>>>
