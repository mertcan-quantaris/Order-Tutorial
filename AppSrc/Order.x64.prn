75923>>>>>            If (ghoApplication <> 0) Begin
75925>>>>>                Get phoVersionInfo of ghoApplication to hoVersionInfo
75926>>>>>                If (hoVersionInfo <> 0) Begin
75928>>>>>                    Get pbIncluded of hoVersionInfo to bIncluded
75929>>>>>                    If (bIncluded) Begin
75931>>>>>                        Get piVersionMajor of hoVersionInfo to iMajor
75932>>>>>                        Get piVersionMinor of hoVersionInfo to iMinor
75933>>>>>                        Get piVersionRelease of hoVersionInfo to iRelease
75934>>>>>                        Get piVersionBuild of hoVersionInfo to iBuild
75935>>>>>                        Move (SFormat (C_$VERSION + ": %1.%2.%3.%4", iMajor, iMinor, iRelease, iBuild)) to sLabel
75936>>>>>                        Set Version to sLabel
