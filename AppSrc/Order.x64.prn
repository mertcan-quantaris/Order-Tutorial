78918>>>>>    
78918>>>>>    // All subtotal commands use the outer main report. This makes it easier to keep
78918>>>>>    // track of these numbers
78918>>>>>    
78918>>>>>    Procedure Add_SubTotal Integer iCounter Number nData
78920>>>>>        Number nValue
78920>>>>>        Integer iObj
78920>>>>>        Move (RptTotal(Main_Report_Id(Self))) to iObj
78921>>>>>        Get Number_Value of iObj iCounter to nValue
78922>>>>>        Add nData to nValue
78923>>>>>        Set Array_Value of iObj iCounter to nValue
78924>>>>>    End_Procedure
78925>>>>>    
78925>>>>>    Procedure Clr_SubTotal Integer iCounter
78927>>>>>        Set Array_Value of (RptTotal(Main_Report_Id(Self))) iCounter to 0
78928>>>>>    End_Procedure
78929>>>>>    
78929>>>>>    Procedure Clr_AllSubTotals
78931>>>>>        Send Delete_Data of (RptTotal(Main_Report_Id(Self)))
78932>>>>>    End_Procedure
78933>>>>>    
78933>>>>>    Function Sum_SubTotal Integer iTotal Returns Number
78935>>>>>        Number nRetVal
78935>>>>>        Get Number_Value of (RptTotal(Main_Report_Id(Self))) iTotal to nRetVal
78936>>>>>        Function_Return nRetVal
78937>>>>>    End_Function
78938>>>>>    
78938>>>>>    //Return sub-total and clear accumulator
78938>>>>>    //
78938>>>>>    Function SubTotal Integer iTotal Returns Number
78940>>>>>        Number nRetVal
78940>>>>>        Get Sum_SubTotal  iTotal to nRetVal
78941>>>>>        Send Clr_SubTotal iTotal
78942>>>>>        Function_Return nRetVal
78943>>>>>    End_Function
78944>>>>>    
78944>>>>>    
78944>>>>>    // Note: Cols is optional. If no argument is passed it will use
78944>>>>>    //       the object's property Print_Columns (0 by default)
78944>>>>>    //
78944>>>>>    Procedure DFNew_Page Integer Cols
78946>>>>>        Integer PageNumber Columns
78946>>>>>        Boolean bFirstPagePrinted
78946>>>>>        // If no args passed used default setting
78946>>>>>        If (Num_Arguments=0) ;            Move (Print_Columns(Main_Report_id(Self))) to Columns
78949>>>>>        Else ;            Move Cols to Columns
78951>>>>>        Set Page_Feed   to -2   // No FormFeed
78952>>>>>        If (Child_Rpt_State(Self)) ;            Send DFNew_Page of (Main_Report_Id(Self)) Columns
78955>>>>>        Else Begin
78956>>>>>            // we only want to print report_header once. When report starts
78956>>>>>            // this is set true, after the first print it is false. You can set
78956>>>>>            // this to true before and explicit dfNew_page to force a header
78956>>>>>            Get pbFirstPagePrinted to bFirstPagePrinted
78957>>>>>            Get  DFNewPage of (phoWinPrint(Self)) Columns to PageNumber
78958>>>>>            If (PageNumber<>0) Begin // if 0, it failed
78960>>>>>                Set No_PageCheck_State to True
78961>>>>>                
78961>>>>>                //Top section
78961>>>>>                Send Page_Top
78962>>>>>                If not bFirstPagePrinted ;                    Send Report_Header
78965>>>>>                Send Page_Header
78966>>>>>                Send Page_Title
78967>>>>>                
78967>>>>>                Set New_Page_State to False
78968>>>>>                Set Page_End_State to False
78969>>>>>                Set No_PageCheck_State to False        // No longer Paging
78970>>>>>                Set pbFirstPagePrinted to True
78971>>>>>            End
78971>>>>>>
78971>>>>>        End
78971>>>>>>
78971>>>>>        
78971>>>>>        // Footer section
78971>>>>>        //
78971>>>>>        // DO NOT CHANGE THE ORDER OF BOTTOM SECTIONS !!!!!
78971>>>>>        //
78971>>>>>        
78971>>>>>        Send Page_Bottom
78972>>>>>        
78972>>>>>        // in WinPrint it is not possible to replace Page_Footer
78972>>>>>        // with Report_Footer. If you use Report_Footer you will
78972>>>>>        // have both Page_Footer and Report_Footer
78972>>>>>        //
78972>>>>>        //If LastTime eq 0 Send Page_Footer
78972>>>>>        //else             Send Report_Footer
78972>>>>>        
78972>>>>>        Send Page_Footer
78973>>>>>        Send Page_Total
78974>>>>>    End_Procedure
78975>>>>>    
78975>>>>>    Procedure Ending_Main_Report
78977>>>>>        Boolean bCancel bMultiReports
78977>>>>>        
78977>>>>>        Get Cancelled_state to bCancel
78978>>>>>        Get pbMultiReports to bMultiReports
78979>>>>>        
78979>>>>>        Forward Send Ending_Main_Report
78981>>>>>        
78981>>>>>        If bCancel Begin
78983>>>>>            Send DFEndDocument
78984>>>>>            Send DFClearDoc // this will also close the previewer
78985>>>>>        End
78985>>>>>>
78985>>>>>        Else Begin
78986>>>>>            Send Report_Footer
78987>>>>>            
78987>>>>>            // if multi-reports, we don't do an end of report yet. The programmer must
78987>>>>>            // manually end the report by sending EndMultiReport
78987>>>>>            If (not(bMultiReports)) Begin
78989>>>>>                Send EndWinPrintReport
78990>>>>>            End
78990>>>>>>
78990>>>>>            
78990>>>>>        End
78990>>>>>>
78990>>>>>        
78990>>>>>    End_Procedure
78991>>>>>    
78991>>>>>    // This must get called when you are running multiple reports (pbMultiReport).
78991>>>>>    // Send this when the last report is complete.
78991>>>>>    Procedure EndMultiReport
78993>>>>>        Send EndWinPrintReport
78994>>>>>    End_Procedure
78995>>>>>    
78995>>>>>    
78995>>>>>    Procedure EndWinPrintReport
78997>>>>>        Boolean bAutoOutput
78997>>>>>        Integer iStatus eMode
78997>>>>>        Get DocumentStatus to iStatus
78998>>>>>        If (iStatus<>dsStarted) ;            Procedure_Return
79001>>>>>        
79001>>>>>        // this tells winprint that the report is complete
79001>>>>>        Send DFEndDocument
79002>>>>>        // if auto-output we print or display automatically.
79002>>>>>        // for winprint2, if in preview mode you must do this so the previewer can enter
79002>>>>>        // a modal state (which it may or may not need to do).
79002>>>>>        Get AutoOutput_state to bAutoOutput
79003>>>>>        Get Output_device_mode to eMode
79004>>>>>        If (bAutoOutput or eMode=PRINT_TO_WINDOW) Begin
79006>>>>>            Send PrintReport
79007>>>>>            // if auto output, we assume that you are done when it is all over
79007>>>>>            // we only can do this with the modal viewer
79007>>>>>            If (bAutoOutput and pbModalViewer(Self)) Begin
79009>>>>>                Send DFClearDoc
79010>>>>>            End
79010>>>>>>
79010>>>>>        End
79010>>>>>>
79010>>>>>        
79010>>>>>    End_Procedure
79011>>>>>    
79011>>>>>    
79011>>>>>    Function Setup_Report Returns Integer
79013>>>>>        Integer iErr iStatus eMode
79013>>>>>        Boolean bActiveViewer bChildReport bMultiReports bOk
79013>>>>>        
79013>>>>>        Get Child_rpt_state to bChildReport
79014>>>>>        
79014>>>>>        If not bChildReport Begin
79016>>>>>            
79016>>>>>            // This makes sure that we are pointing to the new winprint2 engine object.
79016>>>>>            // normally this will be the new winprint, but it can be redirected
79016>>>>>            Get phoWinPrint to WinPrintID
79017>>>>>            
79017>>>>>            // winprint must have installed printer. If not installed, generate error and stop the report
79017>>>>>            Get ArePrintersInstalled to bOk
79018>>>>>            If not bOk Begin
79020>>>>>                Error DFERR_WINPRINT C_$NoInstalledPrinters
79021>>>>>>
79021>>>>>                Function_Return 1
79022>>>>>            End
79022>>>>>>
79022>>>>>            
79022>>>>>            // check if selected printer is valid. If not, generate error and stop the report
79022>>>>>            Get IsPrinterValid to bOk
79023>>>>>            If not bOk Begin
79025>>>>>                Error DFERR_WINPRINT DFPrintError936    // Could not select a valid printer
79026>>>>>>
79026>>>>>                Function_Return 1
79027>>>>>            End
79027>>>>>>
79027>>>>>            
79027>>>>>            // make sure it is ok to start a new report but try to be smart about it.
79027>>>>>            // if a report is active (dsstarted or dsFinished) check to see if it is
79027>>>>>            // finished w/ no viewer. If so, assume the user closed the report and is done
79027>>>>>            // so just clear the report. If a viewer is present, declare an error.
79027>>>>>            Get DocumentStatus to iStatus
79028>>>>>            Get pbMultiReports to bMultiReports
79029>>>>>            // multi-report only in-progress is multi and it is started
79029>>>>>            Move (bMultiReports and iStatus=dsStarted) to bMultiReports
79030>>>>>            If not bMultiReports Begin
79032>>>>>                If (iStatus<>dsNotStarted) Begin
79034>>>>>                    Get IsViewerActive to bActiveViewer
79035>>>>>                    If (iStatus=dsFinished and not(bActiveViewer)) Begin
79037>>>>>                        Send DfClearDoc
79038>>>>>                    End
79038>>>>>>
79038>>>>>                    Else Begin
79039>>>>>                        Error DFERR_WINPRINT DFPrintError967
79040>>>>>>
79040>>>>>                        Function_Return 1
79041>>>>>                    End
79041>>>>>>
79041>>>>>                End
79041>>>>>>
79041>>>>>                
79041>>>>>                // all new reports by default allow printing from viewer and they have the print job set up when you select print
79041>>>>>                // if you need to change these defaults, you can change these inside of Starting_main_report
79041>>>>>                // We only do this with non-multi-reports.
79041>>>>>                Send DFSetPrintDlgInPreview      True
79042>>>>>                Send DFSetEnablePrintFromPreview True
79043>>>>>                
79043>>>>>            End
79043>>>>>>
79043>>>>>            
79043>>>>>            // In the new winprint, this message is not needed and is a stub. For
79043>>>>>            // now it is in here for compatibility purposes
79043>>>>>            //You MUST always start a new report with this procedure
79043>>>>>            Send DFZeroCounters of (phoWinPrint(Self))
79044>>>>>            Send Clr_AllSubTotals
79045>>>>>            
79045>>>>>        End
79045>>>>>>
79045>>>>>        
79045>>>>>        Forward Get Setup_report to iErr
79047>>>>>        
79047>>>>>        If (iErr=0) Begin
79049>>>>>            If not bChildReport Begin
79051>>>>>                // if part of a multi-report we don't do a new doc
79051>>>>>                If not bMultiReports Begin
79053>>>>>                    Get Output_Device_Mode to eMode
79054>>>>>                    Send DFNewDoc of (phoWinPrint(Self))  (eMode = PRINT_TO_WINDOW) // pass True of display while printing
79055>>>>>                End
79055>>>>>>
79055>>>>>                // Do new page if not part of a multi-report and we say don't do a new page
79055>>>>>                If (not(bMultiReports) or AutoNew_Page_State(Self)) Begin
79057>>>>>                    Set pbFirstPagePrinted to False // tells new page that this is the first time for this report
79058>>>>>                    Send DFNew_page
79059>>>>>                End
79059>>>>>>
79059>>>>>            End
79059>>>>>>
79059>>>>>        End
79059>>>>>>
79059>>>>>        Function_Return iErr
79060>>>>>    End_Function
79061>>>>>    
79061>>>>>    
