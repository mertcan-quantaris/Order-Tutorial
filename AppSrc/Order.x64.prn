77092>>>>>>>>>Class cFormatter is an cObject
77093>>>>>>>>>    
77093>>>>>>>>>    Procedure Construct_object
77095>>>>>>>>>        Integer iCh
77095>>>>>>>>>        Forward Send construct_object
77097>>>>>>>>>        Property String  psCurrencySymbol
77098>>>>>>>>>        Set psCurrencySymbol to (Default_Currency_Symbol())
77099>>>>>>>>>        
77099>>>>>>>>>        Property String  psLeft
77100>>>>>>>>>        Property String  psright
77101>>>>>>>>>        Property Integer pbThousandsSep
77102>>>>>>>>>        Property Integer piPoints
77103>>>>>>>>>        
77103>>>>>>>>>        Property String  psCurPosLeft
77104>>>>>>>>>        Property String  psCurPosright
77105>>>>>>>>>        Property Integer pbCurPosThousandsSep
77106>>>>>>>>>        Property Integer piCurPosPoints
77107>>>>>>>>>        
77107>>>>>>>>>        Property String  psCurNegLeft
77108>>>>>>>>>        Property String  psCurNegright
77109>>>>>>>>>        Property Integer pbCurNegThousandsSep
77110>>>>>>>>>        Property Integer piCurNegPoints
77111>>>>>>>>>        
77111>>>>>>>>>        Property String  psNumPosLeft
77112>>>>>>>>>        Property String  psNumPosright
77113>>>>>>>>>        Property Integer pbNumPosThousandsSep
77114>>>>>>>>>        Property Integer piNumPosPoints
77115>>>>>>>>>        
77115>>>>>>>>>        Property String  psNumNegLeft
77116>>>>>>>>>        Property String  psNumNegright
77117>>>>>>>>>        Property Integer pbNumNegThousandsSep
77118>>>>>>>>>        Property Integer piNumNegPoints
77119>>>>>>>>>        
77119>>>>>>>>>        Send SetFormat "$,#.##;($,#.##)" True  // currency
77120>>>>>>>>>        Send SetFormat  ",#.*"           False // numeric
77121>>>>>>>>>        
77121>>>>>>>>>    End_Procedure
77122>>>>>>>>>    
77122>>>>>>>>>    // internal
77122>>>>>>>>>    // parse passed format string and set temporary properties with result
77122>>>>>>>>>    Procedure ParseFormat String sFmt
77124>>>>>>>>>        
77124>>>>>>>>>        String sLeft sRight sDigit
77124>>>>>>>>>        Integer bSep iPos i iDigits
77124>>>>>>>>>        
77124>>>>>>>>>        // replace any literals. A "/" followed by anything.
77124>>>>>>>>>        // some literals are special. $ . , / #
77124>>>>>>>>>        Move (Replaces("/$",sFmt,Character(1)))    to sFmt
77125>>>>>>>>>        Move (Replaces("/.",sFmt,Character(2)))    to sFmt
77126>>>>>>>>>        Move (Replaces("/,",sFmt,Character(3)))    to sFmt
77127>>>>>>>>>        Move (Replaces("/"+"/",sFmt,Character(4))) to sFmt
77128>>>>>>>>>        Move (Replaces("/#",sFmt,Character(5)))    to sFmt
77129>>>>>>>>>        Move (Character(9)) to sDigit
77130>>>>>>>>>        Move (Replaces("#",sFmt,sDigit))           to sFmt
77131>>>>>>>>>        Move (Replaces("/",sFmt,""))               to sFmt // replace all others
77132>>>>>>>>>        
77132>>>>>>>>>        Move (Pos(",",sFmt))                 to bSep // if we have any , we use thousand seps
77133>>>>>>>>>        If bSep ;            Move (Replaces(",",sFmt,"")) to sFmt // remove all ,
77136>>>>>>>>>        
77136>>>>>>>>>        Move (Replaces("$",sFmt,psCurrencySymbol(Self))) to sFmt // replace any $ with currency symbol
77137>>>>>>>>>        
77137>>>>>>>>>        Move (Pos(".",sFmt)) to iPos                 // position of decimal
77138>>>>>>>>>        
77138>>>>>>>>>        // Move all the special literals back into place before parsing
77138>>>>>>>>>        Move (Replaces(Character(1),sFmt,"$")) to sFmt
77139>>>>>>>>>        Move (Replaces(Character(2),sFmt,".")) to sFmt
77140>>>>>>>>>        Move (Replaces(Character(3),sFmt,",")) to sFmt
77141>>>>>>>>>        Move (Replaces(Character(4),sFmt,"/")) to sFmt
77142>>>>>>>>>        Move (Replaces(Character(5),sFmt,"#")) to sFmt
77143>>>>>>>>>        
77143>>>>>>>>>        If (iPos>0) Begin                      // if we have a decimanl point
77145>>>>>>>>>            Move 1 to i                        // look for first non # to right and count the #s
77146>>>>>>>>>            If (mid(sFmt,1,iPos+i)="*") Begin  // the "*" is special. It means as many as you want
77148>>>>>>>>>                Move -2 to iDigits
77149>>>>>>>>>                Increment i
77150>>>>>>>>>            End
77150>>>>>>>>>>
77150>>>>>>>>>            While (mid(sFmt,1,iPos+i)=sDigit)
77154>>>>>>>>>                Increment i
77155>>>>>>>>>            Loop
77156>>>>>>>>>>
77156>>>>>>>>>            Move (Mid(sFmt,255,iPos+i)) to sRight // everything to the right of the last # is format stuff
77157>>>>>>>>>            If (iDigits=0) ;                Move (i-1) to iDigits
77160>>>>>>>>>            //
77160>>>>>>>>>            Move 1 to i                           // find the first non-# to the left of the point
77161>>>>>>>>>            While (mid(sFmt,1,iPos-i)=sDigit)     // everything to the left is format stuff
77165>>>>>>>>>                Increment i
77166>>>>>>>>>            Loop
77167>>>>>>>>>>
77167>>>>>>>>>            Move (left(sFmt,iPos-i)) to sLeft
77168>>>>>>>>>        End
77168>>>>>>>>>>
77168>>>>>>>>>        Else Begin                             // we have no decinal
77169>>>>>>>>>            Move 0 to iDigits                  // so points is none
77170>>>>>>>>>            Move (Pos(sDigit,sFmt)) to iPos    // find first #.
77171>>>>>>>>>            If (iPos=0) Begin                  // if none, entire string is left format stuff..wierd!
77173>>>>>>>>>                Move sFmt to sLeft
77174>>>>>>>>>                Move ""   to sRight
77175>>>>>>>>>            End
77175>>>>>>>>>>
77175>>>>>>>>>            Else Begin
77176>>>>>>>>>                Move (left(sFmt,iPos-1)) to sLeft // all char to left of first # is left format stuff
77177>>>>>>>>>                Move 1 to i
77178>>>>>>>>>                While (mid(sFmt,1,iPos+i)=sDigit) // find last #, all char to right is right format
77182>>>>>>>>>                    Increment i
77183>>>>>>>>>                Loop
77184>>>>>>>>>>
77184>>>>>>>>>                Move (Mid(sFmt,255,i+iPos)) to sRight
77185>>>>>>>>>            End
77185>>>>>>>>>>
77185>>>>>>>>>        End
77185>>>>>>>>>>
77185>>>>>>>>>        // set temporary format properties and exit
77185>>>>>>>>>        Set pbThousandsSep to bSep
77186>>>>>>>>>        Set psLeft         to sLeft
77187>>>>>>>>>        Set psRight        to sRight
77188>>>>>>>>>        Set piPoints       to iDigits
77189>>>>>>>>>    End_Procedure
77190>>>>>>>>>    
77190>>>>>>>>>    // Public: Sets a format string. Pass full format for Positve and negative in sFmt. Pass
77190>>>>>>>>>    //         bCurrency true is this is a currency format, false if a numeric format
77190>>>>>>>>>    //
77190>>>>>>>>>    //  e.g. Send SetFormat "$,#.##;($,#.##)" True
77190>>>>>>>>>    Procedure SetFormat String sFmt Integer bCurrency
77192>>>>>>>>>        String sPos sNeg
77192>>>>>>>>>        Integer iPos
77192>>>>>>>>>        
77192>>>>>>>>>        Move (Pos(";",sFmt)) to iPos
77193>>>>>>>>>        If iPos Begin
77195>>>>>>>>>            Move (left(sFmt,iPos-1))    to sPos
77196>>>>>>>>>            Move (mid(sFmt,255,iPos+1)) to sNeg
77197>>>>>>>>>        End
77197>>>>>>>>>>
77197>>>>>>>>>        Else Begin
77198>>>>>>>>>            Move sFmt         to sPos
77199>>>>>>>>>            Move ("-" + sFmt) to sNeg
77200>>>>>>>>>        End
77200>>>>>>>>>>
77200>>>>>>>>>        Send ParseFormat sPos
77201>>>>>>>>>        If bCurrency Begin
77203>>>>>>>>>            Set pbCurPosThousandsSep to (pbThousandsSep(Self))
77204>>>>>>>>>            Set psCurPosLeft         to (psLeft(Self))
77205>>>>>>>>>            Set psCurPosRight        to (psRight(Self))
77206>>>>>>>>>            Set piCurPosPoints       to (piPoints(Self))
77207>>>>>>>>>        End
77207>>>>>>>>>>
77207>>>>>>>>>        Else Begin
77208>>>>>>>>>            Set pbNumPosThousandsSep to (pbThousandsSep(Self))
77209>>>>>>>>>            Set psNumPosLeft         to (psLeft(Self))
77210>>>>>>>>>            Set psNumPosRight        to (psRight(Self))
77211>>>>>>>>>            Set piNumPosPoints       to (piPoints(Self))
77212>>>>>>>>>        End
77212>>>>>>>>>>
77212>>>>>>>>>        
77212>>>>>>>>>        Send ParseFormat sNeg
77213>>>>>>>>>        If bCurrency Begin
77215>>>>>>>>>            Set pbCurNegThousandsSep to (pbThousandsSep(Self))
77216>>>>>>>>>            Set psCurNegLeft         to (psLeft(Self))
77217>>>>>>>>>            Set psCurNegRight        to (psRight(Self))
77218>>>>>>>>>            Set piCurNegPoints       to (piPoints(Self))
77219>>>>>>>>>        End
77219>>>>>>>>>>
77219>>>>>>>>>        Else Begin
77220>>>>>>>>>            Set pbNumNegThousandsSep to (pbThousandsSep(Self))
77221>>>>>>>>>            Set psNumNegLeft         to (psLeft(Self))
77222>>>>>>>>>            Set psNumNegRight        to (psRight(Self))
77223>>>>>>>>>            Set piNumNegPoints       to (piPoints(Self))
77224>>>>>>>>>        End
77224>>>>>>>>>>
77224>>>>>>>>>    End_Procedure
77225>>>>>>>>>    
77225>>>>>>>>>    // low level formatting. Pass parameters
77225>>>>>>>>>    Function Format_Num Number nNumber Integer iPoints Integer bSep ;            String sPrefix String sSuffix Returns String
77227>>>>>>>>>        String  sLeft sRight sNumber sSep sDec
77227>>>>>>>>>        Integer iDec iLen iCh
77227>>>>>>>>>        
77227>>>>>>>>>        Get_Attribute DF_DECIMAL_SEPARATOR to iCh
77230>>>>>>>>>        Move (Character(iCh)) to sDec
77231>>>>>>>>>        
77231>>>>>>>>>        Move (abs(nNumber)) to sNumber
77232>>>>>>>>>        Move (Pos(sDec,sNumber)) to iDec
77233>>>>>>>>>        Move (If(iDec=0, sNumber, left(sNumber,iDec-1))) to sLeft
77234>>>>>>>>>        Move (If(iDec=0, "", mid(sNumber,255,iDec+1)))   to sRight
77235>>>>>>>>>        // format for decimal separator
77235>>>>>>>>>        If (iPoints>=0) ; // if -2, leave it alone, it should not be -1            Move (left(sRight+Repeat("0",iPoints),iPoints)) to sRight
77238>>>>>>>>>        
77238>>>>>>>>>        // format for thousand sep.
77238>>>>>>>>>        If bSep Begin
77240>>>>>>>>>            Get_Attribute DF_THOUSANDS_SEPARATOR to iCh
77243>>>>>>>>>            Move (Character(iCh)) to sSep
77244>>>>>>>>>            Move (Length(sLeft)) to iLen
77245>>>>>>>>>            While (iLen>3)
77249>>>>>>>>>                Move (insert(sSep,sLeft,iLen-2)) to sLeft
77250>>>>>>>>>                Move (iLen-3) to iLen
77251>>>>>>>>>            Loop
77252>>>>>>>>>>
77252>>>>>>>>>        End
77252>>>>>>>>>>
77252>>>>>>>>>        // if decimal points or -2 (allow anything) and there are points to show
77252>>>>>>>>>        If (iPoints>0 or (iPoints=-2 and sRight<>"")) ;            Move (sLeft + sDec + sright) to sLeft
77255>>>>>>>>>        Function_Return (sPrefix + sLeft+ sSuffix)
77256>>>>>>>>>    End_Function
77257>>>>>>>>>    
77257>>>>>>>>>    // Public: Format for currency
77257>>>>>>>>>    Function FormatCur Number nNumber Integer iPoints Returns String
77259>>>>>>>>>        String  sLeft sRight
77259>>>>>>>>>        Integer bSep
77259>>>>>>>>>        If (nNumber<0) Begin
77261>>>>>>>>>            Get pbCurNegThousandsSep to bSep
77262>>>>>>>>>            Get psCurNegLeft         to sLeft
77263>>>>>>>>>            Get psCurNegRight        to sRight
77264>>>>>>>>>            If (iPoints=-1) ;                Get piCurNegPoints       to iPoints
77267>>>>>>>>>        End
77267>>>>>>>>>>
77267>>>>>>>>>        Else Begin
77268>>>>>>>>>            Get pbCurPosThousandsSep to bSep
77269>>>>>>>>>            Get psCurPosLeft         to sLeft
77270>>>>>>>>>            Get psCurPosRight        to sRight
77271>>>>>>>>>            If (iPoints=-1) ;                Get piCurPosPoints       to iPoints
77274>>>>>>>>>        End
77274>>>>>>>>>>
77274>>>>>>>>>        Function_Return (Format_Num(Self, nNumber,iPoints,bSep,sLeft,sRight))
77275>>>>>>>>>    End_Function
77276>>>>>>>>>    
77276>>>>>>>>>    // Public: Format for numeric
77276>>>>>>>>>    Function FormatNum Number nNumber Integer iPoints Returns String
77278>>>>>>>>>        String  sLeft sRight
77278>>>>>>>>>        Integer bSep
77278>>>>>>>>>        If (nNumber<0) Begin
77280>>>>>>>>>            Get pbNumNegThousandsSep to bSep
77281>>>>>>>>>            Get psNumNegLeft         to sLeft
77282>>>>>>>>>            Get psNumNegRight        to sRight
77283>>>>>>>>>            If (iPoints=-1) ;                Get piNumNegPoints       to iPoints
77286>>>>>>>>>        End
77286>>>>>>>>>>
77286>>>>>>>>>        Else Begin
77287>>>>>>>>>            Get pbNumPosThousandsSep to bSep
77288>>>>>>>>>            Get psNumPosLeft         to sLeft
77289>>>>>>>>>            Get psNumPosRight        to sRight
77290>>>>>>>>>            If (iPoints=-1) ;                Get piNumPosPoints       to iPoints
77293>>>>>>>>>        End
77293>>>>>>>>>>
77293>>>>>>>>>        Function_Return (Format_Num(Self, nNumber,iPoints,bSep,sLeft,sRight))
77294>>>>>>>>>    End_Function
77295>>>>>>>>>    
77295>>>>>>>>>    
77295>>>>>>>>>    // Public: Format passing format string
77295>>>>>>>>>    Function FormatVal Number nNumber String sFmt Returns String
77297>>>>>>>>>        Integer iPos bIsNeg
77297>>>>>>>>>        String  sLeft sRight
77297>>>>>>>>>        Integer iPoints bSep
77297>>>>>>>>>        Move (nNumber<0) to bIsNeg
77298>>>>>>>>>        Move (Pos(";",sFmt)) to iPos
77299>>>>>>>>>        Case Begin
77299>>>>>>>>>            Case (iPos and not(bIsNeg)) ;                Move (left(sFmt,iPos-1))    to sFmt
77302>>>>>>>>>            Case (iPos and bIsNeg) ;                Move (mid(sFmt,255,iPos+1)) to sFmt
77306>>>>>>>>>            Case (not(iPos) and not(bIsNeg)) ;                Move sFmt                   to sFmt
77310>>>>>>>>>            Case Else ;                Move ("-" + sFmt)           to sFmt
77312>>>>>>>>>        Case End
77312>>>>>>>>>        Send ParseFormat sFmt
77313>>>>>>>>>        Get pbThousandsSep to bSep
77314>>>>>>>>>        Get psLeft         to sLeft
77315>>>>>>>>>        Get psRight        to sRight
77316>>>>>>>>>        Get piPoints       to iPoints
77317>>>>>>>>>        Function_Return (Format_Num(Self, nNumber,iPoints,bSep,sLeft,sRight))
77318>>>>>>>>>    End_Function
77319>>>>>>>>>    
77319>>>>>>>>>End_Class
