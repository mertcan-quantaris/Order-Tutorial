75184>>>>>>>Class cDFBtrDrvHandler is an Array
75185>>>>>>>    
75185>>>>>>>    Procedure Construct_Object Integer iImage
75187>>>>>>>        Forward Send Construct_object iImage
75189>>>>>>>        
75189>>>>>>>        Property String  psDriverID "DFBTRDRV"
75190>>>>>>>    End_Procedure
75191>>>>>>>    
75191>>>>>>>    //  The revsion of a Dfbtrdrv Connectivity Kit
75191>>>>>>>    //
75191>>>>>>>    
75191>>>>>>>    Function CKRevision Returns String
75193>>>>>>>        String  sDriverID
75193>>>>>>>        String  sRevision
75193>>>>>>>        String  sVoid
75193>>>>>>>        Integer iRetval
75193>>>>>>>        
75193>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75193>>>>>>>        // This error would otherwise be raised when we have an older
75193>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75193>>>>>>>        Send Ignore_error to Error_object_Id 20491
75194>>>>>>>        Get psDriverID to sDriverID
75195>>>>>>>        Move (Repeat(" ", 255)) to sRevision
75196>>>>>>>        Call_Driver 0 sDRiverID Function DFBTRFN_CKREVISION Callback 0 Passing sRevision sVoid 0 Result iRetval
75201>>>>>>>        Send Trap_Error to Error_object_Id 20491
75202>>>>>>>        If (Trim(sRevision) = "") Begin
75204>>>>>>>            // Unable to get the revision. return all zeroes.
75204>>>>>>>            Move "0.0.0.0" to sRevision
75205>>>>>>>        End
75205>>>>>>>>
75205>>>>>>>        Function_Return sRevision
75206>>>>>>>    End_Function
75207>>>>>>>    
75207>>>>>>>    Function CkUsesUri Returns Integer
75209>>>>>>>        String  sDriverID
75209>>>>>>>        String  sVoid1
75209>>>>>>>        String  sVoid2
75209>>>>>>>        Integer iRetval
75209>>>>>>>        
75209>>>>>>>        Get psDriverID to sDriverID
75210>>>>>>>        
75210>>>>>>>        Move 0 to iRetval
75211>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75211>>>>>>>        // This error would otherwise be raised when we have an older
75211>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKUSESURI function
75211>>>>>>>        Send Ignore_error to Error_object_Id 20491
75212>>>>>>>        Call_Driver 0 sDRiverID Function DFBTRFN_CKUSESURI Callback 0 Passing sVoid1 sVoid2 0 Result iRetval
75217>>>>>>>        Send Trap_Error to Error_object_Id 20491
75218>>>>>>>        
75218>>>>>>>        Function_Return iRetval
75219>>>>>>>    End_Function
75220>>>>>>>    
75220>>>>>>>    
75220>>>>>>>    
75220>>>>>>>    // Extract the Nth part of a a.b.c.d revsion string.
75220>>>>>>>    //
75220>>>>>>>    // Returns : The part version number or -1 if there is no such part number.
75220>>>>>>>    //
75220>>>>>>>    
75220>>>>>>>    Function ExtractPartFromRevision Integer iPartNum String sRevision Returns Integer
75222>>>>>>>        Integer iPartRev
75222>>>>>>>        Integer iCurrentPart
75222>>>>>>>        Integer iSeparatorPos
75222>>>>>>>        
75222>>>>>>>        If (iPartNum > 4) ;            Function_Return -1
75225>>>>>>>        
75225>>>>>>>        Move 0 to iCurrentPart
75226>>>>>>>        Repeat
75226>>>>>>>>
75226>>>>>>>            Move (Pos(".", sRevision)) to iSeparatorPos
75227>>>>>>>            If (iSeparatorPos > 0) Begin
75229>>>>>>>                Move (Left(sRevision, iSeparatorPos - 1)) to iPartRev
75230>>>>>>>                Move (Right(sRevision, Length(sRevision) - iSeparatorPos)) to sRevision
75231>>>>>>>                Increment iCurrentPart
75232>>>>>>>            End
75232>>>>>>>>
75232>>>>>>>            Else If (sRevision <> "") Begin
75235>>>>>>>                Move sRevision to iPartRev
75236>>>>>>>                Move "" to sRevision
75237>>>>>>>                Increment iCurrentPart
75238>>>>>>>            End
75238>>>>>>>>
75238>>>>>>>            Else ;                Move -1 to iPartRev
75240>>>>>>>        Until (iCurrentPart >= iPartNum or iPartRev = -1)
75242>>>>>>>        
75242>>>>>>>        Function_Return iPartRev
75243>>>>>>>    End_Function
75244>>>>>>>    
75244>>>>>>>    
75244>>>>>>>    
75244>>>>>>>    //
75244>>>>>>>    //  Returns the major revision of the CK
75244>>>>>>>    //
75244>>>>>>>    
75244>>>>>>>    Function CKMajorRevision Returns Integer
75246>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 1, CKRevision(Current_Object)))
75247>>>>>>>    End_Function
75248>>>>>>>    
75248>>>>>>>    
75248>>>>>>>    
75248>>>>>>>    //  Returns the minor revision of the CK
75248>>>>>>>    //
75248>>>>>>>    
75248>>>>>>>    Function CKMinorRevision Returns Integer
75250>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 2, CKRevision(Current_Object)))
75251>>>>>>>    End_Function
75252>>>>>>>    
75252>>>>>>>    
75252>>>>>>>    //  Returns the release revision of the CK
75252>>>>>>>    //
75252>>>>>>>    
75252>>>>>>>    Function CKReleaseRevision Returns Integer
75254>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 3, CKRevision(Current_Object)))
75255>>>>>>>    End_Function
75256>>>>>>>    
75256>>>>>>>    
75256>>>>>>>    //  Returns the major revision of the CK
75256>>>>>>>    //
75256>>>>>>>    
75256>>>>>>>    Function CKBuildRevision Returns Integer
75258>>>>>>>        Function_Return (ExtractPartFromRevision (Current_Object, 4, CKRevision(Current_Object)))
75259>>>>>>>    End_Function
75260>>>>>>>    
75260>>>>>>>    
75260>>>>>>>    //  Determines if the CK conforms to a passed minimal revsion.
75260>>>>>>>    //
75260>>>>>>>    
75260>>>>>>>    Function IsMinimalRevision Integer iMajor Integer iMinor Integer iRelease Integer iBuild Returns Integer
75262>>>>>>>        If (iMajor < CKMajorRevision(Current_object)) ;            Function_Return (True)
75265>>>>>>>        Else If (iMajor = CKMajorRevision(Current_object)) Begin
75268>>>>>>>            If (iMinor < CKMinorRevision(Current_object)) ;                Function_Return (True)
75271>>>>>>>            Else If (iMinor = CKMinorRevision(Current_object)) Begin
75274>>>>>>>                If (iRelease < CKReleaseRevision(Current_object)) ;                    Function_Return (True)
75277>>>>>>>                Else If (iRelease = CKReleaseRevision(Current_object) and iBuild <= CKBuildRevision(Current_object)) ;                    Function_Return (True)
75281>>>>>>>            End
75281>>>>>>>>
75281>>>>>>>        End
75281>>>>>>>>
75281>>>>>>>        
75281>>>>>>>        Function_Return (False)
75282>>>>>>>    End_Function
75283>>>>>>>    
75283>>>>>>>    //   Functions to query the Pervasive.SQL version:
75283>>>>>>>    //       PSQLRequesterVersionInfo    Integer iFileNum Returns String
75283>>>>>>>    //       PSQLLocalEngineVersionInfo  Integer iFileNum Returns String
75283>>>>>>>    //       PSQLServerEngineVersionInfo Integer iFileNum Returns String
75283>>>>>>>    //
75283>>>>>>>    //   All 3 functions return the version of a Pervasive.SQL component
75283>>>>>>>    //   in the following format:
75283>>>>>>>    //       <version>.<revision>.<type>
75283>>>>>>>    //   possible values for <type>:
75283>>>>>>>    //       9 for 32-bit Windows workstation/workgroup engine or Linux
75283>>>>>>>    //         server using Workgroup authentication mode
75283>>>>>>>    //       C for client cache engine
75283>>>>>>>    //       D for DOS workstation
75283>>>>>>>    //       N for client Requester
75283>>>>>>>    //       S for NetWare server
75283>>>>>>>    //       T for 32-bit Windows server engine
75283>>>>>>>    //       U for Linux server using PAM or BTPASSWD authentication
75283>>>>>>>    //
75283>>>>>>>    //   example:
75283>>>>>>>    //       8.50.T
75283>>>>>>>    //   will be returned for a Pervasive.SQL 8.5 Server Engine running on
75283>>>>>>>    //   32-bits Windows server.
75283>>>>>>>    //
75283>>>>>>>    //   The FileNumber parameter must specify an opened table or 0.
75283>>>>>>>    //   For PSQLServerEngineVersionInfo the FileNumber can not be 0.
75283>>>>>>>    //
75283>>>>>>>    //   If the version information is not available or can not be obtained
75283>>>>>>>    //   the functions will return "0.0.0"
75283>>>>>>>    
75283>>>>>>>    //  Returns the version information of the
75283>>>>>>>    //           Pervasive.SQL Client requester.
75283>>>>>>>    
75283>>>>>>>    Function PSQLRequesterVersionInfo Integer iFileNum Returns String
75285>>>>>>>        
75285>>>>>>>        String  sDriverID
75285>>>>>>>        String  sVersion
75285>>>>>>>        String  sVoid
75285>>>>>>>        Integer iRetval
75285>>>>>>>        
75285>>>>>>>        // Ignore error 20491 DFBTRERR_INVALID_DRIVER_FUNCTION_CALL.
75285>>>>>>>        // This error would otherwise be raised when we have an older
75285>>>>>>>        // DFBTRDRV version that has no DFBTRFN_CKREVISION function
75285>>>>>>>        Send Ignore_error to Error_object_Id 20491
75286>>>>>>>        Get psDriverID to sDriverID
75287>>>>>>>        Move (Repeat(" ", 255)) to sVersion
75288>>>>>>>        Call_Driver iFileNum sDRiverID Function DFBTRFN_PSQLREQUESTERVERSIONINFO Callback 0 Passing sVersion sVoid 0 Result iRetval
75293>>>>>>>        Send Trap_Error to Error_object_Id 20491
75294>>>>>>>        If (Trim(sVersion) = "") Begin
75296>>>>>>>            // Unable to get the revision. return all zeroes.
75296>>>>>>>            Move "0.0.0" to sVersion
75297>>>>>>>        End
75297>>>>>>>>
75297>>>>>>>        Function_Return sVersion
75298>>>>>>>    End_Function
75299>>>>>>>    
