77445>>>>>    Procedure Update
77447>>>>>        Forward Send Update
77449>>>>>        Send Adjust_Balances OrderHeader.Order_Total
77450>>>>>    End_Procedure
77451>>>>>    
77451>>>>>    Procedure Backout
77453>>>>>        Forward Send Backout
77455>>>>>        Send Adjust_Balances (-OrderHeader.Order_Total)
77456>>>>>    End_Procedure
77457>>>>>    
77457>>>>>    Procedure Adjust_Balances Number Amt
77459>>>>>        
77459>>>>>        If (((Amt + Customer.Purchases) < 999999) and ((Amt + Customer.Balance) < 999999)) Begin
77461>>>>>            Add Amt to Customer.Purchases
77462>>>>>            Add Amt to Customer.Balance
77463>>>>>        End
77463>>>>>>
77463>>>>>        Else Begin
77464>>>>>            Send UserError ("The value of" * FormatCurrency(Amt + Customer.Purchases, 2) * "exceeds the maximum amount allowed for customer purchases." * ;                 "Review your order to adjust prices and quantities to be within the limit of" * FormatCurrency(999999, 2)) "Error in updating Customer"
77465>>>>>        End
77465>>>>>>
77465>>>>>    End_Procedure
77466>>>>>    
77466>>>>>    Procedure Deleting
77468>>>>>        Forward Send Deleting
77470>>>>>        // see if we can decrement the order number in sys table...
77470>>>>>        // can only do this if this is the newest order.
77470>>>>>        If (OrderHeader.Order_Number=DFLastID.Order_Number) Begin // if this is
77472>>>>>            Decrement DFLastID.Order_Number          // the last number,
77473>>>>>            SaveRecord DFLastID                      // decrement and save.
77474>>>>>        End
77474>>>>>>
77474>>>>>    End_Procedure
