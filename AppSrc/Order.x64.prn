79515>>>        End_Procedure 
79516>>>
79516>>>        Procedure Page_Title 
79519>>>            string  sFont 
79519>>>            integer iFontSize iHeaderStyle iFill iBorder
79519>>>
79519>>>            Move "arial" to sFont
79520>>>            Move 8 to iFontSize
79521>>>            Move (Font_Bold + rgb_dBlue) to iHeaderStyle
79522>>>            Move (rgb_Grey) to iFill
79523>>>            Move (rgb_Grey) to iBorder
79524>>>
79524>>>            DFFont sFont
79525>>>            DFFontSize iFontSize
79526>>>            DFBeginHeader DFPageTitle
79527>>>                DFHeaderPos   Hdr_Left
79528>>>                DFHeaderFrame Hdr_Margins 0.01 iBorder iFill
79529>>>                DFHeaderMargin HM_TopInner    0.04
79530>>>                DFHeaderMargin HM_BottomInner 0.04
79531>>>                DFHeaderMargin HM_BottomOuter 0.08
79532>>>
79532>>>                DFWritePos "Number"                       (0.08 + 1.22) (iHeaderStyle + Font_Right) -1 1.22
79533>>>                DFWritePos "Name"                         1.38 iHeaderStyle -1 5.11
79534>>>                DFWritePos "Address"                      6.57 iHeaderStyle -1 5.11
79535>>>                DFWritePos "City"                         11.76 iHeaderStyle -1 2.38
79536>>>                DFWritePos "St."                          14.22 iHeaderStyle -1 0.61
79537>>>                DFWritePos "Zip"                          14.91 iHeaderStyle -1 1.7
79538>>>                DFWriteLn
79539>>>            DFEndHeader
79541>>>
79541>>>        End_Procedure 
