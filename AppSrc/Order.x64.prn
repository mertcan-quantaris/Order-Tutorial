79587>>>    Procedure StartReport 
79590>>>        Boolean bToPrinter
79590>>>
79590>>>        // determine if direct print
79590>>>        Get IsToPrinter of oPrintTo to bToPrinter
79591>>>        Set OutPut_Device_Mode of oReport to (If(bToPrinter, PRINT_TO_PRINTER, PRINT_TO_WINDOW))
79592>>>
79592>>>        // run the report
79592>>>        Send Run_Report of oReport
79593>>>
79593>>>    End_Procedure 
79594>>>
79594>>>End_Object 
