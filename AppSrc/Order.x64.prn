75404>>>>>>>    //   Enumerate database in a given server.
75404>>>>>>>    Function EnumerateDatabases String sServer String sUser String sPassWord Returns Integer
75406>>>>>>>        Integer hoSQL
75406>>>>>>>        String  sConnect
75406>>>>>>>        String  sDatabase
75406>>>>>>>        Integer hdbc
75406>>>>>>>        Integer hstmt
75406>>>>>>>        Integer iFetchResult
75406>>>>>>>        
75406>>>>>>>        If (Num_Arguments < 3) ;            Move "" to sPassWord
75409>>>>>>>        If (Num_Arguments < 2) ;            Move "" to sUser
75412>>>>>>>        
75412>>>>>>>        If (sUser <> "") ;            Move ("SERVER=" + Trim(sServer) + ";UID=" + Trim(sUser) + ";PWD=" + Trim(sPassword) + ";") to sConnect
75415>>>>>>>        Else ;            Move ("SERVER=" + Trim(sServer) + ";Trusted_Connection=yes") to sConnect
75417>>>>>>>        
75417>>>>>>>        Object oEnumDBSQLmanager is a cSQLHandleManager
75419>>>>>>>            Move Current_Object to hoSQL
75420>>>>>>>        End_Object
75421>>>>>>>        
75421>>>>>>>        If (hoSQL <> 0) Begin
75423>>>>>>>            Get SQLConnect of hoSQL "MSSQLDRV" sConnect to hdbc
75424>>>>>>>            If (hdbc <> 0) Begin
75426>>>>>>>                Get SQLOpen of hdbc to hstmt
75427>>>>>>>                If (hstmt <> 0) Begin
75429>>>>>>>                    //   We could do a direct select on the sysdatabases table but we use
75429>>>>>>>                    //   the stored procedure sp_database instead. SQL Server recommends this
75429>>>>>>>                    //   approach in case meta data might change, the stored procedure will
75429>>>>>>>                    //   stay the same.
75429>>>>>>>                    Send SQLSetProcedureName to hstmt "sp_databases"
75430>>>>>>>                    Send SQLCall to hstmt
75431>>>>>>>                    Repeat
75431>>>>>>>>
75431>>>>>>>                        Get SQLFetch of hstmt to iFetchResult
75432>>>>>>>                        If (iFetchResult <> 0) Begin
75434>>>>>>>                            Get SQLColumnValue of hstmt 1 to sDatabase
75435>>>>>>>                            Set Value  (Item_Count(Current_Object)) to sDatabase
75436>>>>>>>                        End
75436>>>>>>>>
75436>>>>>>>                    Until (iFetchResult = 0)
75438>>>>>>>                    
75438>>>>>>>                    Send SQLClose to hstmt
75439>>>>>>>                End
75439>>>>>>>>
75439>>>>>>>                Send SQLDisconnect to hdbc
75440>>>>>>>            End
75440>>>>>>>>
75440>>>>>>>        End
75440>>>>>>>>
75440>>>>>>>        Send Destroy_Object to hoSQL
75441>>>>>>>        
75441>>>>>>>        Function_Return (Item_Count(Current_Object))
75442>>>>>>>    End_Function
