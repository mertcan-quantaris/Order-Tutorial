76018>>>//  This is the default message. It is expected that you will
76018>>>//  create your own message to override this
76018>>>Procedure Activate_About
76021>>>    Send DoAbout "" "" "" "" ""
76022>>>End_Procedure
76023>>>
76023>>>//  It is expected that you will send this message (most
76023>>>//  likely from Activate_About. This creates an about object, activates it
76023>>>//  and destroys it when done. It is not exepected that you will augment this.
76023>>>Procedure DoAbout String sTitle String sVersion String sCopyRight String sAuthor String sBitmap
76026>>>    Integer hoObj hoMain
76026>>>    
76026>>>    // create object
76026>>>    Object About is an AboutDialog
76028>>>        // if no title passed use the label of the main panel
76028>>>        // (if a main panel exists).
76028>>>        If (sTitle = "") Begin
76030>>>            Get Main_Window of desktop to hoMain
76031>>>            If hoMain ;                Get Label of hoMain to sTitle
76034>>>        End
76034>>>>
76034>>>        Set productname to sTitle
76035>>>        Set version     to sVersion
76036>>>        Set copyright   to sCopyRight
76037>>>        Set author      to sAuthor
76038>>>        If (sBitmap <> '') ;            Set logo to sBitMap // square bitmaps of 42x42 work best
76041>>>        Move Self to hoObj // object Id
76042>>>    End_Object
76043>>>    Send Popup   of hoObj    // popup the about object
76044>>>    Send Destroy of hoObj // when done, it will be destroyed
76045>>>End_Procedure
