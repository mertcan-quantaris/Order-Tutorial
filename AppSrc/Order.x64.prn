78955>>>>>    
78955>>>>>    // Note: Cols is optional. If no argument is passed it will use
78955>>>>>    //       the object's property Print_Columns (0 by default)
78955>>>>>    //
78955>>>>>    Procedure DFNew_Page Integer Cols
78957>>>>>        Integer PageNumber Columns
78957>>>>>        Boolean bFirstPagePrinted
78957>>>>>        // If no args passed used default setting
78957>>>>>        If (Num_Arguments=0) ;            Move (Print_Columns(Main_Report_id(Self))) to Columns
78960>>>>>        Else ;            Move Cols to Columns
78962>>>>>        Set Page_Feed   to -2   // No FormFeed
78963>>>>>        If (Child_Rpt_State(Self)) ;            Send DFNew_Page of (Main_Report_Id(Self)) Columns
78966>>>>>        Else Begin
78967>>>>>            // we only want to print report_header once. When report starts
78967>>>>>            // this is set true, after the first print it is false. You can set
78967>>>>>            // this to true before and explicit dfNew_page to force a header
78967>>>>>            Get pbFirstPagePrinted to bFirstPagePrinted
78968>>>>>            Get  DFNewPage of (phoWinPrint(Self)) Columns to PageNumber
78969>>>>>            If (PageNumber<>0) Begin // if 0, it failed
78971>>>>>                Set No_PageCheck_State to True
78972>>>>>                
78972>>>>>                //Top section
78972>>>>>                Send Page_Top
78973>>>>>                If not bFirstPagePrinted ;                    Send Report_Header
78976>>>>>                Send Page_Header
78977>>>>>                Send Page_Title
78978>>>>>                
78978>>>>>                Set New_Page_State to False
78979>>>>>                Set Page_End_State to False
78980>>>>>                Set No_PageCheck_State to False        // No longer Paging
78981>>>>>                Set pbFirstPagePrinted to True
78982>>>>>            End
78982>>>>>>
78982>>>>>        End
78982>>>>>>
78982>>>>>        
78982>>>>>        // Footer section
78982>>>>>        //
78982>>>>>        // DO NOT CHANGE THE ORDER OF BOTTOM SECTIONS !!!!!
78982>>>>>        //
78982>>>>>        
78982>>>>>        Send Page_Bottom
78983>>>>>        
78983>>>>>        // in WinPrint it is not possible to replace Page_Footer
78983>>>>>        // with Report_Footer. If you use Report_Footer you will
78983>>>>>        // have both Page_Footer and Report_Footer
78983>>>>>        //
78983>>>>>        //If LastTime eq 0 Send Page_Footer
78983>>>>>        //else             Send Report_Footer
78983>>>>>        
78983>>>>>        Send Page_Footer
78984>>>>>        Send Page_Total
78985>>>>>    End_Procedure
78986>>>>>    
78986>>>>>    Procedure Ending_Main_Report
78988>>>>>        Boolean bCancel bMultiReports
78988>>>>>        
78988>>>>>        Get Cancelled_state to bCancel
78989>>>>>        Get pbMultiReports to bMultiReports
78990>>>>>        
78990>>>>>        Forward Send Ending_Main_Report
78992>>>>>        
78992>>>>>        If bCancel Begin
78994>>>>>            Send DFEndDocument
78995>>>>>            Send DFClearDoc // this will also close the previewer
78996>>>>>        End
78996>>>>>>
78996>>>>>        Else Begin
78997>>>>>            Send Report_Footer
78998>>>>>            
78998>>>>>            // if multi-reports, we don't do an end of report yet. The programmer must
78998>>>>>            // manually end the report by sending EndMultiReport
78998>>>>>            If (not(bMultiReports)) Begin
79000>>>>>                Send EndWinPrintReport
79001>>>>>            End
79001>>>>>>
79001>>>>>            
79001>>>>>        End
79001>>>>>>
79001>>>>>        
79001>>>>>    End_Procedure
79002>>>>>    
79002>>>>>    // This must get called when you are running multiple reports (pbMultiReport).
79002>>>>>    // Send this when the last report is complete.
79002>>>>>    Procedure EndMultiReport
79004>>>>>        Send EndWinPrintReport
79005>>>>>    End_Procedure
79006>>>>>    
79006>>>>>    
79006>>>>>    Procedure EndWinPrintReport
79008>>>>>        Boolean bAutoOutput
79008>>>>>        Integer iStatus eMode
79008>>>>>        Get DocumentStatus to iStatus
79009>>>>>        If (iStatus<>dsStarted) ;            Procedure_Return
79012>>>>>        
79012>>>>>        // this tells winprint that the report is complete
79012>>>>>        Send DFEndDocument
79013>>>>>        // if auto-output we print or display automatically.
79013>>>>>        // for winprint2, if in preview mode you must do this so the previewer can enter
79013>>>>>        // a modal state (which it may or may not need to do).
79013>>>>>        Get AutoOutput_state to bAutoOutput
79014>>>>>        Get Output_device_mode to eMode
79015>>>>>        If (bAutoOutput or eMode=PRINT_TO_WINDOW) Begin
79017>>>>>            Send PrintReport
79018>>>>>            // if auto output, we assume that you are done when it is all over
79018>>>>>            // we only can do this with the modal viewer
79018>>>>>            If (bAutoOutput and pbModalViewer(Self)) Begin
79020>>>>>                Send DFClearDoc
79021>>>>>            End
79021>>>>>>
79021>>>>>        End
79021>>>>>>
79021>>>>>        
79021>>>>>    End_Procedure
79022>>>>>    
79022>>>>>    
79022>>>>>    Function Setup_Report Returns Integer
79024>>>>>        Integer iErr iStatus eMode
79024>>>>>        Boolean bActiveViewer bChildReport bMultiReports bOk
79024>>>>>        
79024>>>>>        Get Child_rpt_state to bChildReport
79025>>>>>        
79025>>>>>        If not bChildReport Begin
79027>>>>>            
79027>>>>>            // This makes sure that we are pointing to the new winprint2 engine object.
79027>>>>>            // normally this will be the new winprint, but it can be redirected
79027>>>>>            Get phoWinPrint to WinPrintID
79028>>>>>            
79028>>>>>            // winprint must have installed printer. If not installed, generate error and stop the report
79028>>>>>            Get ArePrintersInstalled to bOk
79029>>>>>            If not bOk Begin
79031>>>>>                Error DFERR_WINPRINT C_$NoInstalledPrinters
79032>>>>>>
79032>>>>>                Function_Return 1
79033>>>>>            End
79033>>>>>>
79033>>>>>            
79033>>>>>            // check if selected printer is valid. If not, generate error and stop the report
79033>>>>>            Get IsPrinterValid to bOk
79034>>>>>            If not bOk Begin
79036>>>>>                Error DFERR_WINPRINT DFPrintError936    // Could not select a valid printer
79037>>>>>>
79037>>>>>                Function_Return 1
79038>>>>>            End
79038>>>>>>
79038>>>>>            
79038>>>>>            // make sure it is ok to start a new report but try to be smart about it.
79038>>>>>            // if a report is active (dsstarted or dsFinished) check to see if it is
79038>>>>>            // finished w/ no viewer. If so, assume the user closed the report and is done
79038>>>>>            // so just clear the report. If a viewer is present, declare an error.
79038>>>>>            Get DocumentStatus to iStatus
79039>>>>>            Get pbMultiReports to bMultiReports
79040>>>>>            // multi-report only in-progress is multi and it is started
79040>>>>>            Move (bMultiReports and iStatus=dsStarted) to bMultiReports
79041>>>>>            If not bMultiReports Begin
79043>>>>>                If (iStatus<>dsNotStarted) Begin
79045>>>>>                    Get IsViewerActive to bActiveViewer
79046>>>>>                    If (iStatus=dsFinished and not(bActiveViewer)) Begin
79048>>>>>                        Send DfClearDoc
79049>>>>>                    End
79049>>>>>>
79049>>>>>                    Else Begin
79050>>>>>                        Error DFERR_WINPRINT DFPrintError967
79051>>>>>>
79051>>>>>                        Function_Return 1
79052>>>>>                    End
79052>>>>>>
79052>>>>>                End
79052>>>>>>
79052>>>>>                
79052>>>>>                // all new reports by default allow printing from viewer and they have the print job set up when you select print
79052>>>>>                // if you need to change these defaults, you can change these inside of Starting_main_report
79052>>>>>                // We only do this with non-multi-reports.
79052>>>>>                Send DFSetPrintDlgInPreview      True
79053>>>>>                Send DFSetEnablePrintFromPreview True
79054>>>>>                
79054>>>>>            End
79054>>>>>>
79054>>>>>            
79054>>>>>            // In the new winprint, this message is not needed and is a stub. For
79054>>>>>            // now it is in here for compatibility purposes
79054>>>>>            //You MUST always start a new report with this procedure
79054>>>>>            Send DFZeroCounters of (phoWinPrint(Self))
79055>>>>>            Send Clr_AllSubTotals
79056>>>>>            
79056>>>>>        End
79056>>>>>>
79056>>>>>        
79056>>>>>        Forward Get Setup_report to iErr
79058>>>>>        
79058>>>>>        If (iErr=0) Begin
79060>>>>>            If not bChildReport Begin
79062>>>>>                // if part of a multi-report we don't do a new doc
79062>>>>>                If not bMultiReports Begin
79064>>>>>                    Get Output_Device_Mode to eMode
79065>>>>>                    Send DFNewDoc of (phoWinPrint(Self))  (eMode = PRINT_TO_WINDOW) // pass True of display while printing
79066>>>>>                End
79066>>>>>>
79066>>>>>                // Do new page if not part of a multi-report and we say don't do a new page
79066>>>>>                If (not(bMultiReports) or AutoNew_Page_State(Self)) Begin
79068>>>>>                    Set pbFirstPagePrinted to False // tells new page that this is the first time for this report
79069>>>>>                    Send DFNew_page
79070>>>>>                End
79070>>>>>>
79070>>>>>            End
79070>>>>>>
79070>>>>>        End
79070>>>>>>
79070>>>>>        Function_Return iErr
79071>>>>>    End_Function
79072>>>>>    
79072>>>>>    
79072>>>>>    
