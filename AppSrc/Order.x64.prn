75673>>>>>    // If workspaces are used, we will send the message EnumerateWorkspaceData
75673>>>>>    // To the workspace object passing the an object and message To send back
75673>>>>>    // To this object. It is expected that the workspace object will send this
75673>>>>>    // message for every line Of information it wants displayed (passing the
75673>>>>>    // information To be displayed
75673>>>>>    Register_Procedure EnumerateWorkspaceData Handle hObjId Handle hmMessId
75673>>>>>    
75673>>>>>    Procedure Show_ServicePack
75675>>>>>        String sKey sVersionDescription sVersion
75675>>>>>        Handle hoRegistry
75675>>>>>        Boolean bExists bOpened
75675>>>>>        
75675>>>>>        Get Create (RefClass (cRegistry)) to hoRegistry
75676>>>>>        Set phRootKey of hoRegistry to HKEY_LOCAL_MACHINE
75677>>>>>        Set pfAccessRights of hoRegistry to KEY_READ
75678>>>>>        
75678>>>>>        Move C_DFVersionRegistryRoot to sKey
75679>>>>>        Get KeyExists of hoRegistry sKey to bExists
75680>>>>>        If (bExists) Begin
75682>>>>>            Get OpenKey of hoRegistry sKey to bOpened
75683>>>>>            If (bOpened) Begin
75685>>>>>                Get ValueExists of hoRegistry "CurrentVersionDescription" to bExists
75686>>>>>                If (bExists) Begin
75688>>>>>                    Get ReadString of hoRegistry "CurrentVersionDescription" to sVersionDescription
75689>>>>>                End
75689>>>>>>
75689>>>>>                
75689>>>>>                Get ValueExists of hoRegistry "CurrentVersion" to bExists
75690>>>>>                If (bExists) Begin
75692>>>>>                    Get ReadString of hoRegistry "CurrentVersion" to sVersion
75693>>>>>                End
75693>>>>>>
75693>>>>>                Send CloseKey of hoRegistry
75694>>>>>            End
75694>>>>>>
75694>>>>>        End
75694>>>>>>
75694>>>>>        Send Destroy of hoRegistry
75695>>>>>        
75695>>>>>        If (sVersionDescription <> "") Begin
75697>>>>>            Send AppendTextLn (sVersionDescription * "-" * sVersion)
75698>>>>>            Send AppendTextLn ""
75699>>>>>        End
75699>>>>>>
75699>>>>>    End_Procedure
