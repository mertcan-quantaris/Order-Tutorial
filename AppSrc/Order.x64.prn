75995>>>>>    Procedure End_Construct_Object
75997>>>>>        Handle hoVersionInfo
75997>>>>>        Boolean bIncluded
75997>>>>>        Integer iMajor iMinor iRelease iBuild
75997>>>>>        String sLabel
75997>>>>>        
75997>>>>>        Get Label of oVersion to sLabel
75998>>>>>        If (sLabel = C_$VERSION) Begin
76000>>>>>            // set it To the version info Of the program, if available
76000>>>>>            If (ghoApplication <> 0) Begin
76002>>>>>                Get phoVersionInfo of ghoApplication to hoVersionInfo
76003>>>>>                If (hoVersionInfo <> 0) Begin
76005>>>>>                    Get pbIncluded of hoVersionInfo to bIncluded
76006>>>>>                    If (bIncluded) Begin
76008>>>>>                        Get piVersionMajor of hoVersionInfo to iMajor
76009>>>>>                        Get piVersionMinor of hoVersionInfo to iMinor
76010>>>>>                        Get piVersionRelease of hoVersionInfo to iRelease
76011>>>>>                        Get piVersionBuild of hoVersionInfo to iBuild
76012>>>>>                        Move (SFormat (C_$VERSION + ": %1.%2.%3.%4", iMajor, iMinor, iRelease, iBuild)) to sLabel
76013>>>>>                        Set Version to sLabel
76014>>>>>                    End
76014>>>>>>
76014>>>>>                End
76014>>>>>>
76014>>>>>            End
76014>>>>>>
76014>>>>>        End
76014>>>>>>
76014>>>>>        
76014>>>>>        Forward Send End_Construct_Object
76016>>>>>    End_Procedure
