36694>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36695>>>>>>>        End
36695>>>>>>>>
36695>>>>>>>        Else Begin
36696>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36697>>>>>>>        End
36697>>>>>>>>
36697>>>>>>>        
36697>>>>>>>        Function_Return bOk
36698>>>>>>>    End_Function
36699>>>>>>>    
36699>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36701>>>>>>>        UChar[] ucaSalt
36702>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36703>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36706>>>>>>>        
36706>>>>>>>        If (num_arguments > 4) Begin
36708>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36709>>>>>>>        End
36709>>>>>>>>
36709>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36710>>>>>>>    End_Function
36711>>>>>>>    
36711>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36713>>>>>>>        Boolean bRequiresTimeCost
36713>>>>>>>        UInteger uiAlgo uiTimeCost
36713>>>>>>>        Integer iBegin iEnd
36713>>>>>>>        String sSalt
36713>>>>>>>        
36713>>>>>>>        Move 1 to iBegin
36714>>>>>>>        
36714>>>>>>>        // Parse Algo
36714>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36715>>>>>>>        If (not(iEnd)) Function_Return False
36718>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36719>>>>>>>        
36719>>>>>>>        // Parse Salt
36719>>>>>>>        Move (iEnd + 1) to iBegin
36720>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36721>>>>>>>        If (not(iEnd)) Function_Return False
36724>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36725>>>>>>>        
36725>>>>>>>        Case Begin
36725>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36727>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36730>>>>>>>                Move True to bRequiresTimeCost
36731>>>>>>>                Case Break
36732>>>>>>>            Case Else
36732>>>>>>>                Error 8710 "Invalid algorithm selected."
36733>>>>>>>>
36733>>>>>>>                Function_Return False
36734>>>>>>>        Case End
36734>>>>>>>        
36734>>>>>>>        // Parse optional timecost
36734>>>>>>>        If (bRequiresTimeCost) Begin
36736>>>>>>>            Move (iEnd + 1) to iBegin
36737>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36738>>>>>>>            If (not(iEnd)) Function_Return False
36741>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36742>>>>>>>        End
36742>>>>>>>>
36742>>>>>>>        
36742>>>>>>>        // Parse rest hash
36742>>>>>>>        Move (iEnd + 1) to iBegin
36743>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36744>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36747>>>>>>>        
36747>>>>>>>        // Base64Decode
36747>>>>>>>        UChar[] ucaSalt
36748>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36749>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36752>>>>>>>        
36752>>>>>>>        // Create new hash
36752>>>>>>>        String sNewHash
36752>>>>>>>        If (bRequiresTimeCost) Begin
36754>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36756>>>>>>>                Function_Return False 
36757>>>>>>>            End
36757>>>>>>>>
36757>>>>>>>        End
36757>>>>>>>>
36757>>>>>>>        Else Begin
36758>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36760>>>>>>>                Function_Return False 
36761>>>>>>>            End
36761>>>>>>>>
36761>>>>>>>        End
36761>>>>>>>>
36761>>>>>>>        Function_Return (sNewHash = sHash)
36762>>>>>>>    End_Function
36763>>>>>>>    
36763>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36765>>>>>>>        Boolean bRequireTimeCost
36765>>>>>>>        UBigInt ullSize
36765>>>>>>>        UChar[] ucaSalt
36766>>>>>>>        String sSalt
36766>>>>>>>        
36766>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36767>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36768>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36771>>>>>>>        
36771>>>>>>>        Case Begin
36771>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36773>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36774>>>>>>>                Move True to bRequireTimeCost
36775>>>>>>>                Case Break
36776>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36779>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36780>>>>>>>                Move True to bRequireTimeCost
36781>>>>>>>                Case Break
36782>>>>>>>            Case Else
36782>>>>>>>                Error 8710 "Invalid algorithm selected."
36783>>>>>>>>
36783>>>>>>>                Function_Return 0
36784>>>>>>>        Case End
36784>>>>>>>        
36784>>>>>>>        // calculate base64 in a non-floating-manner
36784>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36785>>>>>>>        
36785>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36786>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36787>>>>>>>        If (bRequireTimeCost) Begin
36789>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36790>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36791>>>>>>>        End
36791>>>>>>>>
36791>>>>>>>        Else Begin
36792>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36793>>>>>>>        End
36793>>>>>>>>
36793>>>>>>>        
36793>>>>>>>        Function_Return ullSize
36794>>>>>>>    End_Function
36795>>>>>>>End_Class
36796>>>>>>>
36796>>>>>>>Class cPasswordHasher is a cObject
36797>>>>>>>    
36797>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36798>>>>>>>    
36798>>>>>>>    Procedure Construct_Object
36800>>>>>>>        Forward Send Construct_Object
36802>>>>>>>        
36802>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36803>>>>>>>        Property UInteger   puiSaltSize         16
36804>>>>>>>        
36804>>>>>>>        Property UInteger   puiOptTimeCost      420000
36805>>>>>>>    End_Procedure
36806>>>>>>>    
36806>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36808>>>>>>>        Boolean bOk
36808>>>>>>>        UInteger uiAlgo
36808>>>>>>>        Get peAlgorithm to uiAlgo
36809>>>>>>>        
36809>>>>>>>        Case Begin
36809>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36811>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36814>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36815>>>>>>>                Case Break
36816>>>>>>>            Case Else
36816>>>>>>>                Error 8710 "Invalid algorithm selected."
36817>>>>>>>>
36817>>>>>>>                Function_Return False
36818>>>>>>>        Case End
36818>>>>>>>        
36818>>>>>>>        Function_Return bOk
36819>>>>>>>    End_Function
36820>>>>>>>    
36820>>>>>>>    Function RequiredBufferSize Returns UBigInt
36822>>>>>>>        UBigInt ullSize
36822>>>>>>>        UInteger uiAlgo
36822>>>>>>>        Get peAlgorithm to uiAlgo
36823>>>>>>>        
36823>>>>>>>        Case Begin
36823>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36825>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36828>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36829>>>>>>>                Case Break
36830>>>>>>>            Case Else
36830>>>>>>>                Error 8710 "Invalid algorithm selected."
36831>>>>>>>>
36831>>>>>>>                Function_Return 0
36832>>>>>>>        Case End
36832>>>>>>>        
36832>>>>>>>        Function_Return ullSize
36833>>>>>>>    End_Function
36834>>>>>>>
36834>>>>>>>End_Class
