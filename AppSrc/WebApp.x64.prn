37228>>>    Procedure DoLogin
37231>>>        String sLoginName sPassword
37231>>>        Boolean bResult
37231>>>        Handle hoDefaultView
37231>>>        
37231>>>        WebGet psValue of oLoginName to sLoginName
37232>>>        WebGet psValue of oPassword to sPassword
37233>>>        
37233>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37234>>>        
37234>>>        If (bResult) Begin
37236>>>            Send Hide of oLoginDialog
37237>>>            Get GetDefaultView to hoDefaultView
37238>>>            If (hoDefaultView > 0) Begin
37240>>>                Send Show of hoDefaultView
37241>>>            End
37241>>>>
37241>>>            
37241>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37241>>>            WebSet psValue of oLoginName to ""
37242>>>            WebSet psValue of oPassword  to ""
37243>>>            WebSet pbVisible of oWarning to False
37244>>>        End
37244>>>>
37244>>>        Else Begin
37245>>>            WebSet pbVisible of oWarning to True
37246>>>        End
37246>>>>
37246>>>    End_Procedure
37247>>>    
37247>>>    
37247>>>    Set pbServerOnSubmit to True
37248>>>    Procedure OnSubmit
37251>>>         Send DoLogin
37252>>>    End_Procedure
37253>>>End_Object
