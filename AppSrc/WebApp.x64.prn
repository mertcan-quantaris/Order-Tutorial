37233>>>    Procedure DoLogin
37236>>>        String sLoginName sPassword
37236>>>        Boolean bResult
37236>>>        Handle hoDefaultView
37236>>>        
37236>>>        WebGet psValue of oLoginName to sLoginName
37237>>>        WebGet psValue of oPassword to sPassword
37238>>>        
37238>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37239>>>        
37239>>>        If (bResult) Begin
37241>>>            Send Hide of oLoginDialog
37242>>>            Get GetDefaultView to hoDefaultView
37243>>>            If (hoDefaultView > 0) Begin
37245>>>                Send Show of hoDefaultView
37246>>>            End
37246>>>>
37246>>>            
37246>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37246>>>            WebSet psValue of oLoginName to ""
37247>>>            WebSet psValue of oPassword  to ""
37248>>>            WebSet pbVisible of oWarning to False
37249>>>        End
37249>>>>
37249>>>        Else Begin
37250>>>            WebSet pbVisible of oWarning to True
37251>>>        End
37251>>>>
37251>>>    End_Procedure
37252>>>    
37252>>>    
37252>>>    Set pbServerOnSubmit to True
37253>>>    Procedure OnSubmit
37256>>>         Send DoLogin
37257>>>    End_Procedure
37258>>>End_Object
