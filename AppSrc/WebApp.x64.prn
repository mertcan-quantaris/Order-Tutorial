36693>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36696>>>>>>>                Get CNG_PBKDF2_HMAC "SHA512" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36697>>>>>>>                If (not(bOk)) Function_Return False
36700>>>>>>>                
36700>>>>>>>                Move True to bRequireTimeCost
36701>>>>>>>                Case Break
36702>>>>>>>            Case Else
36702>>>>>>>                Error 8710 "Invalid algorithm selected."
36703>>>>>>>>
36703>>>>>>>                Function_Return False
36704>>>>>>>        Case End
36704>>>>>>>        
36704>>>>>>>        String sSalt
36704>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36705>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36708>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36709>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36712>>>>>>>        
36712>>>>>>>        If (bRequireTimeCost) Begin
36714>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36715>>>>>>>        End
36715>>>>>>>>
36715>>>>>>>        Else Begin
36716>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36717>>>>>>>        End
36717>>>>>>>>
36717>>>>>>>        
36717>>>>>>>        Function_Return bOk
36718>>>>>>>    End_Function
36719>>>>>>>    
36719>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36721>>>>>>>        UChar[] ucaSalt
36722>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36723>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36726>>>>>>>        
36726>>>>>>>        If (num_arguments > 4) Begin
36728>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36729>>>>>>>        End
36729>>>>>>>>
36729>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36730>>>>>>>    End_Function
36731>>>>>>>    
36731>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36733>>>>>>>        Boolean bRequiresTimeCost
36733>>>>>>>        UInteger uiAlgo uiTimeCost
36733>>>>>>>        Integer iBegin iEnd
36733>>>>>>>        String sSalt
36733>>>>>>>        
36733>>>>>>>        Move 1 to iBegin
36734>>>>>>>        
36734>>>>>>>        // Parse Algo
36734>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36735>>>>>>>        If (not(iEnd)) Function_Return False
36738>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36739>>>>>>>        
36739>>>>>>>        // Parse Salt
36739>>>>>>>        Move (iEnd + 1) to iBegin
36740>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36741>>>>>>>        If (not(iEnd)) Function_Return False
36744>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36745>>>>>>>        
36745>>>>>>>        Case Begin
36745>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36747>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36750>>>>>>>                Move True to bRequiresTimeCost
36751>>>>>>>                Case Break
36752>>>>>>>            Case Else
36752>>>>>>>                Error 8710 "Invalid algorithm selected."
36753>>>>>>>>
36753>>>>>>>                Function_Return False
36754>>>>>>>        Case End
36754>>>>>>>        
36754>>>>>>>        // Parse optional timecost
36754>>>>>>>        If (bRequiresTimeCost) Begin
36756>>>>>>>            Move (iEnd + 1) to iBegin
36757>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36758>>>>>>>            If (not(iEnd)) Function_Return False
36761>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36762>>>>>>>        End
36762>>>>>>>>
36762>>>>>>>        
36762>>>>>>>        // Parse rest hash
36762>>>>>>>        Move (iEnd + 1) to iBegin
36763>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36764>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36767>>>>>>>        
36767>>>>>>>        // Base64Decode
36767>>>>>>>        UChar[] ucaSalt
36768>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36769>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36772>>>>>>>        
36772>>>>>>>        // Create new hash
36772>>>>>>>        String sNewHash
36772>>>>>>>        If (bRequiresTimeCost) Begin
36774>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36776>>>>>>>                Function_Return False 
36777>>>>>>>            End
36777>>>>>>>>
36777>>>>>>>        End
36777>>>>>>>>
36777>>>>>>>        Else Begin
36778>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36780>>>>>>>                Function_Return False 
36781>>>>>>>            End
36781>>>>>>>>
36781>>>>>>>        End
36781>>>>>>>>
36781>>>>>>>        Function_Return (sNewHash = sHash)
36782>>>>>>>    End_Function
36783>>>>>>>    
36783>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36785>>>>>>>        Boolean bRequireTimeCost
36785>>>>>>>        UBigInt ullSize
36785>>>>>>>        UChar[] ucaSalt
36786>>>>>>>        String sSalt
36786>>>>>>>        
36786>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36787>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36788>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36791>>>>>>>        
36791>>>>>>>        Case Begin
36791>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36793>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36794>>>>>>>                Move True to bRequireTimeCost
36795>>>>>>>                Case Break
36796>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36799>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36800>>>>>>>                Move True to bRequireTimeCost
36801>>>>>>>                Case Break
36802>>>>>>>            Case Else
36802>>>>>>>                Error 8710 "Invalid algorithm selected."
36803>>>>>>>>
36803>>>>>>>                Function_Return 0
36804>>>>>>>        Case End
36804>>>>>>>        
36804>>>>>>>        // calculate base64 in a non-floating-manner
36804>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36805>>>>>>>        
36805>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36806>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36807>>>>>>>        If (bRequireTimeCost) Begin
36809>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36810>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36811>>>>>>>        End
36811>>>>>>>>
36811>>>>>>>        Else Begin
36812>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36813>>>>>>>        End
36813>>>>>>>>
36813>>>>>>>        
36813>>>>>>>        Function_Return ullSize
36814>>>>>>>    End_Function
36815>>>>>>>End_Class
36816>>>>>>>
36816>>>>>>>Class cPasswordHasher is a cObject
36817>>>>>>>    
36817>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36818>>>>>>>    
36818>>>>>>>    Procedure Construct_Object
36820>>>>>>>        Forward Send Construct_Object
36822>>>>>>>        
36822>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36823>>>>>>>        Property UInteger   puiSaltSize         16
36824>>>>>>>        
36824>>>>>>>        Property UInteger   puiOptTimeCost      420000
36825>>>>>>>    End_Procedure
36826>>>>>>>    
36826>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36828>>>>>>>        Boolean bOk
36828>>>>>>>        UInteger uiAlgo
36828>>>>>>>        Get peAlgorithm to uiAlgo
36829>>>>>>>        
36829>>>>>>>        Case Begin
36829>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36831>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36834>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36835>>>>>>>                Case Break
36836>>>>>>>            Case Else
36836>>>>>>>                Error 8710 "Invalid algorithm selected."
36837>>>>>>>>
36837>>>>>>>                Function_Return False
36838>>>>>>>        Case End
36838>>>>>>>        
36838>>>>>>>        Function_Return bOk
36839>>>>>>>    End_Function
36840>>>>>>>    
36840>>>>>>>    Function RequiredBufferSize Returns UBigInt
36842>>>>>>>        UBigInt ullSize
36842>>>>>>>        UInteger uiAlgo
36842>>>>>>>        Get peAlgorithm to uiAlgo
36843>>>>>>>        
36843>>>>>>>        Case Begin
36843>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36845>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36848>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36849>>>>>>>                Case Break
36850>>>>>>>            Case Else
36850>>>>>>>                Error 8710 "Invalid algorithm selected."
36851>>>>>>>>
36851>>>>>>>                Function_Return 0
36852>>>>>>>        Case End
36852>>>>>>>        
36852>>>>>>>        Function_Return ullSize
36853>>>>>>>    End_Function
36854>>>>>>>
36854>>>>>>>End_Class
