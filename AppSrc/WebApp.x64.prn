36536>>>>>>>    //
36536>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36536>>>>>>>    //
36536>>>>>>>    //  Params:
36536>>>>>>>    //      dtTime  Time to convert
36536>>>>>>>    //  Returns:
36536>>>>>>>    //      String with "HH:MM:SS" format
36536>>>>>>>    //
36536>>>>>>>    Function TimeToString DateTime dtTime Returns String
36538>>>>>>>        String sHours sMinutes sSeconds
36538>>>>>>>        
36538>>>>>>>        //  Extract parts
36538>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36539>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36540>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36541>>>>>>>        
36541>>>>>>>        //  Fill out with 0
36541>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36544>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36547>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36550>>>>>>>        
36550>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36551>>>>>>>    End_Function
36552>>>>>>>    
36552>>>>>>>    //
36552>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36552>>>>>>>    //
36552>>>>>>>    //  Params:
36552>>>>>>>    //      dtTime  Datetime variable to add time to
36552>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
36552>>>>>>>    //  Returns:
36552>>>>>>>    //      dtDateTime with the loaded time
36552>>>>>>>    //
36552>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36554>>>>>>>        String sHours sMinutes sSeconds
36554>>>>>>>        
36554>>>>>>>        //  Extract parts
36554>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36555>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36556>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36557>>>>>>>        
36557>>>>>>>        //  Set to DateTime
36557>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36558>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36559>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36560>>>>>>>        
36560>>>>>>>        Function_Return dtTime
36561>>>>>>>    End_Function
36562>>>>>>>End_Class
