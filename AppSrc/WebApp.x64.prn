37218>>>    Procedure DoLogin
37221>>>        String sLoginName sPassword
37221>>>        Boolean bResult
37221>>>        Handle hoDefaultView
37221>>>        
37221>>>        WebGet psValue of oLoginName to sLoginName
37222>>>        WebGet psValue of oPassword to sPassword
37223>>>        
37223>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37224>>>        
37224>>>        If (bResult) Begin
37226>>>            Send Hide of oLoginDialog
37227>>>            Get GetDefaultView to hoDefaultView
37228>>>            If (hoDefaultView > 0) Begin
37230>>>                Send Show of hoDefaultView
37231>>>            End
37231>>>>
37231>>>            
37231>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37231>>>            WebSet psValue of oLoginName to ""
37232>>>            WebSet psValue of oPassword  to ""
37233>>>            WebSet pbVisible of oWarning to False
37234>>>        End
37234>>>>
37234>>>        Else Begin
37235>>>            WebSet pbVisible of oWarning to True
37236>>>        End
37236>>>>
37236>>>    End_Procedure
37237>>>    
37237>>>    
37237>>>    Set pbServerOnSubmit to True
37238>>>    Procedure OnSubmit
37241>>>         Send DoLogin
37242>>>    End_Procedure
