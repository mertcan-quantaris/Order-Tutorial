36690>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36693>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36694>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36697>>>>>>>        
36697>>>>>>>        If (bRequireTimeCost) Begin
36699>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36700>>>>>>>        End
36700>>>>>>>>
36700>>>>>>>        Else Begin
36701>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36702>>>>>>>        End
36702>>>>>>>>
36702>>>>>>>        
36702>>>>>>>        Function_Return bOk
36703>>>>>>>    End_Function
36704>>>>>>>    
36704>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36706>>>>>>>        UChar[] ucaSalt
36707>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36708>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36711>>>>>>>        
36711>>>>>>>        If (num_arguments > 4) Begin
36713>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36714>>>>>>>        End
36714>>>>>>>>
36714>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36715>>>>>>>    End_Function
36716>>>>>>>    
36716>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36718>>>>>>>        Boolean bRequiresTimeCost
36718>>>>>>>        UInteger uiAlgo uiTimeCost
36718>>>>>>>        Integer iBegin iEnd
36718>>>>>>>        String sSalt
36718>>>>>>>        
36718>>>>>>>        Move 1 to iBegin
36719>>>>>>>        
36719>>>>>>>        // Parse Algo
36719>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36720>>>>>>>        If (not(iEnd)) Function_Return False
36723>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36724>>>>>>>        
36724>>>>>>>        // Parse Salt
36724>>>>>>>        Move (iEnd + 1) to iBegin
36725>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36726>>>>>>>        If (not(iEnd)) Function_Return False
36729>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36730>>>>>>>        
36730>>>>>>>        Case Begin
36730>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36732>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36735>>>>>>>                Move True to bRequiresTimeCost
36736>>>>>>>                Case Break
36737>>>>>>>            Case Else
36737>>>>>>>                Error 8710 "Invalid algorithm selected."
36738>>>>>>>>
36738>>>>>>>                Function_Return False
36739>>>>>>>        Case End
36739>>>>>>>        
36739>>>>>>>        // Parse optional timecost
36739>>>>>>>        If (bRequiresTimeCost) Begin
36741>>>>>>>            Move (iEnd + 1) to iBegin
36742>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36743>>>>>>>            If (not(iEnd)) Function_Return False
36746>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36747>>>>>>>        End
36747>>>>>>>>
36747>>>>>>>        
36747>>>>>>>        // Parse rest hash
36747>>>>>>>        Move (iEnd + 1) to iBegin
36748>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36749>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36752>>>>>>>        
36752>>>>>>>        // Base64Decode
36752>>>>>>>        UChar[] ucaSalt
36753>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36754>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36757>>>>>>>        
36757>>>>>>>        // Create new hash
36757>>>>>>>        String sNewHash
36757>>>>>>>        If (bRequiresTimeCost) Begin
36759>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36761>>>>>>>                Function_Return False 
36762>>>>>>>            End
36762>>>>>>>>
36762>>>>>>>        End
36762>>>>>>>>
36762>>>>>>>        Else Begin
36763>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36765>>>>>>>                Function_Return False 
36766>>>>>>>            End
36766>>>>>>>>
36766>>>>>>>        End
36766>>>>>>>>
36766>>>>>>>        Function_Return (sNewHash = sHash)
36767>>>>>>>    End_Function
36768>>>>>>>    
36768>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36770>>>>>>>        Boolean bRequireTimeCost
36770>>>>>>>        UBigInt ullSize
36770>>>>>>>        UChar[] ucaSalt
36771>>>>>>>        String sSalt
36771>>>>>>>        
36771>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36772>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36773>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36776>>>>>>>        
36776>>>>>>>        Case Begin
36776>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36778>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36779>>>>>>>                Move True to bRequireTimeCost
36780>>>>>>>                Case Break
36781>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36784>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36785>>>>>>>                Move True to bRequireTimeCost
36786>>>>>>>                Case Break
36787>>>>>>>            Case Else
36787>>>>>>>                Error 8710 "Invalid algorithm selected."
36788>>>>>>>>
36788>>>>>>>                Function_Return 0
36789>>>>>>>        Case End
36789>>>>>>>        
36789>>>>>>>        // calculate base64 in a non-floating-manner
36789>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36790>>>>>>>        
36790>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36791>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36792>>>>>>>        If (bRequireTimeCost) Begin
36794>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36795>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36796>>>>>>>        End
36796>>>>>>>>
36796>>>>>>>        Else Begin
36797>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36798>>>>>>>        End
36798>>>>>>>>
36798>>>>>>>        
36798>>>>>>>        Function_Return ullSize
36799>>>>>>>    End_Function
36800>>>>>>>End_Class
36801>>>>>>>
36801>>>>>>>Class cPasswordHasher is a cObject
36802>>>>>>>    
36802>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36803>>>>>>>    
36803>>>>>>>    Procedure Construct_Object
36805>>>>>>>        Forward Send Construct_Object
36807>>>>>>>        
36807>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36808>>>>>>>        Property UInteger   puiSaltSize         16
36809>>>>>>>        
36809>>>>>>>        Property UInteger   puiOptTimeCost      420000
36810>>>>>>>    End_Procedure
36811>>>>>>>    
36811>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36813>>>>>>>        Boolean bOk
36813>>>>>>>        UInteger uiAlgo
36813>>>>>>>        Get peAlgorithm to uiAlgo
36814>>>>>>>        
36814>>>>>>>        Case Begin
36814>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36816>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36819>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36820>>>>>>>                Case Break
36821>>>>>>>            Case Else
36821>>>>>>>                Error 8710 "Invalid algorithm selected."
36822>>>>>>>>
36822>>>>>>>                Function_Return False
36823>>>>>>>        Case End
36823>>>>>>>        
36823>>>>>>>        Function_Return bOk
36824>>>>>>>    End_Function
36825>>>>>>>    
36825>>>>>>>    Function RequiredBufferSize Returns UBigInt
36827>>>>>>>        UBigInt ullSize
36827>>>>>>>        UInteger uiAlgo
36827>>>>>>>        Get peAlgorithm to uiAlgo
36828>>>>>>>        
36828>>>>>>>        Case Begin
36828>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36830>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36833>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36834>>>>>>>                Case Break
36835>>>>>>>            Case Else
36835>>>>>>>                Error 8710 "Invalid algorithm selected."
36836>>>>>>>>
36836>>>>>>>                Function_Return 0
36837>>>>>>>        Case End
36837>>>>>>>        
36837>>>>>>>        Function_Return ullSize
36838>>>>>>>    End_Function
36839>>>>>>>
36839>>>>>>>End_Class
