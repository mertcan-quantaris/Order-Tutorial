36845>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36846>>>>>    
36846>>>>>    Procedure Construct_Object
36848>>>>>        Handle hoObj
36848>>>>>        
36848>>>>>        Forward Send Construct_Object
36850>>>>>        
36850>>>>>        Set pbSessionCookieHttpOnly to True
36851>>>>>        
36851>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36852>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36853>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36854>>>>>        
36854>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36855>>>>>        Set phoUserDD to hoObj
36856>>>>>        
36856>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36857>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36858>>>>>        Set phoSessionDD to hoObj
36859>>>>>        
36859>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36860>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36861>>>>>        Set phoCrypto to hoObj
36862>>>>>        
36862>>>>>        Property Boolean pbPasswordHashing True
36863>>>>>        
36863>>>>>        Property Boolean pbCreatingNewSession False
36864>>>>>        Property String psLoginName
36865>>>>>        Property String psUserName ""
36866>>>>>        Property Integer piUserRights 0
36867>>>>>    End_Procedure
36868>>>>>    
36868>>>>>    Procedure End_Construct_Object
36870>>>>>        Forward Send End_Construct_Object
36872>>>>>        
36872>>>>>        Handle hoCrypto
36872>>>>>        Integer iFieldLen
36872>>>>>        If (pbPasswordHashing(Self)) Begin
36874>>>>>            Get phoCrypto to hoCrypto
36875>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36878>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36880>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36881>>>>>>
36881>>>>>            End
36881>>>>>>
36881>>>>>        End
36881>>>>>>
36881>>>>>    End_Procedure
36882>>>>>    
36882>>>>>    Function CreateSession String sRemoteAddress Returns String
36884>>>>>        String sSessionKey
36884>>>>>        Integer iErr
36884>>>>>        Boolean bLogWebSession
36884>>>>>        Handle hoSessionDD       
36884>>>>>        Get phoSessionDD to hoSessionDD
36885>>>>>        
36885>>>>>        //  Get session key
36885>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36887>>>>>        
36887>>>>>        Get pbLogWebSession to bLogWebSession
36888>>>>>        If not bLogWebSession Begin
36890>>>>>            Function_Return sSessionKey        
36891>>>>>        End
36891>>>>>>
36891>>>>>
36891>>>>>        //  Store session
36891>>>>>        Send Clear of hoSessionDD
36892>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36893>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36894>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36895>>>>>        Get Request_Validate of hoSessionDD to iErr
36896>>>>>        If (iErr) Begin
36898>>>>>            // this should not happen. If it does its a programming error
36898>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36899>>>>>>
36899>>>>>            Function_Return ""
36900>>>>>        End
36900>>>>>>
36900>>>>>        Send Request_Save of hoSessionDD
36901>>>>>        If (Err) Begin
36903>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36903>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36904>>>>>>
36904>>>>>            Function_Return ""
36905>>>>>        End
36905>>>>>>
36905>>>>>       
36905>>>>>        Function_Return sSessionKey        
36906>>>>>    End_Function
36907>>>>>    
36907>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36909>>>>>        DateTime dtLastAccess dtCurrent
36909>>>>>        TimeSpan tsDiff
36909>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36909>>>>>        Boolean bResult bCreatingNewSession
36909>>>>>        Boolean bLogWebSession bLoadWebApp
36909>>>>>        Integer eLoginMode
36909>>>>>        String sTime
36909>>>>>        Handle hoSessionDD hoUserDD       
36909>>>>>        
36909>>>>>        Move False to bLoadWebApp
36910>>>>>        If (num_arguments >= 2) Begin
36912>>>>>            Move bOptLoadWebApp to bLoadWebApp
36913>>>>>        End
36913>>>>>>
36913>>>>>        
36913>>>>>        Get phoSessionDD to hoSessionDD
36914>>>>>        Get phoUserDD to hoUserDD
36915>>>>>        
36915>>>>>        Get pbLogWebSession to bLogWebSession
36916>>>>>        Get peLoginMode to eLoginMode
36917>>>>>        
36917>>>>>        // for this object, you can only disable logging if login completely is disabled
36917>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36919>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36920>>>>>>
36920>>>>>            Function_Return False
36921>>>>>        End
36921>>>>>>
36921>>>>>
36921>>>>>        //  Clear session properties
36921>>>>>        Set psSessionKey to ""
36922>>>>>        Send UpdateSessionProperties True
36923>>>>>        
36923>>>>>        If not bLogWebSession Begin
36925>>>>>            Forward Get ValidateSession sSessionKey to bResult
36927>>>>>            Function_Return bResult
36928>>>>>        End        
36928>>>>>>
36928>>>>>        
36928>>>>>        Move False to bResult
36929>>>>>        Get piSessionTimeout to iSessionTimeout 
36930>>>>>        
36930>>>>>        //  Check if session exists
36930>>>>>        Send Clear of hoSessionDD
36931>>>>>        Move sSessionKey to WebAppSession.SessionKey
36932>>>>>        Send Find of hoSessionDD EQ Index.1
36933>>>>>            
36933>>>>>        If (Found) Begin
36935>>>>>            //  Calculate timespan between now and last access time
36935>>>>>            Move (CurrentDateTime()) to dtCurrent
36936>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36937>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36938>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36939>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36940>>>>>            
36940>>>>>            //  Check if session didn't time out
36940>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36942>>>>>                Forward Get ValidateSession sSessionKey to bResult
36944>>>>>                   
36944>>>>>                If (bResult) Begin
36946>>>>>                    //  Update session record
36946>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36947>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36948>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36949>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36950>>>>>                    Get Request_Validate of hoSessionDD to iErr
36951>>>>>                    If (iErr) Begin
36953>>>>>                        // this should not happen. If it does its a programming error
36953>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36954>>>>>>
36954>>>>>                        Function_Return False
36955>>>>>                    End
36955>>>>>>
36955>>>>>                    Send Request_Save of hoSessionDD
36956>>>>>                    
36956>>>>>                    //  Update user properties
36956>>>>>                    Send UpdateSessionProperties False
36957>>>>>                End
36957>>>>>>
36957>>>>>            End
36957>>>>>>
36957>>>>>            Else Begin
36958>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36958>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36959>>>>>                
36959>>>>>                If (not(bCreatingNewSession)) Begin
36961>>>>>                    If (not(bLoadWebApp)) Begin
36963>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
36964>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
36965>>>>>>
36965>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
36966>>>>>                    End
36966>>>>>>
36966>>>>>                    Else Begin
36967>>>>>                        Set pbCreatingNewSession to True                    
36968>>>>>                        Get RecreateSession of ghoWebApp to bResult 
36969>>>>>                        Set pbCreatingNewSession to False                        
36970>>>>>                    End
36970>>>>>>
36970>>>>>                End
36970>>>>>>
36970>>>>>            End
36970>>>>>>
36970>>>>>        End
36970>>>>>>
36970>>>>>        Else Begin
36971>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
36972>>>>>>
36972>>>>>        End
36972>>>>>>
36972>>>>>        
36972>>>>>        Function_Return bResult
36973>>>>>    End_Function
36974>>>>>    
36974>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36976>>>>>        If (not(pbPasswordHashing(Self))) Begin
36978>>>>>            Move sPassword to sHash
36979>>>>>            Function_Return True
36980>>>>>        End
36980>>>>>>
36980>>>>>        
36980>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
36982>>>>>            Function_Return False
36983>>>>>        End
36983>>>>>>
36983>>>>>        Move ("V1$" + sHash) to sHash
36984>>>>>        Function_Return True
36985>>>>>    End_Function
36986>>>>>    
36986>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
36988>>>>>        If (not(pbPasswordHashing(Self))) Begin
36990>>>>>            Move False to bShouldUpgrade
36991>>>>>            Function_Return (sUserPassword = sEnteredPassword)
36992>>>>>        End
36992>>>>>>
36992>>>>>        
36992>>>>>        String sVersion
36992>>>>>        Move (Left(sUserPassword, 3)) to sVersion
36993>>>>>        If (sVersion = "V1$") Begin
36995>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
36998>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
36999>>>>>        End
36999>>>>>>
36999>>>>>        Else Begin
37000>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37003>>>>>            Function_Return False
37004>>>>>        End
37004>>>>>>
37004>>>>>    End_Function
37005>>>>>    
37005>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37007>>>>>        Handle hoUserDD
37007>>>>>        Integer iErr
37007>>>>>        Get phoUserDD to hoUserDD
37008>>>>>        
37008>>>>>        //  Find the user
37008>>>>>        Send Clear of hoUserDD
37009>>>>>        Move sLoginName to WebAppUser.LoginName
37010>>>>>        Send Find of hoUserDD EQ Index.1
37011>>>>>        If (Found) Begin
37013>>>>>            Send Clear of hoUserDD
37014>>>>>            Function_Return False
37015>>>>>        End
37015>>>>>>
37015>>>>>        
37015>>>>>        Send Clear of hoUserDD
37016>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37017>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37018>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37020>>>>>            Send Clear of hoUserDD
37021>>>>>            Function_Return False
37022>>>>>        End
37022>>>>>>
37022>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37023>>>>>        Get Request_Validate of hoUserDD to iErr
37024>>>>>        If (iErr) Begin
37026>>>>>            Send Clear of hoUserDD
37027>>>>>            Function_Return False
37028>>>>>        End
37028>>>>>>
37028>>>>>        
37028>>>>>        Send Request_Save of hoUserDD
37029>>>>>        Function_Return (not(Err))
37030>>>>>    End_Function
37031>>>>>    
37031>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37033>>>>>        String sSessionKey sUserPassword
37033>>>>>        Handle hoSessionDD hoUserDD
37033>>>>>        Boolean bMatch bUpgrade
37033>>>>>        
37033>>>>>        Get phoSessionDD to hoSessionDD
37034>>>>>        Get phoUserDD to hoUserDD
37035>>>>>        Integer iErr eLoginMode
37035>>>>>        
37035>>>>>        // Refind session record
37035>>>>>        Get psSessionKey to sSessionKey
37036>>>>>        Send Clear of hoSessionDD
37037>>>>>        Move sSessionKey to WebAppSession.SessionKey
37038>>>>>        Send Find of hoSessionDD EQ Index.1
37039>>>>>        
37039>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37041>>>>>            Get peLoginMode to eLoginMode
37042>>>>>            
37042>>>>>            //  Find the user
37042>>>>>            Move sLoginName to WebAppUser.LoginName
37043>>>>>            Send Find of hoUserDD EQ Index.1
37044>>>>>            
37044>>>>>            // Check username and password
37044>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37046>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37047>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37048>>>>>                
37048>>>>>                If (bMatch) Begin
37050>>>>>                    // Store the login
37050>>>>>                    If (bUpgrade) Begin
37052>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37053>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37056>>>>>                    End
37056>>>>>>
37056>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37057>>>>>                    Get Request_Validate of hoSessionDD to iErr
37058>>>>>                    If (iErr) Begin
37060>>>>>                        // this should not happen. If it does its a programming error
37060>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37061>>>>>>
37061>>>>>                        Function_Return False
37062>>>>>                    End
37062>>>>>>
37062>>>>>                    
37062>>>>>                    Send Request_Save of hoSessionDD
37063>>>>>                    
37063>>>>>                    // Update session properties
37063>>>>>                    Send UpdateSessionProperties False
37064>>>>>                    Send NotifyChangeRights
37065>>>>>                    Function_Return True
37066>>>>>                End
37066>>>>>>
37066>>>>>                Else Begin
37067>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37067>>>>>                    Send Clear of hoUserDD
37068>>>>>                End
37068>>>>>>
37068>>>>>            End
37068>>>>>>
37068>>>>>            Else Begin
37069>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37069>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37070>>>>>            End
37070>>>>>>
37070>>>>>        End
37070>>>>>>
37070>>>>>        Else Begin
37071>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37071>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37072>>>>>        End
37072>>>>>>
37072>>>>>          
37072>>>>>        Function_Return False
37073>>>>>    End_Function
37074>>>>>    
37074>>>>>    Function SetUserPassword String sLoginName String sPassword Returns Boolean
37076>>>>>        Handle hoUserDD
37076>>>>>        Integer iErr
37076>>>>>        Get phoUserDD to hoUserDD
37077>>>>>        
37077>>>>>        //  Find the user
