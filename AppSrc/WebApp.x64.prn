36526>>>>>>>    //
36526>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36526>>>>>>>    //
36526>>>>>>>    //  Params:
36526>>>>>>>    //      dtTime  Time to convert
36526>>>>>>>    //  Returns:
36526>>>>>>>    //      String with "HH:MM:SS" format
36526>>>>>>>    //
36526>>>>>>>    Function TimeToString DateTime dtTime Returns String
36528>>>>>>>        String sHours sMinutes sSeconds
36528>>>>>>>        
36528>>>>>>>        //  Extract parts
36528>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36529>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36530>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36531>>>>>>>        
36531>>>>>>>        //  Fill out with 0
36531>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36534>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36537>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36540>>>>>>>        
36540>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36541>>>>>>>    End_Function
36542>>>>>>>    
36542>>>>>>>    //
36542>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36542>>>>>>>    //
36542>>>>>>>    //  Params:
36542>>>>>>>    //      dtTime  Datetime variable to add time to
36542>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
36542>>>>>>>    //  Returns:
36542>>>>>>>    //      dtDateTime with the loaded time
36542>>>>>>>    //
36542>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36544>>>>>>>        String sHours sMinutes sSeconds
36544>>>>>>>        
36544>>>>>>>        //  Extract parts
36544>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36545>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36546>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36547>>>>>>>        
36547>>>>>>>        //  Set to DateTime
36547>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36548>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36549>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36550>>>>>>>        
36550>>>>>>>        Function_Return dtTime
36551>>>>>>>    End_Function
