36521>>>>>>>    //
36521>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36521>>>>>>>    //
36521>>>>>>>    //  Params:
36521>>>>>>>    //      dtTime  Time to convert
36521>>>>>>>    //  Returns:
36521>>>>>>>    //      String with "HH:MM:SS" format
36521>>>>>>>    //
36521>>>>>>>    Function TimeToString DateTime dtTime Returns String
36523>>>>>>>        String sHours sMinutes sSeconds
36523>>>>>>>        
36523>>>>>>>        //  Extract parts
36523>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36524>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36525>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36526>>>>>>>        
36526>>>>>>>        //  Fill out with 0
36526>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36529>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36532>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36535>>>>>>>        
36535>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36536>>>>>>>    End_Function
36537>>>>>>>    
36537>>>>>>>    //
36537>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36537>>>>>>>    //
36537>>>>>>>    //  Params:
