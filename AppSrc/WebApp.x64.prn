37337>>>>>    //  Validates if the field contains a valid email address (it allows empty values too).
37337>>>>>    Function ValidateEmail Integer iColumn String sValue Returns Boolean
37339>>>>>        Integer iAt iDot
37339>>>>>        Boolean bResult
37339>>>>>        
37339>>>>>        If (Trim(sValue) <> "") Begin
37341>>>>>            Move (Pos("@", sValue)) to iAt
37342>>>>>            Move (RightPos(".", sValue)) to iDot
37343>>>>>            
37343>>>>>            If (not(iAt > 1 and iDot > 0 and iDot > iAt + 1 and iDot < Length(sValue))) Begin
37345>>>>>                Send Data_set_error iColumn DFERR_OPERATOR "Please enter a valid email address"
37346>>>>>                Move True to bResult
37347>>>>>            End
37347>>>>>>
37347>>>>>        End
37347>>>>>>
37347>>>>>        
37347>>>>>        Function_Return bResult
37348>>>>>    End_Function
