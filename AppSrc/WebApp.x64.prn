37342>>>>>    //  Validates if the field contains a valid email address (it allows empty values too).
37342>>>>>    Function ValidateEmail Integer iColumn String sValue Returns Boolean
37344>>>>>        Integer iAt iDot
37344>>>>>        Boolean bResult
37344>>>>>        
37344>>>>>        If (Trim(sValue) <> "") Begin
37346>>>>>            Move (Pos("@", sValue)) to iAt
37347>>>>>            Move (RightPos(".", sValue)) to iDot
37348>>>>>            
37348>>>>>            If (not(iAt > 1 and iDot > 0 and iDot > iAt + 1 and iDot < Length(sValue))) Begin
37350>>>>>                Send Data_set_error iColumn DFERR_OPERATOR "Please enter a valid email address"
37351>>>>>                Move True to bResult
37352>>>>>            End
37352>>>>>>
37352>>>>>        End
37352>>>>>>
37352>>>>>        
37352>>>>>        Function_Return bResult
37353>>>>>    End_Function
37354>>>>>    
37354>>>>>End_Class
