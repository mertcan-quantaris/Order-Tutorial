37213>>>    Procedure DoLogin
37216>>>        String sLoginName sPassword
37216>>>        Boolean bResult
37216>>>        Handle hoDefaultView
37216>>>        
37216>>>        WebGet psValue of oLoginName to sLoginName
37217>>>        WebGet psValue of oPassword to sPassword
37218>>>        
37218>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37219>>>        
37219>>>        If (bResult) Begin
37221>>>            Send Hide of oLoginDialog
37222>>>            Get GetDefaultView to hoDefaultView
37223>>>            If (hoDefaultView > 0) Begin
37225>>>                Send Show of hoDefaultView
37226>>>            End
37226>>>>
37226>>>            
37226>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37226>>>            WebSet psValue of oLoginName to ""
37227>>>            WebSet psValue of oPassword  to ""
37228>>>            WebSet pbVisible of oWarning to False
37229>>>        End
37229>>>>
37229>>>        Else Begin
37230>>>            WebSet pbVisible of oWarning to True
37231>>>        End
37231>>>>
37231>>>    End_Procedure
