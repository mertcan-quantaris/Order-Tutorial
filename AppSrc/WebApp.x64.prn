36840>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36841>>>>>    
36841>>>>>    Procedure Construct_Object
36843>>>>>        Handle hoObj
36843>>>>>        
36843>>>>>        Forward Send Construct_Object
36845>>>>>        
36845>>>>>        Set pbSessionCookieHttpOnly to True
36846>>>>>        
36846>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36847>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36848>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36849>>>>>        
36849>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36850>>>>>        Set phoUserDD to hoObj
36851>>>>>        
36851>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36852>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36853>>>>>        Set phoSessionDD to hoObj
36854>>>>>        
36854>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36855>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36856>>>>>        Set phoCrypto to hoObj
36857>>>>>        
36857>>>>>        Property Boolean pbPasswordHashing True
36858>>>>>        
36858>>>>>        Property Boolean pbCreatingNewSession False
36859>>>>>        Property String psLoginName
36860>>>>>        Property String psUserName ""
36861>>>>>        Property Integer piUserRights 0
36862>>>>>    End_Procedure
36863>>>>>    
36863>>>>>    Procedure End_Construct_Object
36865>>>>>        Forward Send End_Construct_Object
36867>>>>>        
36867>>>>>        Handle hoCrypto
36867>>>>>        Integer iFieldLen
36867>>>>>        If (pbPasswordHashing(Self)) Begin
36869>>>>>            Get phoCrypto to hoCrypto
36870>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36873>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36875>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36876>>>>>>
36876>>>>>            End
36876>>>>>>
36876>>>>>        End
36876>>>>>>
36876>>>>>    End_Procedure
36877>>>>>    
36877>>>>>    Function CreateSession String sRemoteAddress Returns String
36879>>>>>        String sSessionKey
36879>>>>>        Integer iErr
36879>>>>>        Boolean bLogWebSession
36879>>>>>        Handle hoSessionDD       
36879>>>>>        Get phoSessionDD to hoSessionDD
36880>>>>>        
36880>>>>>        //  Get session key
36880>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36882>>>>>        
36882>>>>>        Get pbLogWebSession to bLogWebSession
36883>>>>>        If not bLogWebSession Begin
36885>>>>>            Function_Return sSessionKey        
36886>>>>>        End
36886>>>>>>
36886>>>>>
36886>>>>>        //  Store session
36886>>>>>        Send Clear of hoSessionDD
36887>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36888>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36889>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36890>>>>>        Get Request_Validate of hoSessionDD to iErr
36891>>>>>        If (iErr) Begin
36893>>>>>            // this should not happen. If it does its a programming error
36893>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36894>>>>>>
36894>>>>>            Function_Return ""
36895>>>>>        End
36895>>>>>>
36895>>>>>        Send Request_Save of hoSessionDD
36896>>>>>        If (Err) Begin
36898>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36898>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36899>>>>>>
36899>>>>>            Function_Return ""
36900>>>>>        End
36900>>>>>>
36900>>>>>       
36900>>>>>        Function_Return sSessionKey        
36901>>>>>    End_Function
36902>>>>>    
36902>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36904>>>>>        DateTime dtLastAccess dtCurrent
36904>>>>>        TimeSpan tsDiff
36904>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36904>>>>>        Boolean bResult bCreatingNewSession
36904>>>>>        Boolean bLogWebSession bLoadWebApp
36904>>>>>        Integer eLoginMode
36904>>>>>        String sTime
36904>>>>>        Handle hoSessionDD hoUserDD       
36904>>>>>        
36904>>>>>        Move False to bLoadWebApp
36905>>>>>        If (num_arguments >= 2) Begin
36907>>>>>            Move bOptLoadWebApp to bLoadWebApp
36908>>>>>        End
36908>>>>>>
36908>>>>>        
36908>>>>>        Get phoSessionDD to hoSessionDD
36909>>>>>        Get phoUserDD to hoUserDD
36910>>>>>        
36910>>>>>        Get pbLogWebSession to bLogWebSession
36911>>>>>        Get peLoginMode to eLoginMode
36912>>>>>        
36912>>>>>        // for this object, you can only disable logging if login completely is disabled
36912>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36914>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36915>>>>>>
36915>>>>>            Function_Return False
36916>>>>>        End
36916>>>>>>
36916>>>>>
36916>>>>>        //  Clear session properties
36916>>>>>        Set psSessionKey to ""
36917>>>>>        Send UpdateSessionProperties True
36918>>>>>        
36918>>>>>        If not bLogWebSession Begin
36920>>>>>            Forward Get ValidateSession sSessionKey to bResult
36922>>>>>            Function_Return bResult
36923>>>>>        End        
36923>>>>>>
36923>>>>>        
36923>>>>>        Move False to bResult
36924>>>>>        Get piSessionTimeout to iSessionTimeout 
36925>>>>>        
36925>>>>>        //  Check if session exists
36925>>>>>        Send Clear of hoSessionDD
36926>>>>>        Move sSessionKey to WebAppSession.SessionKey
36927>>>>>        Send Find of hoSessionDD EQ Index.1
36928>>>>>            
36928>>>>>        If (Found) Begin
36930>>>>>            //  Calculate timespan between now and last access time
36930>>>>>            Move (CurrentDateTime()) to dtCurrent
36931>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36932>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36933>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36934>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36935>>>>>            
36935>>>>>            //  Check if session didn't time out
36935>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36937>>>>>                Forward Get ValidateSession sSessionKey to bResult
36939>>>>>                   
36939>>>>>                If (bResult) Begin
36941>>>>>                    //  Update session record
36941>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36942>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36943>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36944>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36945>>>>>                    Get Request_Validate of hoSessionDD to iErr
36946>>>>>                    If (iErr) Begin
36948>>>>>                        // this should not happen. If it does its a programming error
36948>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36949>>>>>>
36949>>>>>                        Function_Return False
36950>>>>>                    End
36950>>>>>>
36950>>>>>                    Send Request_Save of hoSessionDD
36951>>>>>                    
36951>>>>>                    //  Update user properties
36951>>>>>                    Send UpdateSessionProperties False
36952>>>>>                End
36952>>>>>>
36952>>>>>            End
36952>>>>>>
36952>>>>>            Else Begin
36953>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36953>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36954>>>>>                
36954>>>>>                If (not(bCreatingNewSession)) Begin
36956>>>>>                    If (not(bLoadWebApp)) Begin
36958>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
36959>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
36960>>>>>>
36960>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
36961>>>>>                    End
36961>>>>>>
36961>>>>>                    Else Begin
36962>>>>>                        Set pbCreatingNewSession to True                    
36963>>>>>                        Get RecreateSession of ghoWebApp to bResult 
36964>>>>>                        Set pbCreatingNewSession to False                        
36965>>>>>                    End
36965>>>>>>
36965>>>>>                End
36965>>>>>>
36965>>>>>            End
36965>>>>>>
36965>>>>>        End
36965>>>>>>
36965>>>>>        Else Begin
36966>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
36967>>>>>>
36967>>>>>        End
36967>>>>>>
36967>>>>>        
36967>>>>>        Function_Return bResult
36968>>>>>    End_Function
36969>>>>>    
36969>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36971>>>>>        If (not(pbPasswordHashing(Self))) Begin
36973>>>>>            Move sPassword to sHash
36974>>>>>            Function_Return True
36975>>>>>        End
36975>>>>>>
36975>>>>>        
36975>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
36977>>>>>            Function_Return False
36978>>>>>        End
36978>>>>>>
36978>>>>>        Move ("V1$" + sHash) to sHash
36979>>>>>        Function_Return True
36980>>>>>    End_Function
36981>>>>>    
36981>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
36983>>>>>        If (not(pbPasswordHashing(Self))) Begin
36985>>>>>            Move False to bShouldUpgrade
36986>>>>>            Function_Return (sUserPassword = sEnteredPassword)
36987>>>>>        End
36987>>>>>>
36987>>>>>        
36987>>>>>        String sVersion
36987>>>>>        Move (Left(sUserPassword, 3)) to sVersion
36988>>>>>        If (sVersion = "V1$") Begin
36990>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
36993>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
36994>>>>>        End
36994>>>>>>
36994>>>>>        Else Begin
36995>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
36998>>>>>            Function_Return False
36999>>>>>        End
36999>>>>>>
36999>>>>>    End_Function
37000>>>>>    
37000>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37002>>>>>        Handle hoUserDD
37002>>>>>        Integer iErr
37002>>>>>        Get phoUserDD to hoUserDD
37003>>>>>        
37003>>>>>        //  Find the user
37003>>>>>        Send Clear of hoUserDD
37004>>>>>        Move sLoginName to WebAppUser.LoginName
37005>>>>>        Send Find of hoUserDD EQ Index.1
37006>>>>>        If (Found) Begin
37008>>>>>            Send Clear of hoUserDD
37009>>>>>            Function_Return False
37010>>>>>        End
37010>>>>>>
37010>>>>>        
37010>>>>>        Send Clear of hoUserDD
37011>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37012>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37013>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37015>>>>>            Send Clear of hoUserDD
37016>>>>>            Function_Return False
37017>>>>>        End
37017>>>>>>
37017>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37018>>>>>        Get Request_Validate of hoUserDD to iErr
37019>>>>>        If (iErr) Begin
37021>>>>>            Send Clear of hoUserDD
37022>>>>>            Function_Return False
37023>>>>>        End
37023>>>>>>
37023>>>>>        
37023>>>>>        Send Request_Save of hoUserDD
37024>>>>>        Function_Return (not(Err))
37025>>>>>    End_Function
37026>>>>>    
37026>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37028>>>>>        String sSessionKey sUserPassword
37028>>>>>        Handle hoSessionDD hoUserDD
37028>>>>>        Boolean bMatch bUpgrade
37028>>>>>        
37028>>>>>        Get phoSessionDD to hoSessionDD
37029>>>>>        Get phoUserDD to hoUserDD
37030>>>>>        Integer iErr eLoginMode
37030>>>>>        
37030>>>>>        // Refind session record
37030>>>>>        Get psSessionKey to sSessionKey
37031>>>>>        Send Clear of hoSessionDD
37032>>>>>        Move sSessionKey to WebAppSession.SessionKey
37033>>>>>        Send Find of hoSessionDD EQ Index.1
37034>>>>>        
37034>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37036>>>>>            Get peLoginMode to eLoginMode
37037>>>>>            
37037>>>>>            //  Find the user
37037>>>>>            Move sLoginName to WebAppUser.LoginName
37038>>>>>            Send Find of hoUserDD EQ Index.1
37039>>>>>            
37039>>>>>            // Check username and password
37039>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37041>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37042>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37043>>>>>                
37043>>>>>                If (bMatch) Begin
37045>>>>>                    // Store the login
37045>>>>>                    If (bUpgrade) Begin
37047>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37048>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37051>>>>>                    End
37051>>>>>>
37051>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37052>>>>>                    Get Request_Validate of hoSessionDD to iErr
37053>>>>>                    If (iErr) Begin
37055>>>>>                        // this should not happen. If it does its a programming error
37055>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37056>>>>>>
37056>>>>>                        Function_Return False
37057>>>>>                    End
37057>>>>>>
37057>>>>>                    
37057>>>>>                    Send Request_Save of hoSessionDD
37058>>>>>                    
37058>>>>>                    // Update session properties
37058>>>>>                    Send UpdateSessionProperties False
37059>>>>>                    Send NotifyChangeRights
37060>>>>>                    Function_Return True
37061>>>>>                End
37061>>>>>>
37061>>>>>                Else Begin
37062>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37062>>>>>                    Send Clear of hoUserDD
37063>>>>>                End
37063>>>>>>
37063>>>>>            End
37063>>>>>>
37063>>>>>            Else Begin
37064>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37064>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37065>>>>>            End
37065>>>>>>
37065>>>>>        End
37065>>>>>>
37065>>>>>        Else Begin
37066>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37066>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37067>>>>>        End
37067>>>>>>
37067>>>>>          
37067>>>>>        Function_Return False
37068>>>>>    End_Function
37069>>>>>    
37069>>>>>    Function SetUserPassword String sLoginName String sPassword Returns Boolean
37071>>>>>        Handle hoUserDD
