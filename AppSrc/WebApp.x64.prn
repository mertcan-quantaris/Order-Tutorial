37223>>>    
37223>>>    Procedure DoLogin
37226>>>        String sLoginName sPassword
37226>>>        Boolean bResult
37226>>>        Handle hoDefaultView
37226>>>        
37226>>>        WebGet psValue of oLoginName to sLoginName
37227>>>        WebGet psValue of oPassword to sPassword
37228>>>        
37228>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37229>>>        
37229>>>        If (bResult) Begin
37231>>>            Send Hide of oLoginDialog
37232>>>            Get GetDefaultView to hoDefaultView
37233>>>            If (hoDefaultView > 0) Begin
37235>>>                Send Show of hoDefaultView
37236>>>            End
37236>>>>
37236>>>            
37236>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37236>>>            WebSet psValue of oLoginName to ""
37237>>>            WebSet psValue of oPassword  to ""
37238>>>            WebSet pbVisible of oWarning to False
37239>>>        End
37239>>>>
37239>>>        Else Begin
37240>>>            WebSet pbVisible of oWarning to True
37241>>>        End
37241>>>>
37241>>>    End_Procedure
37242>>>    
37242>>>    
37242>>>    Set pbServerOnSubmit to True
37243>>>    Procedure OnSubmit
37246>>>         Send DoLogin
37247>>>    End_Procedure
37248>>>End_Object
