37352>>>>>    //  Validates if the field contains a valid email address (it allows empty values too).
37352>>>>>    Function ValidateEmail Integer iColumn String sValue Returns Boolean
37354>>>>>        Integer iAt iDot
37354>>>>>        Boolean bResult
37354>>>>>        
37354>>>>>        If (Trim(sValue) <> "") Begin
37356>>>>>            Move (Pos("@", sValue)) to iAt
37357>>>>>            Move (RightPos(".", sValue)) to iDot
37358>>>>>            
37358>>>>>            If (not(iAt > 1 and iDot > 0 and iDot > iAt + 1 and iDot < Length(sValue))) Begin
37360>>>>>                Send Data_set_error iColumn DFERR_OPERATOR "Please enter a valid email address"
37361>>>>>                Move True to bResult
37362>>>>>            End
37362>>>>>>
37362>>>>>        End
37362>>>>>>
37362>>>>>        
37362>>>>>        Function_Return bResult
37363>>>>>    End_Function
37364>>>>>    
37364>>>>>End_Class
