36693>>>>>>>                Function_Return False
36694>>>>>>>        Case End
36694>>>>>>>        
36694>>>>>>>        String sSalt
36694>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36695>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36698>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36699>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36702>>>>>>>        
36702>>>>>>>        If (bRequireTimeCost) Begin
36704>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36705>>>>>>>        End
36705>>>>>>>>
36705>>>>>>>        Else Begin
36706>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36707>>>>>>>        End
36707>>>>>>>>
36707>>>>>>>        
36707>>>>>>>        Function_Return bOk
36708>>>>>>>    End_Function
