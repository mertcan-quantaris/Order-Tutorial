36835>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36836>>>>>    
36836>>>>>    Procedure Construct_Object
36838>>>>>        Handle hoObj
36838>>>>>        
36838>>>>>        Forward Send Construct_Object
36840>>>>>        
36840>>>>>        Set pbSessionCookieHttpOnly to True
36841>>>>>        
36841>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36842>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36843>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36844>>>>>        
36844>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36845>>>>>        Set phoUserDD to hoObj
36846>>>>>        
36846>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36847>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36848>>>>>        Set phoSessionDD to hoObj
36849>>>>>        
36849>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36850>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36851>>>>>        Set phoCrypto to hoObj
36852>>>>>        
36852>>>>>        Property Boolean pbPasswordHashing True
36853>>>>>        
36853>>>>>        Property Boolean pbCreatingNewSession False
36854>>>>>        Property String psLoginName
36855>>>>>        Property String psUserName ""
36856>>>>>        Property Integer piUserRights 0
36857>>>>>    End_Procedure
36858>>>>>    
36858>>>>>    Procedure End_Construct_Object
36860>>>>>        Forward Send End_Construct_Object
36862>>>>>        
36862>>>>>        Handle hoCrypto
36862>>>>>        Integer iFieldLen
36862>>>>>        If (pbPasswordHashing(Self)) Begin
36864>>>>>            Get phoCrypto to hoCrypto
36865>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36868>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36870>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36871>>>>>>
36871>>>>>            End
36871>>>>>>
36871>>>>>        End
36871>>>>>>
36871>>>>>    End_Procedure
36872>>>>>    
36872>>>>>    Function CreateSession String sRemoteAddress Returns String
36874>>>>>        String sSessionKey
36874>>>>>        Integer iErr
36874>>>>>        Boolean bLogWebSession
36874>>>>>        Handle hoSessionDD       
36874>>>>>        Get phoSessionDD to hoSessionDD
36875>>>>>        
36875>>>>>        //  Get session key
36875>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36877>>>>>        
36877>>>>>        Get pbLogWebSession to bLogWebSession
36878>>>>>        If not bLogWebSession Begin
36880>>>>>            Function_Return sSessionKey        
36881>>>>>        End
36881>>>>>>
36881>>>>>
36881>>>>>        //  Store session
36881>>>>>        Send Clear of hoSessionDD
36882>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36883>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36884>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36885>>>>>        Get Request_Validate of hoSessionDD to iErr
36886>>>>>        If (iErr) Begin
36888>>>>>            // this should not happen. If it does its a programming error
36888>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36889>>>>>>
36889>>>>>            Function_Return ""
36890>>>>>        End
36890>>>>>>
36890>>>>>        Send Request_Save of hoSessionDD
36891>>>>>        If (Err) Begin
36893>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36893>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36894>>>>>>
36894>>>>>            Function_Return ""
36895>>>>>        End
36895>>>>>>
36895>>>>>       
36895>>>>>        Function_Return sSessionKey        
36896>>>>>    End_Function
36897>>>>>    
36897>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36899>>>>>        DateTime dtLastAccess dtCurrent
36899>>>>>        TimeSpan tsDiff
36899>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36899>>>>>        Boolean bResult bCreatingNewSession
36899>>>>>        Boolean bLogWebSession bLoadWebApp
36899>>>>>        Integer eLoginMode
36899>>>>>        String sTime
36899>>>>>        Handle hoSessionDD hoUserDD       
36899>>>>>        
36899>>>>>        Move False to bLoadWebApp
36900>>>>>        If (num_arguments >= 2) Begin
36902>>>>>            Move bOptLoadWebApp to bLoadWebApp
36903>>>>>        End
36903>>>>>>
36903>>>>>        
36903>>>>>        Get phoSessionDD to hoSessionDD
36904>>>>>        Get phoUserDD to hoUserDD
36905>>>>>        
36905>>>>>        Get pbLogWebSession to bLogWebSession
36906>>>>>        Get peLoginMode to eLoginMode
36907>>>>>        
36907>>>>>        // for this object, you can only disable logging if login completely is disabled
36907>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36909>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36910>>>>>>
36910>>>>>            Function_Return False
36911>>>>>        End
36911>>>>>>
36911>>>>>
36911>>>>>        //  Clear session properties
36911>>>>>        Set psSessionKey to ""
36912>>>>>        Send UpdateSessionProperties True
36913>>>>>        
36913>>>>>        If not bLogWebSession Begin
36915>>>>>            Forward Get ValidateSession sSessionKey to bResult
36917>>>>>            Function_Return bResult
36918>>>>>        End        
36918>>>>>>
36918>>>>>        
36918>>>>>        Move False to bResult
36919>>>>>        Get piSessionTimeout to iSessionTimeout 
36920>>>>>        
36920>>>>>        //  Check if session exists
36920>>>>>        Send Clear of hoSessionDD
36921>>>>>        Move sSessionKey to WebAppSession.SessionKey
36922>>>>>        Send Find of hoSessionDD EQ Index.1
36923>>>>>            
36923>>>>>        If (Found) Begin
36925>>>>>            //  Calculate timespan between now and last access time
36925>>>>>            Move (CurrentDateTime()) to dtCurrent
36926>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36927>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36928>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36929>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36930>>>>>            
36930>>>>>            //  Check if session didn't time out
36930>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36932>>>>>                Forward Get ValidateSession sSessionKey to bResult
36934>>>>>                   
36934>>>>>                If (bResult) Begin
36936>>>>>                    //  Update session record
36936>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36937>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36938>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36939>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36940>>>>>                    Get Request_Validate of hoSessionDD to iErr
36941>>>>>                    If (iErr) Begin
36943>>>>>                        // this should not happen. If it does its a programming error
36943>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36944>>>>>>
36944>>>>>                        Function_Return False
36945>>>>>                    End
36945>>>>>>
36945>>>>>                    Send Request_Save of hoSessionDD
36946>>>>>                    
36946>>>>>                    //  Update user properties
36946>>>>>                    Send UpdateSessionProperties False
36947>>>>>                End
36947>>>>>>
36947>>>>>            End
36947>>>>>>
36947>>>>>            Else Begin
36948>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36948>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36949>>>>>                
36949>>>>>                If (not(bCreatingNewSession)) Begin
36951>>>>>                    If (not(bLoadWebApp)) Begin
36953>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
36954>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
36955>>>>>>
36955>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
36956>>>>>                    End
36956>>>>>>
36956>>>>>                    Else Begin
36957>>>>>                        Set pbCreatingNewSession to True                    
36958>>>>>                        Get RecreateSession of ghoWebApp to bResult 
36959>>>>>                        Set pbCreatingNewSession to False                        
36960>>>>>                    End
36960>>>>>>
36960>>>>>                End
36960>>>>>>
36960>>>>>            End
36960>>>>>>
36960>>>>>        End
36960>>>>>>
36960>>>>>        Else Begin
36961>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
36962>>>>>>
36962>>>>>        End
36962>>>>>>
36962>>>>>        
36962>>>>>        Function_Return bResult
36963>>>>>    End_Function
36964>>>>>    
36964>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36966>>>>>        If (not(pbPasswordHashing(Self))) Begin
36968>>>>>            Move sPassword to sHash
36969>>>>>            Function_Return True
36970>>>>>        End
36970>>>>>>
36970>>>>>        
36970>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
36972>>>>>            Function_Return False
36973>>>>>        End
36973>>>>>>
36973>>>>>        Move ("V1$" + sHash) to sHash
36974>>>>>        Function_Return True
36975>>>>>    End_Function
36976>>>>>    
36976>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
36978>>>>>        If (not(pbPasswordHashing(Self))) Begin
36980>>>>>            Move False to bShouldUpgrade
36981>>>>>            Function_Return (sUserPassword = sEnteredPassword)
36982>>>>>        End
36982>>>>>>
36982>>>>>        
36982>>>>>        String sVersion
36982>>>>>        Move (Left(sUserPassword, 3)) to sVersion
36983>>>>>        If (sVersion = "V1$") Begin
36985>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
36988>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
36989>>>>>        End
36989>>>>>>
36989>>>>>        Else Begin
36990>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
36993>>>>>            Function_Return False
36994>>>>>        End
36994>>>>>>
36994>>>>>    End_Function
36995>>>>>    
36995>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
36997>>>>>        Handle hoUserDD
36997>>>>>        Integer iErr
36997>>>>>        Get phoUserDD to hoUserDD
36998>>>>>        
36998>>>>>        //  Find the user
36998>>>>>        Send Clear of hoUserDD
36999>>>>>        Move sLoginName to WebAppUser.LoginName
37000>>>>>        Send Find of hoUserDD EQ Index.1
37001>>>>>        If (Found) Begin
37003>>>>>            Send Clear of hoUserDD
37004>>>>>            Function_Return False
37005>>>>>        End
37005>>>>>>
37005>>>>>        
37005>>>>>        Send Clear of hoUserDD
37006>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37007>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37008>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37010>>>>>            Send Clear of hoUserDD
37011>>>>>            Function_Return False
37012>>>>>        End
37012>>>>>>
37012>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37013>>>>>        Get Request_Validate of hoUserDD to iErr
37014>>>>>        If (iErr) Begin
37016>>>>>            Send Clear of hoUserDD
37017>>>>>            Function_Return False
37018>>>>>        End
37018>>>>>>
37018>>>>>        
37018>>>>>        Send Request_Save of hoUserDD
37019>>>>>        Function_Return (not(Err))
37020>>>>>    End_Function
37021>>>>>    
37021>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37023>>>>>        String sSessionKey sUserPassword
37023>>>>>        Handle hoSessionDD hoUserDD
37023>>>>>        Boolean bMatch bUpgrade
37023>>>>>        
37023>>>>>        Get phoSessionDD to hoSessionDD
37024>>>>>        Get phoUserDD to hoUserDD
37025>>>>>        Integer iErr eLoginMode
37025>>>>>        
37025>>>>>        // Refind session record
37025>>>>>        Get psSessionKey to sSessionKey
37026>>>>>        Send Clear of hoSessionDD
37027>>>>>        Move sSessionKey to WebAppSession.SessionKey
37028>>>>>        Send Find of hoSessionDD EQ Index.1
37029>>>>>        
37029>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37031>>>>>            Get peLoginMode to eLoginMode
37032>>>>>            
37032>>>>>            //  Find the user
37032>>>>>            Move sLoginName to WebAppUser.LoginName
37033>>>>>            Send Find of hoUserDD EQ Index.1
37034>>>>>            
37034>>>>>            // Check username and password
37034>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37036>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37037>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37038>>>>>                
37038>>>>>                If (bMatch) Begin
37040>>>>>                    // Store the login
37040>>>>>                    If (bUpgrade) Begin
37042>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37043>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37046>>>>>                    End
37046>>>>>>
37046>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37047>>>>>                    Get Request_Validate of hoSessionDD to iErr
37048>>>>>                    If (iErr) Begin
37050>>>>>                        // this should not happen. If it does its a programming error
37050>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37051>>>>>>
37051>>>>>                        Function_Return False
37052>>>>>                    End
37052>>>>>>
37052>>>>>                    
37052>>>>>                    Send Request_Save of hoSessionDD
37053>>>>>                    
37053>>>>>                    // Update session properties
37053>>>>>                    Send UpdateSessionProperties False
37054>>>>>                    Send NotifyChangeRights
37055>>>>>                    Function_Return True
37056>>>>>                End
37056>>>>>>
37056>>>>>                Else Begin
37057>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37057>>>>>                    Send Clear of hoUserDD
37058>>>>>                End
37058>>>>>>
37058>>>>>            End
37058>>>>>>
37058>>>>>            Else Begin
37059>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37059>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37060>>>>>            End
37060>>>>>>
37060>>>>>        End
37060>>>>>>
37060>>>>>        Else Begin
37061>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37061>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37062>>>>>        End
37062>>>>>>
37062>>>>>          
37062>>>>>        Function_Return False
37063>>>>>    End_Function
37064>>>>>    
37064>>>>>    Function SetUserPassword String sLoginName String sPassword Returns Boolean
37066>>>>>        Handle hoUserDD
37066>>>>>        Integer iErr
37066>>>>>        Get phoUserDD to hoUserDD
37067>>>>>        
37067>>>>>        //  Find the user
37067>>>>>        Send Clear of hoUserDD
