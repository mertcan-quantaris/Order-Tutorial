36855>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36856>>>>>    
36856>>>>>    Procedure Construct_Object
36858>>>>>        Handle hoObj
36858>>>>>        
36858>>>>>        Forward Send Construct_Object
36860>>>>>        
36860>>>>>        Set pbSessionCookieHttpOnly to True
36861>>>>>        
36861>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36862>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36863>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36864>>>>>        
36864>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36865>>>>>        Set phoUserDD to hoObj
36866>>>>>        
36866>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36867>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36868>>>>>        Set phoSessionDD to hoObj
36869>>>>>        
36869>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36870>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36871>>>>>        Set phoCrypto to hoObj
36872>>>>>        
36872>>>>>        Property Boolean pbPasswordHashing True
36873>>>>>        
36873>>>>>        Property Boolean pbCreatingNewSession False
36874>>>>>        Property String psLoginName
36875>>>>>        Property String psUserName ""
36876>>>>>        Property Integer piUserRights 0
36877>>>>>    End_Procedure
36878>>>>>    
36878>>>>>    Procedure End_Construct_Object
36880>>>>>        Forward Send End_Construct_Object
36882>>>>>        
36882>>>>>        Handle hoCrypto
36882>>>>>        Integer iFieldLen
36882>>>>>        If (pbPasswordHashing(Self)) Begin
36884>>>>>            Get phoCrypto to hoCrypto
36885>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36888>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36890>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36891>>>>>>
36891>>>>>            End
36891>>>>>>
36891>>>>>        End
36891>>>>>>
36891>>>>>    End_Procedure
36892>>>>>    
36892>>>>>    Function CreateSession String sRemoteAddress Returns String
36894>>>>>        String sSessionKey
36894>>>>>        Integer iErr
36894>>>>>        Boolean bLogWebSession
36894>>>>>        Handle hoSessionDD       
36894>>>>>        Get phoSessionDD to hoSessionDD
36895>>>>>        
36895>>>>>        //  Get session key
36895>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36897>>>>>        
36897>>>>>        Get pbLogWebSession to bLogWebSession
36898>>>>>        If not bLogWebSession Begin
36900>>>>>            Function_Return sSessionKey        
36901>>>>>        End
36901>>>>>>
36901>>>>>
36901>>>>>        //  Store session
36901>>>>>        Send Clear of hoSessionDD
36902>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36903>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36904>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36905>>>>>        Get Request_Validate of hoSessionDD to iErr
36906>>>>>        If (iErr) Begin
36908>>>>>            // this should not happen. If it does its a programming error
36908>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36909>>>>>>
36909>>>>>            Function_Return ""
36910>>>>>        End
36910>>>>>>
36910>>>>>        Send Request_Save of hoSessionDD
36911>>>>>        If (Err) Begin
36913>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36913>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36914>>>>>>
36914>>>>>            Function_Return ""
36915>>>>>        End
36915>>>>>>
36915>>>>>       
36915>>>>>        Function_Return sSessionKey        
36916>>>>>    End_Function
36917>>>>>    
36917>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36919>>>>>        DateTime dtLastAccess dtCurrent
36919>>>>>        TimeSpan tsDiff
36919>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36919>>>>>        Boolean bResult bCreatingNewSession
36919>>>>>        Boolean bLogWebSession bLoadWebApp
36919>>>>>        Integer eLoginMode
36919>>>>>        String sTime
36919>>>>>        Handle hoSessionDD hoUserDD       
36919>>>>>        
36919>>>>>        Move False to bLoadWebApp
36920>>>>>        If (num_arguments >= 2) Begin
36922>>>>>            Move bOptLoadWebApp to bLoadWebApp
36923>>>>>        End
36923>>>>>>
36923>>>>>        
36923>>>>>        Get phoSessionDD to hoSessionDD
36924>>>>>        Get phoUserDD to hoUserDD
36925>>>>>        
36925>>>>>        Get pbLogWebSession to bLogWebSession
36926>>>>>        Get peLoginMode to eLoginMode
36927>>>>>        
36927>>>>>        // for this object, you can only disable logging if login completely is disabled
36927>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36929>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36930>>>>>>
36930>>>>>            Function_Return False
36931>>>>>        End
36931>>>>>>
36931>>>>>
36931>>>>>        //  Clear session properties
36931>>>>>        Set psSessionKey to ""
36932>>>>>        Send UpdateSessionProperties True
36933>>>>>        
36933>>>>>        If not bLogWebSession Begin
36935>>>>>            Forward Get ValidateSession sSessionKey to bResult
36937>>>>>            Function_Return bResult
36938>>>>>        End        
36938>>>>>>
36938>>>>>        
36938>>>>>        Move False to bResult
36939>>>>>        Get piSessionTimeout to iSessionTimeout 
36940>>>>>        
36940>>>>>        //  Check if session exists
36940>>>>>        Send Clear of hoSessionDD
36941>>>>>        Move sSessionKey to WebAppSession.SessionKey
36942>>>>>        Send Find of hoSessionDD EQ Index.1
36943>>>>>            
36943>>>>>        If (Found) Begin
36945>>>>>            //  Calculate timespan between now and last access time
36945>>>>>            Move (CurrentDateTime()) to dtCurrent
36946>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36947>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36948>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36949>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36950>>>>>            
36950>>>>>            //  Check if session didn't time out
36950>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36952>>>>>                Forward Get ValidateSession sSessionKey to bResult
36954>>>>>                   
36954>>>>>                If (bResult) Begin
36956>>>>>                    //  Update session record
36956>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36957>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36958>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36959>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36960>>>>>                    Get Request_Validate of hoSessionDD to iErr
36961>>>>>                    If (iErr) Begin
36963>>>>>                        // this should not happen. If it does its a programming error
36963>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36964>>>>>>
36964>>>>>                        Function_Return False
36965>>>>>                    End
36965>>>>>>
36965>>>>>                    Send Request_Save of hoSessionDD
36966>>>>>                    
36966>>>>>                    //  Update user properties
36966>>>>>                    Send UpdateSessionProperties False
36967>>>>>                End
36967>>>>>>
36967>>>>>            End
36967>>>>>>
36967>>>>>            Else Begin
36968>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36968>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36969>>>>>                
36969>>>>>                If (not(bCreatingNewSession)) Begin
36971>>>>>                    If (not(bLoadWebApp)) Begin
36973>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
36974>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
36975>>>>>>
36975>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
36976>>>>>                    End
36976>>>>>>
36976>>>>>                    Else Begin
36977>>>>>                        Set pbCreatingNewSession to True                    
36978>>>>>                        Get RecreateSession of ghoWebApp to bResult 
36979>>>>>                        Set pbCreatingNewSession to False                        
36980>>>>>                    End
36980>>>>>>
36980>>>>>                End
36980>>>>>>
36980>>>>>            End
36980>>>>>>
36980>>>>>        End
36980>>>>>>
36980>>>>>        Else Begin
36981>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
36982>>>>>>
36982>>>>>        End
36982>>>>>>
36982>>>>>        
36982>>>>>        Function_Return bResult
36983>>>>>    End_Function
36984>>>>>    
36984>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36986>>>>>        If (not(pbPasswordHashing(Self))) Begin
36988>>>>>            Move sPassword to sHash
36989>>>>>            Function_Return True
36990>>>>>        End
36990>>>>>>
36990>>>>>        
36990>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
36992>>>>>            Function_Return False
36993>>>>>        End
36993>>>>>>
36993>>>>>        Move ("V1$" + sHash) to sHash
36994>>>>>        Function_Return True
36995>>>>>    End_Function
36996>>>>>    
36996>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
36998>>>>>        If (not(pbPasswordHashing(Self))) Begin
37000>>>>>            Move False to bShouldUpgrade
37001>>>>>            Function_Return (sUserPassword = sEnteredPassword)
37002>>>>>        End
37002>>>>>>
37002>>>>>        
37002>>>>>        String sVersion
37002>>>>>        Move (Left(sUserPassword, 3)) to sVersion
37003>>>>>        If (sVersion = "V1$") Begin
37005>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
37008>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
37009>>>>>        End
37009>>>>>>
37009>>>>>        Else Begin
37010>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37013>>>>>            Function_Return False
37014>>>>>        End
37014>>>>>>
37014>>>>>    End_Function
37015>>>>>    
37015>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37017>>>>>        Handle hoUserDD
37017>>>>>        Integer iErr
37017>>>>>        Get phoUserDD to hoUserDD
37018>>>>>        
37018>>>>>        //  Find the user
37018>>>>>        Send Clear of hoUserDD
37019>>>>>        Move sLoginName to WebAppUser.LoginName
37020>>>>>        Send Find of hoUserDD EQ Index.1
37021>>>>>        If (Found) Begin
37023>>>>>            Send Clear of hoUserDD
37024>>>>>            Function_Return False
37025>>>>>        End
37025>>>>>>
37025>>>>>        
37025>>>>>        Send Clear of hoUserDD
37026>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37027>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37028>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37030>>>>>            Send Clear of hoUserDD
37031>>>>>            Function_Return False
37032>>>>>        End
37032>>>>>>
37032>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37033>>>>>        Get Request_Validate of hoUserDD to iErr
37034>>>>>        If (iErr) Begin
37036>>>>>            Send Clear of hoUserDD
37037>>>>>            Function_Return False
37038>>>>>        End
37038>>>>>>
37038>>>>>        
37038>>>>>        Send Request_Save of hoUserDD
37039>>>>>        Function_Return (not(Err))
37040>>>>>    End_Function
37041>>>>>    
37041>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37043>>>>>        String sSessionKey sUserPassword
37043>>>>>        Handle hoSessionDD hoUserDD
37043>>>>>        Boolean bMatch bUpgrade
37043>>>>>        
37043>>>>>        Get phoSessionDD to hoSessionDD
37044>>>>>        Get phoUserDD to hoUserDD
37045>>>>>        Integer iErr eLoginMode
37045>>>>>        
37045>>>>>        // Refind session record
37045>>>>>        Get psSessionKey to sSessionKey
37046>>>>>        Send Clear of hoSessionDD
37047>>>>>        Move sSessionKey to WebAppSession.SessionKey
37048>>>>>        Send Find of hoSessionDD EQ Index.1
37049>>>>>        
37049>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37051>>>>>            Get peLoginMode to eLoginMode
37052>>>>>            
37052>>>>>            //  Find the user
37052>>>>>            Move sLoginName to WebAppUser.LoginName
37053>>>>>            Send Find of hoUserDD EQ Index.1
37054>>>>>            
37054>>>>>            // Check username and password
37054>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37056>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37057>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37058>>>>>                
37058>>>>>                If (bMatch) Begin
37060>>>>>                    // Store the login
37060>>>>>                    If (bUpgrade) Begin
37062>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37063>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37066>>>>>                    End
37066>>>>>>
37066>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37067>>>>>                    Get Request_Validate of hoSessionDD to iErr
37068>>>>>                    If (iErr) Begin
37070>>>>>                        // this should not happen. If it does its a programming error
37070>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37071>>>>>>
37071>>>>>                        Function_Return False
37072>>>>>                    End
37072>>>>>>
37072>>>>>                    
37072>>>>>                    Send Request_Save of hoSessionDD
37073>>>>>                    
37073>>>>>                    // Update session properties
37073>>>>>                    Send UpdateSessionProperties False
37074>>>>>                    Send NotifyChangeRights
37075>>>>>                    Function_Return True
37076>>>>>                End
37076>>>>>>
37076>>>>>                Else Begin
37077>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37077>>>>>                    Send Clear of hoUserDD
37078>>>>>                End
37078>>>>>>
37078>>>>>            End
37078>>>>>>
37078>>>>>            Else Begin
37079>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37079>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37080>>>>>            End
37080>>>>>>
37080>>>>>        End
37080>>>>>>
37080>>>>>        Else Begin
37081>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37081>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37082>>>>>        End
37082>>>>>>
37082>>>>>          
37082>>>>>        Function_Return False
37083>>>>>    End_Function
37084>>>>>    
37084>>>>>    Function SetUserPassword String sLoginName String sPassword Returns Boolean
37086>>>>>        Handle hoUserDD
37086>>>>>        Integer iErr
37086>>>>>        Get phoUserDD to hoUserDD
37087>>>>>        
37087>>>>>        //  Find the user
37087>>>>>        Send Clear of hoUserDD
37088>>>>>        Move sLoginName to WebAppUser.LoginName
37089>>>>>        Send Find of hoUserDD EQ Index.1
37090>>>>>        If (not(Found)) Begin
37092>>>>>            Send Clear of hoUserDD
37093>>>>>            Function_Return False
37094>>>>>        End
37094>>>>>>
37094>>>>>        
37094>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37096>>>>>            Send Clear of hoUserDD
37097>>>>>            Function_Return False
37098>>>>>        End
37098>>>>>>
37098>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37099>>>>>        Get Request_Validate of hoUserDD to iErr
37100>>>>>        If (iErr) Begin
37102>>>>>            Send Clear of hoUserDD
37103>>>>>            Function_Return False
37104>>>>>        End
37104>>>>>>
37104>>>>>        
37104>>>>>        Send Request_Save of hoUserDD
37105>>>>>        Function_Return (not(Err))
37106>>>>>    End_Function
37107>>>>>    
37107>>>>>    Function IsLoggedIn Returns Boolean
37109>>>>>        String sLoginName
37109>>>>>        Boolean bLogWebSession bLoggedIn
37109>>>>>        
37109>>>>>        Get pbLogWebSession to bLogWebSession
37110>>>>>        If not bLogWebSession Begin
37112>>>>>            Forward Get IsLoggedIn to bLoggedIn
37114>>>>>            Function_Return bLoggedIn
37115>>>>>        End
37115>>>>>>
37115>>>>>        
37115>>>>>        Get psLoginName to sLoginName
37116>>>>>        
37116>>>>>        Function_Return (sLoginName <> "")
37117>>>>>    End_Function
37118>>>>>    
37118>>>>>    
37118>>>>>    //
37118>>>>>    // This procedure is called when validating a session and after logging in. Its purpose is to 
37118>>>>>    // update properties based on the session and user data. Augment this function to update 
37118>>>>>    // properties based on the session / user table. Note that WebAppUser and WebAppSession contain
37118>>>>>    // the right records when this procedure is called.
37118>>>>>    //
37118>>>>>    // Params:
37118>>>>>    //      bClear   True if the procedure is called before session validation to clear properties.
37118>>>>>    //
37118>>>>>    Procedure UpdateSessionProperties Boolean bClear
37120>>>>>        Handle hoUserDD
37120>>>>>        
37120>>>>>        Get phoUserDD to hoUserDD
37121>>>>>        
37121>>>>>        //  Update user properties
37121>>>>>        If (not(bClear) and HasRecord(hoUserDD)) Begin
37123>>>>>            Set psUsername to (Trim(WebAppUser.FullName))
37124>>>>>            Set psLoginName to (Trim(WebAppUser.LoginName))
37125>>>>>            Set piUserRights to WebAppUser.Rights
37126>>>>>            
37126>>>>>            Send OnSessionPropertiesSet 
37127>>>>>        End
37127>>>>>>
37127>>>>>        Else Begin
37128>>>>>            Set psUsername to ""
37129>>>>>            Set psLoginName to ""
37130>>>>>            Set piUserRights to 0
37131>>>>>            
37131>>>>>            Send OnSessionPropertiesClear
37132>>>>>        End
37132>>>>>>
37132>>>>>    End_Procedure
37133>>>>>    
37133>>>>>    Procedure OnSessionPropertiesSet
37135>>>>>        //  Empty event stub
37135>>>>>    End_Procedure
37136>>>>>    
37136>>>>>    Procedure OnSessionPropertiesClear
37138>>>>>        //  Empty event stub
37138>>>>>    End_Procedure
37139>>>>>    
37139>>>>>    Procedure EndSession
37141>>>>>        Integer iErr
37141>>>>>        Boolean bLogWebSession
37141>>>>>        Handle hoSessionDD       
37141>>>>>        
37141>>>>>        Get phoSessionDD to hoSessionDD
37142>>>>>        Get pbLogWebSession to bLogWebSession
37143>>>>>        If not bLogWebSession Begin
37145>>>>>            Forward Send EndSession
37147>>>>>            Procedure_Return
37148>>>>>        End
37148>>>>>>
37148>>>>>            
37148>>>>>        //  Check if session exists
37148>>>>>        Send Clear of hoSessionDD
37149>>>>>        Get psSessionKey to WebAppSession.SessionKey
37150>>>>>        
37150>>>>>        Send Find of hoSessionDD EQ Index.1
37151>>>>>        If (Found) Begin
37153>>>>>            Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "N"
37154>>>>>            Get Request_Validate of hoSessionDD to iErr
37155>>>>>            If (iErr) Begin
37157>>>>>                // this should not happen. If it does its a programming error
37157>>>>>                Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37158>>>>>>
37158>>>>>                Procedure_Return
37159>>>>>            End
37159>>>>>>
37159>>>>>            Send Request_Save of hoSessionDD
37160>>>>>        End
37160>>>>>>
37160>>>>>    End_Procedure
37161>>>>>
37161>>>>>End_Class
37162>>>>>
