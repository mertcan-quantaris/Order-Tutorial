36541>>>>>>>    //
36541>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36541>>>>>>>    //
36541>>>>>>>    //  Params:
36541>>>>>>>    //      dtTime  Time to convert
36541>>>>>>>    //  Returns:
36541>>>>>>>    //      String with "HH:MM:SS" format
36541>>>>>>>    //
36541>>>>>>>    Function TimeToString DateTime dtTime Returns String
36543>>>>>>>        String sHours sMinutes sSeconds
36543>>>>>>>        
36543>>>>>>>        //  Extract parts
36543>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36544>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36545>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36546>>>>>>>        
36546>>>>>>>        //  Fill out with 0
36546>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36549>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36552>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36555>>>>>>>        
36555>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36556>>>>>>>    End_Function
36557>>>>>>>    
36557>>>>>>>    //
36557>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36557>>>>>>>    //
36557>>>>>>>    //  Params:
36557>>>>>>>    //      dtTime  Datetime variable to add time to
36557>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
36557>>>>>>>    //  Returns:
36557>>>>>>>    //      dtDateTime with the loaded time
36557>>>>>>>    //
36557>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36559>>>>>>>        String sHours sMinutes sSeconds
36559>>>>>>>        
36559>>>>>>>        //  Extract parts
36559>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36560>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36561>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36562>>>>>>>        
36562>>>>>>>        //  Set to DateTime
36562>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36563>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36564>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36565>>>>>>>        
36565>>>>>>>        Function_Return dtTime
36566>>>>>>>    End_Function
36567>>>>>>>End_Class
