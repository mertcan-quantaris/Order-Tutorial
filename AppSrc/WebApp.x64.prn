36692>>>>>>>                If (not(bOk)) Function_Return False
36695>>>>>>>                
36695>>>>>>>                Move True to bRequireTimeCost
36696>>>>>>>                Case Break
36697>>>>>>>            Case Else
36697>>>>>>>                Error 8710 "Invalid algorithm selected."
36698>>>>>>>>
36698>>>>>>>                Function_Return False
36699>>>>>>>        Case End
36699>>>>>>>        
36699>>>>>>>        String sSalt
36699>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36700>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36703>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36704>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36707>>>>>>>        
36707>>>>>>>        If (bRequireTimeCost) Begin
36709>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36710>>>>>>>        End
36710>>>>>>>>
36710>>>>>>>        Else Begin
36711>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36712>>>>>>>        End
36712>>>>>>>>
36712>>>>>>>        
36712>>>>>>>        Function_Return bOk
36713>>>>>>>    End_Function
36714>>>>>>>    
36714>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36716>>>>>>>        UChar[] ucaSalt
36717>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36718>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36721>>>>>>>        
36721>>>>>>>        If (num_arguments > 4) Begin
36723>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36724>>>>>>>        End
36724>>>>>>>>
36724>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36725>>>>>>>    End_Function
36726>>>>>>>    
36726>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36728>>>>>>>        Boolean bRequiresTimeCost
36728>>>>>>>        UInteger uiAlgo uiTimeCost
36728>>>>>>>        Integer iBegin iEnd
36728>>>>>>>        String sSalt
36728>>>>>>>        
36728>>>>>>>        Move 1 to iBegin
36729>>>>>>>        
36729>>>>>>>        // Parse Algo
36729>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36730>>>>>>>        If (not(iEnd)) Function_Return False
36733>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36734>>>>>>>        
36734>>>>>>>        // Parse Salt
36734>>>>>>>        Move (iEnd + 1) to iBegin
36735>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36736>>>>>>>        If (not(iEnd)) Function_Return False
36739>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36740>>>>>>>        
36740>>>>>>>        Case Begin
36740>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36742>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36745>>>>>>>                Move True to bRequiresTimeCost
36746>>>>>>>                Case Break
36747>>>>>>>            Case Else
36747>>>>>>>                Error 8710 "Invalid algorithm selected."
36748>>>>>>>>
36748>>>>>>>                Function_Return False
36749>>>>>>>        Case End
36749>>>>>>>        
36749>>>>>>>        // Parse optional timecost
36749>>>>>>>        If (bRequiresTimeCost) Begin
36751>>>>>>>            Move (iEnd + 1) to iBegin
36752>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36753>>>>>>>            If (not(iEnd)) Function_Return False
36756>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36757>>>>>>>        End
36757>>>>>>>>
36757>>>>>>>        
36757>>>>>>>        // Parse rest hash
36757>>>>>>>        Move (iEnd + 1) to iBegin
36758>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36759>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36762>>>>>>>        
36762>>>>>>>        // Base64Decode
36762>>>>>>>        UChar[] ucaSalt
36763>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36764>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36767>>>>>>>        
36767>>>>>>>        // Create new hash
36767>>>>>>>        String sNewHash
36767>>>>>>>        If (bRequiresTimeCost) Begin
36769>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36771>>>>>>>                Function_Return False 
36772>>>>>>>            End
36772>>>>>>>>
36772>>>>>>>        End
36772>>>>>>>>
36772>>>>>>>        Else Begin
36773>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36775>>>>>>>                Function_Return False 
36776>>>>>>>            End
36776>>>>>>>>
36776>>>>>>>        End
36776>>>>>>>>
36776>>>>>>>        Function_Return (sNewHash = sHash)
36777>>>>>>>    End_Function
36778>>>>>>>    
36778>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36780>>>>>>>        Boolean bRequireTimeCost
36780>>>>>>>        UBigInt ullSize
36780>>>>>>>        UChar[] ucaSalt
36781>>>>>>>        String sSalt
36781>>>>>>>        
36781>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36782>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36783>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36786>>>>>>>        
36786>>>>>>>        Case Begin
36786>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36788>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36789>>>>>>>                Move True to bRequireTimeCost
36790>>>>>>>                Case Break
36791>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36794>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36795>>>>>>>                Move True to bRequireTimeCost
36796>>>>>>>                Case Break
36797>>>>>>>            Case Else
36797>>>>>>>                Error 8710 "Invalid algorithm selected."
36798>>>>>>>>
36798>>>>>>>                Function_Return 0
36799>>>>>>>        Case End
36799>>>>>>>        
36799>>>>>>>        // calculate base64 in a non-floating-manner
36799>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36800>>>>>>>        
36800>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36801>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36802>>>>>>>        If (bRequireTimeCost) Begin
36804>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36805>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36806>>>>>>>        End
36806>>>>>>>>
36806>>>>>>>        Else Begin
36807>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36808>>>>>>>        End
36808>>>>>>>>
36808>>>>>>>        
36808>>>>>>>        Function_Return ullSize
36809>>>>>>>    End_Function
36810>>>>>>>End_Class
36811>>>>>>>
36811>>>>>>>Class cPasswordHasher is a cObject
36812>>>>>>>    
36812>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36813>>>>>>>    
36813>>>>>>>    Procedure Construct_Object
36815>>>>>>>        Forward Send Construct_Object
36817>>>>>>>        
36817>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36818>>>>>>>        Property UInteger   puiSaltSize         16
36819>>>>>>>        
36819>>>>>>>        Property UInteger   puiOptTimeCost      420000
36820>>>>>>>    End_Procedure
36821>>>>>>>    
36821>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36823>>>>>>>        Boolean bOk
36823>>>>>>>        UInteger uiAlgo
36823>>>>>>>        Get peAlgorithm to uiAlgo
36824>>>>>>>        
36824>>>>>>>        Case Begin
36824>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36826>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36829>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36830>>>>>>>                Case Break
36831>>>>>>>            Case Else
36831>>>>>>>                Error 8710 "Invalid algorithm selected."
36832>>>>>>>>
36832>>>>>>>                Function_Return False
36833>>>>>>>        Case End
36833>>>>>>>        
36833>>>>>>>        Function_Return bOk
36834>>>>>>>    End_Function
36835>>>>>>>    
36835>>>>>>>    Function RequiredBufferSize Returns UBigInt
36837>>>>>>>        UBigInt ullSize
36837>>>>>>>        UInteger uiAlgo
36837>>>>>>>        Get peAlgorithm to uiAlgo
36838>>>>>>>        
36838>>>>>>>        Case Begin
36838>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36840>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36843>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36844>>>>>>>                Case Break
36845>>>>>>>            Case Else
36845>>>>>>>                Error 8710 "Invalid algorithm selected."
36846>>>>>>>>
36846>>>>>>>                Function_Return 0
36847>>>>>>>        Case End
36847>>>>>>>        
36847>>>>>>>        Function_Return ullSize
36848>>>>>>>    End_Function
36849>>>>>>>
36849>>>>>>>End_Class
