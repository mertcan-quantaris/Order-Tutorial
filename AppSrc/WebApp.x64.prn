37347>>>>>    //  Validates if the field contains a valid email address (it allows empty values too).
37347>>>>>    Function ValidateEmail Integer iColumn String sValue Returns Boolean
37349>>>>>        Integer iAt iDot
37349>>>>>        Boolean bResult
37349>>>>>        
37349>>>>>        If (Trim(sValue) <> "") Begin
37351>>>>>            Move (Pos("@", sValue)) to iAt
37352>>>>>            Move (RightPos(".", sValue)) to iDot
37353>>>>>            
37353>>>>>            If (not(iAt > 1 and iDot > 0 and iDot > iAt + 1 and iDot < Length(sValue))) Begin
37355>>>>>                Send Data_set_error iColumn DFERR_OPERATOR "Please enter a valid email address"
37356>>>>>                Move True to bResult
37357>>>>>            End
37357>>>>>>
37357>>>>>        End
37357>>>>>>
37357>>>>>        
37357>>>>>        Function_Return bResult
37358>>>>>    End_Function
37359>>>>>    
37359>>>>>End_Class
