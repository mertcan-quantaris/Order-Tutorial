36531>>>>>>>    //
36531>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36531>>>>>>>    //
36531>>>>>>>    //  Params:
36531>>>>>>>    //      dtTime  Time to convert
36531>>>>>>>    //  Returns:
36531>>>>>>>    //      String with "HH:MM:SS" format
36531>>>>>>>    //
36531>>>>>>>    Function TimeToString DateTime dtTime Returns String
36533>>>>>>>        String sHours sMinutes sSeconds
36533>>>>>>>        
36533>>>>>>>        //  Extract parts
36533>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36534>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36535>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36536>>>>>>>        
36536>>>>>>>        //  Fill out with 0
36536>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36539>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36542>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36545>>>>>>>        
36545>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36546>>>>>>>    End_Function
36547>>>>>>>    
36547>>>>>>>    //
36547>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36547>>>>>>>    //
36547>>>>>>>    //  Params:
36547>>>>>>>    //      dtTime  Datetime variable to add time to
36547>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
36547>>>>>>>    //  Returns:
36547>>>>>>>    //      dtDateTime with the loaded time
36547>>>>>>>    //
36547>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36549>>>>>>>        String sHours sMinutes sSeconds
36549>>>>>>>        
36549>>>>>>>        //  Extract parts
36549>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36550>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36551>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36552>>>>>>>        
36552>>>>>>>        //  Set to DateTime
36552>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36553>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36554>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36555>>>>>>>        
36555>>>>>>>        Function_Return dtTime
36556>>>>>>>    End_Function
36557>>>>>>>End_Class
