36709>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36711>>>>>>>        UChar[] ucaSalt
36712>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36713>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36716>>>>>>>        
36716>>>>>>>        If (num_arguments > 4) Begin
36718>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36719>>>>>>>        End
36719>>>>>>>>
36719>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36720>>>>>>>    End_Function
36721>>>>>>>    
36721>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36723>>>>>>>        Boolean bRequiresTimeCost
36723>>>>>>>        UInteger uiAlgo uiTimeCost
36723>>>>>>>        Integer iBegin iEnd
36723>>>>>>>        String sSalt
36723>>>>>>>        
36723>>>>>>>        Move 1 to iBegin
36724>>>>>>>        
36724>>>>>>>        // Parse Algo
36724>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36725>>>>>>>        If (not(iEnd)) Function_Return False
36728>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36729>>>>>>>        
36729>>>>>>>        // Parse Salt
36729>>>>>>>        Move (iEnd + 1) to iBegin
36730>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36731>>>>>>>        If (not(iEnd)) Function_Return False
36734>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36735>>>>>>>        
36735>>>>>>>        Case Begin
36735>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36737>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36740>>>>>>>                Move True to bRequiresTimeCost
36741>>>>>>>                Case Break
36742>>>>>>>            Case Else
36742>>>>>>>                Error 8710 "Invalid algorithm selected."
36743>>>>>>>>
36743>>>>>>>                Function_Return False
36744>>>>>>>        Case End
36744>>>>>>>        
36744>>>>>>>        // Parse optional timecost
36744>>>>>>>        If (bRequiresTimeCost) Begin
36746>>>>>>>            Move (iEnd + 1) to iBegin
36747>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36748>>>>>>>            If (not(iEnd)) Function_Return False
36751>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36752>>>>>>>        End
36752>>>>>>>>
36752>>>>>>>        
36752>>>>>>>        // Parse rest hash
36752>>>>>>>        Move (iEnd + 1) to iBegin
36753>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36754>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36757>>>>>>>        
36757>>>>>>>        // Base64Decode
36757>>>>>>>        UChar[] ucaSalt
36758>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36759>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36762>>>>>>>        
36762>>>>>>>        // Create new hash
36762>>>>>>>        String sNewHash
36762>>>>>>>        If (bRequiresTimeCost) Begin
36764>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36766>>>>>>>                Function_Return False 
36767>>>>>>>            End
36767>>>>>>>>
36767>>>>>>>        End
36767>>>>>>>>
36767>>>>>>>        Else Begin
36768>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36770>>>>>>>                Function_Return False 
36771>>>>>>>            End
36771>>>>>>>>
36771>>>>>>>        End
36771>>>>>>>>
36771>>>>>>>        Function_Return (sNewHash = sHash)
36772>>>>>>>    End_Function
36773>>>>>>>    
36773>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36775>>>>>>>        Boolean bRequireTimeCost
36775>>>>>>>        UBigInt ullSize
36775>>>>>>>        UChar[] ucaSalt
36776>>>>>>>        String sSalt
36776>>>>>>>        
36776>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36777>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36778>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36781>>>>>>>        
36781>>>>>>>        Case Begin
36781>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36783>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36784>>>>>>>                Move True to bRequireTimeCost
36785>>>>>>>                Case Break
36786>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36789>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36790>>>>>>>                Move True to bRequireTimeCost
36791>>>>>>>                Case Break
36792>>>>>>>            Case Else
36792>>>>>>>                Error 8710 "Invalid algorithm selected."
36793>>>>>>>>
36793>>>>>>>                Function_Return 0
36794>>>>>>>        Case End
36794>>>>>>>        
36794>>>>>>>        // calculate base64 in a non-floating-manner
36794>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36795>>>>>>>        
36795>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36796>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36797>>>>>>>        If (bRequireTimeCost) Begin
36799>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36800>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36801>>>>>>>        End
36801>>>>>>>>
36801>>>>>>>        Else Begin
36802>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36803>>>>>>>        End
36803>>>>>>>>
36803>>>>>>>        
36803>>>>>>>        Function_Return ullSize
36804>>>>>>>    End_Function
36805>>>>>>>End_Class
36806>>>>>>>
36806>>>>>>>Class cPasswordHasher is a cObject
36807>>>>>>>    
36807>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36808>>>>>>>    
36808>>>>>>>    Procedure Construct_Object
36810>>>>>>>        Forward Send Construct_Object
36812>>>>>>>        
36812>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36813>>>>>>>        Property UInteger   puiSaltSize         16
36814>>>>>>>        
36814>>>>>>>        Property UInteger   puiOptTimeCost      420000
36815>>>>>>>    End_Procedure
36816>>>>>>>    
36816>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36818>>>>>>>        Boolean bOk
36818>>>>>>>        UInteger uiAlgo
36818>>>>>>>        Get peAlgorithm to uiAlgo
36819>>>>>>>        
36819>>>>>>>        Case Begin
36819>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36821>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36824>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36825>>>>>>>                Case Break
36826>>>>>>>            Case Else
36826>>>>>>>                Error 8710 "Invalid algorithm selected."
36827>>>>>>>>
36827>>>>>>>                Function_Return False
36828>>>>>>>        Case End
36828>>>>>>>        
36828>>>>>>>        Function_Return bOk
36829>>>>>>>    End_Function
36830>>>>>>>    
36830>>>>>>>    Function RequiredBufferSize Returns UBigInt
36832>>>>>>>        UBigInt ullSize
36832>>>>>>>        UInteger uiAlgo
36832>>>>>>>        Get peAlgorithm to uiAlgo
36833>>>>>>>        
36833>>>>>>>        Case Begin
36833>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36835>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36838>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36839>>>>>>>                Case Break
36840>>>>>>>            Case Else
36840>>>>>>>                Error 8710 "Invalid algorithm selected."
36841>>>>>>>>
36841>>>>>>>                Function_Return 0
36842>>>>>>>        Case End
36842>>>>>>>        
36842>>>>>>>        Function_Return ullSize
36843>>>>>>>    End_Function
36844>>>>>>>
36844>>>>>>>End_Class
