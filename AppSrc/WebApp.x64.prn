36537>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36539>>>>>>>        String sHours sMinutes sSeconds
36539>>>>>>>        
36539>>>>>>>        //  Extract parts
36539>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36540>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36541>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36542>>>>>>>        
36542>>>>>>>        //  Set to DateTime
36542>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36543>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36544>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36545>>>>>>>        
36545>>>>>>>        Function_Return dtTime
36546>>>>>>>    End_Function
